[bootstrap]
main_collection = /main/main_v2.collectionc

[script]
shared_state = 1

[display]
width = 1280
height = 720
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = zoom
heap_size = 256
custom_heap_size = 1
htmlfile = /main/engine_template.html

[project]
title = АВОСЬ
custom_resources = /main/story
dependencies#0 = https://github.com/indiesoftby/defold-yagames/archive/master.zip
dependencies#1 = https://github.com/abadonna/defold-ink/archive/master.zip

