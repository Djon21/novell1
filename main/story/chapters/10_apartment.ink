    ~ mc_name_gen = "Артёма"
    ~ npc_name_gen = "Милы"
    ~ mc_name_dat = "Артёму"
    ~ npc_name_dat = "Миле"
    ~ mc_name_acc = "Артёма"
    ~ npc_name_acc = "Милу"
    ~ mc_name_ins = "Артёмом"
    ~ npc_name_ins = "Милой"
    ~ mc_name_prep = "Артёме"
    ~ npc_name_prep = "Миле"
    -> apartment_start

* [Мила]
    ~ mc_gender = "female"
    ~ mc_name = "Мила"
    ~ npc_name = "Артём"
    ~ mc_name_gen = "Милы"
    ~ npc_name_gen = "Артёма"
    ~ mc_name_dat = "Миле"
    ~ npc_name_dat = "Артёму"
    ~ mc_name_acc = "Милу"
    ~ npc_name_acc = "Артёма"
    ~ mc_name_ins = "Милой"
    ~ npc_name_ins = "Артёмом"
    ~ mc_name_prep = "Миле"
    ~ npc_name_prep = "Артёме"
    -> apartment_start

=== apartment_start ===
# bg:bg_apartment_bedroom_morning # speaker:none
Воскресное утро.

Спальня тихая и светлая. Слева ещё держит тепло смятая кровать, справа у окна молчит рабочий стол.
За стеклом город уже давно начал день без тебя.

# sfx:phone_notify
Где-то рядом коротко вибрирует телефон.

{iteration_number > 1:
На секунду возникает ощущение, что эта тишина уже была.
Не похожая. Та же самая.
~ INSIGHT = INSIGHT + 1
~ anomaly_noticed = true
}

# speaker:mc
Сначала до меня доходит вибрация телефона. Потом свет из окна. Потом всё остальное.
{not phone_history_seeded:
    -> seed_phone_history
- else:
    # quest:start:find_phone
    # explore:apartment_bedroom
    -> DONE
}

// ----------------------------------------------------------------
// Seed телефонной истории — старые сообщения, появившиеся ДО игры.
// Все add_old → unread=false, time = задано явно ("пн", "вчера", "сб").
// Игрок при первом открытии телефона увидит не лавину новых пушей,
// а лента жизни последних дней + сегодняшние свежие беспокойства
// (они отдельно прилетают в take_phone).
// ----------------------------------------------------------------
=== seed_phone_history ===
~ phone_history_seeded = true
# set_flag:phone_history_seeded=true

# sms:add_old:bank:сб:Карта *4821: списание 480 ₽. Кофейня «петля». 12 апр. Баланс 12 740 ₽.
# sms:add_old:delivery:пт:Заказ #74021 у двери. Курьер ушёл, дверь была открыта.
# sms:add_old:upravdom:чт:Отключение горячей воды 24–26 апр. Ремонт стояка в подъезде №2.
# sms:add_old:taxi:чт:Поездка завершена. 320 ₽. Оцените водителя в приложении.
# sms:add_old:mama:пн:Не забудь поесть. И зонт возьми — обещают дождь.
# sms:add_old:mila:пн:Есть планы на сегодня? Может, увидимся в «петле» после работы.
# sms:add_old:prod:вчера:Прод упал. Тех. долг догнал. Подними, пожалуйста.

# msg:add_old:friends:пт:Доброе утро, выжившие. Кто сегодня не отменяет планы в последний момент?
# msg:add_old:friends:пт:Я могу отменить заранее, чтобы не рушить традицию.
# msg:add_old:work_team:пн:Понедельничная планёрка перенесена на 10:40. Да, в воскресенье. Нет, я тоже не рад.
# msg:add_old:work_team:вчера:По кейсу 017 завтра не забудьте сверить входящие.
# msg:add_old:prod_bot:вчера:CASE-017 создан. Часть полей ожидает подтверждения.
# msg:add_old:neighbor_chat:пн:У кого опять будильник играет с 07:00?
# msg:add_old:city_bot:вчера:Солнечно. Летний день без осадков, будто специально для прогулки.

# quest:start:find_phone
# explore:apartment_bedroom
-> DONE


