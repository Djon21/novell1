-- phone_map.gui_script
-- Карта внутри телефона (split-модуль).
-- Принимает: open_app, close_app
--
-- Флоу: клик по POI → диалог подтверждения → ДА → map_travel → ui_manager
-- ui_manager закрывает телефон и вызывает scene_controller.enter(scene_id).
--
-- POI lock: если ink-сценарий ограничил доступные POI через теги
-- # map:allow:poi_X / # map:lock_to:poi_X, то клик по запрещённому POI
-- покажет «отказной» диалог вместо confirm. См. game_state.map_is_poi_allowed.

local gs = require "main.scripts.game_state"

local UI_MGR = "#ui_manager_v2"

local BLOCKED_LABEL = "Сейчас не время. Мне туда не надо."

-- Маппинг poi_NAME → { scene, label }
-- label — строка в диалоге "Перейти в [label]?"
local POI_SCENES = {
    poi_home    = { scene = "apartment_hub", label = "Домой"       },
    poi_work    = { scene = "work_hub",      label = "На работу"   },
    poi_cafe    = { scene = "cafe_hub",      label = "Кафе"        },
    poi_park    = { scene = "park_hub",      label = "Парк у реки" },
    poi_shop    = { scene = "shop_hub",      label = "Магазин 24/7"},
    poi_bar     = { scene = "bar_hub",       label = "Бар Maybe"   },
    poi_view    = { scene = "view_hub",      label = "Смотровая"   },
    poi_archive = { scene = "archive_hub",   label = "Архив"       },
}

-- -----------------------------------------------------------------------

local function get_node(id)
    local ok, n = pcall(gui.get_node, id)
    if ok then return n end
    return nil
end

local function set_root_enabled(enabled)
    local root = get_node("grp_panel")
    if root then gui.set_enabled(root, enabled) end
end

local function hide_confirm(self)
    self.confirm_target = nil
    self.confirm_blocked = false
    local n = get_node("grp_confirm")
    if n then gui.set_enabled(n, false) end
end

local function show_confirm(self, info)
    self.confirm_target = info
    self.confirm_blocked = false
    local n = get_node("confirm_location_name")
    if n then gui.set_text(n, info.label) end
    local g = get_node("grp_confirm")
    if g then gui.set_enabled(g, true) end
end

-- Заблокированный POI: показать тот же диалог с «отказным» текстом.
-- ДА/НЕТ обе закрывают без map_travel — это просто info-overlay.
local function show_blocked(self, info)
    self.confirm_target = info
    self.confirm_blocked = true
    local n = get_node("confirm_location_name")
    if n then gui.set_text(n, BLOCKED_LABEL) end
    local g = get_node("grp_confirm")
    if g then gui.set_enabled(g, true) end
end

-- ─── POI pulse: разблокированные POI пульсируют alpha-каналом ─────────
-- PINGPONG между 1.0 и PULSE_ALPHA_LO за PULSE_DURATION (на цикл вниз).
-- Пульс идёт синхронно на трёх нодах: _circle, _center, _icon — чтобы
-- POI «дышал» целиком, а не только обводка крутилась как раньше.
local PULSE_DURATION = 0.9
local PULSE_ALPHA_LO = 0.65
local PULSE_SUFFIXES = { "_circle", "_center", "_icon" }

local function start_poi_pulse(poi_id)
    for _, suf in ipairs(PULSE_SUFFIXES) do
        local node = get_node(poi_id .. suf)
        if node then
            gui.cancel_animation(node, "color.w")
            -- Прежний spin мог оставить rotation ≠ 0 на _circle. Сбросим
            -- на всякий случай, чтобы при миграции старых сейвов не было
            -- косых иконок.
            gui.set_rotation(node, vmath.vector3(0, 0, 0))
            local c = gui.get_color(node)
            gui.set_color(node, vmath.vector4(c.x, c.y, c.z, 1))
            gui.animate(node, "color.w", PULSE_ALPHA_LO, gui.EASING_INOUTSINE,
                PULSE_DURATION, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
        end
    end
end

local function stop_poi_pulse(poi_id)
    for _, suf in ipairs(PULSE_SUFFIXES) do
        local node = get_node(poi_id .. suf)
        if node then
            gui.cancel_animation(node, "color.w")
            local c = gui.get_color(node)
            gui.set_color(node, vmath.vector4(c.x, c.y, c.z, 1))
        end
    end
end

-- Перерисовать состояние всех POI-кружков. Вызывается при open_app,
-- refresh_app и любом изменении allowed-set из ink-тегов
-- # map:allow:poi_X / # map:lock_to:poi_X.
--
-- Использует self.pulsing_pois для трекинга: если POI УЖЕ пульсирует —
-- не перезапускаем, иначе будет визуальный «прыжок» alpha на каждый refresh.
local function refresh_pois(self)
    self.pulsing_pois = self.pulsing_pois or {}
    for poi_id, _ in pairs(POI_SCENES) do
        local circle = get_node(poi_id .. "_circle")
        if circle then
            local allowed = (not gs.map_is_poi_allowed) or gs.map_is_poi_allowed(poi_id)
            if allowed and not self.pulsing_pois[poi_id] then
                start_poi_pulse(poi_id)
                self.pulsing_pois[poi_id] = true
            elseif not allowed and self.pulsing_pois[poi_id] then
                stop_poi_pulse(poi_id)
                self.pulsing_pois[poi_id] = nil
            end
        end
    end
end

-- Полный стоп — экономит CPU когда карта закрыта.
local function stop_all_pois(self)
    for poi_id, _ in pairs(POI_SCENES) do
        stop_poi_pulse(poi_id)
    end
    if self then self.pulsing_pois = {} end
end

-- -----------------------------------------------------------------------

function init(self)
    self.visible         = false
    self.confirm_target  = nil
    self.confirm_blocked = false
    set_root_enabled(false)
    -- явно прячем grp_confirm: его own enabled = false,
    -- чтобы не всплыл когда set_root_enabled(true) включит родителя
    local c = get_node("grp_confirm")
    if c then gui.set_enabled(c, false) end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_app") then
        self.visible = true
        set_root_enabled(true)
        hide_confirm(self)          -- сбрасываем возможный старый диалог
        refresh_pois(self)          -- запустить spin для разблокированных POI
    elseif message_id == hash("refresh_app") then
        if self.visible then refresh_pois(self) end
    elseif message_id == hash("close_app") then
        self.visible = false
        hide_confirm(self)
        stop_all_pois(self)         -- не крутим в скрытом app — экономия CPU
        set_root_enabled(false)
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    -- ── Диалог подтверждения открыт ──────────────────────────────────────
    if self.confirm_target then
        local yes = get_node("confirm_yes_btn")
        if yes and gui.pick_node(yes, action.x, action.y) then
            -- Заблокированный POI: ДА работает как ОК — закрываем без перехода.
            if self.confirm_blocked then
                hide_confirm(self)
                return true
            end
            local scene_id = self.confirm_target.scene
            hide_confirm(self)
            msg.post(UI_MGR, "map_travel", { scene = scene_id })
            return true
        end
        local no = get_node("confirm_no_btn")
        if no and gui.pick_node(no, action.x, action.y) then
            hide_confirm(self)
            return true
        end
        -- клик мимо кнопок — закрываем без перехода
        hide_confirm(self)
        return true
    end

    -- ── Клик по POI ──────────────────────────────────────────────────────
    for poi_id, info in pairs(POI_SCENES) do
        local hitbox = get_node(poi_id .. "_hitbox")
        if hitbox and gui.pick_node(hitbox, action.x, action.y) then
            local allowed = (not gs.map_is_poi_allowed)
                            or gs.map_is_poi_allowed(poi_id)
            if allowed then
                show_confirm(self, info)
            else
                show_blocked(self, info)
            end
            return true
        end
    end

    return false
end
