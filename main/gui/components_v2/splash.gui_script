-- splash.gui_script
-- Универсальная полноэкранная заглушка-перебивка. Используется для:
--   - смены дня (variant="day": terminal-лог + крупное название дня)
--   - смены локации (variant="location": eyebrow «ЛОКАЦИЯ» + название)
--   - воспоминаний (variant="memory": eyebrow «ВОСПОМИНАНИЕ», тёплая палитра)
--   - тревожных событий (variant="alarm": eyebrow «ВНИМАНИЕ», hot-палитра)
--   - произвольных перебивок (variant="generic": title + опц. subtitle)
--
-- Сообщения:
--   "show_splash" {
--       variant   = "day"|"location"|"memory"|"alarm"|"generic",
--       title     = "ВОСКРЕСЕНЬЕ",    -- крупный текст (для day заполняется автоматически)
--       subtitle  = "12 апреля",      -- опц. под title
--       eyebrow   = "ЛОКАЦИЯ",        -- опц. над title (для day не используется)
--       day       = "monday",         -- для variant=day (key из DAY_DISPLAY)
--       iteration = 1,                -- для day-terminal-лога
--       palette   = "normal"|"alarm"|"warm",  -- опц. ручной override
--   }
--   "hide_splash"  — принудительное скрытие (dev-jump / rollback).
--
-- Ответное сообщение в UI_MGR: "splash_done" — когда игрок тапнул И fade-out
-- отыграл. Payload содержит { variant, title } для логирования.
--
-- Тайминги: fade_in пайплайн ~1.5-2 сек, затем ждёт touch.pressed,
-- по тапу — fade_out ~0.5 сек → splash_done.

local UI_MGR = "#ui_manager_v2"

local NODE_IDS = {
    "dt_bg",
    "dt_line1", "dt_line2", "dt_line3", "dt_line4",
    "dt_eyebrow", "dt_underline", "dt_day", "dt_subtitle",
}

local COLORS = {
    bg          = vmath.vector4(0.031, 0.024, 0.094, 1),
    paper       = vmath.vector4(0.953, 0.925, 0.851, 1),
    paper_dim   = vmath.vector4(0.788, 0.753, 0.659, 1),
    accent      = vmath.vector4(0.490, 0.976, 1.000, 1),
    hot         = vmath.vector4(1.000, 0.239, 0.498, 1),
    amber       = vmath.vector4(1.000, 0.702, 0.278, 1),
}

local DAY_DISPLAY = {
    sunday    = "ВОСКРЕСЕНЬЕ",
    monday    = "ПОНЕДЕЛЬНИК",
    tuesday   = "ВТОРНИК",
    wednesday = "СРЕДА?",
}

local DAY_TERMINAL = {
    sunday    = "воскресенье",
    monday    = "понедельник",
    tuesday   = "вторник",
    wednesday = "???",
}

local function get_node(id)
    local ok, n = pcall(gui.get_node, id)
    if ok then return n end
    return nil
end

local function set_text(id, value)
    local n = get_node(id)
    if n then gui.set_text(n, tostring(value or "")) end
end

local function set_color(id, color)
    local n = get_node(id)
    if n then gui.set_color(n, color) end
end

local function set_alpha(id, alpha)
    local n = get_node(id)
    if n then
        local c = gui.get_color(n)
        gui.set_color(n, vmath.vector4(c.x, c.y, c.z, alpha))
    end
end

local function cancel_anims(id)
    local n = get_node(id)
    if n then gui.cancel_animation(n, "color.w") end
end

local function set_enabled(id, enabled)
    local n = get_node(id)
    if n then gui.set_enabled(n, enabled) end
end

local function fade_in(id, target_alpha, duration, delay, on_complete)
    local n = get_node(id)
    if not n then return end
    local c = gui.get_color(n)
    gui.set_color(n, vmath.vector4(c.x, c.y, c.z, 0))
    gui.animate(n, "color.w", target_alpha,
        gui.EASING_OUTQUAD, duration, delay or 0,
        on_complete)
end

local function fade_out(id, duration, delay, on_complete)
    local n = get_node(id)
    if not n then return end
    gui.animate(n, "color.w", 0,
        gui.EASING_INQUAD, duration, delay or 0,
        on_complete)
end

local function set_all_enabled(enabled)
    for _, id in ipairs(NODE_IDS) do
        set_enabled(id, enabled)
    end
end

local function reset_visual()
    for _, id in ipairs(NODE_IDS) do
        cancel_anims(id)
        set_alpha(id, 0)
    end
end

-- Тайминги (секунды), шаренные между всеми вариантами.
local T = {
    bg_fade_in   = 0.25,
    line_delay   = 0.30,
    line_dur     = 0.18,
    under_delay  = 0.30,
    under_dur    = 0.25,
    eyebrow_dur  = 0.30,
    title_dur    = 0.40,
    subtitle_dur = 0.30,
    fade_out     = 0.50,
}

-- Палитра по варианту (или ручному override). Возвращает таблицу с цветами
-- для всех видимых узлов.
local function resolve_palette(variant, palette_override)
    local p = palette_override
    if not p then
        if variant == "alarm" then p = "alarm"
        elseif variant == "memory" then p = "warm"
        else p = "normal" end
    end
    if p == "alarm" then
        return {
            bg = COLORS.bg, eyebrow = COLORS.hot, line = COLORS.hot,
            underline = COLORS.hot, title = COLORS.hot, subtitle = COLORS.amber,
        }
    elseif p == "warm" then
        return {
            bg = COLORS.bg, eyebrow = COLORS.amber, line = COLORS.amber,
            underline = COLORS.amber, title = COLORS.paper, subtitle = COLORS.amber,
        }
    end
    return {
        bg = COLORS.bg, eyebrow = COLORS.accent, line = COLORS.paper_dim,
        underline = COLORS.accent, title = COLORS.paper, subtitle = COLORS.paper_dim,
    }
end

-- Строит config для рендера по варианту + payload из сообщения.
local function build_config(message)
    message = message or {}
    local variant = tostring(message.variant or "generic")

    if variant == "day" then
        local to_day = tostring(message.day or message.to or "sunday")
        local from_day = tostring(message.from or "")
        local iteration = tonumber(message.iteration) or 1
        local from_t = DAY_TERMINAL[from_day] or "..."
        local to_t   = DAY_TERMINAL[to_day]   or "???"
        local palette = (to_day == "wednesday") and "alarm" or "normal"
        return {
            variant = "day",
            palette = resolve_palette("day", palette),
            show_lines = true,
            show_eyebrow = false,
            show_underline = true,
            show_title = true,
            show_subtitle = false,
            line_texts = {
                "> завершение цикла: " .. from_t,
                "> состояние сна: завершено",
                "> начало цикла: " .. to_t,
                (to_day == "wednesday")
                    and "> итерация: ???"
                    or string.format("> итерация: %03d", iteration),
            },
            title_text = DAY_DISPLAY[to_day] or string.upper(to_day),
        }
    end

    -- Остальные варианты: eyebrow + title + опц. subtitle.
    local default_eyebrow = {
        location = "ЛОКАЦИЯ",
        memory   = "ВОСПОМИНАНИЕ",
        alarm    = "ВНИМАНИЕ",
        generic  = nil,
    }
    local eyebrow = message.eyebrow or default_eyebrow[variant]
    return {
        variant = variant,
        palette = resolve_palette(variant, message.palette),
        show_lines = false,
        show_eyebrow = eyebrow ~= nil and eyebrow ~= "",
        show_underline = true,
        show_title = true,
        show_subtitle = message.subtitle ~= nil and tostring(message.subtitle) ~= "",
        eyebrow_text = eyebrow,
        title_text = message.title or "...",
        subtitle_text = message.subtitle,
    }
end

local function apply_config(cfg)
    -- Цвета на всех узлах (даже скрытых) — чтобы не было «грязи» при повторном show.
    set_color("dt_bg", cfg.palette.bg)
    for i = 1, 4 do set_color("dt_line" .. i, cfg.palette.line) end
    set_color("dt_eyebrow", cfg.palette.eyebrow)
    set_color("dt_underline", cfg.palette.underline)
    set_color("dt_day", cfg.palette.title)
    set_color("dt_subtitle", cfg.palette.subtitle)

    if cfg.show_lines then
        for i = 1, 4 do set_text("dt_line" .. i, cfg.line_texts[i] or "") end
    end
    if cfg.show_eyebrow then set_text("dt_eyebrow", cfg.eyebrow_text) end
    if cfg.show_title then set_text("dt_day", cfg.title_text) end
    if cfg.show_subtitle then set_text("dt_subtitle", cfg.subtitle_text) end

    set_enabled("dt_bg", true)
    for i = 1, 4 do set_enabled("dt_line" .. i, cfg.show_lines) end
    set_enabled("dt_eyebrow", cfg.show_eyebrow)
    set_enabled("dt_underline", cfg.show_underline)
    set_enabled("dt_day", cfg.show_title)
    set_enabled("dt_subtitle", cfg.show_subtitle)
end

-- Запускает fade-out фазу + сообщает ui_manager что всё.
local function start_fade_out(self)
    if not self.visible then return end
    self.waiting_for_tap = false
    local targets = {
        "dt_line1", "dt_line2", "dt_line3", "dt_line4",
        "dt_eyebrow", "dt_underline", "dt_day", "dt_subtitle", "dt_bg",
    }
    for i, id in ipairs(targets) do
        local last = (i == #targets)
        fade_out(id, T.fade_out, 0, last and function()
            set_all_enabled(false)
            self.visible = false
            msg.post(UI_MGR, "splash_done", self.payload or {})
            self.payload = nil
        end or nil)
    end
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = false
    self.waiting_for_tap = false
    self.payload = nil
    set_all_enabled(false)
    reset_visual()
end

function on_message(self, message_id, message, sender)
    if message_id == hash("show_splash") then
        message = message or {}
        local cfg = build_config(message)

        self.visible = true
        self.waiting_for_tap = false
        self.payload = { variant = cfg.variant, title = cfg.title_text }

        reset_visual()
        apply_config(cfg)

        -- Pipeline fade_in'ов через delay-аргумент gui.animate.
        local t = 0
        fade_in("dt_bg", 0.95, T.bg_fade_in, t)
        t = t + T.bg_fade_in

        if cfg.show_lines then
            fade_in("dt_line1", 1.0, T.line_dur, t); t = t + T.line_delay
            fade_in("dt_line2", 1.0, T.line_dur, t); t = t + T.line_delay
            fade_in("dt_line3", 1.0, T.line_dur, t); t = t + T.line_delay
            fade_in("dt_line4", 1.0, T.line_dur, t)
            t = t + T.line_dur + T.under_delay
        end

        if cfg.show_eyebrow then
            fade_in("dt_eyebrow", 1.0, T.eyebrow_dur, t)
            t = t + T.eyebrow_dur * 0.6   -- частично перекрывается со следующим
        end

        if cfg.show_underline then
            fade_in("dt_underline", 0.85, T.under_dur, t)
            t = t + T.under_dur
        end

        if cfg.show_title then
            fade_in("dt_day", 1.0, T.title_dur, t)
            t = t + T.title_dur
        end

        if cfg.show_subtitle then
            fade_in("dt_subtitle", 1.0, T.subtitle_dur, t)
            t = t + T.subtitle_dur
        end

        -- После всех fade_in'ов — ставим флаг ожидания тапа.
        -- ВАЖНО: fade_out'ы нельзя запускать здесь же через delay-аргумент
        -- gui.animate (Defold cancels existing animation на той же property).
        -- timer.delay даёт fade_in'ам отыграть полностью.
        timer.delay(t, false, function()
            self.waiting_for_tap = true
        end)

    elseif message_id == hash("hide_splash") then
        reset_visual()
        set_all_enabled(false)
        self.visible = false
        self.waiting_for_tap = false
        self.payload = nil
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if not self.waiting_for_tap then
        return true   -- анимация ещё идёт, не пропускаем клик дальше
    end
    if action_id == hash("touch") and action.pressed then
        start_fade_out(self)
        return true
    end
    return true   -- модалка эксклюзивная, любой input глотаем
end
