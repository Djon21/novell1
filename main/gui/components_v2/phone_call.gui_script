-- phone_call.gui_script
-- Журнал звонков в составе split-телефона.
-- Принимает: open_app, close_app, refresh_app

local gs = require "main.scripts.game_state"

local COLOR_PAPER = vmath.vector4(0.95, 0.95, 0.90, 1.0)
local COLOR_HOT   = vmath.vector4(1.00, 0.30, 0.30, 1.0)

local NODE_IDS = {
    "calls_screen_bg", "calls_header_line", "calls_footer_line", "calls_status_chip",
    "v_calls_eyebrow", "v_calls_title",
    "calls_row1_accent",
    "v_calls_row1_bg", "v_calls_row1_name", "v_calls_row1_meta",
    "calls_row2_accent",
    "v_calls_row2_bg", "v_calls_row2_name", "v_calls_row2_meta",
    "calls_row3_accent",
    "v_calls_row3_bg", "v_calls_row3_name", "v_calls_row3_meta",
}

local CALL_SLOTS = 3

local function get_node(id)
    local ok, n = pcall(gui.get_node, id)
    if ok then return n end
    return nil
end

local function set_node_enabled(id, enabled)
    local n = get_node(id)
    if n then gui.set_enabled(n, enabled) end
end

local function set_nodes_enabled(enabled)
    for _, id in ipairs(NODE_IDS) do
        set_node_enabled(id, enabled)
    end
end

local function set_text(id, s)
    local n = get_node(id)
    if n then gui.set_text(n, s or "") end
end

local function set_node_color(id, c)
    local n = get_node(id)
    if n then gui.set_color(n, c) end
end

local function refresh(self)
    local list = gs.get_call_log and gs.get_call_log() or {}
    for i = 1, CALL_SLOTS do
        local prefix = "v_calls_row" .. i
        local has = list[i] ~= nil
        set_node_enabled(prefix .. "_bg",   has)
        set_node_enabled(prefix .. "_name", has)
        set_node_enabled(prefix .. "_meta", has)
        if has then
            local c = list[i]
            set_text(prefix .. "_name", c.who or "—")
            set_text(prefix .. "_meta", c.time or "")
            set_node_color(prefix .. "_name", c.missed and COLOR_HOT or COLOR_PAPER)
        end
    end
end

function init(self)
    self.visible = false
    set_nodes_enabled(false)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_app") then
        self.visible = true
        set_nodes_enabled(true)
        refresh(self)
    elseif message_id == hash("close_app") then
        self.visible = false
        set_nodes_enabled(false)
    elseif message_id == hash("refresh_app") then
        if self.visible then refresh(self) end
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    return false
end
