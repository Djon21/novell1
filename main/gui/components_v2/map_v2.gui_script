local DEFAULT_PIN_ORDER = { "home", "work", "cafe", "metro", "shop", "clue", "gov" }

local VERBS = { "route", "save", "share" }
local VERB_LABEL = { route = "МАРШРУТ", save = "СОХР.", share = "ОТМЕТИТЬ" }
local make_pin
local select_pin

local function set_text(id, s)
    gui.set_text(gui.get_node(id), s or "")
end

local function set_color(id, c)
    gui.set_color(gui.get_node(id), c)
end

local function set_map_enabled(self, enabled)
    for _, id in ipairs(MAP_NODES) do
        gui.set_enabled(gui.get_node(id), enabled)
    end
    for _, pin in pairs(self.pins) do
        gui.set_enabled(pin.body, enabled)
        gui.set_enabled(pin.border, enabled)
        gui.set_enabled(pin.icon, enabled)
    end
    for i = 1, #self.verb_btns do
        local btn = self.verb_btns[i]
        gui.set_enabled(btn.bg, enabled)
        gui.set_enabled(btn.border, enabled)
        gui.set_enabled(btn.label, enabled)
    end
end

local function clone_point(point)
    if type(point) ~= "table" then
        return point
    end
    local out = {}
    for k, v in pairs(point) do
        if type(v) == "table" then
            local nested = {}
            for nk, nv in pairs(v) do
                nested[nk] = nv
            end
            out[k] = nested
        else
            out[k] = v
        end
    end
    return out
end

local function clone_points(points)
    local out = {}
    for id, point in pairs(points or {}) do
        out[id] = clone_point(point)
    end
    return out
end

local function clone_array(src)
    local out = {}
    for i = 1, #(src or {}) do
        out[i] = src[i]
    end
    return out
end

local function normalize_point_overrides(points)
    local out = {}
    if type(points) ~= "table" then
        return out
    end

    if #points > 0 then
        for _, point in ipairs(points) do
            if type(point) == "table" and point.id then
                out[point.id] = clone_point(point)
            end
        end
        return out
    end

    for id, point in pairs(points) do
        if point == false then
            out[id] = false
        elseif type(point) == "table" then
            local copy = clone_point(point)
            copy.id = copy.id or id
            out[id] = copy
        end
    end
    return out
end

local function delete_pin_nodes(pin)
    if not pin then return end
    if pin.body then gui.delete_node(pin.body) end
    if pin.border then gui.delete_node(pin.border) end
    if pin.icon then gui.delete_node(pin.icon) end
end

local function rebuild_pins(self)
    for _, pin in pairs(self.pins or {}) do
        delete_pin_nodes(pin)
    end
    self.pins = {}

    for _, id in ipairs(self.pin_order or {}) do
        local point = self.points and self.points[id] or nil
        if point and point.visible ~= false then
            self.pins[id] = make_pin(self, id, point)
        end
    end
end

local function apply_points(self, points, selected_id)
    local overrides = normalize_point_overrides(points)
    local next_points = clone_points(DEFAULT_POINTS)
    local next_order = {}

    for _, id in ipairs(DEFAULT_PIN_ORDER) do
        local point = next_points[id]
        local override = overrides[id]

        if override == false then
            next_points[id] = nil
        else
            if point and type(override) == "table" then
                for k, v in pairs(override) do
                    point[k] = v
                end
            end
            if point and point.visible ~= false then
                table.insert(next_order, id)
            end
        end

        overrides[id] = nil
    end

    local extra_ids = {}
    for id, point in pairs(overrides) do
        if point and point ~= false then
            next_points[id] = point
            if point.visible ~= false then
                table.insert(extra_ids, id)
            end
        end
    end
    table.sort(extra_ids)
    for _, id in ipairs(extra_ids) do
        table.insert(next_order, id)
    end

    self.points = next_points
    self.pin_order = next_order
    rebuild_pins(self)

    local preferred = selected_id or self.selected or self.pin_order[1]
    if preferred and self.points[preferred] and self.points[preferred].visible ~= false then
        select_pin(self, preferred)
    elseif self.pin_order[1] then
        select_pin(self, self.pin_order[1])
    end

    set_map_enabled(self, self.visible)
end

make_pin = function(self, id, p)
    local parent = gui.get_node("map_area")
    local parent_pos = gui.get_position(parent)
    
    -- Локальные координаты (нормализованные 0..1)
    local local_px = p.pos.x * MAP_W
    local local_py = p.pos.y * MAP_H
    
    -- Абсолютные координаты
    local abs_px = parent_pos.x + local_px
    local abs_py = parent_pos.y + local_py
    
    local ring_color = COLORS[p.color] or COLORS.accent

    local body = gui.new_box_node(vmath.vector3(abs_px, abs_py, 0.55), vmath.vector3(32, 32, 0))
    gui.set_pivot(body, gui.PIVOT_CENTER)
    gui.set_color(body, COLORS.pin_bg)
    gui.set_inherit_alpha(body, false)

    local border = gui.new_box_node(vmath.vector3(abs_px, abs_py - 16, 0.56), vmath.vector3(32, 1, 0))
    gui.set_pivot(border, gui.PIVOT_CENTER)
    gui.set_color(border, ring_color)
    gui.set_inherit_alpha(border, false)

    local ic = gui.new_text_node(vmath.vector3(abs_px, abs_py, 0.57), p.icon or "?")
    gui.set_pivot(ic, gui.PIVOT_CENTER)
    gui.set_font(ic, "icons")
    gui.set_color(ic, ring_color)
    gui.set_inherit_alpha(ic, false)

    return { body = body, border = border, icon = ic, id = id, color = ring_color }
end

local function make_verb(self, idx, verb)
    local parent = gui.get_node("doss_verbs")
    local parent_pos = gui.get_position(parent)
    
    local w, h, gap = 92, 30, 4
    local local_x = (idx - 1) * (w + gap)
    local local_y = 0
    
    -- Абсолютные координаты
    local abs_x = parent_pos.x + local_x
    local abs_y = parent_pos.y + local_y

    local bg = gui.new_box_node(vmath.vector3(abs_x, abs_y, 0.55), vmath.vector3(w, h, 0))
    gui.set_pivot(bg, gui.PIVOT_SW)
    gui.set_color(bg, COLORS.btn_bg)
    gui.set_inherit_alpha(bg, false)

    local border = gui.new_box_node(vmath.vector3(abs_x, abs_y, 0.56), vmath.vector3(w, 1, 0))
    gui.set_pivot(border, gui.PIVOT_SW)
    gui.set_color(border, COLORS.btn_border)
    gui.set_inherit_alpha(border, false)

    local label = gui.new_text_node(vmath.vector3(abs_x + w/2, abs_y + h/2, 0.57), VERB_LABEL[verb] or verb:upper())
    gui.set_pivot(label, gui.PIVOT_CENTER)
    gui.set_font(label, "jb_mono_bold_14")
    gui.set_color(label, COLORS.accent)
    gui.set_inherit_alpha(label, false)

    return { bg = bg, border = border, label = label, verb = verb }
end

local function highlight_pin(self, id)
    for pid, pin in pairs(self.pins) do
        local active = (pid == id)
        gui.set_color(pin.border, active and COLORS.pin_active_border or pin.color)
        if active then
            gui.set_color(pin.body, pin.color)
        else
            gui.set_color(pin.body, COLORS.pin_bg)
        end
    end
end

select_pin = function(self, id)
    local p = self.points and self.points[id] or nil
    if not p then return end
    self.selected = id
    highlight_pin(self, id)
    set_text("doss_name", (p.name or ""):upper())
    set_text("doss_stamp", (p.stamp or "") .. " · петля " .. (p.iter or ""))
    set_color("doss_stamp", COLORS[p.color] or COLORS.accent)
    set_text("doss_v_addr", p.addr or "—")
    set_text("doss_v_walk", p.walk or "—")
    set_text("doss_v_sub",  p.sub or "—")
    local stat_str = (p.stat or "—")
    if p.clue and p.clue ~= "—" then stat_str = stat_str .. " · улика: " .. p.clue end
    set_text("doss_v_stat", stat_str)
    set_text("doss_desc", p.desc or "")
    set_text("log", "> маркер выбран: " .. (p.name or ""):lower() .. " _")
    -- координаты (fake)
    local lat = 55.740 + p.pos.y * 0.040
    local lon = 37.555 + p.pos.x * 0.070
    set_text("map_coords", string.format("%.4f° N · %.4f° E", lat, lon))
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = false
    self.pins = {}
    self.verb_btns = {}
    self.selected = nil
    self.points = clone_points(DEFAULT_POINTS)
    self.pin_order = clone_array(DEFAULT_PIN_ORDER)

    rebuild_pins(self)
    for i, v in ipairs(VERBS) do
        self.verb_btns[i] = make_verb(self, i, v)
    end

    select_pin(self, "home")
    set_map_enabled(self, false)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_map") then
        self.visible = true
        set_map_enabled(self, true)
    elseif message_id == hash("close_map") then
        self.visible = false
        set_map_enabled(self, false)
    elseif message_id == hash("set_points") then
        apply_points(self, message and message.points, message and message.selected_id)
    elseif message_id == hash("select_pin") then
        if message and message.id then select_pin(self, message.id) end
    elseif message_id == hash("set_log") then
        set_text("log", message and message.text or "")
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    if gui.pick_node(gui.get_node("close_btn"), action.x, action.y) then
        msg.post(UI_MGR, "close_map")
        return true
    end

    for id, pin in pairs(self.pins) do
        if gui.pick_node(pin.body, action.x, action.y) then
            select_pin(self, id)
            return true
        end
    end

    for i = 1, #self.verb_btns do
        local b = self.verb_btns[i]
        if gui.pick_node(b.bg, action.x, action.y) then
            local map = { route = "прокладываю маршрут", save = "маркер сохранён", share = "отмечено в досье" }
            set_text("log", "> " .. (map[b.verb] or b.verb) .. " _")
            if self.selected then
                msg.post(UI_MGR, "map_verb", { pin_id = self.selected, verb = b.verb })
            end
            return true
        end
    end

    return false
end
