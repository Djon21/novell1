-- map_v2.gui_script
-- Карта Москвы · Пресня. Слева — map_area (560×480) с 7 динамическими пинами,
-- справа — dossier-панель с инфой по выбранному пину и 3 кнопки-глагола.
--
-- Сообщения:
--   "open_map"            — показать
--   "close_map"           — скрыть
--   "set_points" {points} — заменить массив POINTS (опционально)
--   "select_pin" {id}     — программно выбрать пин
--
-- В ui_manager_v2 шлёт:
--   "close_map"
--   "map_verb" {pin_id, verb}  — verb ∈ {"route","save","share"}

local theme = require "main.gui.modules.v2_theme"

local UI_MGR = "#ui_manager_v2"

local MAP_NODES = {
    "backdrop", "title_eyebrow", "title_main", "close_btn", "map_area",
    "map_border_bot", "map_border_top", "map_coords", "dossier",
    "doss_eyebrow", "doss_name", "doss_stamp", "doss_k_addr", "doss_v_addr",
    "doss_k_walk", "doss_v_walk", "doss_k_sub", "doss_v_sub", "doss_k_stat",
    "doss_v_stat", "doss_desc", "doss_verbs", "log",
}

-- map_area origin (SW) + size:
local MAP_X, MAP_Y = 30, 70
local MAP_W, MAP_H = 560, 480

local COLORS = {
    paper = vmath.vector4(0.952, 0.925, 0.85, 1.0),
    accent = vmath.vector4(0.49, 0.976, 1.0, 1.0),
    hot = vmath.vector4(1.0, 0.239, 0.498, 1.0),
    amber = vmath.vector4(1.0, 0.702, 0.278, 1.0),
    violet = vmath.vector4(0.478, 0.361, 1.0, 1.0),
    pin_bg = vmath.vector4(0.039, 0.031, 0.129, 0.95),
    pin_border = vmath.vector4(0.49, 0.976, 1.0, 0.8),
    pin_active_border = vmath.vector4(0.952, 0.925, 0.85, 1.0),
    stamp = vmath.vector4(0.784, 0.078, 0.165, 1.0),
    btn_bg = vmath.vector4(0.067, 0.055, 0.173, 0.85),
    btn_border = vmath.vector4(0.49, 0.976, 1.0, 0.5),
}

local function icon_b(a,b,c) return string.char(a,b,c) end

