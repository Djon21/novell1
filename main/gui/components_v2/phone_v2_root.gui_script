-- phone_v2_root.gui_script
-- Chrome + launcher. Роутит open/close к дочерним app-компонентам.
--
-- Входящие сообщения (от #ui_manager_v2):
--   "open_phone"            — показать телефон, открыть SMS по умолчанию
--   "close_phone"           — закрыть телефон (только скрыть, не постить обратно)
--   "refresh_phone"         — обновить счётчик + переслать активному приложению
--   "set_phone_notif" {n}   — обновить "сообщений: N"
--   "set_phone_time" {time} — legacy no-op; wall_time показывает текущий день
--
-- Исходящие сообщения (к #ui_manager_v2):
--   "close_phone"           — пользователь нажал X
--   "phone_app_clicked" {id}— нажат тайл приложения

local gs      = require "main.scripts.game_state"
local U       = require "main.gui.modules.gui_utils"
local log     = require "main.scripts.log"
local MSG     = require "main.gui.modules.messages"
local UI_MGR  = "#ui_manager_v2"

local BASE_W  = 1280
local BASE_H  = 720

local function dbg(...) log.debug("phone_root", ...) end

-- Root-level chrome nodes (no parent in .gui) — reparented under phone_root
-- at init for uniform adaptive scaling.
local ROOT_CHROME = {
    "phone_bg",
    "phone_case", "phone_case_top", "phone_screen", "phone_notch", "phone_side_btn",
    "stats_msg", "status_meta",
    "wall_time", "wall_date", "wall_glitch",
    "home_indicator", "home_btn",
    "side_panel1", "side_panel", "head_divider",
    "corner_tl_v", "corner_tl_h", "corner_tr_v", "corner_tr_h",
    "corner_bl_v", "corner_bl_h", "corner_br_v", "corner_br_h",
    "title_eyebrow", "title_main",
    "close_btn",
    "close_btn_border_t", "close_btn_border_b", "close_btn_border_l", "close_btn_border_r",
    "app_slot_vline_1", "app_slot_vline_2", "app_slot_vline_3", "app_slot_vline_4",
    "app_slot_vline_5", "app_slot_vline_6", "app_slot_vline_7", "app_slot_vline_8",
    "app_slot_vline_9", "app_slot_vline_10", "app_slot_vline_11", "app_slot_vline_12",
    "app_slot_vline_13", "app_slot_vline_14", "app_slot_vline_15", "app_slot_vline_16", "app_slot_vline_17",
    "app_slot_hline_1", "app_slot_hline_2", "app_slot_hline_3", "app_slot_hline_4",
    "app_slot_hline_5", "app_slot_hline_6", "app_slot_hline_7", "app_slot_hline_8",
    "app_slot_hline_9", "app_slot_hline_10", "app_slot_hline_11", "app_slot_hline_12",
    "app_slot_hline_13", "app_slot_hline_14",
    "app_card_proto",
}

local function apply_adaptive_layout()
    U.apply_adaptive_layout("phone_root", BASE_W, BASE_H)
end

-- Карта app-id → component-id (все на одном game object-е → "#" prefix)
local APP_COMPONENT = {
    sms    = "#phone_sms",
    call   = "#phone_call",
    map    = "#phone_map",
    notes  = "#phone_notes",
    quests = "#phone_quests",
    mail   = "#phone_mail",
    messenger = "#phone_messenger",
    term   = "#phone_term",
}

-- Внешние приложения (закрывают телефон и открывают оверлей через ui_manager).
-- map убран: теперь карта открывается внутри телефона через phone_map.gui.
local EXTERNAL_APPS = {
}

local APP_TITLES = {
    sms    = "СООБЩЕНИЯ",
    call   = "ЗВОНКИ",
    map    = "КАРТА",
    notes  = "УЛИКИ",
    quests = "КВЕСТЫ",
    mail   = "ПОЧТА",
    messenger = "ЧАТЫ",
    term   = "ТЕРМИНАЛ",
}


local _card_clones = {}

local APP_CARD_DATA = {
    { key = "app1", id = "sms",    x = 143, y = 422, bg_r = 0.0,    bg_g = 0.239, bg_b = 0.498, icon = "icon_sms",     label = "\320\241\320\234\320\241" },
    { key = "app2", id = "call",   x = 245, y = 422, bg_r = 0.490,  bg_g = 0.976, bg_b = 0.0,   icon = "icon_call",    label = "\320\227\320\262\320\276\320\275\320\272\320\270" },
    { key = "app3", id = "map",    x = 347, y = 422, bg_r = 0.0,    bg_g = 0.702, bg_b = 0.278, icon = "icon_map",     label = "\320\232\320\260\321\200\321\202\320\260" },
    { key = "app4", id = "notes",  x = 348, y = 303, bg_r = 0.953,  bg_g = 0.925, bg_b = 0.851, icon = "icon_notes",   label = "\320\243\320\273\320\270\320\272\320\270" },
    { key = "app5", id = "quests", x = 245, y = 303, bg_r = 0.478,  bg_g = 0.361, bg_b = 0.0,   icon = "icon_quests",  label = "\320\232\320\262\320\265\321\201\321\202\321\213" },
    { key = "app6", id = "mail",   x = 142, y = 183, bg_r = 0.0,    bg_g = 0.239, bg_b = 0.498, icon = "icon_mail",    label = "\320\237\320\276\321\207\321\202\320\260" },
    { key = "app7", id = "messenger", x = 141, y = 303, bg_r = 0.282, bg_g = 0.961, bg_b = 0.0, icon = "icon_sms",   label = "\320\247\320\260\321\202\321\213" },
    { key = "app8", id = "term",   x = 247, y = 183, bg_r = 0.0,    bg_g = 0.702, bg_b = 0.278, icon = "icon_terminal", label = "\320\242\320\265\321\200\320\274\320\270\320\275\320\260\320\273" },
}

local CHROME_NODES = {
    "phone_bg",
    "phone_case", "phone_case_top", "phone_screen", "phone_notch", "phone_side_btn",
    "stats_msg", "status_meta",
    "wall_time", "wall_date", "wall_glitch",
    "home_indicator", "home_btn",
    "side_panel1", "side_panel", "head_divider",
    "corner_tl_v", "corner_tl_h", "corner_tr_v", "corner_tr_h",
    "corner_bl_v", "corner_bl_h", "corner_br_v", "corner_br_h",
    "title_eyebrow", "title_main",
    "close_btn", "close_x",
    "close_btn_border_t", "close_btn_border_b", "close_btn_border_l", "close_btn_border_r",
    "app_slot_vline_1", "app_slot_vline_2", "app_slot_vline_3", "app_slot_vline_4",
    "app_slot_vline_5", "app_slot_vline_6", "app_slot_vline_7", "app_slot_vline_8",
    "app_slot_vline_9", "app_slot_vline_10", "app_slot_vline_11", "app_slot_vline_12",
    "app_slot_vline_13", "app_slot_vline_14", "app_slot_vline_15", "app_slot_vline_16", "app_slot_vline_17",
    "app_slot_hline_1", "app_slot_hline_2", "app_slot_hline_3", "app_slot_hline_4",
    "app_slot_hline_5", "app_slot_hline_6", "app_slot_hline_7", "app_slot_hline_8",
    "app_slot_hline_9", "app_slot_hline_10", "app_slot_hline_11", "app_slot_hline_12",
    "app_slot_hline_13", "app_slot_hline_14",
}

local APPS = {
    { key = "app1", id = "sms"    },
    { key = "app2", id = "call"   },
    { key = "app3", id = "map"    },
    { key = "app4", id = "notes"  },
    { key = "app5", id = "quests" },
    { key = "app6", id = "mail"   },
    { key = "app7", id = "messenger" },
    { key = "app8", id = "term"   },
}

local get_node          = U.get_node
local set_node_enabled  = U.set_node_enabled
local set_nodes_enabled = U.set_nodes_enabled
local set_text          = U.set_text

local function update_app_title(id)
    set_text("title_main", APP_TITLES[id or "sms"] or "ДОМАШНИЙ ЭКРАН")
end

local function current_day_label()
    if gs.get_flag and gs.get_flag("tuesday_started") then
        return "Вторник"
    elseif gs.get_flag and gs.get_flag("monday_started") then
        return "Понедельник"
    end
    return "Воскресенье"
end

local function update_wall_day()
    set_text("wall_time", current_day_label())
end

local function current_date_label()
    if gs.get_flag and gs.get_flag("tuesday_started") then
        return "23 июня"
    elseif gs.get_flag and gs.get_flag("monday_started") then
        return "22 июня"
    end
    return "21 июня"
end

local function update_wall_date()
    set_text("wall_date", current_date_label())
end

local function update_wall_calendar()
    update_wall_day()
    update_wall_date()
end

local function init_app_card_clones()
    local proto = U.get_node("app_card_proto")
    local root = gui.get_node("phone_root")
    if not proto then return end

    for _, app in ipairs(APP_CARD_DATA) do
        local cmap = gui.clone_tree(proto)
        if cmap then
            local card = cmap["app_card_proto"]
            local bg   = cmap["app_bg"]
            local bg1  = cmap["app_bg1"]
            local label = cmap["app_label"]
            local badge_bg   = cmap["app_badge_bg"]
            local badge_text = cmap["app_badge_text"]

            gui.set_position(card, vmath.vector3(app.x, app.y, 0))
            if root then gui.set_parent(card, root) end

            gui.set_color(bg, vmath.vector4(app.bg_r, app.bg_g, app.bg_b, 1))
            gui.set_text(label, app.label)

            gui.set_enabled(badge_bg, false)
            gui.set_enabled(badge_text, false)

            -- Reparent static icon under this card
            local icon = U.get_node(app.key .. "_icon")
            if icon then gui.set_parent(icon, card) end

            _card_clones[app.key] = {
                card = card, bg = bg, badge_bg = badge_bg, badge_text = badge_text,
            }
        end
    end
end

local function set_card_clones_enabled(enabled)
    for _, c in pairs(_card_clones) do
        gui.set_enabled(c.card, enabled)
    end
end

function init(self)
    self.visible    = false
    self.active_app = nil

    -- Reparent all root-level chrome nodes under phone_root for adaptive scaling
    local root = gui.get_node("phone_root")
    if root then
        for _, id in ipairs(ROOT_CHROME) do
            local n = U.get_node(id)
            if n then gui.set_parent(n, root) end
        end
        apply_adaptive_layout()
    end

    set_nodes_enabled(CHROME_NODES, false)
    init_app_card_clones()
    set_card_clones_enabled(false)
    update_app_title("sms")
    update_wall_calendar()
    msg.post(".", "acquire_input_focus")
end

function on_message(self, message_id, message, sender)
    if message_id == MSG.open_phone then
        self.visible = true
        set_nodes_enabled(CHROME_NODES, true)
        set_card_clones_enabled(true)
        update_notif(self)
        update_wall_calendar()
        local comp = APP_COMPONENT["sms"]
        if comp then msg.post(comp, MSG.open_app) end
        self.active_app = "sms"
        update_app_title("sms")
        dbg("[phone_v2_root] open_phone -> sms")

    elseif message_id == MSG.close_phone then
        close_active_app(self)
        set_card_clones_enabled(false)
        set_nodes_enabled(CHROME_NODES, false)
        self.visible = false
        dbg("[phone_v2_root] close_phone")

    elseif message_id == MSG.refresh_phone then
        update_notif(self)
        update_wall_calendar()
        if self.active_app then
            local comp = APP_COMPONENT[self.active_app]
            if comp then msg.post(comp, MSG.refresh_app) end
        end

    elseif message_id == MSG.open_app then
        if self.visible then
            local id = message and message.id or "sms"
            if self.active_app ~= id then
                switch_app(self, id)
            end
        end

    elseif message_id == MSG.set_phone_notif then
        -- Keep status total and per-app badges semantically split.
        -- message.n is the aggregate phone unread total; app badges must still
        -- come from their own channels (SMS vs Messenger).
        local n = tonumber(message and message.n) or 0
        set_text("stats_msg", "сообщений: " .. tostring(n))
        local sms_unread = gs.get_sms_unread_total and gs.get_sms_unread_total() or 0
        local msg_unread = gs.get_msg_unread_total and gs.get_msg_unread_total() or 0
        set_badge(self, "app1", sms_unread)
        set_badge(self, "app7", msg_unread)

    elseif message_id == MSG.set_phone_time then
        update_wall_calendar()
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end

    -- Non-touch inputs, such as mouse wheel if bound by the project, belong to
    -- the active app while the phone is open.
    if action_id ~= MSG.touch then
        forward_active_app_input(self, action_id, action or {})
        return true
    end

    -- Root owns the input focus. It handles chrome/launcher taps on press,
    -- then forwards all other touch phases to the active phone app.
    if action and action.pressed then
        -- Кнопка закрытия
        local close = get_node("close_btn")
        if close and gui.is_enabled(close) and gui.pick_node(close, action.x, action.y) then
            flash_node(close)
            msg.post(UI_MGR, "close_phone")
            return true
        end

        -- Кнопка Home → SMS
        local home = get_node("home_btn")
        if home and gui.is_enabled(home) and gui.pick_node(home, action.x, action.y) then
            flash_node(home)
            switch_app(self, "sms")
            return true
        end

        -- Тайлы приложений
        for _, app in ipairs(APPS) do
            local c = _card_clones[app.key]
            local n = c and c.bg
            if n and gui.is_enabled(n) and gui.pick_node(n, action.x, action.y) then
                dbg("[phone_v2_root] tile clicked:", app.id)
                flash_node(n)
                msg.post(UI_MGR, MSG.phone_app_clicked, { id = app.id })
                if not EXTERNAL_APPS[app.id] then
                    switch_app(self, app.id)
                end
                return true
            end
        end
    end

    forward_active_app_input(self, action_id, action or {})
    return true
end
