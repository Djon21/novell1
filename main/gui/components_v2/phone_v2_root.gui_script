-- phone_v2_root.gui_script
-- Chrome + launcher. Роутит open/close к дочерним app-компонентам.
--
-- Входящие сообщения (от #ui_manager_v2):
--   "open_phone"            — показать телефон, открыть SMS по умолчанию
--   "close_phone"           — закрыть телефон (только скрыть, не постить обратно)
--   "refresh_phone"         — обновить счётчик + переслать активному приложению
--   "set_phone_notif" {n}   — обновить "сообщений: N"
--   "set_phone_time" {time} — обновить время в статус-баре
--
-- Исходящие сообщения (к #ui_manager_v2):
--   "close_phone"           — пользователь нажал X
--   "phone_app_clicked" {id}— нажат тайл приложения

local gs      = require "main.scripts.game_state"
local UI_MGR  = "#ui_manager_v2"

local DEBUG_LOG = false
local function dbg(...) if DEBUG_LOG then print(...) end end

-- Карта app-id → component-id (все на одном game object-е → "#" prefix)
local APP_COMPONENT = {
    sms    = "#phone_sms",
    call   = "#phone_call",
    map    = "#phone_map",
    notes  = "#phone_notes",
    quests = "#phone_quests",
    mail   = "#phone_mail",
    cam    = "#phone_cam",
    term   = "#phone_term",
}

-- Внешние приложения (закрывают телефон и открывают оверлей через ui_manager).
-- map убран: теперь карта открывается внутри телефона через phone_map.gui.
local EXTERNAL_APPS = {
}

local APP_TITLES = {
    sms    = "СООБЩЕНИЯ",
    call   = "ЗВОНКИ",
    map    = "КАРТА",
    notes  = "УЛИКИ",
    quests = "КВЕСТЫ",
    mail   = "ПОЧТА",
    cam    = "КАМЕРА",
    term   = "ТЕРМИНАЛ",
}


local CHROME_NODES = {
    "phone_bg",
    "phone_case", "phone_case_top", "phone_screen1", "phone_screen", "phone_notch", "phone_side_btn",
    "stats_msg", "status_time", "status_meta",
    "wall_time", "wall_date", "wall_glitch",
    "home_indicator", "home_btn",
    "side_panel1", "side_panel", "head_divider",
    "corner_tl_v", "corner_tl_h", "corner_tr_v", "corner_tr_h",
    "corner_bl_v", "corner_bl_h", "corner_br_v", "corner_br_h",
    "title_eyebrow", "title_main",
    "close_btn", "close_x",
    "close_btn_border_t", "close_btn_border_b", "close_btn_border_l", "close_btn_border_r",
    "app1_badge_bg", "app1_badge_text",
    "app_slot_vline_1", "app_slot_vline_2", "app_slot_vline_3", "app_slot_vline_4",
    "app_slot_vline_5", "app_slot_vline_6", "app_slot_vline_7", "app_slot_vline_8",
    "app_slot_vline_9", "app_slot_vline_10", "app_slot_vline_11", "app_slot_vline_12",
    "app_slot_vline_13", "app_slot_vline_14", "app_slot_vline_15", "app_slot_vline_16", "app_slot_vline_17",
    "app_slot_hline_1", "app_slot_hline_2", "app_slot_hline_3", "app_slot_hline_4",
    "app_slot_hline_5", "app_slot_hline_6", "app_slot_hline_7", "app_slot_hline_8",
    "app_slot_hline_9", "app_slot_hline_10", "app_slot_hline_11", "app_slot_hline_12",
    "app_slot_hline_13", "app_slot_hline_14",
    "app1_bg", "app1_bg1", "app1_icon", "app1_label",
    "app2_bg", "app2_bg1", "app2_icon", "app2_label",
    "app3_bg", "app3_bg1", "app3_icon", "app3_label",
    "app4_bg", "app4_bg1", "app4_icon", "app4_label",
    "app5_bg", "app5_bg1", "app5_icon", "app5_label",
    "app6_bg", "app6_bg1", "app6_icon", "app6_label",
    "app7_bg", "app7_bg1", "app7_icon", "app7_label",
    "app8_bg", "app8_bg1", "app8_icon", "app8_label",
}

local APPS = {
    { key = "app1", id = "sms"    },
    { key = "app2", id = "call"   },
    { key = "app3", id = "map"    },
    { key = "app4", id = "notes"  },
    { key = "app5", id = "quests" },
    { key = "app6", id = "mail"   },
    { key = "app7", id = "cam"    },
    { key = "app8", id = "term"   },
}

local function get_node(id)
    local ok, n = pcall(gui.get_node, id)
    if ok then return n end
    return nil
end

local function set_node_enabled(id, enabled)
    local n = get_node(id)
    if n then gui.set_enabled(n, enabled) end
end

local function set_nodes_enabled(ids, enabled)
    for _, id in ipairs(ids) do
        set_node_enabled(id, enabled)
    end
end

local function set_text(id, text)
    local n = get_node(id)
    if n then gui.set_text(n, text or "") end
end

local function update_app_title(id)
    set_text("title_main", APP_TITLES[id or "sms"] or "ДОМАШНИЙ ЭКРАН")
end

local function set_badge(self_or_prefix, prefix_or_value, maybe_value)
    -- Backward-compatible signature:
    --   set_badge("app1", n)
    -- Preferred signature:
    --   set_badge(self, "app1", n)
    local ctx, prefix, value
    if type(self_or_prefix) == "string" then
        ctx = nil
        prefix = self_or_prefix
        value = prefix_or_value
    else
        ctx = self_or_prefix
        prefix = prefix_or_value
        value = maybe_value
    end

    if type(prefix) ~= "string" then return end

    local n = tonumber(value) or 0
    local phone_visible = (not ctx) or ctx.visible == true
    local show = phone_visible and n > 0

    set_text(prefix .. "_badge_text", tostring(n))
    set_node_enabled(prefix .. "_badge_bg", show)
    set_node_enabled(prefix .. "_badge_text", show)
end

local function flash_node(node)
    local c  = gui.get_color(node)
    local c0 = vmath.vector4(c.x, c.y, c.z, c.w)
    gui.animate(node, "color.w", math.max(0.25, c0.w * 0.3), gui.EASING_OUTQUAD, 0.08, 0, function()
        gui.animate(node, "color.w", c0.w, gui.EASING_OUTQUAD, 0.18)
    end)
end

local function update_notif(self)
    local unread = gs.get_phone_unread_total and gs.get_phone_unread_total() or 0
    set_text("stats_msg", "сообщений: " .. tostring(unread))
    set_badge(self, "app1", unread)
end

-- Закрыть текущее активное приложение (если есть)
local function close_active_app(self)
    if self.active_app then
        local comp = APP_COMPONENT[self.active_app]
        if comp then
            msg.post(comp, "close_app")
        end
        dbg("[phone_v2_root] closed app:", self.active_app)
        self.active_app = nil
    end
end

-- Переключиться на приложение (закрыть предыдущее, открыть новое)
local function switch_app(self, id)
    if self.active_app == id then
        -- тап на активное → вернуться в SMS
        close_active_app(self)
        local comp = APP_COMPONENT["sms"]
        if comp then msg.post(comp, "open_app") end
        self.active_app = "sms"
        update_app_title("sms")
        dbg("[phone_v2_root] toggled back to sms")
        return
    end
    close_active_app(self)
    local comp = APP_COMPONENT[id]
    if comp then
        msg.post(comp, "open_app")
        self.active_app = id
        update_app_title(id)
        dbg("[phone_v2_root] switched to app:", id)
    end
end


local function forward_active_app_input(self, action_id, action)
    if not self.active_app then return end
    local comp = APP_COMPONENT[self.active_app]
    if not comp then return end
    msg.post(comp, "phone_input", {
        action_id = action_id,
        x = action and action.x or 0,
        y = action and action.y or 0,
        dx = action and action.dx or 0,
        dy = action and action.dy or 0,
        value = action and action.value or 0,
        pressed = action and action.pressed or false,
        released = action and action.released or false,
        repeated = action and action.repeated or false,
    })
end

-- -----------------------------------------------------------------------

function init(self)
    self.visible    = false
    self.active_app = nil
    set_nodes_enabled(CHROME_NODES, false)
    update_app_title("sms")
    -- Берём фокус сразу и держим всегда (как исходный phone_v2.gui_script).
    -- Когда телефон закрыт — on_input возвращает false, инпут проходит дальше.
    -- Это сохраняет правильный порядок стека acquire_input_focus.
    msg.post(".", "acquire_input_focus")
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_phone") then
        self.visible = true
        set_nodes_enabled(CHROME_NODES, true)
        update_notif(self)
        -- Открыть SMS по умолчанию
        local comp = APP_COMPONENT["sms"]
        if comp then msg.post(comp, "open_app") end
        self.active_app = "sms"
        update_app_title("sms")
        dbg("[phone_v2_root] open_phone → sms")

    elseif message_id == hash("close_phone") then
        -- Просто скрыть — НЕ постить обратно в UI_MGR (иначе loop),
        -- НЕ release_input_focus (держим фокус постоянно как phone_v2.gui_script)
        close_active_app(self)
        set_nodes_enabled(CHROME_NODES, false)
        self.visible = false
        dbg("[phone_v2_root] close_phone")

    elseif message_id == hash("refresh_phone") then
        update_notif(self)
        if self.active_app then
            local comp = APP_COMPONENT[self.active_app]
            if comp then msg.post(comp, "refresh_app") end
        end

    elseif message_id == hash("open_app") then
        if self.visible then
            local id = message and message.id or "sms"
            if self.active_app ~= id then
                switch_app(self, id)
            end
        end

    elseif message_id == hash("set_phone_notif") then
        local n = tonumber(message and message.n) or 0
        set_text("stats_msg", "сообщений: " .. tostring(n))
        set_badge(self, "app1", n)

    elseif message_id == hash("set_phone_time") then
        local t = (message and message.time) or "07:12"
        set_text("status_time", t)
        set_text("wall_time", t)
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end

    -- Non-touch inputs, such as mouse wheel if bound by the project, belong to
    -- the active app while the phone is open.
    if action_id ~= hash("touch") then
        forward_active_app_input(self, action_id, action or {})
        return true
    end

    -- Root owns the input focus. It handles chrome/launcher taps on press,
    -- then forwards all other touch phases to the active phone app.
    if action and action.pressed then
        -- Кнопка закрытия
        local close = get_node("close_btn")
        if close and gui.is_enabled(close) and gui.pick_node(close, action.x, action.y) then
            flash_node(close)
            msg.post(UI_MGR, "close_phone")
            return true
        end

        -- Кнопка Home → SMS
        local home = get_node("home_btn")
        if home and gui.is_enabled(home) and gui.pick_node(home, action.x, action.y) then
            flash_node(home)
            switch_app(self, "sms")
            return true
        end

        -- Тайлы приложений
        for _, app in ipairs(APPS) do
            local n = get_node(app.key .. "_bg")
            if n and gui.is_enabled(n) and gui.pick_node(n, action.x, action.y) then
                dbg("[phone_v2_root] tile clicked:", app.id)
                flash_node(n)
                msg.post(UI_MGR, "phone_app_clicked", { id = app.id })
                if not EXTERNAL_APPS[app.id] then
                    switch_app(self, app.id)
                end
                return true
            end
        end
    end

    forward_active_app_input(self, action_id, action or {})
    return true
end
