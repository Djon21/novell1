-- choice_v2.gui_script
-- Модалка выбора 2-4 опций.
-- Визуал перенесён из choice_defold.html: центральная панель, header/meta,
-- prompt/caveat, карточки вариантов с номером и hint, footer label.
--
-- Сообщения:
--   "show_choice" {opts = {…}, title/prompt/caveat/name/tag/meta?}
--   "hide_choice"
--
-- В ui_manager_v2 шлёт:
--   "choice_picked" {index}

local UI_MGR = "#ui_manager_v2"
local ui_state = require "main.scripts.ui_state"

-- HUD uses set_location { name, time, loop }. choice_v2 is a separate GUI
-- component, so it must receive the same message or explicit location fields
-- inside show_choice. We keep the last HUD-style value here.
local current_location_name = nil
local current_location_time = nil
local current_location_loop = nil

local STATIC_NODES = {
    "backdrop", "modal",
    "modal_border_top", "modal_border_bottom", "modal_border_left", "modal_border_right",
    "corner_tl_v", "corner_tl_h", "corner_tr_v", "corner_tr_h",
    "corner_bl_v", "corner_bl_h", "corner_br_v", "corner_br_h",
    "who_tag_bg", "who_tag", "who_name",
    "meta_loop_bg", "meta_loop_border_top", "meta_loop_border_bottom", "meta_loop_border_left", "meta_loop_border_right",
    "meta_loop", "meta_tm", "head_divider",
    "prompt", "caveat", "opts_panel",
    "foot_divider", "foot_label",
    -- старые id оставлены пустыми, чтобы внешние/старые вызовы не падали
    "title_eyebrow", "title_main",
}

local function get_node(id)
    local ok, n = pcall(gui.get_node, id)
    if ok then return n end
    return nil
end

local function set_node_enabled(id, enabled)
    local n = get_node(id)
    if n then gui.set_enabled(n, enabled) end
end

local function set_all_enabled(enabled)
    for _, id in ipairs(STATIC_NODES) do
        set_node_enabled(id, enabled)
    end
end

local function set_text(id, s)
    local n = get_node(id)
    if n then gui.set_text(n, s or "") end
end

local function coalesce(...)
    for i = 1, select("#", ...) do
        local v = select(i, ...)
        if v ~= nil and tostring(v) ~= "" then return v end
    end
    return nil
end

local COLORS = {
    paper      = vmath.vector4(0.953, 0.925, 0.851, 1.0),
    paper_dim  = vmath.vector4(0.788, 0.753, 0.659, 1.0),
    ink0       = vmath.vector4(0.020, 0.012, 0.102, 1.0),
    panel      = vmath.vector4(0.031, 0.024, 0.094, 0.92),
    opt_bg     = vmath.vector4(0.047, 0.039, 0.141, 0.72),
    num_bg     = vmath.vector4(0.020, 0.012, 0.102, 1.0),
    accent     = vmath.vector4(0.490, 0.976, 1.000, 1.0),
    accent_dim = vmath.vector4(0.490, 0.976, 1.000, 0.35),
    hot        = vmath.vector4(1.000, 0.239, 0.498, 1.0),
    hot_dim    = vmath.vector4(1.000, 0.239, 0.498, 0.55),
    amber      = vmath.vector4(1.000, 0.702, 0.278, 1.0),
    amber_dim  = vmath.vector4(1.000, 0.702, 0.278, 0.55),
    violet     = vmath.vector4(0.478, 0.361, 1.000, 1.0),
    violet_dim = vmath.vector4(0.478, 0.361, 1.000, 0.55),
    stamp      = vmath.vector4(0.784, 0.078, 0.165, 1.0),
    stamp_dim  = vmath.vector4(0.784, 0.078, 0.165, 0.25),
    transparent = vmath.vector4(0, 0, 0, 0),
}

local function color_for_class(cls)
    if cls == "key" then return COLORS.amber, COLORS.amber_dim end
    if cls == "danger" then return COLORS.hot, COLORS.hot_dim end
    return COLORS.accent, COLORS.accent_dim
end

local function hint_color(hint_cls)
    if hint_cls == "hot" then return COLORS.hot, COLORS.hot_dim end
    if hint_cls == "amber" then return COLORS.amber, COLORS.amber_dim end
    if hint_cls == "violet" then return COLORS.violet, COLORS.violet_dim end
    return COLORS.paper_dim, vmath.vector4(0.953, 0.925, 0.851, 0.35)
end

local function utf8_len(s)
    local count = 0
    for _ in string.gmatch(tostring(s or ""), "([%z\1-\127\194-\244][\128-\191]*)") do
        count = count + 1
    end
    return count
end

local function new_box(x, y, z, w, h, color)
    local n = gui.new_box_node(vmath.vector3(x, y, z), vmath.vector3(w, h, 0))
    gui.set_pivot(n, gui.PIVOT_SW)
    gui.set_color(n, color)
    gui.set_adjust_mode(n, gui.ADJUST_FIT)
    return n
end

local function new_text(x, y, z, w, h, text, font, color, pivot)
    local n = gui.new_text_node(vmath.vector3(x, y, z), text or "")
    gui.set_pivot(n, pivot or gui.PIVOT_W)
    gui.set_size(n, vmath.vector3(w, h, 0))
    gui.set_font(n, font)
    gui.set_color(n, color)
    gui.set_adjust_mode(n, gui.ADJUST_FIT)
    pcall(gui.set_line_break, n, true)
    return n
end

local function add_line_nodes(list, prefix, x, y, z, w, h, color)
    list[#list + 1] = new_box(x, y + h - 1, z, w, 1, color)
    list[#list + 1] = new_box(x, y, z, w, 1, color)
    list[#list + 1] = new_box(x, y, z, 1, h, color)
    list[#list + 1] = new_box(x + w - 1, y, z, 1, h, color)
end

local OPT_X = 310
local OPT_TOP = 444
local OPT_W = 660
local OPT_H = 54
local OPT_GAP = 10

local function clear_opts(self)
    for _, opt_group in ipairs(self.opt_nodes or {}) do
        for _, n in ipairs(opt_group.nodes or {}) do
            if n then pcall(gui.delete_node, n) end
        end
    end
    self.opt_nodes = {}
    self.opts = {}
end

local function make_opt(self, idx, opt)
    local y = OPT_TOP - idx * OPT_H - (idx - 1) * OPT_GAP
    local accent, border = color_for_class(opt.cls)
    local nodes = {}

    local bg = new_box(OPT_X, y, 0.70, OPT_W, OPT_H, COLORS.opt_bg)
    nodes[#nodes + 1] = bg
    add_line_nodes(nodes, "opt", OPT_X, y, 0.71, OPT_W, OPT_H, border)

    -- номер слева, как .opt .num в HTML
    local num_x = OPT_X + 12
    local num_y = y + 14
    nodes[#nodes + 1] = new_box(num_x, num_y, 0.72, 30, 26, COLORS.num_bg)
    add_line_nodes(nodes, "num", num_x, num_y, 0.73, 30, 26, accent)
    nodes[#nodes + 1] = new_text(num_x + 15, num_y + 13, 0.74, 28, 10, string.format("%02d", idx), "jb_mono_10", accent, gui.PIVOT_CENTER)

    local hint = opt.hint or opt.hint_text or ""
    local hint_w = 0
    if hint ~= "" then
        hint_w = math.max(56, math.min(168, 26 + utf8_len(hint) * 8))
        local hc, hb = hint_color(opt.hintCls or opt.hint_cls)
        local hx = OPT_X + OPT_W - 12 - hint_w
        local hy = y + 16
        add_line_nodes(nodes, "hint", hx, hy, 0.73, hint_w, 22, hb)
        nodes[#nodes + 1] = new_text(hx + hint_w * 0.5, hy + 11, 0.74, hint_w - 8, 10, tostring(hint):upper(), "jb_mono_10", hc, gui.PIVOT_CENTER)
    end

    local text_w = OPT_W - 74 - (hint_w > 0 and (hint_w + 26) or 20)
    nodes[#nodes + 1] = new_text(OPT_X + 56, y + 29, 0.74, text_w, 28, opt.text or "—", "manrope_16", COLORS.paper, gui.PIVOT_W)

    return { bg = bg, nodes = nodes, cls = opt.cls }
end

local function normalize_loop_label(v)
    v = coalesce(v)
    if not v then return "ПЕТЛЯ · #001" end

    local text = tostring(v)
    local n = tonumber(text)
    if n then
        return string.format("ПЕТЛЯ · #%03d", n)
    end

    if string.find(text, "#") or string.find(string.lower(text), "пет") then
        return string.upper(text)
    end

    if string.match(text, "^%d+$") then
        return "ПЕТЛЯ · #" .. text
    end

    return string.upper(text)
end

local function normalize_location_text(v)
    v = coalesce(v)
    if not v then return nil end
    local text = tostring(v)
    local lower = string.lower(text)
    if string.find(lower, "location unknown")
        or string.find(text, "локация неизвест")
        or string.find(text, "Локация неизвест")
        or string.find(text, "ЛОКАЦИЯ НЕИЗВЕСТ") then
        return nil
    end
    return string.upper(text)
end

local function format_location_text(message)
    message = message or {}

    -- message.name in show_choice is speaker/who_name, not location.
    local explicit = normalize_location_text(coalesce(
        message.location_label,
        message.current_location_label,
        message.location_name,
        message.scene_label,
        message.location,
        message.current_location
    ))
    if explicit then return explicit end

    local from_hud = normalize_location_text(current_location_name)
    if from_hud then return from_hud end

    local from_shared_state = normalize_location_text(coalesce(
        ui_state.current_location_name,
        ui_state.location_name
    ))
    if from_shared_state then return from_shared_state end

    local legacy = normalize_location_text(coalesce(message.meta, message.location_time, message.time_label))
    if legacy then return legacy end

    return ""
end

local function remember_location(message)
    message = message or {}
    if coalesce(message.name) then
        current_location_name = tostring(message.name)
        ui_state.current_location_name = current_location_name
        ui_state.location_name = current_location_name
    end
    if message.time ~= nil then
        current_location_time = message.time
        ui_state.current_location_time = message.time
        ui_state.location_time = message.time
    end
    if message.loop ~= nil then
        current_location_loop = message.loop
        ui_state.current_location_loop = message.loop
        ui_state.location_loop = message.loop
    end
end

local function apply_copy(message)
    -- Совместимость: старый ui_manager мог присылать только title.
    local tag = coalesce(message.tag, message.who_tag, "МЫСЛЬ")
    local name = coalesce(message.name, message.who, message.speaker, "К. АВОСЬЕВ")
    local prompt = coalesce(message.prompt, message.title, "Выбери вариант.")
    local caveat = coalesce(message.caveat, message.subtitle, message.note, "")
    local loop = normalize_loop_label(coalesce(
        message.loop_label,
        message.iteration_label,
        message.loop,
        message.iteration_number,
        current_location_loop
    ))
    local meta = format_location_text(message)

    set_text("who_tag", tostring(tag):upper())
    set_text("who_name", tostring(name):upper())
    set_text("prompt", tostring(prompt))
    set_text("caveat", tostring(caveat))
    set_text("meta_loop", loop)
    set_text("meta_tm", meta)

    local has_caveat = caveat ~= nil and tostring(caveat) ~= ""
    set_node_enabled("caveat", has_caveat)
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = false
    self.opts = {}
    self.opt_nodes = {}
    set_all_enabled(false)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("show_choice") then
        message = message or {}
        self.visible = true
        set_all_enabled(true)
        clear_opts(self)
        apply_copy(message or {})

        local opts = message.opts or {}
        self.opts = opts
        for i, opt in ipairs(opts) do
            if i <= 4 then
                self.opt_nodes[i] = make_opt(self, i, opt)
            end
        end

    elseif message_id == hash("set_location") then
        remember_location(message or {})
        if self.visible then
            set_text("meta_tm", format_location_text({}))
            if current_location_loop ~= nil then
                set_text("meta_loop", normalize_loop_label(current_location_loop))
            end
        end

    elseif message_id == hash("hide_choice") then
        self.visible = false
        set_all_enabled(false)
        clear_opts(self)
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return true end

    for i = 1, #self.opt_nodes do
        local o = self.opt_nodes[i]
        if o and o.bg and gui.pick_node(o.bg, action.x, action.y) then
            msg.post(UI_MGR, "choice_picked", { index = i })
            return true
        end
    end

    -- Модалка блокирует клик по сцене под ней.
    return true
end
