-- choice_v2.gui_script
-- Модалка выбора 2-4 опций.
-- Визуал перенесён из choice_defold.html: центральная панель, header/meta,
-- prompt/caveat, карточки вариантов с номером и hint, footer label.
--
-- Сообщения:
--   "show_choice" {opts = {…}, title/prompt/caveat/name/tag/meta?}
--   "hide_choice"
--
-- В ui_manager_v2 шлёт:
--   "choice_picked" {index}

local UI_MGR = "#ui_manager_v2"
local ui_state = require "main.scripts.ui_state"

-- HUD uses set_location { name, time, loop }. choice_v2 is a separate GUI
-- component, so it must receive the same message or explicit location fields
-- inside show_choice. We keep the last HUD-style value here.
local current_location_name = nil
local current_location_time = nil
local current_location_loop = nil

local STATIC_NODES = {
    "backdrop", "modal", "modal_border",
    "meta_loop_bg", "meta_loop_border_top", "meta_loop_border_bottom",
    "meta_loop_border_left", "meta_loop_border_right", "meta_loop",
    "head_divider",
    "prompt", "caveat", "opts_panel",
    "foot_divider", "foot_label",
}

local function get_node(id)
    local ok, n = pcall(gui.get_node, id)
    if ok then return n end
    return nil
end

local function set_node_enabled(id, enabled)
    local n = get_node(id)
    if n then gui.set_enabled(n, enabled) end
end

local function set_all_enabled(enabled)
    for _, id in ipairs(STATIC_NODES) do
        set_node_enabled(id, enabled)
    end
end

local function set_text(id, s)
    local n = get_node(id)
    if n then gui.set_text(n, s or "") end
end


local function set_pos(id, x, y, z)
    local n = get_node(id)
    if n then gui.set_position(n, vmath.vector3(x, y, z or gui.get_position(n).z)) end
end

local function set_size(id, w, h)
    local n = get_node(id)
    if n then gui.set_size(n, vmath.vector3(w, h, 0)) end
end

local function set_pos_size(id, x, y, z, w, h)
    set_pos(id, x, y, z)
    set_size(id, w, h)
end

local function clamp(v, lo, hi)
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

local function coalesce(...)
    for i = 1, select("#", ...) do
        local v = select(i, ...)
        if v ~= nil and tostring(v) ~= "" then return v end
    end
    return nil
end

local COLORS = {
    paper      = vmath.vector4(0.953, 0.925, 0.851, 1.0),
    paper_dim  = vmath.vector4(0.788, 0.753, 0.659, 1.0),
    opt_bg     = vmath.vector4(0.047, 0.039, 0.141, 0.72),
    num_bg     = vmath.vector4(0.020, 0.012, 0.102, 1.0),
    accent     = vmath.vector4(0.490, 0.976, 1.000, 1.0),
    accent_dim = vmath.vector4(0.490, 0.976, 1.000, 0.35),
    hot        = vmath.vector4(1.000, 0.239, 0.498, 1.0),
    hot_dim    = vmath.vector4(1.000, 0.239, 0.498, 0.55),
    amber      = vmath.vector4(1.000, 0.702, 0.278, 1.0),
    amber_dim  = vmath.vector4(1.000, 0.702, 0.278, 0.55),
    violet     = vmath.vector4(0.478, 0.361, 1.000, 1.0),
    violet_dim = vmath.vector4(0.478, 0.361, 1.000, 0.55),
}

local function color_for_class(cls)
    if cls == "key" then return COLORS.amber, COLORS.amber_dim end
    if cls == "danger" then return COLORS.hot, COLORS.hot_dim end
    return COLORS.accent, COLORS.accent_dim
end

local function hint_color(hint_cls)
    if hint_cls == "hot" then return COLORS.hot, COLORS.hot_dim end
    if hint_cls == "amber" then return COLORS.amber, COLORS.amber_dim end
    if hint_cls == "violet" then return COLORS.violet, COLORS.violet_dim end
    return COLORS.paper_dim, vmath.vector4(0.953, 0.925, 0.851, 0.35)
end

local function utf8_len(s)
    local count = 0
    for _ in string.gmatch(tostring(s or ""), "([%z\1-\127\194-\244][\128-\191]*)") do
        count = count + 1
    end
    return count
end


local function cache_opt_slots(self)
    if self.opt_slots then return end
    self.opt_slots = {}
    for i = 1, 4 do
        local prefix = "opt" .. i
        local slot = {
            root = gui.get_node(prefix .. "_root"),
            bg = gui.get_node(prefix .. "_bg"),
            border = gui.get_node(prefix .. "_border"),
            num_bg = gui.get_node(prefix .. "_num_bg"),
            num_border = gui.get_node(prefix .. "_num_border"),
            num_text = gui.get_node(prefix .. "_num_text"),
            hint_border = gui.get_node(prefix .. "_hint_border"),
            hint_text = gui.get_node(prefix .. "_hint_text"),
            text = gui.get_node(prefix .. "_text"),
        }
        pcall(gui.set_line_break, slot.text, true)
        self.opt_slots[i] = slot
    end
end

local DEFAULT_LAYOUT = {
    modal_x = 120,
    modal_y = 46,
    modal_w = 1040,
    modal_h = 628,
    pad_x = 34,
    opt_gap = 12,
    opt_min_h = 70,
    opt_max_h = 124,
}

local function set_slot_enabled(slot, enabled)
    if not slot then return end
    gui.set_enabled(slot.root, enabled)
    -- Hint nodes are controlled separately when the slot is visible.
    if not enabled then
        gui.set_enabled(slot.hint_border, false)
        gui.set_enabled(slot.hint_text, false)
    end
end

local function clear_opts(self)
    cache_opt_slots(self)
    for i = 1, 4 do
        set_slot_enabled(self.opt_slots[i], false)
    end
    self.opt_nodes = {}
    self.opts = {}
end

local function fill_opt_slot(self, idx, opt)
    cache_opt_slots(self)
    local layout = self.choice_layout or {}
    local opt_x = layout.opt_x or 310
    local opt_w = layout.opt_w or 660
    local opt_h = layout.opt_h or 62
    local opt_gap = layout.opt_gap or 10
    local opt_top = layout.opt_top or 444
    local y = opt_top - idx * opt_h - (idx - 1) * opt_gap
    local accent, border = color_for_class(opt.cls)
    local slot = self.opt_slots[idx]
    if not slot then return nil end

    set_slot_enabled(slot, true)
    gui.set_position(slot.root, vmath.vector3(opt_x, y, 0))
    gui.set_size(slot.root, vmath.vector3(opt_w, opt_h, 0))

    gui.set_position(slot.bg, vmath.vector3(0, 0, 0.70))
    gui.set_size(slot.bg, vmath.vector3(opt_w, opt_h, 0))
    gui.set_color(slot.bg, COLORS.opt_bg)

    gui.set_position(slot.border, vmath.vector3(0, 0, 0.71))
    gui.set_size(slot.border, vmath.vector3(opt_w, opt_h, 0))
    gui.set_color(slot.border, border)

    -- Номер слева, как .opt .num в HTML.
    local num_size = clamp(math.floor(opt_h * 0.42), 30, 38)
    local num_x = 14
    local num_y = math.floor((opt_h - num_size) * 0.5)
    gui.set_position(slot.num_bg, vmath.vector3(num_x, num_y, 0.72))
    gui.set_size(slot.num_bg, vmath.vector3(num_size, num_size, 0))
    gui.set_color(slot.num_bg, COLORS.num_bg)

    gui.set_position(slot.num_border, vmath.vector3(num_x, num_y, 0.73))
    gui.set_size(slot.num_border, vmath.vector3(num_size, num_size, 0))
    gui.set_color(slot.num_border, accent)

    gui.set_position(slot.num_text, vmath.vector3(num_x + num_size * 0.5, num_y + num_size * 0.5, 0.74))
    gui.set_size(slot.num_text, vmath.vector3(num_size - 4, 12, 0))
    gui.set_text(slot.num_text, string.format("%02d", idx))
    gui.set_color(slot.num_text, accent)

    local hint = opt.hint or opt.hint_text or ""
    local hint_w = 0
    local has_hint = hint ~= ""
    gui.set_enabled(slot.hint_border, has_hint)
    gui.set_enabled(slot.hint_text, has_hint)
    if has_hint then
        hint_w = math.max(70, math.min(190, 34 + utf8_len(hint) * 8))
        local hc, hb = hint_color(opt.hintCls or opt.hint_cls)
        local hx = opt_w - 14 - hint_w
        local hy = math.floor((opt_h - 26) * 0.5)
        gui.set_position(slot.hint_border, vmath.vector3(hx, hy, 0.73))
        gui.set_size(slot.hint_border, vmath.vector3(hint_w, 26, 0))
        gui.set_color(slot.hint_border, hb)
        gui.set_position(slot.hint_text, vmath.vector3(hx + hint_w * 0.5, hy + 13, 0.74))
        gui.set_size(slot.hint_text, vmath.vector3(hint_w - 10, 12, 0))
        gui.set_text(slot.hint_text, tostring(hint):upper())
        gui.set_color(slot.hint_text, hc)
    end

    local text_x = num_size + 34
    local text_w = opt_w - text_x - (hint_w > 0 and (hint_w + 30) or 24)
    local text_h = opt_h - 16
    gui.set_position(slot.text, vmath.vector3(text_x, opt_h * 0.5, 0.74))
    gui.set_size(slot.text, vmath.vector3(text_w, text_h, 0))
    gui.set_text(slot.text, opt.text or "—")
    gui.set_color(slot.text, COLORS.paper)

    return { bg = slot.bg, nodes = slot, cls = opt.cls }
end

local function estimate_text_height(text, width, min_h, max_h, line_h)
    text = tostring(text or "")
    if text == "" then
        return 0
    end
    -- Грубая оценка для Manrope 24: средний кириллический символ занимает 12-14 px.
    local chars_per_line = math.max(18, math.floor((width or 660) / 13))
    local lines = math.max(1, math.ceil(utf8_len(text) / chars_per_line))
    return clamp(lines * (line_h or 32), min_h or 34, max_h or 96)
end

local function layout_choice(self, message, opt_count)
    message = message or {}
    local L = DEFAULT_LAYOUT
    local mx, my, mw, mh = L.modal_x, L.modal_y, L.modal_w, L.modal_h
    local left = mx + L.pad_x
    local right = mx + mw - L.pad_x
    local content_w = right - left
    local top = my + mh

    -- Растягиваем саму модалку: на мобильном landscape это заметно лучше,
    -- а на desktop не ломает композицию.
    set_pos_size("modal", mx, my, 0.60, mw, mh)
    set_pos_size("modal_border", mx, my, 0.61, mw, mh)

    local header_y = top - 44

    local meta_w = 180
    local meta_x = right - meta_w
    set_pos_size("meta_loop_bg", meta_x, header_y - 14, 0.62, meta_w, 24)
    set_pos_size("meta_loop_border_top", meta_x, header_y + 9, 0.63, meta_w, 1)
    set_pos_size("meta_loop_border_bottom", meta_x, header_y - 14, 0.63, meta_w, 1)
    set_pos_size("meta_loop_border_left", meta_x, header_y - 14, 0.63, 1, 24)
    set_pos_size("meta_loop_border_right", meta_x + meta_w - 1, header_y - 14, 0.63, 1, 24)
    set_pos("meta_loop", meta_x + meta_w * 0.5, header_y - 2, 0.64)
    set_size("meta_loop", meta_w - 12, 12)

    -- foot_label («ВЫБЕРИ ВАРИАНТ») сидит на той же горизонтали что и
    -- бейдж meta_loop справа, но выровнен по левому краю контента (PIVOT_W).
    set_pos("foot_label", left, header_y - 2, 0.63)
    set_size("foot_label", content_w - meta_w - 24, 30)

    local head_div_y = top - 76
    set_pos_size("head_divider", left, head_div_y, 0.62, content_w, 1)

    local prompt = coalesce(message.prompt, message.title, "Выбери вариант.") or ""
    local caveat = coalesce(message.caveat, message.subtitle, message.note, "") or ""
    local prompt_h = estimate_text_height(prompt, content_w, 38, 118, 34)
    local caveat_h = caveat ~= "" and estimate_text_height(caveat, content_w, 32, 86, 30) or 0

    local prompt_top = head_div_y - 24
    set_pos("prompt", left, prompt_top, 0.63)
    set_size("prompt", content_w, prompt_h)

    local next_y = prompt_top - prompt_h - 12
    if caveat_h > 0 then
        set_pos("caveat", left, next_y, 0.63)
        set_size("caveat", content_w, caveat_h)
        next_y = next_y - caveat_h - 18
    else
        set_pos("caveat", left, next_y, 0.63)
        set_size("caveat", content_w, 0)
        next_y = next_y - 8
    end

    local foot_y = my + 72
    set_pos_size("foot_divider", left, foot_y, 0.62, content_w, 1)

    local opts_top = next_y
    local opts_bottom = foot_y + 22
    local available = math.max(180, opts_top - opts_bottom)
    local count = math.max(1, math.min(4, tonumber(opt_count) or 1))
    local opt_gap = L.opt_gap
    local opt_h = math.floor((available - opt_gap * (count - 1)) / count)
    opt_h = clamp(opt_h, L.opt_min_h, L.opt_max_h)

    -- Если текст вопроса длинный, не даём вариантам залезть под footer:
    -- лучше слегка сжать карточку, чем получить наложение.
    local total_opts_h = count * opt_h + (count - 1) * opt_gap
    if opts_top - total_opts_h < opts_bottom then
        opt_h = math.max(62, math.floor((opts_top - opts_bottom - opt_gap * (count - 1)) / count))
        total_opts_h = count * opt_h + (count - 1) * opt_gap
    end

    set_pos_size("opts_panel", left, opts_top - total_opts_h, 0.62, content_w, total_opts_h)

    self.choice_layout = {
        opt_x = left,
        opt_w = content_w,
        opt_top = opts_top,
        opt_h = opt_h,
        opt_gap = opt_gap,
    }
end

local function normalize_loop_label(v)
    v = coalesce(v)
    if not v then return "ПЕТЛЯ · #001" end

    local text = tostring(v)
    local n = tonumber(text)
    if n then
        return string.format("ПЕТЛЯ · #%03d", n)
    end

    if string.find(text, "#") or string.find(string.lower(text), "пет") then
        return string.upper(text)
    end

    if string.match(text, "^%d+$") then
        return "ПЕТЛЯ · #" .. text
    end

    return string.upper(text)
end

local function remember_location(message)
    message = message or {}

    -- Do not use message.name here: in show_choice it is speaker/who_name,
    -- not a location label. Location must arrive through explicit location fields.
    local loc = coalesce(
        message.location_label,
        message.current_location_label,
        message.location_name,
        message.scene_label,
        message.location,
        message.current_location
    )
    if loc then
        current_location_name = tostring(loc)
        ui_state.current_location_name = current_location_name
        ui_state.location_name = current_location_name
    end

    if message.time ~= nil then
        current_location_time = message.time
        ui_state.current_location_time = message.time
        ui_state.location_time = message.time
    end
    if message.loop ~= nil then
        current_location_loop = message.loop
        ui_state.current_location_loop = message.loop
        ui_state.location_loop = message.loop
    end
end

local function apply_copy(message)
    local prompt = coalesce(message.prompt, message.title, "Выбери вариант.")
    local caveat = coalesce(message.caveat, message.subtitle, message.note, "")
    local loop = normalize_loop_label(coalesce(
        message.loop_label,
        message.iteration_label,
        message.loop,
        message.iteration_number,
        current_location_loop
    ))

    set_text("prompt", tostring(prompt))
    set_text("caveat", tostring(caveat))
    set_text("meta_loop", loop)

    local has_caveat = caveat ~= nil and tostring(caveat) ~= ""
    set_node_enabled("caveat", has_caveat)
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = false
    self.opts = {}
    self.opt_nodes = {}
    cache_opt_slots(self)
    set_all_enabled(false)
    clear_opts(self)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("show_choice") then
        message = message or {}
        self.visible = true
        set_all_enabled(true)
        clear_opts(self)

        local opts = message.opts or {}
        layout_choice(self, message or {}, #opts)
        apply_copy(message or {})

        self.opts = opts
        for i, opt in ipairs(opts) do
            if i <= 4 then
                self.opt_nodes[i] = fill_opt_slot(self, i, opt)
            end
        end

        -- Input gate: после быстрого прокликивания диалога игрок не успевает
        -- остановиться, и mouse-down в момент показа choice'ов попадает в
        -- опцию. Глотаем все клики первые 300мс. socket.gettime() — стандарт
        -- Defold (lua-socket).
        self.input_unlock_at = (socket and socket.gettime and socket.gettime() or 0) + 0.30

    elseif message_id == hash("set_location") then
        remember_location(message or {})
        if self.visible then
            if current_location_loop ~= nil then
                set_text("meta_loop", normalize_loop_label(current_location_loop))
            end
        end

    elseif message_id == hash("hide_choice") then
        self.visible = false
        set_all_enabled(false)
        clear_opts(self)
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return true end

    -- Защита от случайного клика на opt'е сразу после появления choice'ов
    -- (когда игрок мэшил-кликал диалог). Первые 300мс после show_choice
    -- глотаем все клики не передавая в опции.
    if self.input_unlock_at and socket and socket.gettime
       and socket.gettime() < self.input_unlock_at then
        return true
    end

    for i = 1, #self.opt_nodes do
        local o = self.opt_nodes[i]
        if o and o.bg and gui.pick_node(o.bg, action.x, action.y) then
            msg.post(UI_MGR, "choice_picked", { index = i })
            return true
        end
    end

    -- Модалка блокирует клик по сцене под ней.
    return true
end
