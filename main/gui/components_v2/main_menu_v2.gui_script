-- main_menu_v2.gui_script
-- Главное меню v2: glitch-логотип (3 слоя текста), 4 пункта, досье-карточка, ticker.
-- Реальная glitch-анимация реализуется в step17 — здесь только статические слои.
-- Реальная ticker marquee — step19; пока текст просто видим.
--
-- Сообщения:
--   "show_menu"      — показать
--   "hide_menu"      — скрыть
--   "set_progress" {loop, branches, percent} — обновить досье
--
-- В ui_manager_v2 (или напрямую game_manager) шлёт:
--   "start_game"
--   "continue_game"
--   "open_gallery"
--   "open_achievements"

local UI_MGR = "#ui_manager_v2"
local sm = require "main.scripts.save_manager"

local COLOR_HOVER   = vmath.vector4(0.49, 0.976, 1.0, 1.0)
local COLOR_NORMAL  = vmath.vector4(0.952, 0.925, 0.85, 0.78)
local COLOR_ACTIVE  = vmath.vector4(0.952, 0.925, 0.85, 1.0)
local COLOR_DISABLE = vmath.vector4(0.952, 0.925, 0.85, 0.38)

local COLOR_BG_NORMAL  = vmath.vector4(0.067, 0.055, 0.173, 0.72)
local COLOR_BG_ACTIVE  = vmath.vector4(0.067, 0.055, 0.173, 0.82)
local COLOR_BG_DISABLE = vmath.vector4(0.067, 0.055, 0.173, 0.38)

local STAMP_ROTATION = vmath.quat_rotation_z(math.rad(-9))

local MENU_ITEMS = {
    { id = "mi_new",          hit = "mi_new_bg",          arrow = "mi_new_arrow",          bar = "mi_new_bar",          bg = "mi_new_bg",          msg = "start_game",         label = "НОВАЯ ИТЕРАЦИЯ" },
    { id = "mi_continue",     hit = "mi_continue_bg",     arrow = "mi_continue_arrow",     bar = "mi_continue_bar",     bg = "mi_continue_bg",     lock = "mi_continue_lock", msg = "continue_game",      label = "ПРОДОЛЖИТЬ", requires_save = true },
    { id = "mi_gallery",      hit = "mi_gallery_bg",      arrow = "mi_gallery_arrow",      bar = "mi_gallery_bar",      bg = "mi_gallery_bg",      msg = "open_gallery",       label = "ГАЛЕРЕЯ" },
    { id = "mi_achievements", hit = "mi_achievements_bg", arrow = "mi_achievements_arrow", bar = "mi_achievements_bar", bg = "mi_achievements_bg", msg = "open_achievements",  label = "ДОСТИЖЕНИЯ" },
}

local INTRO_GROUPS = {
    { id = "eyebrow", delay = 0.00 },
    { id = "logo_hot", delay = 0.03 },
    { id = "logo_cyan", delay = 0.05 },
    { id = "logo_hot_top", delay = 0.07 },
    { id = "logo_cyan_bot", delay = 0.09 },
    { id = "logo_main", delay = 0.11 },
    { id = "meta", delay = 0.16 },
    { id = "mi_new_bg", delay = 0.20 },
    { id = "mi_continue_bg", delay = 0.24 },
    { id = "mi_gallery_bg", delay = 0.28 },
    { id = "mi_achievements_bg", delay = 0.32 },
    { id = "stamp", delay = 0.36 },
    { id = "dossier_card", delay = 0.40 },
    { id = "ticker_bg", delay = 0.46 },
}

local DOSSIER_NODES = {
    "dossier_card",
    "doss_corner_tl_h", "doss_corner_tl_v", "doss_corner_br_h", "doss_corner_br_v",
    "doss_eyebrow", "doss_live_bg", "doss_live", "doss_name",
    "doss_progress", "doss_progress_track", "doss_progress_fill",
    "doss_state_divider", "doss_state_k", "doss_state_v",
    "doss_desc",
    "doss_scene_thumb", "doss_scene_thumb_border_t", "doss_scene_thumb_border_b",
    "doss_scene_thumb_label", "doss_scene_thumb_state", "doss_scene_thumb_silhouette", "doss_scene_thumb_head",
    "doss_caveat", "doss_caveat2",
}

local function set_text(id, s)
    gui.set_text(gui.get_node(id), s or "")
end

local function click_flash(node)
    gui.animate(node, "scale", vmath.vector4(1.06, 1.06, 1, 1), gui.EASING_OUTQUAD, 0.1, 0, function()
        gui.animate(node, "scale", vmath.vector4(1, 1, 1, 1), gui.EASING_OUTQUAD, 0.15)
    end)
end

local function set_menu_item_enabled(item, enabled)
    local label = gui.get_node(item.id)
    local bg = gui.get_node(item.bg)
    local bar = gui.get_node(item.bar)
    local arrow = gui.get_node(item.arrow)

    if enabled then
        gui.set_color(label, COLOR_ACTIVE)
        gui.set_color(bg, COLOR_BG_ACTIVE)
        gui.set_color(bar, vmath.vector4(0.49, 0.976, 1.0, 0.45))
        gui.set_color(arrow, vmath.vector4(0.952, 0.925, 0.85, 0.55))
        if item.lock then gui.set_enabled(gui.get_node(item.lock), false) end
    else
        gui.set_color(label, COLOR_DISABLE)
        gui.set_color(bg, COLOR_BG_DISABLE)
        gui.set_color(bar, vmath.vector4(0.49, 0.976, 1.0, 0.22))
        gui.set_color(arrow, vmath.vector4(0.952, 0.925, 0.85, 0.25))
        if item.lock then gui.set_enabled(gui.get_node(item.lock), true) end
    end
end

local function refresh_continue_state(self)
    pcall(sm.load)
    local has_save = sm.has_save and sm.has_save() or false
    self.can_continue = has_save

    for _, item in ipairs(MENU_ITEMS) do
        if item.requires_save then
            set_menu_item_enabled(item, has_save)
        else
            set_menu_item_enabled(item, true)
        end
    end
end

local function setup_stamp_style()
    local stamp_nodes = {
        "stamp", "stamp_plate",
        "stamp_border_t", "stamp_border_b", "stamp_border_l", "stamp_border_r",
    }
    for _, id in ipairs(stamp_nodes) do
        gui.set_rotation(gui.get_node(id), STAMP_ROTATION)
    end
end

local function setup_menu_ambience()
    local hud_dot = gui.get_node("menu_hud_dot")
    local p = gui.get_position(hud_dot)
    gui.animate(hud_dot, "scale", vmath.vector4(0.72, 0.72, 1, 1), gui.EASING_INOUTSINE, 0.8, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
    gui.animate(hud_dot, "position.y", p.y + 1.5, gui.EASING_INOUTSINE, 0.8, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)

    local blips = {
        { id = "neon_blip_1", min = 0.18, max = 0.88, dur = 1.7 },
        { id = "neon_blip_2", min = 0.10, max = 0.82, dur = 2.3 },
        { id = "neon_blip_3", min = 0.15, max = 0.80, dur = 1.4 },
    }
    for _, b in ipairs(blips) do
        local n = gui.get_node(b.id)
        local c = gui.get_color(n)
        c.w = b.max
        gui.set_color(n, c)
        gui.animate(n, "color.w", b.min, gui.EASING_INOUTSINE, b.dur, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
    end

    local scene_state = gui.get_node("doss_scene_thumb_state")
    gui.animate(scene_state, "color.w", 0.52, gui.EASING_INOUTSINE, 0.95, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)

    local doss_state = gui.get_node("doss_state_v")
    gui.animate(doss_state, "color.w", 0.58, gui.EASING_INOUTSINE, 1.05, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)

    local doss_live_bg = gui.get_node("doss_live_bg")
    gui.animate(doss_live_bg, "color.w", 0.62, gui.EASING_INOUTSINE, 1.25, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)

    local grain = gui.get_node("grain_overlay")
    gui.animate(grain, "color.w", 0.055, gui.EASING_INOUTSINE, 2.2, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)

    local vignette = gui.get_node("vignette_overlay")
    gui.animate(vignette, "color.w", 0.22, gui.EASING_INOUTSINE, 3.1, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)

    local crt = gui.get_node("crt_scan_overlay")
    local cp = gui.get_position(crt)
    gui.animate(crt, "position.y", cp.y + 6, gui.EASING_LINEAR, 0.75, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
    gui.animate(crt, "color.w", 0.085, gui.EASING_INOUTSINE, 0.75, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
end

local function play_intro(self)
    for _, g in ipairs(INTRO_GROUPS) do
        local node = gui.get_node(g.id)
        local base_pos = gui.get_position(node)
        local base_col = gui.get_color(node)

        gui.cancel_animation(node, "position.y")
        gui.cancel_animation(node, "color.w")

        local start_pos = vmath.vector3(base_pos.x, base_pos.y - 12, base_pos.z)
        local start_col = vmath.vector4(base_col.x, base_col.y, base_col.z, 0)

        gui.set_position(node, start_pos)
        gui.set_color(node, start_col)

        gui.animate(node, "position.y", base_pos.y, gui.EASING_OUTQUAD, 0.26, g.delay)
        gui.animate(node, "color.w", base_col.w, gui.EASING_OUTQUAD, 0.22, g.delay)
    end
end

local function apply_responsive_layout(self)
    local w = gui.get_width()
    local compact = w < 980
    if self.compact_dossier == compact then return end

    self.compact_dossier = compact
    for _, id in ipairs(DOSSIER_NODES) do
        gui.set_enabled(gui.get_node(id), not compact)
    end
end

local function set_dossier_progress(percent)
    local track = gui.get_node("doss_progress_track")
    local fill = gui.get_node("doss_progress_fill")
    local track_sz = gui.get_size(track)
    local fill_sz = gui.get_size(fill)
    local pct = math.max(0, math.min(100, tonumber(percent) or 0)) / 100
    fill_sz.x = math.max(4, track_sz.x * pct)
    gui.set_size(fill, fill_sz)
end

local function progress_state(percent)
    local pct = tonumber(percent) or 0
    if pct >= 100 then
        return "SEALED"
    elseif pct >= 60 then
        return "TRACKED"
    end
    return "ACTIVE"
end

-- ---- glitch-анимация логотипа (step17) ----
-- Базовые координаты трёх слоёв: main=60, hot=58 (-2), cyan=62 (+2)
local LOGO_BASE = {
    hot = 58,
    main = 60,
    cyan = 62,
    hot_top = 57,
    cyan_bot = 63,
}
local LOGO_Y = 498

local function logo_pos(id, dx)
    local n = gui.get_node(id)
    local p = gui.get_position(n)
    p.x = LOGO_BASE[id:match("logo_(.+)")] + (dx or 0)
    p.y = LOGO_Y
    gui.set_position(n, p)
end

local function glitch_burst(self)
    if not self.visible then return end
    local n_hot  = gui.get_node("logo_hot")
    local n_cyan = gui.get_node("logo_cyan")
    local n_hot_top = gui.get_node("logo_hot_top")
    local n_cyan_bot = gui.get_node("logo_cyan_bot")
    -- случайные сдвиги ±10 по X + "дрожь" за 3-4 шага
    local dxh1 = -2 + math.random(-8, 0)
    local dxc1 =  2 + math.random(0, 8)
    local dxh2 = -2 + math.random(-4, 4)
    local dxc2 =  2 + math.random(-4, 4)
    local ph = gui.get_position(n_hot)
    local pc = gui.get_position(n_cyan)
    local pht = gui.get_position(n_hot_top)
    local pcb = gui.get_position(n_cyan_bot)
    ph.x, ph.y = LOGO_BASE.hot + dxh1, LOGO_Y
    pc.x, pc.y = LOGO_BASE.cyan + dxc1, LOGO_Y
    pht.x, pht.y = LOGO_BASE.hot_top + dxh1 * 0.8, LOGO_Y + 1
    pcb.x, pcb.y = LOGO_BASE.cyan_bot + dxc1 * 0.8, LOGO_Y - 1
    gui.set_position(n_hot, ph)
    gui.set_position(n_cyan, pc)
    gui.set_position(n_hot_top, pht)
    gui.set_position(n_cyan_bot, pcb)

    -- цепочка: через 30мс второе положение, через 80мс возврат
    gui.animate(n_hot, "position.x", LOGO_BASE.hot + dxh2, gui.EASING_OUTQUAD, 0.03, 0, function()
        gui.animate(n_hot, "position.x", LOGO_BASE.hot, gui.EASING_OUTQUAD, 0.05)
    end)
    gui.animate(n_cyan, "position.x", LOGO_BASE.cyan + dxc2, gui.EASING_OUTQUAD, 0.03, 0, function()
        gui.animate(n_cyan, "position.x", LOGO_BASE.cyan, gui.EASING_OUTQUAD, 0.05)
    end)
    gui.animate(n_hot_top, "position.x", LOGO_BASE.hot_top + dxh2 * 0.8, gui.EASING_OUTQUAD, 0.03, 0, function()
        gui.animate(n_hot_top, "position.x", LOGO_BASE.hot_top, gui.EASING_OUTQUAD, 0.05)
    end)
    gui.animate(n_cyan_bot, "position.x", LOGO_BASE.cyan_bot + dxc2 * 0.8, gui.EASING_OUTQUAD, 0.03, 0, function()
        gui.animate(n_cyan_bot, "position.x", LOGO_BASE.cyan_bot, gui.EASING_OUTQUAD, 0.05)
    end)

    gui.animate(n_hot_top, "color.w", 0.42, gui.EASING_INOUTSINE, 0.05, 0, function()
        gui.animate(n_hot_top, "color.w", 0.26, gui.EASING_INOUTSINE, 0.10)
    end)
    gui.animate(n_cyan_bot, "color.w", 0.42, gui.EASING_INOUTSINE, 0.05, 0, function()
        gui.animate(n_cyan_bot, "color.w", 0.26, gui.EASING_INOUTSINE, 0.10)
    end)
end

local function schedule_next_glitch(self)
    -- случайный интервал 1.5-4.5 сек между вспышками
    local delay = 1.5 + math.random() * 3.0
    self.glitch_timer = timer.delay(delay, false, function()
        glitch_burst(self)
        schedule_next_glitch(self)
    end)
end

-- ---- parallax skyline (step20) ----
-- ИСПРАВЛЕНО: используем абсолютные координаты вместо gui.set_parent()
-- Причина: динамические ноды с set_parent могут не рендериться (известный баг Defold)
-- См. DESIGN_PORT_RULES.md Rule #2
local function make_skyline_layer(parent_pos, y, h, color, sway, period)
    -- Абсолютные координаты: parent_pos + локальные координаты
    local abs_x = parent_pos.x + 0
    local abs_y = parent_pos.y + y
    local abs_z = parent_pos.z - 0.08  -- z=0.12 относительно parent z=0.2
    
    local n = gui.new_box_node(vmath.vector3(abs_x, abs_y, abs_z), vmath.vector3(1280, h, 0))
    gui.set_pivot(n, gui.PIVOT_SW)
    gui.set_color(n, color)
    -- НЕ используем gui.set_parent() для динамических нод!
    gui.set_inherit_alpha(n, false)  -- false, т.к. нет parent
    
    -- Анимация sway - теперь анимируем от абсолютной позиции
    gui.animate(n, "position.x", abs_x + sway, gui.EASING_INOUTSINE, period, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
    return n
end

local function setup_skyline(self)
    local root = gui.get_node("menu_root")
    local root_pos = gui.get_position(root)
    
    self.sky_far  = make_skyline_layer(root_pos, 70,  36,
        vmath.vector4(0.067, 0.055, 0.173, 0.55), 4,  12.0)
    self.sky_mid  = make_skyline_layer(root_pos, 90,  24,
        vmath.vector4(0.047, 0.039, 0.141, 0.75), 8,  8.0)
    self.sky_near = make_skyline_layer(root_pos, 110, 14,
        vmath.vector4(0.027, 0.023, 0.094, 0.90), 12, 5.5)
end

local BOOT_BAR_WIDTH = 280

local function reset_boot_overlay(self)
    local overlay = gui.get_node("boot_overlay")
    local fill = gui.get_node("boot_bar_fill")
    local text = gui.get_node("boot_text")

    gui.cancel_animation(overlay, "color.w")
    gui.cancel_animation(fill, "size.x")
    gui.cancel_animation(text, "color.w")

    local oc = gui.get_color(overlay)
    oc.w = 0
    gui.set_color(overlay, oc)

    local tc = gui.get_color(text)
    tc.w = 0.95
    gui.set_color(text, tc)

    local fs = gui.get_size(fill)
    fs.x = 0
    gui.set_size(fill, fs)

    gui.set_enabled(overlay, false)
    self.booting = false
end

local function start_boot_transition(self)
    if self.booting then return end
    self.booting = true

    local overlay = gui.get_node("boot_overlay")
    local fill = gui.get_node("boot_bar_fill")
    local text = gui.get_node("boot_text")

    gui.set_enabled(overlay, true)

    local oc = gui.get_color(overlay)
    oc.w = 0
    gui.set_color(overlay, oc)
    gui.animate(overlay, "color.w", 0.92, gui.EASING_OUTQUAD, 0.18)

    local fs = gui.get_size(fill)
    fs.x = 0
    gui.set_size(fill, fs)
    gui.animate(fill, "size.x", BOOT_BAR_WIDTH, gui.EASING_LINEAR, 0.55, 0.08, function()
        msg.post(UI_MGR, "start_game")
    end)

    gui.animate(text, "color.w", 0.48, gui.EASING_INOUTSINE, 0.26, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = true
    self.hovered = nil
    self.booting = false
    self.compact_dossier = nil
    self.last_gui_w = 0
    math.randomseed(os.time())
    self.glitch_timer = nil
    schedule_next_glitch(self)
    setup_skyline(self)
    setup_stamp_style()
    setup_menu_ambience()
    refresh_continue_state(self)
    set_dossier_progress(41)
    apply_responsive_layout(self)
    play_intro(self)
    reset_boot_overlay(self)
end

function final(self)
    if self.glitch_timer then
        timer.cancel(self.glitch_timer)
        self.glitch_timer = nil
    end
end

-- ---- ticker marquee (step19) ----
local TICKER_SPEED = 40  -- px/сек влево
local TICKER_TEXT_WIDTH = 2400
local SCREEN_W = 1280  -- было 960

function update(self, dt)
    if not self.visible then return end

    local current_w = gui.get_width()
    if current_w ~= self.last_gui_w then
        self.last_gui_w = current_w
        apply_responsive_layout(self)
    end

    local n = gui.get_node("ticker_text")
    local p = gui.get_position(n)
    p.x = p.x - TICKER_SPEED * dt
    -- Пивот W + ширина 2400 → левый край уходит за -2400, справа нужно ре-вход.
    -- Когда весь текст ушёл влево (p.x + width < 0), сбрасываем к SCREEN_W.
    if p.x + TICKER_TEXT_WIDTH < 0 then
        p.x = SCREEN_W
    end
    gui.set_position(n, p)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("show_menu") then
        self.visible = true
        gui.set_enabled(gui.get_node("menu_root"), true)
        reset_boot_overlay(self)
        refresh_continue_state(self)
        apply_responsive_layout(self)
        play_intro(self)
    elseif message_id == hash("hide_menu") then
        self.visible = false
        reset_boot_overlay(self)
        gui.set_enabled(gui.get_node("menu_root"), false)
    elseif message_id == hash("set_progress") then
        local loop = tonumber(message.loop) or 17
        local br   = tonumber(message.branches) or 23
        local pct  = tonumber(message.percent) or 41
        set_text("doss_progress",
            string.format("петля #%03d · %d разв. · %d%% завершено", loop, br, pct))
        set_text("doss_state_v", progress_state(pct))
        set_dossier_progress(pct)
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    for _, item in ipairs(MENU_ITEMS) do
        local n = gui.get_node(item.hit or item.id)
        if gui.pick_node(n, action.x, action.y) then
            if item.requires_save and not self.can_continue then
                return true
            end
            click_flash(n)
            gui.set_color(gui.get_node(item.id), COLOR_ACTIVE)
            gui.set_color(gui.get_node(item.bg), COLOR_BG_ACTIVE)
            if item.msg == "start_game" then
                start_boot_transition(self)
            else
                msg.post(UI_MGR, item.msg)
            end
            return true
        end
    end

    return false
end
