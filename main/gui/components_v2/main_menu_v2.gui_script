local UI_MGR = "#ui_manager_v2"

local COLOR_HOVER  = vmath.vector4(0.49, 0.976, 1.0, 1.0)
local COLOR_NORMAL = vmath.vector4(0.952, 0.925, 0.85, 0.78)
local COLOR_ACTIVE = vmath.vector4(0.952, 0.925, 0.85, 1.0)

local MENU_ITEMS = {
    { id = "mi_new",          msg = "start_game",         label = "НОВАЯ ИТЕРАЦИЯ" },
    { id = "mi_continue",     msg = "continue_game",      label = "ПРОДОЛЖИТЬ" },
    { id = "mi_gallery",      msg = "open_gallery",       label = "ГАЛЕРЕЯ" },
    { id = "mi_achievements", msg = "open_achievements",  label = "ДОСТИЖЕНИЯ" },
}

local TICKER_SPEED = 40
local TICKER_TEXT_WIDTH = 2400
local SCREEN_W = 1280

local LOGO_BASE = {
    hot  = 58,
    main = 60,
    cyan = 62,
}

local LOGO_Y = 498

local function set_text(id, s)
    gui.set_text(gui.get_node(id), s or "")
end

local function set_text_alpha(id, alpha)
    local node = gui.get_node(id)
    local color = gui.get_color(node)
    color.w = alpha
    gui.set_color(node, color)
end

local function apply_loop_state(self, message)
    local iteration = tonumber(message and message.iteration) or 1
    local awareness = tonumber(message and message.awareness) or 0
    local completed = tonumber(message and message.completed) or math.max(iteration - 1, 0)
    local iteration_label = message and message.iteration_label or string.format("%03d", iteration)
    local can_continue = message and message.can_continue == true

    self.can_continue = can_continue

    set_text("mi_new", string.format("НАЧАТЬ ИТЕРАЦИЮ %s", iteration_label))
    set_text("eyebrow", string.format("visual · novel · dossier · петля #%s", iteration_label))
    set_text("stamp", string.format("СЕКРЕТНО · №%s", iteration_label))
    set_text("doss_eyebrow", "dossier · активная петля")
    set_text("doss_name", string.format("ИТЕРАЦИЯ %s", iteration_label))
    set_text("doss_progress", string.format("осознание %d · завершено %d", awareness, completed))

    if awareness > 0 then
        set_text("doss_desc",
            "День запускается заново, но память уже не стирается полностью.\n" ..
            "Некоторые реплики звучат знакомо, а система начинает пропускать швы.")
        set_text("doss_caveat", "meta-state сохранён между циклами")
        set_text("doss_caveat2", string.format("следующий запуск: итерация %s", iteration_label))
    else
        set_text("doss_desc",
            "Очередной понедельник. Дождь, кофе, три непрочитанных.\n" ..
            "Пока это выглядит как обычное утро, но контур петли уже рядом.")
        set_text("doss_caveat", "run-state сбрасывается при новом запуске")
        set_text("doss_caveat2", string.format("активная итерация: %s", iteration_label))
    end

    set_text_alpha("mi_continue", can_continue and 0.78 or 0.25)
end

local function click_flash(node)
    gui.animate(node, "scale", vmath.vector4(1.06, 1.06, 1, 1), gui.EASING_OUTQUAD, 0.1, 0, function()
        gui.animate(node, "scale", vmath.vector4(1, 1, 1, 1), gui.EASING_OUTQUAD, 0.15)
    end)
end

local function get_logo_key(id)
    return id:match("logo_(.+)")
end

local function cache_logo_base_from_scene()
    local p_hot  = gui.get_position(gui.get_node("logo_hot"))
    local p_main = gui.get_position(gui.get_node("logo_main"))
    local p_cyan = gui.get_position(gui.get_node("logo_cyan"))

    LOGO_BASE.hot  = p_hot.x
    LOGO_BASE.main = p_main.x
    LOGO_BASE.cyan = p_cyan.x
    LOGO_Y = p_main.y
end

local function logo_pos(id, dx)
    local n = gui.get_node(id)
    local p = gui.get_position(n)
    local key = get_logo_key(id)
    p.x = LOGO_BASE[key] + (dx or 0)
    p.y = LOGO_Y
    gui.set_position(n, p)
end

local function reset_logo_glitch()
    local n_hot  = gui.get_node("logo_hot")
    local n_main = gui.get_node("logo_main")
    local n_cyan = gui.get_node("logo_cyan")

    gui.cancel_animation(n_hot,  "position.x")
    gui.cancel_animation(n_hot,  "position.y")
    gui.cancel_animation(n_hot,  "color.w")
    gui.cancel_animation(n_hot,  "scale")

    gui.cancel_animation(n_main, "position.x")
    gui.cancel_animation(n_main, "position.y")
    gui.cancel_animation(n_main, "color.w")
    gui.cancel_animation(n_main, "scale")

    gui.cancel_animation(n_cyan, "position.x")
    gui.cancel_animation(n_cyan, "position.y")
    gui.cancel_animation(n_cyan, "color.w")
    gui.cancel_animation(n_cyan, "scale")

    logo_pos("logo_hot", 0)
    logo_pos("logo_main", 0)
    logo_pos("logo_cyan", 0)

    local ch = gui.get_color(n_hot)
    local cm = gui.get_color(n_main)
    local cc = gui.get_color(n_cyan)

    ch.w = 1.0
    cm.w = 1.0
    cc.w = 1.0

    gui.set_color(n_hot, ch)
    gui.set_color(n_main, cm)
    gui.set_color(n_cyan, cc)

    gui.set_scale(n_hot,  vmath.vector3(1, 1, 1))
    gui.set_scale(n_main, vmath.vector3(1, 1, 1))
    gui.set_scale(n_cyan, vmath.vector3(1, 1, 1))
end

local function animate_x(node, target, duration, easing, delay, complete_fn)
    gui.animate(node, "position.x", target, easing or gui.EASING_LINEAR, duration or 0.02, delay or 0, complete_fn)
end

local function animate_y(node, target, duration, easing, delay, complete_fn)
    gui.animate(node, "position.y", target, easing or gui.EASING_LINEAR, duration or 0.02, delay or 0, complete_fn)
end

local function animate_alpha(node, target, duration, easing, delay, complete_fn)
    gui.animate(node, "color.w", target, easing or gui.EASING_LINEAR, duration or 0.02, delay or 0, complete_fn)
end

local function animate_scale_xy(node, sx, sy, duration, easing, delay, complete_fn)
    gui.animate(node, "scale", vmath.vector3(sx, sy, 1), easing or gui.EASING_LINEAR, duration or 0.02, delay or 0, complete_fn)
end

local function glitch_burst(self)
    if not self.visible then
        reset_logo_glitch()
        return
    end

    local n_hot  = gui.get_node("logo_hot")
    local n_main = gui.get_node("logo_main")
    local n_cyan = gui.get_node("logo_cyan")

    reset_logo_glitch()

    local dir = (math.random() < 0.5) and -1 or 1
    local strong = (math.random() < 0.25)

    -- МЯГКИЕ диапазоны
    local yank = dir * (strong and math.random(14, 20) or math.random(8, 14))

    local split_hot_1  = -dir * (strong and math.random(18, 26) or math.random(10, 16))
    local split_cyan_1 =  dir * (strong and math.random(18, 26) or math.random(10, 16))

    local split_hot_2  = -dir * math.random(6, 10)
    local split_cyan_2 =  dir * math.random(6, 10)

    local split_hot_3  = -dir * math.random(2, 4)
    local split_cyan_3 =  dir * math.random(2, 4)

    local main_1 = dir * math.random(2, 4)
    local main_2 = -dir * math.random(1, 2)

    -- очень лёгкий vertical jitter
    local y_hot  = LOGO_Y + math.random(-1, 1)
    local y_main = LOGO_Y
    local y_cyan = LOGO_Y + math.random(-1, 1)

    -- мягкая альфа (без мигания)
    local a_hot  = strong and 0.65 or 0.78
    local a_main = 0.95
    local a_cyan = strong and 0.65 or 0.78

    -- фаза 1: рывок
    logo_pos("logo_hot",  yank + split_hot_1)
    logo_pos("logo_main", yank + main_1)
    logo_pos("logo_cyan", yank + split_cyan_1)

    local ph = gui.get_position(n_hot)
    local pm = gui.get_position(n_main)
    local pc = gui.get_position(n_cyan)

    ph.y = y_hot
    pm.y = y_main
    pc.y = y_cyan

    gui.set_position(n_hot, ph)
    gui.set_position(n_main, pm)
    gui.set_position(n_cyan, pc)

    animate_alpha(n_hot,  a_hot,  0.02)
    animate_alpha(n_main, a_main, 0.02)
    animate_alpha(n_cyan, a_cyan, 0.02)

    -- фаза 2: отскок (без дерганья)
    animate_x(n_hot, LOGO_BASE.hot + (-yank * 0.3) + split_hot_2, 0.035, gui.EASING_OUTQUAD, 0.01, function()
        animate_x(n_hot, LOGO_BASE.hot + split_hot_3, 0.03, gui.EASING_OUTQUAD, 0, function()
            animate_x(n_hot, LOGO_BASE.hot, 0.06, gui.EASING_OUTQUAD)
        end)
    end)

    animate_x(n_main, LOGO_BASE.main + (-yank * 0.2) + main_2, 0.03, gui.EASING_OUTQUAD, 0.01, function()
        animate_x(n_main, LOGO_BASE.main, 0.05, gui.EASING_OUTQUAD)
    end)

    animate_x(n_cyan, LOGO_BASE.cyan + (-yank * 0.3) + split_cyan_2, 0.035, gui.EASING_OUTQUAD, 0.01, function()
        animate_x(n_cyan, LOGO_BASE.cyan + split_cyan_3, 0.03, gui.EASING_OUTQUAD, 0, function()
            animate_x(n_cyan, LOGO_BASE.cyan, 0.06, gui.EASING_OUTQUAD)
        end)
    end)

    animate_y(n_hot, LOGO_Y, 0.05, gui.EASING_OUTQUAD)
    animate_y(n_main, LOGO_Y, 0.05, gui.EASING_OUTQUAD)
    animate_y(n_cyan, LOGO_Y, 0.05, gui.EASING_OUTQUAD)

    -- возврат альфы
    animate_alpha(n_hot, 1.0, 0.06)
    animate_alpha(n_cyan, 1.0, 0.06)
end

local function schedule_next_glitch(self)
    if self.glitch_timer then
        timer.cancel(self.glitch_timer)
    end

    local delay = 1.2 + math.random() * 2.5

    self.glitch_timer = timer.delay(delay, false, function()
        if not self.visible then return end

        glitch_burst(self)

        -- иногда второй мягкий удар
        if math.random() < 0.35 then
            timer.delay(0.06 + math.random() * 0.06, false, function()
                if self.visible then
                    glitch_burst(self)
                end
            end)
        end

        schedule_next_glitch(self)
    end)
end

local function animate_alpha(node, target, duration, easing, delay, complete_fn)
    gui.animate(node, "color.w", target, easing or gui.EASING_LINEAR, duration or 0.02, delay or 0, complete_fn)
end

local function animate_x(node, target, duration, easing, delay, complete_fn)
    gui.animate(node, "position.x", target, easing or gui.EASING_LINEAR, duration or 0.02, delay or 0, complete_fn)
end

local function animate_y(node, target, duration, easing, delay, complete_fn)
    gui.animate(node, "position.y", target, easing or gui.EASING_LINEAR, duration or 0.02, delay or 0, complete_fn)
end

local function glitch_burst(self)
    if not self.visible then
        reset_logo_glitch()
        return
    end

    local n_hot  = gui.get_node("logo_hot")
    local n_main = gui.get_node("logo_main")
    local n_cyan = gui.get_node("logo_cyan")

    reset_logo_glitch()

    local mode_roll = math.random()
    local mode
    if mode_roll < 0.24 then
        mode = "violent"
    elseif mode_roll < 0.64 then
        mode = "hard"
    else
        mode = "normal"
    end

    local dir = (math.random() < 0.5) and -1 or 1

    local yank
    local split_hot_1, split_cyan_1
    local split_hot_2, split_cyan_2
    local split_hot_3, split_cyan_3
    local main_1, main_2, main_3
    local y_hot, y_main, y_cyan
    local a_hot, a_main, a_cyan
    local sx_main, sy_main
    local sx_hot, sy_hot
    local sx_cyan, sy_cyan
    local hold_1, hold_2

    if mode == "violent" then
        yank = dir * math.random(20, 34)

        split_hot_1  = -dir * math.random(34, 56)
        split_cyan_1 =  dir * math.random(34, 56)

        split_hot_2  = -dir * math.random(14, 24)
        split_cyan_2 =  dir * math.random(14, 24)

        split_hot_3  = -dir * math.random(5, 10)
        split_cyan_3 =  dir * math.random(5, 10)

        main_1 = dir * math.random(10, 18)
        main_2 = -dir * math.random(5, 9)
        main_3 = dir * math.random(-2, 2)

        y_hot  = LOGO_Y + math.random(-5, 5)
        y_main = LOGO_Y + math.random(-3, 3)
        y_cyan = LOGO_Y + math.random(-5, 5)

        a_hot  = 0.08
        a_main = 0.64
        a_cyan = 0.06

        sx_main, sy_main = 1.085, 0.915
        sx_hot,  sy_hot  = 1.028, 0.985
        sx_cyan, sy_cyan = 0.972, 1.020

        hold_1 = 0.012
        hold_2 = 0.000
    elseif mode == "hard" then
        yank = dir * math.random(12, 22)

        split_hot_1  = -dir * math.random(22, 38)
        split_cyan_1 =  dir * math.random(22, 38)

        split_hot_2  = -dir * math.random(10, 16)
        split_cyan_2 =  dir * math.random(10, 16)

        split_hot_3  = -dir * math.random(4, 7)
        split_cyan_3 =  dir * math.random(4, 7)

        main_1 = dir * math.random(6, 10)
        main_2 = -dir * math.random(3, 6)
        main_3 = dir * math.random(-1, 1)

        y_hot  = LOGO_Y + math.random(-3, 3)
        y_main = LOGO_Y + math.random(-2, 2)
        y_cyan = LOGO_Y + math.random(-3, 3)

        a_hot  = 0.20
        a_main = 0.78
        a_cyan = 0.18

        sx_main, sy_main = 1.050, 0.950
        sx_hot,  sy_hot  = 1.015, 0.992
        sx_cyan, sy_cyan = 0.986, 1.012

        hold_1 = 0.010
        hold_2 = 0.000
    else
        yank = dir * math.random(6, 12)

        split_hot_1  = -dir * math.random(12, 22)
        split_cyan_1 =  dir * math.random(12, 22)

        split_hot_2  = -dir * math.random(6, 10)
        split_cyan_2 =  dir * math.random(6, 10)

        split_hot_3  = -dir * math.random(2, 4)
        split_cyan_3 =  dir * math.random(2, 4)

        main_1 = dir * math.random(3, 5)
        main_2 = -dir * math.random(1, 3)
        main_3 = 0

        y_hot  = LOGO_Y + math.random(-2, 2)
        y_main = LOGO_Y + math.random(-1, 1)
        y_cyan = LOGO_Y + math.random(-2, 2)

        a_hot  = 0.36
        a_main = 0.90
        a_cyan = 0.34

        sx_main, sy_main = 1.024, 0.976
        sx_hot,  sy_hot  = 1.008, 0.997
        sx_cyan, sy_cyan = 0.992, 1.008

        hold_1 = 0.008
        hold_2 = 0.000
    end

    -- Первая фаза: весь логотип рвётся в одну сторону, а RGB ещё сильнее расходится
    logo_pos("logo_hot",  yank + split_hot_1)
    logo_pos("logo_main", yank + main_1)
    logo_pos("logo_cyan", yank + split_cyan_1)

    local ph = gui.get_position(n_hot)
    local pm = gui.get_position(n_main)
    local pc = gui.get_position(n_cyan)

    ph.y = y_hot
    pm.y = y_main
    pc.y = y_cyan

    gui.set_position(n_hot, ph)
    gui.set_position(n_main, pm)
    gui.set_position(n_cyan, pc)

    gui.set_scale(n_hot,  vmath.vector3(sx_hot,  sy_hot,  1))
    gui.set_scale(n_main, vmath.vector3(sx_main, sy_main, 1))
    gui.set_scale(n_cyan, vmath.vector3(sx_cyan, sy_cyan, 1))

    animate_alpha(n_hot, a_hot, 0.010, gui.EASING_LINEAR, 0, function()
        animate_alpha(n_hot, 0.88, 0.020, gui.EASING_LINEAR, 0, function()
            animate_alpha(n_hot, 1.0, 0.070, gui.EASING_OUTQUAD)
        end)
    end)

    animate_alpha(n_main, a_main, 0.009, gui.EASING_LINEAR, 0, function()
        animate_alpha(n_main, 1.0, 0.055, gui.EASING_OUTQUAD)
    end)

    animate_alpha(n_cyan, a_cyan, 0.010, gui.EASING_LINEAR, 0, function()
        animate_alpha(n_cyan, 0.86, 0.020, gui.EASING_LINEAR, 0, function()
            animate_alpha(n_cyan, 1.0, 0.070, gui.EASING_OUTQUAD)
        end)
    end)

    animate_scale_xy(n_hot, 1.0, 1.0, 0.085, gui.EASING_OUTQUAD)
    animate_scale_xy(n_main, 1.0, 1.0, 0.095, gui.EASING_OUTQUAD)
    animate_scale_xy(n_cyan, 1.0, 1.0, 0.085, gui.EASING_OUTQUAD)

    -- Вторая фаза: отскок
    animate_x(n_hot, LOGO_BASE.hot + (-yank * 0.35) + split_hot_2, 0.024, gui.EASING_LINEAR, hold_1, function()
        animate_x(n_hot, LOGO_BASE.hot + split_hot_3, 0.022, gui.EASING_LINEAR, hold_2, function()
            animate_x(n_hot, LOGO_BASE.hot, 0.075, gui.EASING_OUTQUAD)
        end)
    end)

    animate_x(n_main, LOGO_BASE.main + (-yank * 0.22) + main_2, 0.022, gui.EASING_LINEAR, hold_1, function()
        animate_x(n_main, LOGO_BASE.main + main_3, 0.020, gui.EASING_LINEAR, hold_2, function()
            animate_x(n_main, LOGO_BASE.main, 0.068, gui.EASING_OUTQUAD)
        end)
    end)

    animate_x(n_cyan, LOGO_BASE.cyan + (-yank * 0.35) + split_cyan_2, 0.024, gui.EASING_LINEAR, hold_1, function()
        animate_x(n_cyan, LOGO_BASE.cyan + split_cyan_3, 0.022, gui.EASING_LINEAR, hold_2, function()
            animate_x(n_cyan, LOGO_BASE.cyan, 0.075, gui.EASING_OUTQUAD)
        end)
    end)

    animate_y(n_hot, LOGO_Y, 0.060, gui.EASING_OUTQUAD)
    animate_y(n_main, LOGO_Y, 0.055, gui.EASING_OUTQUAD)
    animate_y(n_cyan, LOGO_Y, 0.060, gui.EASING_OUTQUAD)
end

local function stop_glitch_loop(self)
    if self.glitch_timer then
        timer.cancel(self.glitch_timer)
        self.glitch_timer = nil
    end
    reset_logo_glitch()
end

local function schedule_next_glitch(self)
    if self.glitch_timer then
        timer.cancel(self.glitch_timer)
        self.glitch_timer = nil
    end

    local delay = 0.35 + math.random() * 1.35

    self.glitch_timer = timer.delay(delay, false, function()
        self.glitch_timer = nil

        if not self.visible then
            reset_logo_glitch()
            return
        end

        glitch_burst(self)

        if math.random() < 0.78 then
            timer.delay(0.026 + math.random() * 0.045, false, function()
                if self.visible then
                    glitch_burst(self)
                end
            end)
        end

        if math.random() < 0.42 then
            timer.delay(0.075 + math.random() * 0.055, false, function()
                if self.visible then
                    glitch_burst(self)
                end
            end)
        end

        if math.random() < 0.14 then
            timer.delay(0.145 + math.random() * 0.070, false, function()
                if self.visible then
                    glitch_burst(self)
                end
            end)
        end

        schedule_next_glitch(self)
    end)
end

local function start_glitch_loop(self)
    reset_logo_glitch()
    schedule_next_glitch(self)
end

local function make_skyline_layer(parent_pos, y, h, color, sway, period)
    local abs_x = parent_pos.x + 0
    local abs_y = parent_pos.y + y
    local abs_z = parent_pos.z - 0.08

    local n = gui.new_box_node(vmath.vector3(abs_x, abs_y, abs_z), vmath.vector3(1280, h, 0))
    gui.set_pivot(n, gui.PIVOT_SW)
    gui.set_color(n, color)
    gui.set_inherit_alpha(n, false)
    gui.animate(n, "position.x", abs_x + sway, gui.EASING_INOUTSINE, period, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
    return n
end

local function setup_skyline(self)
    local root = gui.get_node("menu_root")
    local root_pos = gui.get_position(root)

    self.sky_far  = make_skyline_layer(root_pos, 70, 36,
        vmath.vector4(0.067, 0.055, 0.173, 0.55), 4, 12.0)
    self.sky_mid  = make_skyline_layer(root_pos, 90, 24,
        vmath.vector4(0.047, 0.039, 0.141, 0.75), 8, 8.0)
    self.sky_near = make_skyline_layer(root_pos, 110, 14,
        vmath.vector4(0.027, 0.023, 0.094, 0.90), 12, 5.5)
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = true
    self.hovered = nil
    self.glitch_timer = nil
    self.can_continue = false

    math.randomseed(os.time())

    cache_logo_base_from_scene()
    start_glitch_loop(self)
    setup_skyline(self)
    apply_loop_state(self, { iteration = 1, iteration_label = "001", awareness = 0, completed = 0, can_continue = false })
end

function final(self)
    stop_glitch_loop(self)
end

function update(self, dt)
    if not self.visible then return end

    local n = gui.get_node("ticker_text")
    local p = gui.get_position(n)
    p.x = p.x - TICKER_SPEED * dt

    if p.x + TICKER_TEXT_WIDTH < 0 then
        p.x = SCREEN_W
    end

    gui.set_position(n, p)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("show_menu") then
        self.visible = true
        gui.set_enabled(gui.get_node("menu_root"), true)
        start_glitch_loop(self)

    elseif message_id == hash("hide_menu") then
        self.visible = false
        gui.set_enabled(gui.get_node("menu_root"), false)
        stop_glitch_loop(self)

    elseif message_id == hash("set_loop_state") then
        apply_loop_state(self, message)

    elseif message_id == hash("set_progress") then
        local loop = tonumber(message.loop) or 17
        local br   = tonumber(message.branches) or 23
        local pct  = tonumber(message.percent) or 41

        set_text("doss_progress",
            string.format("петля #%03d · %d разв. · %d%% завершено", loop, br, pct))
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    for _, item in ipairs(MENU_ITEMS) do
        local n = gui.get_node(item.id)
        if gui.pick_node(n, action.x, action.y) then
            if item.id == "mi_continue" and not self.can_continue then
                return true
            end
            click_flash(n)
            gui.set_color(n, COLOR_ACTIVE)
            msg.post(UI_MGR, item.msg)
            return true
        end
    end

    return false
end
