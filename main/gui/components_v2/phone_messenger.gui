    x: 1.0
    y: 1.0
  }
  color {
    x: 0.031
    y: 0.024
    z: 0.094
  }
  type: TYPE_BOX
  id: "messenger_runtime_root"
  pivot: PIVOT_SW
  adjust_mode: ADJUST_MODE_STRETCH
