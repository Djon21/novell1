-- hud_v2.gui_script
-- Верхний HUD с заголовком локации + правый слот BAG/PHN.
--
-- Принимает сообщения:
--   "set_location"       {name, time, loop}     — обновляет заголовок
--   "set_inventory_count"{n}                    — бейдж BAG
--   "set_phone_notif"    {n}                    — бейдж PHN
--   "show_hud" / "hide_hud"
--
-- Шлёт в ui_manager_v2:
--   "open_inventory" — при клике на BAG
--   "open_phone"     — при клике на PHN

local theme = require "main.gui.modules.v2_theme"
local ui_state = require "main.scripts.ui_state"

local UI_MGR = "#ui_manager_v2"

local COLOR_BTN_BG = vmath.vector4(0.031, 0.023, 0.094, 0.85)
local COLOR_BTN_TEXT = vmath.vector4(0.952, 0.925, 0.85, 0.9)

-- Armed-banner для inventory use-on-target: показывается сверху по центру
-- пока игрок выбирает цель для предмета.
local COLOR_BANNER_BG     = vmath.vector4(0.031, 0.023, 0.094, 0.92)
local COLOR_BANNER_BORDER = vmath.vector4(0.49, 0.976, 1.0, 1.0)
local COLOR_BANNER_TEXT   = vmath.vector4(0.952, 0.925, 0.85, 1.0)
local COLOR_BANNER_CANCEL = vmath.vector4(1.0, 0.55, 0.55, 1.0)

local function set_text(id, s)
    gui.set_text(gui.get_node(id), s or "")
end

local function set_visible(id, v)
    gui.set_enabled(gui.get_node(id), v)
end

local function point_in_node(node, action)
    return gui.pick_node(node, action.x, action.y)
end

local function make_box(parent, x, y, z, w, h, color)
    local n = gui.new_box_node(vmath.vector3(x, y, z), vmath.vector3(w, h, 0))
    gui.set_pivot(n, gui.PIVOT_SW)
    gui.set_adjust_mode(n, gui.ADJUST_STRETCH)
    gui.set_color(n, color)
    if parent then gui.set_parent(n, parent, false) end
    return n
end

local function make_text(parent, x, y, z, w, h, text, font, color, pivot)
    local n = gui.new_text_node(vmath.vector3(x, y, z), text or "")
    gui.set_pivot(n, pivot or gui.PIVOT_CENTER)
    gui.set_size(n, vmath.vector3(w, h, 0))
    gui.set_font(n, font)
    gui.set_adjust_mode(n, gui.ADJUST_STRETCH)
    gui.set_color(n, color)
    pcall(gui.set_line_break, n, true)
    if parent then gui.set_parent(n, parent, false) end
    return n
end

local function ensure_log_button(self)
    if self.log_button then return end
    local root = gui.get_node("hud_root")
    self.log_button = make_box(root, 971, 617, 0.1, 64, 64, COLOR_BTN_BG)
    self.log_label = make_text(root, 1003, 650, 0.12, 60, 16, "LOG", "jb_mono_bold_14", COLOR_BTN_TEXT, gui.PIVOT_CENTER)
end

-- Armed-banner: «Используй <предмет> на цели»  +  кнопка ✕ отмены.
-- Координаты в PIVOT_SW системе hud_root: левый-нижний угол ноды.
local ARMED_BANNER_W      = 600
local ARMED_BANNER_H      = 56
local ARMED_BANNER_X      = (1280 - ARMED_BANNER_W) / 2  -- 340
local ARMED_BANNER_Y      = 600                           -- сверху, ниже BAG/PHN
local ARMED_CANCEL_W      = 56
local ARMED_CANCEL_H      = 40

local function ensure_armed_banner(self)
    if self.armed_banner then return end
    local root = gui.get_node("hud_root")
    local nodes = {}

    nodes.bg = make_box(root,
        ARMED_BANNER_X, ARMED_BANNER_Y, 0.2,
        ARMED_BANNER_W, ARMED_BANNER_H, COLOR_BANNER_BG)

    -- Тонкая «обводка» сверху (отдельная узкая полоска).
    nodes.border = make_box(root,
        ARMED_BANNER_X, ARMED_BANNER_Y + ARMED_BANNER_H - 2, 0.21,
        ARMED_BANNER_W, 2, COLOR_BANNER_BORDER)

    -- Текст-инструкция.
    nodes.text = make_text(root,
        ARMED_BANNER_X + 16, ARMED_BANNER_Y + 16, 0.22,
        ARMED_BANNER_W - 16 - ARMED_CANCEL_W - 16, ARMED_BANNER_H - 32,
        "", "jb_mono_bold_14", COLOR_BANNER_TEXT, gui.PIVOT_W)

    -- Кнопка ✕ отмены (правая сторона баннера).
    local cancel_x = ARMED_BANNER_X + ARMED_BANNER_W - ARMED_CANCEL_W - 8
    local cancel_y = ARMED_BANNER_Y + (ARMED_BANNER_H - ARMED_CANCEL_H) / 2
    nodes.cancel_bg = make_box(root,
        cancel_x, cancel_y, 0.22,
        ARMED_CANCEL_W, ARMED_CANCEL_H,
        vmath.vector4(0.06, 0.06, 0.10, 1.0))

    nodes.cancel_label = make_text(root,
        cancel_x + ARMED_CANCEL_W / 2, cancel_y + ARMED_CANCEL_H / 2, 0.23,
        ARMED_CANCEL_W, ARMED_CANCEL_H,
        "ОТМЕНА", "jb_mono_bold_14", COLOR_BANNER_CANCEL, gui.PIVOT_CENTER)

    -- Сразу прячем — показываем только при show_armed_banner.
    for _, n in pairs(nodes) do gui.set_enabled(n, false) end

    self.armed_banner = nodes
end

local function show_armed_banner(self, item_name, verb)
    ensure_armed_banner(self)
    local label
    if verb == "use" then
        label = "Использовать «" .. tostring(item_name or "") .. "» — выбери цель"
    else
        label = tostring(item_name or "") .. " — выбери цель"
    end
    gui.set_text(self.armed_banner.text, label)
    for _, n in pairs(self.armed_banner) do gui.set_enabled(n, true) end
end

local function hide_armed_banner(self)
    if not self.armed_banner then return end
    for _, n in pairs(self.armed_banner) do gui.set_enabled(n, false) end
end

local function set_phone_slot_visible(enabled, notif_count)
    set_visible("phn_ring", enabled)
    set_visible("phn_icon", enabled)

    local show_badge = enabled and (notif_count or 0) > 0
    set_visible("phn_badge", show_badge)
    set_visible("phn_badge_text", show_badge)
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = true
    self.bag_count  = 0
    self.phn_notif  = 0
    self.phone_enabled = false
    ensure_log_button(self)
    -- базовые тексты уже стоят в .gui, но занулим бейджи пока нет данных
    set_text("bag_badge_text", "")
    set_visible("bag_badge", false)
    set_visible("bag_badge_text", false)
    set_text("phn_badge_text", "")
    set_phone_slot_visible(false, 0)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("set_location") then
        set_text("scene_name", (message.name or ""):upper())
        local meta = ""
        if message.time then meta = message.time end
        if message.loop then
            meta = meta .. (meta ~= "" and " · " or "") .. "петля #" .. tostring(message.loop)
        end
        if meta ~= "" then meta = meta .. " · сост. стабильна" end
        set_text("scene_meta", meta)

    elseif message_id == hash("set_inventory_count") then
        local n = tonumber(message.n) or 0
        self.bag_count = n
        if n > 0 then
            set_text("bag_badge_text", tostring(n))
            set_visible("bag_badge", true)
            set_visible("bag_badge_text", true)
        else
            set_visible("bag_badge", false)
            set_visible("bag_badge_text", false)
        end

    elseif message_id == hash("set_phone_notif") then
        local n = tonumber(message.n) or 0
        self.phn_notif = n
        if n > 0 then
            set_text("phn_badge_text", tostring(n))
        end
        set_phone_slot_visible(self.phone_enabled, n)

    elseif message_id == hash("set_phone_enabled") then
        self.phone_enabled = message.enabled and true or false
        set_phone_slot_visible(self.phone_enabled, self.phn_notif)

    elseif message_id == hash("show_hud") then
        self.visible = true
        gui.set_enabled(gui.get_node("hud_root"), true)
        ensure_log_button(self)

    elseif message_id == hash("hide_hud") then
        self.visible = false
        gui.set_enabled(gui.get_node("hud_root"), false)

    elseif message_id == hash("show_armed_banner") then
        -- Игрок взял предмет в инвентаре с verb=use или give. Показываем
        -- инструкцию + ✕ для отмены.
        show_armed_banner(self, message and message.item_name, message and message.verb)

    elseif message_id == hash("hide_armed_banner") then
        hide_armed_banner(self)
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    -- Кнопка ✕ на armed-баннере проверяется ПЕРВОЙ — она должна работать
    -- даже когда armed-режим (modal_open=false), и должна быть кликабельна
    -- надёжно при любом состоянии HUD.
    if self.armed_banner and gui.is_enabled(self.armed_banner.cancel_bg)
       and (point_in_node(self.armed_banner.cancel_bg, action)
            or point_in_node(self.armed_banner.cancel_label, action)) then
        msg.post(UI_MGR, "cancel_armed_inventory")
        gui.animate(self.armed_banner.cancel_bg, "scale", vmath.vector4(0.94, 0.94, 1, 1), gui.EASING_OUTQUAD, 0.08, 0,
            function()
                if self.armed_banner then
                    gui.animate(self.armed_banner.cancel_bg, "scale", vmath.vector4(1, 1, 1, 1), gui.EASING_OUTQUAD, 0.15)
                end
            end)
        return true
    end

    -- Не открываем новый оверлей поверх уже открытого
    if ui_state.modal_open then return false end

    local bag_ring = gui.get_node("bag_ring")
    local phn_ring = gui.get_node("phn_ring")
    ensure_log_button(self)

    if point_in_node(self.log_button, action) then
        msg.post(UI_MGR, "open_backlog")
        gui.animate(self.log_button, "scale", vmath.vector4(0.94, 0.94, 1, 1), gui.EASING_OUTQUAD, 0.08, 0,
            function() gui.animate(self.log_button, "scale", vmath.vector4(1, 1, 1, 1), gui.EASING_OUTQUAD, 0.15) end)
        return true
    end

    if point_in_node(bag_ring, action) then
        msg.post(UI_MGR, "open_inventory")
        -- визуальный фидбек
        gui.animate(bag_ring, "scale", vmath.vector4(0.94, 0.94, 1, 1), gui.EASING_OUTQUAD, 0.08, 0,
            function() gui.animate(bag_ring, "scale", vmath.vector4(1, 1, 1, 1), gui.EASING_OUTQUAD, 0.15) end)
        return true
    end

    if self.phone_enabled and point_in_node(phn_ring, action) then
        msg.post(UI_MGR, "open_phone")
        gui.animate(phn_ring, "scale", vmath.vector4(0.94, 0.94, 1, 1), gui.EASING_OUTQUAD, 0.08, 0,
            function() gui.animate(phn_ring, "scale", vmath.vector4(1, 1, 1, 1), gui.EASING_OUTQUAD, 0.15) end)
        return true
    end

    return false
end
