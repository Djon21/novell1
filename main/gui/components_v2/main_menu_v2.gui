  }
  type: TYPE_TEXT
  text: "\320\224\320\276\320\261\321\200\320\276 \320\277\320\276\320\266\320\260\320\273\320\276\320\262\320\260\321\202\321\214.\n"
  "\320\237\320\265\321\200\320\265\320\264 \320\262\320\260\320\274\320\270 \320\277\320\265\321\200\320\262\320\260\321\217 \320\276\321\202\320\272\321\200\321\213\321\202\320\260\321\217 \320\262\320\265\321\200\321\201\320\270\321\217 \320\270\320\263\321\200\321\213.\n"
  "\n"
  "\320\237\321\200\320\276\320\265\320\272\321\202 \320\265\321\211\321\221 \320\275\320\260\321\205\320\276\320\264\320\270\321\202\321\201\321\217 \320\262 \321\200\320\260\320\267\321\200\320\260\320\261\320\276\321\202\320\272\320\265: \321\207\320\260\321\201\321\202\321\214 \321\201\321\206\320\265\320\275, \320\274\320\265\321\205\320\260\320\275\320\270\320\272 \320\270 \320\264\320\265\321\202\320\260\320\273\320\265\320\271 \320\261\321\203\320\264\320\265\321\202 \320\264\320\276\321\200\320\260\320\261\320\260\321\202\321\213\320\262\320\260\321\202\321\214\321\201\321\217 \320\262 \321\201\320\273\320\265\320\264\321\203\321\216\321\211\320\270\321\205 \320\262\320\265\321\200\321\201\320\270\321\217\321\205. \320\241\320\265\320\271\321\207\320\260\321\201 \321\215\321\202\320\276 \320\277\320\265\321\200\320\262\321\213\320\271 \320\267\320\260\320\262\320\265\321\200\321\210\321\221\320\275\320\275\321\213\320\271 \321\204\321\200\320\260\320\263\320\274\320\265\320\275\321\202 \320\270\321\201\321\202\320\276\321\200\320\270\320\270, \321\201 \320\272\320\276\321\202\320\276\321\200\320\276\320\263\320\276 \320\275\320\260\321\207\320\270\320\275\320\260\320\265\321\202\321\201\321\217 \320\267\320\275\320\260\320\272\320\276\320\274\321\201\321\202\320\262\320\276 \321\201 \320\274\320\270\321\200\320\276\320\274, \320\277\320\265\321\200\321\201\320\276\320\275\320\260\320\266\320\260\320\274\320\270 \320\270 \320\277\320\265\321\202\320\273\321\221\320\271.\n"
  "\n"
  "\320\241\320\277\320\260\321\201\320\270\320\261\320\276, \321\207\321\202\320\276 \320\267\320\260\320\277\321\203\321\201\320\272\320\260\320\265\321\202\320\265 \321\215\321\202\321\203 \320\270\320\263\321\200\321\203 \321\203\320\266\320\265 \321\201\320\265\320\271\321\207\320\260\321\201.\n"
  "\320\235\320\260\320\264\320\265\321\216\321\201\321\214, \320\262\320\260\320\274 \320\261\321\203\320\264\320\265\321\202 \320\270\320\275\321\202\320\265\321\200\320\265\321\201\320\275\320\276 \320\275\320\260\320\261\320\273\321\216\320\264\320\260\321\202\321\214, \320\272\320\260\320\272 \320\276\320\261\321\213\321\207\320\275\321\213\320\271 \320\264\320\265\320\275\321\214 \320\277\320\276\321\201\321\202\320\265\320\277\320\265\320\275\320\275\320\276 \320\277\320\265\321\200\320\265\321\201\321\202\320\260\321\221\321\202 \320\261\321\213\321\202\321\214 \320\276\320\261\321\213\321\207\320\275\321\213\320\274."
  font: "manrope_16"
