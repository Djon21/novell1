  }
  type: TYPE_TEXT
  text: "\320\236\321\207\320\265\321\200\320\265\320\264\320\275\320\276\320\271 \320\277\320\276\320\275\320\265\320\264\320\265\320\273\321\214\320\275\320\270\320\272. \320\224\320\276\320\266\320\264\321\214, \320\272\320\276\321\204\320\265, \321\202\321\200\320\270 \320\275\320\265\320\277\321\200\320\276\321\207\320\270\321\202\320\260\320\275\320\275\321\213\321\205.\n"
