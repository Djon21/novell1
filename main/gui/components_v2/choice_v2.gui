}
background_color { x: 0.0 y: 0.0 z: 0.0 w: 0.0 }

nodes {
  position { x: 0.0 y: 0.0 z: 0.5 }
  size { x: 1280.0 y: 720.0 }
  color { x: 0.0 y: 0.0 z: 0.0 w: 0.55 }
  type: TYPE_BOX
  id: "backdrop"
  pivot: PIVOT_SW
  adjust_mode: ADJUST_MODE_STRETCH
  inherit_alpha: true
}

nodes {
  position { x: 140.0 y: 110.0 z: 0.61 }
  size { x: 680.0 y: 420.0 }
  color { x: 0.047 y: 0.039 z: 0.141 w: 0.98 }
  type: TYPE_BOX
  id: "modal"
