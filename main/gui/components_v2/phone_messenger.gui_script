-- phone_messenger.gui_script
-- Messenger app. Контакты-каталог (имя, аватар, тон) хранится в локальной
-- таблице CHATS ниже. Сообщения и unread приходят из game_state через
-- ink-теги # msg:add: / # msg:reply: / # msg:read: (см. INVENTORY_SYSTEM
-- и HOW_TO_WRITE_INK §4 — раздел телефон).

local gs = require "main.scripts.game_state"

local UI_MGR = "#ui_manager_v2"

local MAX_LIST_ROWS = 7
local MAX_BUBBLES = 8
local LIST_SCROLL_STEP = 1
local CHAT_SCROLL_STEP = 1

