-- phone_messenger.gui_script
-- Messenger app. Source of truth: game_state Messenger channel.
-- Runtime data comes from # msg:add: / # msg:reply: / # msg:read tags:
--   gs.get_msg_chats(), gs.get_msg(chat_id), gs.get_msg_unread(chat_id).
-- This GUI keeps only presentation metadata for known chat ids.

local gs = require "main.scripts.game_state"

local UI_MGR = "#ui_manager_v2"

local MAX_LIST_ROWS = 7
local MAX_BUBBLES = 8
local LIST_SCROLL_STEP = 1
local CHAT_SCROLL_STEP = 1

local COLORS = {
    paper = vmath.vector4(0.953, 0.925, 0.851, 1),
    dim = vmath.vector4(0.788, 0.753, 0.659, 1),
    dark = vmath.vector4(0.031, 0.024, 0.094, 1),
    card = vmath.vector4(0.078, 0.071, 0.204, 1),
    accent = vmath.vector4(0.490, 0.976, 1.000, 1),
    hot = vmath.vector4(1.000, 0.239, 0.498, 1),
    amber = vmath.vector4(1.000, 0.702, 0.278, 1),
    violet = vmath.vector4(0.690, 0.450, 1.000, 1),
    green = vmath.vector4(0.290, 0.870, 0.500, 1),
}

local NODE_IDS = {
    "messenger_runtime_root", "messenger_app_bg",
    "list_root", "msgr_title", "search_bg", "search_bt", "search_bb", "search_bl", "search_br", "search_icon", "search_text",
    "tab_all_bg", "tab_all_bt", "tab_all_bb", "tab_all_bl", "tab_all_br", "tab_all_text", "tab_all_count",
    "tab_unread_bg", "tab_unread_bt", "tab_unread_bb", "tab_unread_bl", "tab_unread_br", "tab_unread_text", "tab_unread_count",
    "list_divider", "list_scrollbar_track", "list_scrollbar_thumb", "list_footer_line", "list_footer_left", "list_footer_right",
    "chat_root", "back_bg", "back_bt", "back_bb", "back_bl", "back_br", "back_text",
    "head_av_bg", "head_av", "head_name", "head_status",
    "head_call_bg", "head_call_bt", "head_call_bb", "head_call_bl", "head_call_br", "head_call_text",
    "head_find_bg", "head_find_bt", "head_find_bb", "head_find_bl", "head_find_br", "head_find_text",
    "head_menu_bg", "head_menu_bt", "head_menu_bb", "head_menu_bl", "head_menu_br", "head_menu_text",
    "chat_header_line", "chat_scrollbar_track", "chat_scrollbar_thumb",
    "input_line", "attach_bg", "attach_bt", "attach_bb", "attach_bl", "attach_br", "attach_text",
    "input_bg", "input_bt", "input_bb", "input_bl", "input_br", "input_text",
    "send_bg", "send_bt", "send_bb", "send_bl", "send_br", "send_text",
    "chat_footer_line", "chat_footer_left", "chat_footer_right",
}

for i = 1, MAX_LIST_ROWS do
    local p = "chat" .. i
    table.insert(NODE_IDS, p .. "_bg")
    table.insert(NODE_IDS, p .. "_bt")
    table.insert(NODE_IDS, p .. "_bb")
    table.insert(NODE_IDS, p .. "_bl")
    table.insert(NODE_IDS, p .. "_br")
    table.insert(NODE_IDS, p .. "_av_bg")
    table.insert(NODE_IDS, p .. "_av")
    table.insert(NODE_IDS, p .. "_name")
    table.insert(NODE_IDS, p .. "_icons")
    table.insert(NODE_IDS, p .. "_preview")
    table.insert(NODE_IDS, p .. "_time")
    table.insert(NODE_IDS, p .. "_badge_bg")
    table.insert(NODE_IDS, p .. "_badge")
end

for i = 1, MAX_BUBBLES do
    local p = "bub" .. i
    table.insert(NODE_IDS, p .. "_bg")
    table.insert(NODE_IDS, p .. "_bt")
    table.insert(NODE_IDS, p .. "_bb")
    table.insert(NODE_IDS, p .. "_bl")
    table.insert(NODE_IDS, p .. "_br")
    table.insert(NODE_IDS, p .. "_text")
    table.insert(NODE_IDS, p .. "_stamp")
end

local CHAT_META = {
    nm        = { name = "Н. М.", av = "НМ", tone = "hot",    status = "был(а) в сети 5 мин назад" },
    loop      = { name = "loop_bot", av = "L", tone = "violet", status = "бот · работает в фоне", bot = true },
    prod      = { name = "Отдел · Прод", av = "ПР", tone = "amber", status = "группа · 12 участников", group = true },
    mila      = { name = "Мила", av = "МИ", tone = "green",  status = "в сети" },
    artem     = { name = "Артём", av = "АР", tone = "green",  status = "в сети" },
    metro     = { name = "Москва · Транспорт", av = "МР", tone = "default", status = "канал", muted = true },
    mama      = { name = "Мама", av = "М", tone = "violet", status = "была в сети недавно" },
    kgb       = { name = "КГБ-чат · соседи", av = "КН", tone = "dim", status = "группа", group = true },
    changelog = { name = "avos · changelog", av = "АВ", tone = "amber", status = "канал", channel = true },
}

local EMPTY_CHAT_ID = nil

local function get_node(id)
    local ok, n = pcall(gui.get_node, id)
    if ok then return n end
    return nil
end

local function set_node_enabled(id, enabled)
    local n = get_node(id)
    if n then gui.set_enabled(n, enabled) end
end

local function set_nodes_enabled(ids, enabled)
    for _, id in ipairs(ids) do set_node_enabled(id, enabled) end
end

local function set_text(id, value)
    local n = get_node(id)
    if n then gui.set_text(n, value or "") end
end

local function set_color(id, color, alpha)
    local n = get_node(id)
    if n then
        local c = vmath.vector4(color.x, color.y, color.z, alpha or color.w or 1)
        gui.set_color(n, c)
    end
end

local function set_alpha(id, alpha)
    local n = get_node(id)
    if n then gui.set_alpha(n, alpha) end
end

local function set_size_x(id, width)
    local n = get_node(id)
    if n then
        local s = gui.get_size(n)
        gui.set_size(n, vmath.vector3(width, s.y, s.z))
    end
end

local function get_pos(id)
    local n = get_node(id)
    if n then return gui.get_position(n) end
    return vmath.vector3(0, 0, 0)
end

local function set_pos_y(id, y)
    local n = get_node(id)
    if n then
        local p = gui.get_position(n)
        gui.set_position(n, vmath.vector3(p.x, y, p.z))
    end
end

local function set_pos_x(id, x)
    local n = get_node(id)
    if n then
        local p = gui.get_position(n)
        gui.set_position(n, vmath.vector3(x, p.y, p.z))
    end
end

local function clamp_text(s, limit)
    s = tostring(s or ""):gsub("\n", " ")
    limit = limit or 80
    if utf8 and utf8.len and utf8.len(s) and utf8.len(s) > limit then
        local out = ""
        local count = 0
        for _, cp in utf8.codes(s) do
            count = count + 1
            if count > limit - 3 then break end
            out = out .. utf8.char(cp)
        end
        return out .. "..."
    end
    if #s > limit then return s:sub(1, limit - 3) .. "..." end
    return s
end

local function tone_color(tone)
    if tone == "hot" then return COLORS.hot end
    if tone == "amber" then return COLORS.amber end
    if tone == "violet" then return COLORS.violet end
    if tone == "green" then return COLORS.green end
    return COLORS.accent
end

local function title_from_id(chat_id)
    local s = tostring(chat_id or "")
    if s == "" then return "—" end
    s = s:gsub("_", " "):gsub("%-", " ")
    return (s:gsub("(%S+)", function(word)
        return word:sub(1, 1):upper() .. word:sub(2)
    end))
end

local function make_avatar(name_or_id)
    local s = tostring(name_or_id or "?")
    local first = s:match("%S") or "?"
    local second = nil
    local words = {}
    for w in s:gmatch("%S+") do table.insert(words, w) end
    if #words >= 2 then
        second = words[2]:match("%S")
    else
        second = s:match("^%S+%s*(%S)")
    end
    local av = first .. (second or "")
    return clamp_text(av:upper(), 2)
end

local function get_meta(chat_id)
    local id = tostring(chat_id or "")
    local base = CHAT_META[id] or {}
    local out = {}
    for k, v in pairs(base) do out[k] = v end
    out.id = id
    out.name = out.name or title_from_id(id)
    out.av = out.av or make_avatar(out.name ~= "—" and out.name or id)
    out.tone = out.tone or "default"
    out.status = out.status or "в сети"
    return out
end

local function chat_unread(id)
    if not id or id == "" then return 0 end
    return (gs.get_msg_unread and tonumber(gs.get_msg_unread(id)) or 0) or 0
end

local function runtime_chat_ids()
    if gs.get_msg_chats then
        return gs.get_msg_chats() or {}
    end
    return {}
end

local function build_chat_list(self)
    local out = {}
    for _, id in ipairs(runtime_chat_ids()) do
        if self.filter ~= "unread" or chat_unread(id) > 0 then
            table.insert(out, id)
        end
    end
    return out
end

local function unread_total()
    return (gs.get_msg_unread_total and tonumber(gs.get_msg_unread_total()) or 0) or 0
end

local function last_runtime_message(chat_id)
    if not (gs.get_msg and chat_id) then return nil end
    local msgs = gs.get_msg(chat_id) or {}
    return msgs[#msgs]
end

local function preview_from_message(m)
    if not m then return "" end
    local text = tostring(m.text or "")
    if m.direction == "out" then
        text = "Я: " .. text
    end
    return text
end

local function set_border(prefix, color, alpha)
    for _, suffix in ipairs({ "_bt", "_bb", "_bl", "_br" }) do
        set_color(prefix .. suffix, color, alpha)
    end
end

local function set_row_enabled(i, enabled)
    local p = "chat" .. i
    for _, suffix in ipairs({ "_bg", "_bt", "_bb", "_bl", "_br", "_av_bg", "_av", "_name", "_icons", "_preview", "_time", "_badge_bg", "_badge" }) do
        set_node_enabled(p .. suffix, enabled)
    end
end

local function hide_rows()
    for i = 1, MAX_LIST_ROWS do set_row_enabled(i, false) end
end

local function render_tab(self)
    local all_count = #runtime_chat_ids()
    local unread = unread_total()
    set_text("tab_all_count", tostring(all_count))
    set_text("tab_unread_count", tostring(unread))
    local all_active = self.filter ~= "unread"
    set_color("tab_all_bg", all_active and COLORS.accent or COLORS.card, all_active and 0.15 or 0.60)
    set_color("tab_unread_bg", (not all_active) and COLORS.accent or COLORS.card, (not all_active) and 0.15 or 0.60)
    set_border("tab_all", all_active and COLORS.accent or COLORS.accent, all_active and 0.55 or 0.25)
    set_border("tab_unread", (not all_active) and COLORS.accent or COLORS.accent, (not all_active) and 0.55 or 0.25)
end

local function update_list_scrollbar(self, total)
    local track_h = 450
    local visible = MAX_LIST_ROWS
    if total <= visible then
        set_alpha("list_scrollbar_thumb", 0.18)
        set_size_x("list_scrollbar_thumb", 4)
        set_pos_y("list_scrollbar_thumb", 442)
        return
    end
    local ratio = visible / total
    local h = math.max(80, track_h * ratio)
    local max_off = math.max(1, total - visible)
    local travel = track_h - h
    local top_y = 92 + track_h - h
    local y = top_y - travel * ((self.list_offset or 0) / max_off)
    local n = get_node("list_scrollbar_thumb")
    if n then
        local s = gui.get_size(n)
        gui.set_size(n, vmath.vector3(s.x, h, s.z))
        local p = gui.get_position(n)
        gui.set_position(n, vmath.vector3(p.x, y, p.z))
        gui.set_alpha(n, 0.70)
    end
end

local function render_list(self)
    local ids = build_chat_list(self)
    self.visible_chat_ids = ids
    local total = #ids
    local max_offset = math.max(0, total - MAX_LIST_ROWS)
    self.list_offset = math.max(0, math.min(self.list_offset or 0, max_offset))
    hide_rows()
    render_tab(self)

    for slot = 1, MAX_LIST_ROWS do
        local id = ids[(self.list_offset or 0) + slot]
        if id then
            local p = "chat" .. slot
            local meta = get_meta(id)
            local tone = tone_color(meta.tone)
            local unread_n = chat_unread(id)
            local unread = unread_n > 0
            local last = last_runtime_message(id)
            set_row_enabled(slot, true)
            set_color(p .. "_bg", unread and COLORS.accent or COLORS.card, unread and 0.06 or 0.55)
            set_border(p, unread and COLORS.accent or COLORS.paper, unread and 0.30 or 0.10)
            set_color(p .. "_av_bg", tone, (meta.tone == "dim") and 0.10 or 0.20)
            set_color(p .. "_av", tone, 1)
            set_color(p .. "_name", unread and COLORS.accent or COLORS.paper, 1)
            set_text(p .. "_av", clamp_text(meta.av or "?", 2))
            set_text(p .. "_name", clamp_text(meta.name or id, 26))
            local icons = ""
            if meta.bot then icons = icons .. " BOT" end
            if meta.group then icons = icons .. " GRP" end
            if meta.channel then icons = icons .. " CH" end
            if meta.muted then icons = icons .. " MUTE" end
            set_text(p .. "_icons", icons)
            set_text(p .. "_preview", clamp_text(preview_from_message(last), 66))
            set_text(p .. "_time", last and last.time or "")
            if unread_n > 0 then
                set_node_enabled(p .. "_badge_bg", true)
                set_node_enabled(p .. "_badge", true)
                set_color(p .. "_badge_bg", meta.tone == "hot" and COLORS.hot or COLORS.accent, 1)
                set_text(p .. "_badge", tostring(unread_n))
            else
                set_node_enabled(p .. "_badge_bg", false)
                set_node_enabled(p .. "_badge", false)
            end
        end
    end
    set_text("list_footer_left", "messenger · runtime channel")
    if total == 0 then
        if self.filter == "unread" then
            set_text("list_footer_right", "нет непрочитанных")
        else
            set_text("list_footer_right", "нет сообщений · # msg:add")
        end
    else
        local first = math.min(total, (self.list_offset or 0) + 1)
        local last = math.min(total, (self.list_offset or 0) + MAX_LIST_ROWS)
        set_text("list_footer_right", "показаны: " .. tostring(first) .. "-" .. tostring(last) .. " / " .. tostring(total))
    end
    update_list_scrollbar(self, total)
end

local function set_bubble_enabled(i, enabled)
    local p = "bub" .. i
    for _, suffix in ipairs({ "_bg", "_bt", "_bb", "_bl", "_br", "_text", "_stamp" }) do
        set_node_enabled(p .. suffix, enabled)
    end
end

local function hide_bubbles()
    for i = 1, MAX_BUBBLES do set_bubble_enabled(i, false) end
end

-- Конвертирует runtime-сообщения из game_state в формат bubble-renderer.
-- Отличия от SMS-вида: исходящие получают галочки read-receipt (✓✓),
-- в начало вставляется day-separator с именем чата для атмосферы.
local function runtime_msgs_to_ui(chat_id, raw)
    local out = {}
    local meta = get_meta(chat_id)
    if raw and #raw > 0 then
        -- Day-separator как «шапка» чата — выделяет messenger от плоского
        -- SMS-списка. Текст «сегодня» — простой и универсальный.
        table.insert(out, { type = "daysep", text = "сегодня" })
    end
    for _, m in ipairs(raw or {}) do
        local entry = {
            dir  = m.direction or "in",
            text = m.text or "",
            time = m.time or "",
            tone = meta.tone,
        }
        if entry.dir == "out" then
            -- Read receipt: пока всегда «прочитано» (получатель — NPC,
            -- ink-сценарий обычно отвечает сразу через # msg:add:).
            -- Можно сделать гейт по флагу msg_<chat>_replied позже.
            entry.status = "✓✓"
        end
        table.insert(out, entry)
    end
    return out
end

local function get_messages(chat_id)
    if not (chat_id and gs.get_msg) then return {} end
    return runtime_msgs_to_ui(chat_id, gs.get_msg(chat_id) or {})
end

local function update_chat_scrollbar(self, total)
    local track_h = 430
    local visible = MAX_BUBBLES
    if total <= visible then
        set_alpha("chat_scrollbar_thumb", 0.18)
        return
    end
    local ratio = visible / total
    local h = math.max(80, track_h * ratio)
    local max_off = math.max(1, total - visible)
    local travel = track_h - h
    local top_y = 148 + track_h - h
    local y = top_y - travel * ((self.chat_offset or 0) / max_off)
    local n = get_node("chat_scrollbar_thumb")
    if n then
        local s = gui.get_size(n)
        gui.set_size(n, vmath.vector3(s.x, h, s.z))
        local p = gui.get_position(n)
        gui.set_position(n, vmath.vector3(p.x, y, p.z))
        gui.set_alpha(n, 0.70)
    end
end

local function render_chat(self)
    local id = self.active_chat_id
    if not id then return end
    local meta = get_meta(id)
    set_text("head_av", clamp_text(meta.av or "?", 2))
    set_text("head_name", clamp_text(meta.name or id, 28))
    set_text("head_status", meta.status or "в сети")
    local tone = tone_color(meta.tone)
    set_color("head_av_bg", tone, 0.20)
    set_color("head_av", tone, 1)
    local msgs = get_messages(id)
    local total = #msgs
    local max_offset = math.max(0, total - MAX_BUBBLES)
    self.chat_offset = math.max(0, math.min(self.chat_offset or max_offset, max_offset))
    hide_bubbles()

    for slot = 1, MAX_BUBBLES do
        local m = msgs[(self.chat_offset or 0) + slot]
        if m then
            local p = "bub" .. slot
            set_bubble_enabled(slot, true)
            local is_out = m.dir == "out"
            local is_sep = m.type == "daysep" or m.type == "sys"
            local color = is_out and COLORS.accent or tone_color(m.tone or meta.tone)
            if is_sep then
                set_color(p .. "_bg", COLORS.paper, m.type == "daysep" and 0.08 or 0.0)
                set_border(p, COLORS.paper, 0.0)
                set_color(p .. "_text", COLORS.dim, 0.78)
                set_text(p .. "_text", clamp_text((m.text or ""):upper(), 68))
                set_text(p .. "_stamp", "")
                set_pos_x(p .. "_bg", 610)
                set_pos_x(p .. "_text", 624)
                set_pos_x(p .. "_stamp", 1010)
                set_size_x(p .. "_bg", 380)
                set_size_x(p .. "_text", 340)
            else
                local x = is_out and 686 or 540
                local w = is_out and 500 or 560
                set_pos_x(p .. "_bg", x)
                set_pos_x(p .. "_text", x + 14)
                set_pos_x(p .. "_stamp", x + w - 12)
                set_size_x(p .. "_bg", w)
                set_size_x(p .. "_text", w - 28)
                set_color(p .. "_bg", is_out and COLORS.accent or COLORS.card, is_out and 0.12 or 0.70)
                set_border(p, color, is_out and 0.45 or 0.28)
                set_color(p .. "_text", COLORS.paper, 1)
                set_text(p .. "_text", clamp_text(m.text or "", is_out and 72 or 80))
                local stamp = tostring(m.time or "")
                if is_out and m.status then stamp = stamp .. " · " .. tostring(m.status):upper() end
                set_text(p .. "_stamp", stamp)
                set_color(p .. "_stamp", is_out and COLORS.accent or COLORS.dim, 0.80)
            end
        end
    end
    update_chat_scrollbar(self, total)
end

local function set_view(self, view)
    self.view = view or "list"
    local show_list = self.view == "list"
    set_node_enabled("list_root", show_list)
    set_node_enabled("chat_root", not show_list)
    set_node_enabled("messenger_runtime_root", true)
    set_node_enabled("messenger_app_bg", true)
    if show_list then render_list(self) else render_chat(self) end
end

local function open_list(self)
    self.active_chat_id = nil
    set_view(self, "list")
end

local function open_chat(self, chat_id)
    if not chat_id then return end
    self.active_chat_id = chat_id
    self.chat_offset = nil
    -- runtime: помечаем чат прочитанным (auto-flag msg_<chat>_read)
    if gs.mark_msg_read then gs.mark_msg_read(chat_id) end
    -- Если у автора есть ink-knot msg_thread_<chat> и игрок ещё не отвечал
    -- (msg_<chat>_replied != true), ui_manager_v2 закроет телефон и
    -- прыгнет в knot для интерактивного ответа. Если knot'а нет или уже
    -- ответили — ui_manager игнорирует, inline-вид остаётся открытым.
    msg.post(UI_MGR, "messenger_open_chat", { chat_id = chat_id })
    set_view(self, "chat")
end

local function is_inside_rect(id, x, y)
    local n = get_node(id)
    if not n or not gui.is_enabled(n) then return false end
    return gui.pick_node(n, x, y)
end

local function handle_send_stub(self)
    if not self.active_chat_id then return end
    print("[phone_messenger] TODO send_message runtime hook for", self.active_chat_id)
    -- Intentionally do not mutate local mock data. Future implementation should
    -- call gs.reply_msg(chat_id, text) or route into msg_thread_<chat_id> Ink.
end

local function handle_scroll(self, action)
    local dy = tonumber(action.dy or action.value or 0) or 0
    if dy == 0 then return false end
    if self.view == "list" then
        local ids = build_chat_list(self)
        local max_offset = math.max(0, #ids - MAX_LIST_ROWS)
        self.list_offset = math.max(0, math.min((self.list_offset or 0) + (dy < 0 and LIST_SCROLL_STEP or -LIST_SCROLL_STEP), max_offset))
        render_list(self)
        return true
    elseif self.view == "chat" then
        local total = #get_messages(self.active_chat_id)
        local max_offset = math.max(0, total - MAX_BUBBLES)
        self.chat_offset = math.max(0, math.min((self.chat_offset or max_offset) + (dy < 0 and CHAT_SCROLL_STEP or -CHAT_SCROLL_STEP), max_offset))
        render_chat(self)
        return true
    end
    return false
end

local function handle_phone_input(self, action_id, action)
    if not self.visible then return false end
    action = action or {}
    if action_id == hash("wheel_up") then
        action.dy = 1
        return handle_scroll(self, action)
    elseif action_id == hash("wheel_down") then
        action.dy = -1
        return handle_scroll(self, action)
    end
    -- Дальше обрабатываем только клики (pressed/released). Просто
    -- движение мыши без клика игнорируем — иначе любой mouse_move
    -- с ненулевым dy вызывал бы прокрутку.
    if not action.released and not action.pressed then return false end
    local x, y = action.x or 0, action.y or 0

    if self.view == "list" then
        if is_inside_rect("tab_all_bg", x, y) then
            self.filter = "all"
            self.list_offset = 0
            render_list(self)
            return true
        elseif is_inside_rect("tab_unread_bg", x, y) then
            self.filter = "unread"
            self.list_offset = 0
            render_list(self)
            return true
        end
        for i = 1, MAX_LIST_ROWS do
            if is_inside_rect("chat" .. i .. "_bg", x, y) then
                local id = self.visible_chat_ids and self.visible_chat_ids[(self.list_offset or 0) + i]
                if id then open_chat(self, id) end
                return true
            end
        end
    else
        if is_inside_rect("back_bg", x, y) then
            open_list(self)
            return true
        elseif is_inside_rect("send_bg", x, y) or is_inside_rect("input_bg", x, y) then
            handle_send_stub(self)
            return true
        elseif is_inside_rect("attach_bg", x, y) then
            print("[phone_messenger] TODO attach runtime hook")
            return true
        end
    end
    return false
end

local function set_all_enabled(enabled)
    set_nodes_enabled(NODE_IDS, enabled)
end

function init(self)
    self.visible = false
    self.view = "list"
    self.filter = "all"
    self.list_offset = 0
    self.chat_offset = 0
    set_all_enabled(false)
end

function final(self)
    set_all_enabled(false)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_app") then
        self.visible = true
        self.filter = self.filter or "all"
        self.list_offset = self.list_offset or 0
        set_all_enabled(true)
        open_list(self)
    elseif message_id == hash("close_app") then
        self.visible = false
        self.view = "list"
        self.active_chat_id = nil
        set_all_enabled(false)
    elseif message_id == hash("refresh_app") then
        if self.visible then set_view(self, self.view or "list") end
    elseif message_id == hash("phone_input") then
        -- Defold: on_message не должна возвращать значения. handle_phone_input
        -- возвращает bool (consumed-флаг для on_input), но здесь на ветке
        -- сообщения он нам не нужен — просто игнорируем результат.
        if self.visible then
            handle_phone_input(self, message and message.action_id or hash("touch"), {
                x = message and message.x or 0,
                y = message and message.y or 0,
                dx = message and message.dx or 0,
                dy = message and message.dy or 0,
                value = message and message.value or 0,
                pressed = message and message.pressed or false,
                released = message and message.released or false,
            })
        end
    end
end

function on_input(self, action_id, action)
    return handle_phone_input(self, action_id, action or {})
end
