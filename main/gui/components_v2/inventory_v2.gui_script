-- inventory_v2.gui_script
-- Step26: fullscreen modal inventory, fully static (rule 2 — no dynamic parenting).
-- All nodes (12 slots + 5 verb buttons + details + corner brackets) are
-- declared in inventory_v2.gui. This script only drives:
--   * enabling/disabling the modal root group
--   * filling slot text/color from gs.get_inventory() + items_catalog
--   * selection highlight (colored border)
--   * details panel population for the selected item
--   * click handlers: close, slot click, verb click
--
-- Incoming messages:
--   "show_inventory"      — open + refresh
--   "hide_inventory"      — close
--   "refresh_inventory"   — re-pull data from game_state (silent if hidden)
--
-- Outgoing messages (to #ui_manager_v2):
--   "close_inventory"
--   "inventory_verb" { item_id = <id>, verb = <verb_name> }
--
-- Rules used: 1 (inherit_alpha:false everywhere), 2 (no dynamic parenting),
-- 4 (explicit z in .gui), 9 (acquire_input_focus), 10 (early return on hidden),
-- 12 (line_break on details_desc).

local catalog = require "main.scripts.items_catalog"
local gs      = require "main.scripts.game_state"

local UI_MGR = "#ui_manager_v2"

local SLOT_COUNT = gs.MAX_INVENTORY_SLOTS or 12
local VERB_COUNT = 5
local ACTIVE_VERBS = {
    use = true,
    inspect = true,
    read = true,
}

-- Full set of chrome nodes that comprise the modal. Toggled on/off when the
-- modal opens/closes. Slot & verb nodes are handled separately (see below).
local CHROME_NODES = {
    "backdrop", "modal",
    "modal_border_top", "modal_border_bot",
    "corner_tl_v", "corner_tl_h",
    "corner_tr_v", "corner_tr_h",
    "corner_bl_v", "corner_bl_h",
    "corner_br_v", "corner_br_h",
    "title_eyebrow", "title_main",
    "stats_slots", "stats_weight", "stats_loop",
    "close_btn",
    "head_divider", "foot_divider",
    "foot_left", "foot_right",
    "details_bg", "details_border_top",
    "details_cap", "details_name",
    "details_iter", "details_clue",
    "details_preview_bg", "details_preview_top", "details_preview_bot",
    "details_icon", "details_desc",
    "details_stats_divider",
    "stat_src_k", "stat_src_v",
    "stat_iter_k", "stat_iter_v",
    "stat_type_k", "stat_type_v",
    "stat_clue_k", "stat_clue_v",
    "details_verbs_divider",
}

-- Colors (mirror the v2 palette used in .gui).
local COLOR_PAPER       = vmath.vector4(0.952, 0.925, 0.850, 1.00)
local COLOR_PAPER_DIM   = vmath.vector4(0.952, 0.925, 0.850, 0.55)
local COLOR_ACCENT      = vmath.vector4(0.490, 0.976, 1.000, 1.00)
local COLOR_ACCENT_DIM  = vmath.vector4(0.490, 0.976, 1.000, 0.35)
local COLOR_HOT         = vmath.vector4(1.000, 0.239, 0.498, 1.00)
local COLOR_AMBER       = vmath.vector4(1.000, 0.702, 0.278, 1.00)
local COLOR_VIOLET      = vmath.vector4(0.478, 0.361, 1.000, 1.00)

-- Empty-slot styling: dashed placeholder (low alpha) per brief.
local COLOR_EMPTY_BG     = vmath.vector4(0.067, 0.055, 0.173, 0.45)
local COLOR_EMPTY_BORDER = vmath.vector4(0.952, 0.925, 0.850, 0.08)
local COLOR_EMPTY_COORD  = vmath.vector4(0.952, 0.925, 0.850, 0.25)

-- Filled-slot styling.
local COLOR_SLOT_BG      = vmath.vector4(0.067, 0.055, 0.173, 0.90)
local COLOR_SLOT_BORDER  = vmath.vector4(0.490, 0.976, 1.000, 0.35)
local COLOR_SLOT_COORD   = vmath.vector4(0.952, 0.925, 0.850, 0.40)

-- Selected-slot styling: bright border + paper accents.
local COLOR_SEL_BORDER   = vmath.vector4(0.952, 0.925, 0.850, 1.00)
local COLOR_SEL_BG       = vmath.vector4(0.110, 0.090, 0.260, 0.95)

-- Verb button palette.
local COLOR_VERB_LABEL_ON  = COLOR_ACCENT
local COLOR_VERB_LABEL_OFF = vmath.vector4(0.952, 0.925, 0.850, 0.25)
local COLOR_VERB_BORDER_ON  = vmath.vector4(0.490, 0.976, 1.000, 0.50)
local COLOR_VERB_BORDER_OFF = vmath.vector4(0.952, 0.925, 0.850, 0.10)

-- Verb label text per HTML design.
local VERB_LABEL = {
    use     = "ИСПОЛЬЗОВАТЬ",
    inspect = "ОСМОТРЕТЬ",
    combine = "СОЕДИНИТЬ",
    read    = "ПРОЧИТАТЬ",
    give    = "ОТДАТЬ",
}

-- Fixed order of verb buttons in the footer (matches .gui verb1..verb5).
local VERB_ORDER = { "use", "inspect", "combine", "read", "give" }

-- Color per item type (paper = consumable, amber = key, hot = clue, violet = rare).
local function color_for_type(t, is_clue)
    if is_clue then return COLOR_HOT end
    if t == "ключ"    then return COLOR_AMBER end
    if t == "улика"   then return COLOR_HOT end
    if t == "редкий"  then return COLOR_VIOLET end
    return COLOR_PAPER
end

local function n(id)           return gui.get_node(id) end
local function set_text(id, s) gui.set_text(n(id), s or "") end
local function set_color(id, c) gui.set_color(n(id), c) end
local function set_enabled(id, b) gui.set_enabled(n(id), b) end

local function set_group_enabled(ids, enabled)
    for _, id in ipairs(ids) do
        gui.set_enabled(n(id), enabled)
    end
end

-- ---------------------------------------------------------------------------
-- Slot handling: each slot has 5 sub-nodes: slotN_bg, slotN_border, slotN_coord,
-- slotN_icon, slotN_name, slotN_qty. All static, defined in .gui.
-- ---------------------------------------------------------------------------

local function slot_nodes(i)
    return {
        bg     = n("slot" .. i .. "_bg"),
        border = n("slot" .. i .. "_border"),
        coord  = n("slot" .. i .. "_coord"),
        icon   = n("slot" .. i .. "_icon"),
        name   = n("slot" .. i .. "_name"),
        qty    = n("slot" .. i .. "_qty"),
    }
end

local function set_slot_enabled(i, enabled)
    local s = slot_nodes(i)
    gui.set_enabled(s.bg,     enabled)
    gui.set_enabled(s.border, enabled)
    gui.set_enabled(s.coord,  enabled)
    gui.set_enabled(s.icon,   enabled)
    gui.set_enabled(s.name,   enabled)
    gui.set_enabled(s.qty,    enabled)
end

-- Style a slot as "empty placeholder": dim background, no icon/name, keep coord dim.
local function paint_slot_empty(i)
    local s = slot_nodes(i)
    gui.set_color(s.bg,     COLOR_EMPTY_BG)
    gui.set_color(s.border, COLOR_EMPTY_BORDER)
    gui.set_color(s.coord,  COLOR_EMPTY_COORD)
    gui.set_text(s.icon, "")
    gui.set_text(s.name, "—")
    gui.set_color(s.name, vmath.vector4(0.952, 0.925, 0.850, 0.30))
    gui.set_text(s.qty,  "")
end

-- Style a slot as "filled": bright icon, name, optional qty badge.
local function paint_slot_filled(i, item, selected)
    local s = slot_nodes(i)
    gui.set_color(s.bg,     selected and COLOR_SEL_BG     or COLOR_SLOT_BG)
    gui.set_color(s.border, selected and COLOR_SEL_BORDER or COLOR_SLOT_BORDER)
    gui.set_color(s.coord,  COLOR_SLOT_COORD)
    gui.set_text(s.icon, item.icon or "")
    gui.set_color(s.icon, color_for_type(item.type, item.clue == "да"))
    gui.set_text(s.name, (item.name or ""):upper())
    gui.set_color(s.name, COLOR_PAPER)
    local q = item.qty or 1
    if q > 1 then
        gui.set_text(s.qty, "x" .. tostring(q))
    else
        gui.set_text(s.qty, "")
    end
end

-- ---------------------------------------------------------------------------
-- Verb button handling: verbN_bg, verbN_border, verbN_label.
-- ---------------------------------------------------------------------------

local function verb_nodes(i)
    return {
        bg     = n("verb" .. i .. "_bg"),
        border = n("verb" .. i .. "_border"),
        label  = n("verb" .. i .. "_label"),
    }
end

local function set_verb_enabled(i, enabled)
    local v = verb_nodes(i)
    gui.set_enabled(v.bg,     enabled)
    gui.set_enabled(v.border, enabled)
    gui.set_enabled(v.label,  enabled)
end

-- When open but no item selected, show all 5 verb buttons in disabled style
-- so the layout still reads as a verb row.
local function paint_verb(i, available)
    local v = verb_nodes(i)
    local name = VERB_ORDER[i]
    gui.set_text(v.label, VERB_LABEL[name] or (name or ""):upper())
    if available then
        gui.set_color(v.label,  COLOR_VERB_LABEL_ON)
        gui.set_color(v.border, COLOR_VERB_BORDER_ON)
    else
        gui.set_color(v.label,  COLOR_VERB_LABEL_OFF)
        gui.set_color(v.border, COLOR_VERB_BORDER_OFF)
    end
end

-- ---------------------------------------------------------------------------
-- Details panel.
-- ---------------------------------------------------------------------------

local function clear_details(self)
    set_text("details_cap",  "details · предмет")
    set_text("details_name", "Выберите предмет")
    set_text("details_iter", "")
    set_text("details_clue", "")
    set_text("details_icon", "")
    set_text("details_desc", "Выбери предмет в сетке слева. Каждый несёт след одной из прошлых итераций.")
    set_text("stat_src_v",   "—")
    set_text("stat_iter_v",  "—")
    set_text("stat_type_v",  "—")
    set_text("stat_clue_v",  "—")
    -- all verbs disabled, but visible as placeholders
    self.available_verbs = {}
    for i = 1, VERB_COUNT do
        paint_verb(i, false)
    end
end

local function show_item_details(self, item_id)
    local item = catalog.get_runtime(item_id)
    if not item then clear_details(self); return end

    set_text("details_cap",  "details · " .. (item.type or "предмет"))
    set_text("details_name", (item.name or ""):upper())
    set_text("details_iter", "итер. " .. (item.iter or "—"))
    if item.clue == "да" then
        set_text("details_clue", "УЛИКА")
    else
        set_text("details_clue", "")
    end
    set_text("details_icon", item.icon or "")
    set_color("details_icon", color_for_type(item.type, item.clue == "да"))
    set_text("details_desc", item.desc or item.description or "")
    set_text("stat_src_v",  item.source or "—")
    set_text("stat_iter_v", item.iter   or "—")
    set_text("stat_type_v", item.type   or "—")
    set_text("stat_clue_v", item.clue   or "—")

    -- figure which of the 5 verbs are available for this item
    local avail = {}
    for _, v in ipairs(item.verbs or {}) do
        if ACTIVE_VERBS[v] then
            avail[v] = true
        end
    end
    self.available_verbs = avail
    for i = 1, VERB_COUNT do
        paint_verb(i, avail[VERB_ORDER[i]] == true)
    end
end

-- ---------------------------------------------------------------------------
-- Refresh: rebuild slot contents from gs.get_inventory().
-- ---------------------------------------------------------------------------

local function refresh(self)
    local inv = gs.get_inventory() or {}
    self.inv_ids = {}
    local used = #inv
    for i = 1, SLOT_COUNT do
        local id = inv[i]
        local item = id and catalog.get_runtime(id)
        if item then
            self.inv_ids[i] = id
            paint_slot_filled(i, item, self.selected == i)
        else
            self.inv_ids[i] = nil
            paint_slot_empty(i)
        end
    end
    set_text("stats_slots", "слотов: " .. tostring(used) .. "/" .. tostring(SLOT_COUNT))

    -- drop a stale selection (item removed), re-pick first if nothing selected
    if self.selected and not self.inv_ids[self.selected] then
        self.selected = nil
    end
    if not self.selected then
        for i = 1, SLOT_COUNT do
            if self.inv_ids[i] then self.selected = i; break end
        end
    end

    if self.selected then
        -- re-paint selected slot with selection colors
        paint_slot_filled(self.selected, catalog.get_runtime(self.inv_ids[self.selected]), true)
        show_item_details(self, self.inv_ids[self.selected])
    else
        clear_details(self)
    end
end

-- ---------------------------------------------------------------------------
-- Enable / disable the whole modal.
-- ---------------------------------------------------------------------------

local function set_modal_enabled(self, enabled)
    set_group_enabled(CHROME_NODES, enabled)
    for i = 1, SLOT_COUNT do set_slot_enabled(i, enabled) end
    for i = 1, VERB_COUNT do set_verb_enabled(i, enabled) end
end

-- ---------------------------------------------------------------------------
-- Lifecycle.
-- ---------------------------------------------------------------------------

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible         = false
    self.selected        = nil
    self.inv_ids         = {}
    self.available_verbs = {}
    set_modal_enabled(self, false)
    -- Legacy selection-ring static nodes from earlier layout: unused by the
    -- current implementation (selection is shown via border color). Keep them
    -- permanently disabled so they never flash onto slot1.
    gui.set_enabled(n("sel_ring_b"), false)
    gui.set_enabled(n("sel_ring_t"), false)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("show_inventory") then
        self.visible = true
        set_modal_enabled(self, true)
        refresh(self)
    elseif message_id == hash("hide_inventory") then
        self.visible = false
        set_modal_enabled(self, false)
    elseif message_id == hash("refresh_inventory") then
        if self.visible then refresh(self) end
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    -- close button
    if gui.is_enabled(n("close_btn")) and gui.pick_node(n("close_btn"), action.x, action.y) then
        msg.post(UI_MGR, "close_inventory")
        return true
    end

    -- slot click: only slots that actually hold an item register a click
    for i = 1, SLOT_COUNT do
        local bg = n("slot" .. i .. "_bg")
        if self.inv_ids[i] and gui.is_enabled(bg) and gui.pick_node(bg, action.x, action.y) then
            local prev = self.selected
            self.selected = i
            -- repaint prev + new to update highlight
            if prev and self.inv_ids[prev] then
                paint_slot_filled(prev, catalog.get_runtime(self.inv_ids[prev]), false)
            end
            paint_slot_filled(i, catalog.get_runtime(self.inv_ids[i]), true)
            show_item_details(self, self.inv_ids[i])
            return true
        end
    end

    -- verb clicks: only act if the verb is available for the current item
    if self.selected and self.inv_ids[self.selected] then
        for i = 1, VERB_COUNT do
            local bg = n("verb" .. i .. "_bg")
            local vname = VERB_ORDER[i]
            if vname and self.available_verbs[vname]
               and gui.is_enabled(bg) and gui.pick_node(bg, action.x, action.y) then
                msg.post(UI_MGR, "inventory_verb", {
                    item_id = self.inv_ids[self.selected],
                    verb    = vname,
                })
                return true
            end
        end
    end

    -- click inside modal chrome: consume so it doesn't fall through to
    -- hotspots/nav underneath
    if gui.is_enabled(n("modal")) and gui.pick_node(n("modal"), action.x, action.y) then
        return true
    end
    if gui.is_enabled(n("backdrop")) and gui.pick_node(n("backdrop"), action.x, action.y) then
        -- click on dim backdrop closes (matches phone_v2 convention).
        msg.post(UI_MGR, "close_inventory")
        return true
    end
    return false
end
