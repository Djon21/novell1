-- phone_notes.gui_script
-- Улики / заметки в составе split-телефона.
-- Принимает: open_app, close_app, refresh_app

local gs = require "main.scripts.game_state"
local U  = require "main.gui.modules.gui_utils"

local COLOR_CYAN      = vmath.vector4(0.47, 0.94, 1.00, 1.0)
local COLOR_PAPER_DIM = vmath.vector4(0.80, 0.80, 0.78, 0.7)

local NODE_IDS = {
    "notes_runtime_root",
    "clues_screen_bg", "clues_header_line",
    "clues_card1_card", "clues_card1_accent",
    "clues_card2_card", "clues_card2_accent",
    "clues_footer_line",
    "v_clues_eyebrow", "v_clues_title",
    "v_clues_card1_bg", "v_clues_card1_tag", "v_clues_card1_body",
    "v_clues_card2_bg", "v_clues_card2_tag", "v_clues_card2_body",
}

local CLUE_SLOTS = 2

local get_node         = U.get_node
local set_node_enabled = U.set_node_enabled
local set_text         = U.set_text
local set_node_color   = U.set_color  -- vector4 с .w → используется как есть

local function set_nodes_enabled(enabled)
    U.set_nodes_enabled(NODE_IDS, enabled)
end

local function refresh(self)
    local list = gs.get_clues and gs.get_clues() or {}
    if #list == 0 then
        set_node_enabled("v_clues_card1_bg",   true)
        set_node_enabled("v_clues_card1_tag",  true)
        set_node_enabled("v_clues_card1_body", true)
        set_text("v_clues_card1_tag",  "улики")
        set_text("v_clues_card1_body", "пока пусто")
        set_node_color("v_clues_card1_tag", COLOR_PAPER_DIM)
        set_node_enabled("v_clues_card2_bg",   false)
        set_node_enabled("v_clues_card2_tag",  false)
        set_node_enabled("v_clues_card2_body", false)
        return
    end
    for i = 1, CLUE_SLOTS do
        local prefix = "v_clues_card" .. i
        local has = list[i] ~= nil
        set_node_enabled(prefix .. "_bg",   has)
        set_node_enabled(prefix .. "_tag",  has)
        set_node_enabled(prefix .. "_body", has)
        if has then
            local cl = list[i]
            set_text(prefix .. "_tag",  cl.id or "—")
            set_text(prefix .. "_body", cl.label or "")
            set_node_color(prefix .. "_tag", COLOR_CYAN)
        end
    end
end

function init(self)
    self.visible = false

    U.apply_adaptive_layout("notes_runtime_root")

    set_nodes_enabled(false)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_app") then
        self.visible = true
        set_nodes_enabled(true)
        refresh(self)
    elseif message_id == hash("close_app") then
        self.visible = false
        set_nodes_enabled(false)
    elseif message_id == hash("refresh_app") then
        if self.visible then refresh(self) end
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    return false
end
