-- phone_cam.gui_script
-- Камера в составе split-телефона.
-- Принимает: open_app, close_app, refresh_app

local gs = require "main.scripts.game_state"

local COLOR_CYAN      = vmath.vector4(0.47, 0.94, 1.00, 1.0)
local COLOR_PAPER_DIM = vmath.vector4(0.80, 0.80, 0.78, 0.7)
local COLOR_HOT       = vmath.vector4(1.00, 0.30, 0.30, 1.0)

local NODE_IDS = {
    "v_cam_eyebrow", "v_cam_title",
    "v_cam_screen", "v_cam_msg", "v_cam_meta",
}

local function get_node(id)
    local ok, n = pcall(gui.get_node, id)
    if ok then return n end
    return nil
end

local function set_node_enabled(id, enabled)
    local n = get_node(id)
    if n then gui.set_enabled(n, enabled) end
end

local function set_nodes_enabled(enabled)
    for _, id in ipairs(NODE_IDS) do
        set_node_enabled(id, enabled)
    end
end

local function set_text(id, s)
    local n = get_node(id)
    if n then gui.set_text(n, s or "") end
end

local function set_node_color(id, c)
    local n = get_node(id)
    if n then gui.set_color(n, c) end
end

local function refresh(self)
    local feed   = gs.get_camera_feed and gs.get_camera_feed() or {}
    local status = feed.status or "offline"
    set_text("v_cam_msg",  feed.message or "NO SIGNAL")
    set_text("v_cam_meta", feed.meta    or "CAM · offline")
    local col = COLOR_PAPER_DIM
    if     status == "online" then col = COLOR_CYAN
    elseif status == "error"  then col = COLOR_HOT end
    set_node_color("v_cam_msg", col)
end

function init(self)
    self.visible = false
    set_nodes_enabled(false)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_app") then
        self.visible = true
        set_nodes_enabled(true)
        refresh(self)
    elseif message_id == hash("close_app") then
        self.visible = false
        set_nodes_enabled(false)
    elseif message_id == hash("refresh_app") then
        if self.visible then refresh(self) end
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    return false
end
