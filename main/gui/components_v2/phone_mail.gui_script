-- phone_mail.gui_script
-- Почта в составе split-телефона.
-- Minimal rich layout ported from phone_app_mail_defold.html.
-- Runtime rules:
--   - app script does not acquire input focus;
--   - phone_v2_root forwards phone_input to the active app;
--   - mail rows support wheel/touch-drag scrolling when list is longer than visible slots.

local gs = require "main.scripts.game_state"
local drag_scroll = require "main.gui.modules.drag_scroll"
local U = require "main.gui.modules.gui_utils"

local MAX_MAIL_SLOTS = 7
local SCROLL_STEP_ROWS = 3
local DRAG_THRESHOLD_PX = 8
local DRAG_STEP_PX = 34
local ROW_H = 63
local ROW_GAP = 0

local COLORS = {
    paper     = vmath.vector4(0.953, 0.925, 0.851, 1),
    paper_dim = vmath.vector4(0.788, 0.753, 0.659, 1),
    accent    = vmath.vector4(0.490, 0.976, 1.000, 1),
    hot       = vmath.vector4(1.000, 0.239, 0.498, 1),
    amber     = vmath.vector4(1.000, 0.702, 0.278, 1),
    violet    = vmath.vector4(0.690, 0.455, 1.000, 1),
    green     = vmath.vector4(0.290, 0.870, 0.500, 1),
    dark      = vmath.vector4(0.031, 0.024, 0.094, 1),
    card      = vmath.vector4(0.078, 0.071, 0.204, 1),
    card_hot  = vmath.vector4(0.140, 0.034, 0.115, 1),
}

local NODE_IDS = {
    "mail_runtime_root", "v_mail_bg", "v_mail_head_bg",
    "v_mail_eyebrow", "v_mail_title", "v_mail_compose_bg", "v_mail_compose_text",
    "v_mail_tab_inbox_bg", "v_mail_tab_inbox_text",
    "v_mail_tab_important_bg", "v_mail_tab_important_text",
    "v_mail_tab_promo_bg", "v_mail_tab_promo_text",
    "v_mail_tab_spam_bg", "v_mail_tab_spam_text",
    "v_mail_tab_sent_bg", "v_mail_tab_sent_text",
    "v_mail_divider", "v_mail_list_clip", "v_mail_scroll_track", "v_mail_scroll_thumb",
    "v_mail_foot_line", "v_mail_footer_left", "v_mail_footer_right",
}

local ROW_SUFFIXES = {
    "_bg", "_accent", "_star", "_from", "_addr", "_subj", "_body",
    "_tag1_bg", "_tag1_text", "_tag2_bg", "_tag2_text", "_time"
}

local _row_clones = nil

for i = 1, MAX_MAIL_SLOTS do
    local p = "v_mail_m" .. i
    for _, suffix in ipairs(ROW_SUFFIXES) do
        NODE_IDS[#NODE_IDS + 1] = p .. suffix
    end
end

