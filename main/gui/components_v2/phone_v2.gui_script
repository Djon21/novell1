-- phone_v2.gui_script
-- Fullscreen 2-col modal per hud_mobile.html (phone section).
-- Step22: app view switcher + stub views for 7 non-SMS apps.
-- All nodes declared in phone_v2.gui. Views are node groups toggled by enabled flag.
--
-- Incoming messages:
--   "open_phone"             — show modal (defaults to SMS view), pulls data
--   "close_phone"            — hide modal
--   "refresh_phone"          — re-pull data into all app views (step23)
--   "set_phone_notif"  {n}   — update "сообщений: N" stat (override)
--   "set_phone_time"   {time}— update status bar time
--
-- Outgoing messages (to #ui_manager_v2):
--   "close_phone"            — user hit close button
--   "phone_app_clicked" {id} — user tapped an app tile (informational)

local gs = require "main.scripts.game_state"

local UI_MGR = "#ui_manager_v2"

-- Палитра цветов (матчим hud_mobile.html для app-вьюх).
-- Используется в per-view refresh для статусов/missed и т.п.
local COLOR_CYAN      = vmath.vector4(0.47, 0.94, 1.00, 1.0)  -- active quest
local COLOR_PAPER_DIM = vmath.vector4(0.80, 0.80, 0.78, 0.7)  -- done / placeholder
local COLOR_HOT       = vmath.vector4(1.00, 0.30, 0.30, 1.0)  -- failed / missed
local COLOR_PAPER     = vmath.vector4(0.95, 0.95, 0.90, 1.0)

-- Shared chrome: always visible when phone open.
local CHROME_NODES = {
    "backdrop", "modal",
    "modal_border_top", "modal_border_bot",
    "corner_tl_v", "corner_tl_h", "corner_tr_v", "corner_tr_h",
    "corner_bl_v", "corner_bl_h", "corner_br_v", "corner_br_h",
    "title_eyebrow", "title_main",
    "stats_net", "stats_msg", "close_btn",
    "head_divider",
    "phone_case", "phone_case_top", "phone_notch", "phone_side_btn",
    "phone_screen", "status_time", "status_meta",
    "wall_time", "wall_date", "wall_glitch",
    "home_indicator",
    "side_panel",
    "home_btn",
    "app1_bg", "app1_icon", "app1_label",
    "app2_bg", "app2_icon", "app2_label",
    "app3_bg", "app3_icon", "app3_label",
    "app4_bg", "app4_icon", "app4_label",
    "app5_bg", "app5_icon", "app5_label",
    "app6_bg", "app6_icon", "app6_label",
    "app7_bg", "app7_icon", "app7_label",
    "app8_bg", "app8_icon", "app8_label",
}

-- Right-panel views. key = app id, value = list of node ids in that view.
local VIEWS = {
    sms = {
        "side_eyebrow", "side_title",
        "msg1_bg", "msg1_border", "msg1_name", "msg1_time", "msg1_body",
        "msg2_bg", "msg2_border", "msg2_name", "msg2_time", "msg2_body",
        "msg3_bg", "msg3_border", "msg3_name", "msg3_time", "msg3_body",
        "msg4_bg", "msg4_border", "msg4_name", "msg4_time", "msg4_body",
    },
    call = {
        "v_calls_eyebrow", "v_calls_title",
        "v_calls_row1_bg", "v_calls_row1_name", "v_calls_row1_meta",
        "v_calls_row2_bg", "v_calls_row2_name", "v_calls_row2_meta",
        "v_calls_row3_bg", "v_calls_row3_name", "v_calls_row3_meta",
    },
    map = {
        "v_map_eyebrow", "v_map_title",
        "v_map_placeholder", "v_map_hint", "v_map_hint2",
    },
    notes = {
        "v_clues_eyebrow", "v_clues_title",
        "v_clues_card1_bg", "v_clues_card1_tag", "v_clues_card1_body",
        "v_clues_card2_bg", "v_clues_card2_tag", "v_clues_card2_body",
    },
    quests = {
        "v_quests_eyebrow", "v_quests_title",
        "v_quests_q1_bg", "v_quests_q1_name", "v_quests_q1_desc",
        "v_quests_q2_bg", "v_quests_q2_name", "v_quests_q2_desc",
    },
    mail = {
        "v_mail_eyebrow", "v_mail_title",
        "v_mail_m1_bg", "v_mail_m1_from", "v_mail_m1_subj",
        "v_mail_m2_bg", "v_mail_m2_from", "v_mail_m2_subj",
    },
    cam = {
        "v_cam_eyebrow", "v_cam_title",
        "v_cam_screen", "v_cam_msg", "v_cam_meta",
    },
    term = {
        "v_term_eyebrow", "v_term_title",
        "v_term_screen", "v_term_l1", "v_term_l2", "v_term_l3", "v_term_l4",
    },
}

-- Ordered tile list (for click routing).
local APPS = {
    { key = "app1", id = "sms"    },
    { key = "app2", id = "call"   },
    { key = "app3", id = "map"    },
    { key = "app4", id = "notes"  },
    { key = "app5", id = "quests" },
    { key = "app6", id = "mail"   },
    { key = "app7", id = "cam"    },
    { key = "app8", id = "term"   },
}

local function set_nodes_enabled(ids, enabled)
    for _, id in ipairs(ids) do
        local n = gui.get_node(id)
        if n then 
            gui.set_enabled(n, enabled)
            -- Uncomment for detailed per-node logging:
            -- print("[phone_v2]     node '" .. id .. "' -> " .. tostring(enabled))
        end
    end
end

local function set_all_enabled(enabled)
    print("[phone_v2] set_all_enabled(" .. tostring(enabled) .. ")")
    print("[phone_v2]   setting CHROME_NODES (" .. #CHROME_NODES .. " nodes)")
    set_nodes_enabled(CHROME_NODES, enabled)
    print("[phone_v2]   setting VIEW nodes")
    for view_id, ids in pairs(VIEWS) do
        print("[phone_v2]     view '" .. view_id .. "' (" .. #ids .. " nodes)")
        set_nodes_enabled(ids, enabled)
    end
    print("[phone_v2] set_all_enabled complete")
end

local function show_view(self, view_id)
    if not VIEWS[view_id] then view_id = "sms" end
    print("[phone_v2] show_view called, switching from '" .. (self.active_view or "none") .. "' to '" .. view_id .. "'")
    
    -- hide all views
    for v_id, ids in pairs(VIEWS) do
        print("[phone_v2]   hiding view '" .. v_id .. "' (" .. #ids .. " nodes)")
        set_nodes_enabled(ids, false)
    end
    
    -- show target
    print("[phone_v2]   showing view '" .. view_id .. "' (" .. #VIEWS[view_id] .. " nodes)")
    set_nodes_enabled(VIEWS[view_id], true)
    self.active_view = view_id
    print("[phone_v2] show view complete: " .. view_id)
end

local function flash_node(node)
    local c = gui.get_color(node)
    local c0 = vmath.vector4(c.x, c.y, c.z, c.w)
    gui.animate(node, "color.w", math.max(0.25, c0.w * 0.3), gui.EASING_OUTQUAD, 0.08, 0, function()
        gui.animate(node, "color.w", c0.w, gui.EASING_OUTQUAD, 0.18)
    end)
end

local function set_text(id, s)
    local n = gui.get_node(id)
    if n then gui.set_text(n, s or "") end
end

local function set_node_enabled(id, enabled)
    local n = gui.get_node(id)
    if n then gui.set_enabled(n, enabled) end
end

local function set_node_color(id, c)
    local n = gui.get_node(id)
    if n then gui.set_color(n, c) end
end

-- -------- per-view refreshers --------
-- Каждый refresh_* получает таблицу данных (list) и ничего не возвращает.
-- Статические ноды существуют всегда — когда данных меньше слотов, лишние
-- слоты (bg-root карточки) выключаются целиком, чтобы не оставалось стэйла.

-- SMS: 4 статичных карточки msg1..msg4.
local SMS_SLOTS = 4
local function refresh_sms(self, list)
    list = list or {}
    for i = 1, SMS_SLOTS do
        local prefix = "msg" .. i
        local has = list[i] ~= nil
        set_node_enabled(prefix .. "_bg",     has)
        set_node_enabled(prefix .. "_border", has)
        set_node_enabled(prefix .. "_name",   has)
        set_node_enabled(prefix .. "_time",   has)
        set_node_enabled(prefix .. "_body",   has)
        if has then
            local m = list[i]
            set_text(prefix .. "_name", m.from or "—")
            set_text(prefix .. "_time", m.time or "")
            set_text(prefix .. "_body", m.body or "")
            -- unread → акцентный цвет имени, read → приглушённый
            set_node_color(prefix .. "_name", m.unread and COLOR_CYAN or COLOR_PAPER)
        end
    end
end

-- Quests: 2 слота q1..q2.
local QUEST_SLOTS = 2
local function refresh_quests(self, list)
    list = list or {}
    for i = 1, QUEST_SLOTS do
        local prefix = "v_quests_q" .. i
        local has = list[i] ~= nil
        set_node_enabled(prefix .. "_bg",   has)
        set_node_enabled(prefix .. "_name", has)
        set_node_enabled(prefix .. "_desc", has)
        if has then
            local q = list[i]
            -- Название квеста с прогрессом
            local title_text = q.title or "—"
            if q.progress and q.progress ~= "" then
                title_text = title_text .. " [" .. q.progress .. "]"
            end
            set_text(prefix .. "_name", title_text)
            -- Описание или статус
            set_text(prefix .. "_desc", q.desc or q.status or "")
            -- Цвет по статусу
            local c = COLOR_PAPER
            if q.status == "active" then c = COLOR_CYAN
            elseif q.status == "done"   then c = COLOR_PAPER_DIM
            elseif q.status == "failed" then c = COLOR_HOT end
            set_node_color(prefix .. "_name", c)
        end
    end
end

-- Mail: 2 слота m1..m2.
local MAIL_SLOTS = 2
local function refresh_mail(self, list)
    list = list or {}
    for i = 1, MAIL_SLOTS do
        local prefix = "v_mail_m" .. i
        local has = list[i] ~= nil
        set_node_enabled(prefix .. "_bg",   has)
        set_node_enabled(prefix .. "_from", has)
        set_node_enabled(prefix .. "_subj", has)
        if has then
            local m = list[i]
            set_text(prefix .. "_from", m.from or "—")
            set_text(prefix .. "_subj", m.subject or "")
            set_node_color(prefix .. "_from", m.unread and COLOR_CYAN or COLOR_PAPER)
        end
    end
end

-- Calls: 3 строки row1..row3.
local CALL_SLOTS = 3
local function refresh_calls(self, list)
    list = list or {}
    for i = 1, CALL_SLOTS do
        local prefix = "v_calls_row" .. i
        local has = list[i] ~= nil
        set_node_enabled(prefix .. "_bg",   has)
        set_node_enabled(prefix .. "_name", has)
        set_node_enabled(prefix .. "_meta", has)
        if has then
            local c = list[i]
            set_text(prefix .. "_name", c.who or "—")
            set_text(prefix .. "_meta", c.time or "")
            set_node_color(prefix .. "_name", c.missed and COLOR_HOT or COLOR_PAPER)
        end
    end
end

-- Clues: 2 карточки card1..card2. Если список пуст — в первой карточке
-- показываем «пока пусто», вторую отключаем.
local CLUE_SLOTS = 2
local function refresh_clues(self, list)
    list = list or {}
    if #list == 0 then
        set_node_enabled("v_clues_card1_bg",   true)
        set_node_enabled("v_clues_card1_tag",  true)
        set_node_enabled("v_clues_card1_body", true)
        set_text("v_clues_card1_tag",  "улики")
        set_text("v_clues_card1_body", "пока пусто")
        set_node_color("v_clues_card1_tag", COLOR_PAPER_DIM)
        set_node_enabled("v_clues_card2_bg",   false)
        set_node_enabled("v_clues_card2_tag",  false)
        set_node_enabled("v_clues_card2_body", false)
        return
    end
    for i = 1, CLUE_SLOTS do
        local prefix = "v_clues_card" .. i
        local has = list[i] ~= nil
        set_node_enabled(prefix .. "_bg",   has)
        set_node_enabled(prefix .. "_tag",  has)
        set_node_enabled(prefix .. "_body", has)
        if has then
            local cl = list[i]
            set_text(prefix .. "_tag",  cl.id or "—")
            set_text(prefix .. "_body", cl.label or "")
            set_node_color(prefix .. "_tag", COLOR_CYAN)
        end
    end
end

-- Полный pull из game_state + обновление всех app-вьюх + счётчика.
-- map/camera/terminal данными не обеспечены — остаются как есть (заполнены
-- статичным текстом в .gui, step22).
local function refresh_all_views(self)
    local sms   = gs.get_messages  and gs.get_messages()  or {}
    local qs    = gs.get_quests    and gs.get_quests()    or {}
    local mails = gs.get_mails     and gs.get_mails()     or {}
    local calls = gs.get_call_log  and gs.get_call_log()  or {}
    local clues = gs.get_clues     and gs.get_clues()     or {}

    refresh_sms(self,    sms)
    refresh_quests(self, qs)
    refresh_mail(self,   mails)
    refresh_calls(self,  calls)
    refresh_clues(self,  clues)

    local unread = gs.get_phone_unread_total and gs.get_phone_unread_total() or 0
    set_text("stats_msg", "сообщений: " .. tostring(unread))
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = false
    self.active_view = "sms"
    set_all_enabled(false)
    -- Заполнить статические ноды текущим состоянием до первого показа.
    refresh_all_views(self)
    print("[phone_v2] init complete, default view = sms")
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_phone") then
        self.visible = true
        set_all_enabled(false)
        set_nodes_enabled(CHROME_NODES, true)
        -- Подтянуть свежие данные до показа (рейс unread с game_state).
        refresh_all_views(self)
        show_view(self, "sms")
        print("[phone_v2] open_phone")
    elseif message_id == hash("close_phone") then
        print("[phone_v2] close_phone - hiding all nodes")
        print("[phone_v2] active_view before close:", self.active_view)
        self.visible = false
        set_all_enabled(false)
        print("[phone_v2] close_phone complete")
        
        -- DEBUG: Check if any nodes are still enabled
        local still_enabled = {}
        for view_id, ids in pairs(VIEWS) do
            for _, id in ipairs(ids) do
                local n = gui.get_node(id)
                if n and gui.is_enabled(n) then
                    table.insert(still_enabled, id .. " (view: " .. view_id .. ")")
                end
            end
        end
        if #still_enabled > 0 then
            print("[phone_v2] WARNING: Some nodes still enabled after close:")
            for _, id in ipairs(still_enabled) do
                print("  - " .. id)
            end
        else
            print("[phone_v2] All view nodes properly disabled")
        end
    elseif message_id == hash("refresh_phone") then
        refresh_all_views(self)
    elseif message_id == hash("set_phone_notif") then
        local n = tonumber(message and message.n) or 0
        set_text("stats_msg", "сообщений: " .. tostring(n))
    elseif message_id == hash("set_phone_time") then
        local t = (message and message.time) or "07:12"
        set_text("status_time", t)
        set_text("wall_time", t)
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    local close = gui.get_node("close_btn")
    if gui.is_enabled(close) and gui.pick_node(close, action.x, action.y) then
        flash_node(close)
        msg.post(UI_MGR, "close_phone")
        return true
    end

    local home = gui.get_node("home_btn")
    if gui.is_enabled(home) and gui.pick_node(home, action.x, action.y) then
        flash_node(home)
        show_view(self, "sms")
        return true
    end

    for _, app in ipairs(APPS) do
        local bg = gui.get_node(app.key .. "_bg")
        if gui.is_enabled(bg) and gui.pick_node(bg, action.x, action.y) then
            print("[phone_v2] app tile clicked: " .. app.id)
            flash_node(bg)
            msg.post(UI_MGR, "phone_app_clicked", { id = app.id })
            if self.active_view == app.id then
                show_view(self, "sms")
            else
                show_view(self, app.id)
            end
            return true
        end
    end

    return false
end
