-- phone_v2.gui_script
-- Fullscreen 2-col modal per hud_mobile.html (phone section).
-- Step22: app view switcher + stub views for 7 non-SMS apps.
-- All nodes declared in phone_v2.gui. Views are node groups toggled by enabled flag.
--
-- Incoming messages:
--   "open_phone"             — show modal (defaults to SMS view)
--   "close_phone"            — hide modal
--   "set_phone_notif"  {n}   — update "сообщений: N" stat
--   "set_phone_time"   {time}— update status bar time
--
-- Outgoing messages (to #ui_manager_v2):
--   "close_phone"            — user hit close button
--   "phone_app_clicked" {id} — user tapped an app tile (informational)

local UI_MGR = "#ui_manager_v2"

-- Shared chrome: always visible when phone open.
local CHROME_NODES = {
    "backdrop", "modal",
    "modal_border_top", "modal_border_bot",
    "corner_tl_v", "corner_tl_h", "corner_tr_v", "corner_tr_h",
    "corner_bl_v", "corner_bl_h", "corner_br_v", "corner_br_h",
    "title_eyebrow", "title_main",
    "stats_net", "stats_msg", "close_btn",
    "head_divider",
    "phone_case", "phone_case_top", "phone_notch", "phone_side_btn",
    "phone_screen", "status_time", "status_meta",
    "wall_time", "wall_date", "wall_glitch",
    "home_indicator",
    "side_panel",
    "home_btn",
    "app1_bg", "app1_icon", "app1_label",
    "app2_bg", "app2_icon", "app2_label",
    "app3_bg", "app3_icon", "app3_label",
    "app4_bg", "app4_icon", "app4_label",
    "app5_bg", "app5_icon", "app5_label",
    "app6_bg", "app6_icon", "app6_label",
    "app7_bg", "app7_icon", "app7_label",
    "app8_bg", "app8_icon", "app8_label",
}

-- Right-panel views. key = app id, value = list of node ids in that view.
local VIEWS = {
    sms = {
        "side_eyebrow", "side_title",
        "msg1_bg", "msg1_border", "msg1_name", "msg1_time", "msg1_body",
        "msg2_bg", "msg2_border", "msg2_name", "msg2_time", "msg2_body",
        "msg3_bg", "msg3_border", "msg3_name", "msg3_time", "msg3_body",
        "msg4_bg", "msg4_border", "msg4_name", "msg4_time", "msg4_body",
    },
    call = {
        "v_calls_eyebrow", "v_calls_title",
        "v_calls_row1_bg", "v_calls_row1_name", "v_calls_row1_meta",
        "v_calls_row2_bg", "v_calls_row2_name", "v_calls_row2_meta",
        "v_calls_row3_bg", "v_calls_row3_name", "v_calls_row3_meta",
    },
    map = {
        "v_map_eyebrow", "v_map_title",
        "v_map_placeholder", "v_map_hint", "v_map_hint2",
    },
    notes = {
        "v_clues_eyebrow", "v_clues_title",
        "v_clues_card1_bg", "v_clues_card1_tag", "v_clues_card1_body",
        "v_clues_card2_bg", "v_clues_card2_tag", "v_clues_card2_body",
    },
    quests = {
        "v_quests_eyebrow", "v_quests_title",
        "v_quests_q1_bg", "v_quests_q1_name", "v_quests_q1_desc",
        "v_quests_q2_bg", "v_quests_q2_name", "v_quests_q2_desc",
    },
    mail = {
        "v_mail_eyebrow", "v_mail_title",
        "v_mail_m1_bg", "v_mail_m1_from", "v_mail_m1_subj",
        "v_mail_m2_bg", "v_mail_m2_from", "v_mail_m2_subj",
    },
    cam = {
        "v_cam_eyebrow", "v_cam_title",
        "v_cam_screen", "v_cam_msg", "v_cam_meta",
    },
    term = {
        "v_term_eyebrow", "v_term_title",
        "v_term_screen", "v_term_l1", "v_term_l2", "v_term_l3", "v_term_l4",
    },
}

-- Ordered tile list (for click routing).
local APPS = {
    { key = "app1", id = "sms"    },
    { key = "app2", id = "call"   },
    { key = "app3", id = "map"    },
    { key = "app4", id = "notes"  },
    { key = "app5", id = "quests" },
    { key = "app6", id = "mail"   },
    { key = "app7", id = "cam"    },
    { key = "app8", id = "term"   },
}

local function set_nodes_enabled(ids, enabled)
    for _, id in ipairs(ids) do
        local n = gui.get_node(id)
        if n then gui.set_enabled(n, enabled) end
    end
end

local function set_all_enabled(enabled)
    set_nodes_enabled(CHROME_NODES, enabled)
    for _, ids in pairs(VIEWS) do
        set_nodes_enabled(ids, enabled)
    end
end

local function show_view(self, view_id)
    if not VIEWS[view_id] then view_id = "sms" end
    -- hide all views
    for _, ids in pairs(VIEWS) do
        set_nodes_enabled(ids, false)
    end
    -- show target
    set_nodes_enabled(VIEWS[view_id], true)
    self.active_view = view_id
    print("[phone_v2] show view: " .. view_id)
end

local function flash_node(node)
    local c = gui.get_color(node)
    local c0 = vmath.vector4(c.x, c.y, c.z, c.w)
    gui.animate(node, "color.w", math.max(0.25, c0.w * 0.3), gui.EASING_OUTQUAD, 0.08, 0, function()
        gui.animate(node, "color.w", c0.w, gui.EASING_OUTQUAD, 0.18)
    end)
end

local function set_text(id, s)
    local n = gui.get_node(id)
    if n then gui.set_text(n, s or "") end
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = false
    self.active_view = "sms"
    set_all_enabled(false)
    print("[phone_v2] init complete, default view = sms")
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_phone") then
        self.visible = true
        set_all_enabled(false)
        set_nodes_enabled(CHROME_NODES, true)
        show_view(self, "sms")
        print("[phone_v2] open_phone")
    elseif message_id == hash("close_phone") then
        self.visible = false
        set_all_enabled(false)
        print("[phone_v2] close_phone")
    elseif message_id == hash("set_phone_notif") then
        local n = tonumber(message and message.n) or 0
        set_text("stats_msg", "сообщений: " .. tostring(n))
    elseif message_id == hash("set_phone_time") then
        local t = (message and message.time) or "07:12"
        set_text("status_time", t)
        set_text("wall_time", t)
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    local close = gui.get_node("close_btn")
    if gui.is_enabled(close) and gui.pick_node(close, action.x, action.y) then
        flash_node(close)
        msg.post(UI_MGR, "close_phone")
        return true
    end

    local home = gui.get_node("home_btn")
    if gui.is_enabled(home) and gui.pick_node(home, action.x, action.y) then
        flash_node(home)
        show_view(self, "sms")
        return true
    end

    for _, app in ipairs(APPS) do
        local bg = gui.get_node(app.key .. "_bg")
        if gui.is_enabled(bg) and gui.pick_node(bg, action.x, action.y) then
            print("[phone_v2] app tile clicked: " .. app.id)
            flash_node(bg)
            msg.post(UI_MGR, "phone_app_clicked", { id = app.id })
            if self.active_view == app.id then
                show_view(self, "sms")
            else
                show_view(self, app.id)
            end
            return true
        end
    end

    return false
end
