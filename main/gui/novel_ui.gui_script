-- novel_ui.gui_script
-- Контроллер интерфейса визуальной новеллы.

local dm    = require "main.scripts.dialogue_manager"
local sm    = require "main.scripts.save_manager"
local story = require "main.scripts.story_data"

-- ВАЖНО: top-level require, БЕЗ pcall/if-обёрток. Defold compiler делает
-- статический анализ require'ов и включает Lua extension'а в HTML5 бандл
-- ТОЛЬКО когда видит require как обычный вызов. pcall(require, "...") — это
-- динамический вызов, модуль НЕ попадает в бандл, на HTML5 будет
-- "module 'yagames.yagames' not found".
local yagames = require "yagames.yagames"
local ysdk_ready = false

local bg_node, dialogue_panel, name_panel, name_label
local dialogue_text, continue_hint, choice_panel, choice_question_node
local choice_btns      = {}
local choice_texts     = {}
local choice_btn_tops  = {}
local choice_btn_lefts = {}
local bg_nodes         = {}

local menu_panel, menu_btn_play, menu_btn_continue
local menu_btn_play_text, menu_btn_continue_text
local menu_title_glitch_r, menu_title_glitch_b
local menu_btn_play_top_line, menu_btn_play_left_line
local menu_btn_continue_top_line, menu_btn_continue_left_line

local HINT_BLINK_SPEED = 2.0
local hint_timer       = 0
local in_menu          = true
local glitch_active    = false
local music_started    = false
local game_lang        = "ru"  -- язык по умолчанию (Яндекс требование 2.14)

-- -------------------------------------------------------
-- Глитч-эффект на заголовке (как в Steins;Gate / DDLC)
-- -------------------------------------------------------
local function start_glitch()
    glitch_active = true
    local function do_glitch()
        if not glitch_active then return end

        local pr = gui.get_position(menu_title_glitch_r)
        local pb = gui.get_position(menu_title_glitch_b)
        pr.x = math.random(-6, 6)
        pb.x = math.random(-6, 6)
        gui.set_position(menu_title_glitch_r, pr)
        gui.set_position(menu_title_glitch_b, pb)

        local cr = gui.get_color(menu_title_glitch_r)
        local cb = gui.get_color(menu_title_glitch_b)
        cr.w = math.random(2, 5) * 0.1
        cb.w = math.random(1, 4) * 0.1
        gui.set_color(menu_title_glitch_r, cr)
        gui.set_color(menu_title_glitch_b, cb)

        timer.delay(math.random(3, 8) + math.random(), false, do_glitch)
    end
    timer.delay(math.random(2, 5), false, do_glitch)
end

-- -------------------------------------------------------
-- Вспомогательные функции — игровой экран
-- -------------------------------------------------------

local function set_background(bg, bg_image)
    for name, node in pairs(bg_nodes) do
        gui.set_enabled(node, name == bg_image)
    end
    gui.set_color(bg_node, vmath.vector4(bg.r, bg.g, bg.b, 1))
end

local function show_dialogue_mode(node)
    gui.set_enabled(choice_panel,   false)
    gui.set_enabled(dialogue_panel, true)
    gui.set_enabled(dialogue_text,  true)

    local has_name = node.character and node.character ~= ""
    gui.set_enabled(name_panel, has_name)
    gui.set_enabled(name_label, has_name)
    if has_name then
        gui.set_text(name_label, node.character)
    end

    gui.set_text(dialogue_text, node.text or "")
    gui.set_enabled(continue_hint, true)
end

-- Динамически расставляет кнопки по числу вариантов
local function layout_choices(options)
    local BTN_H   = 54
    local BTN_GAP = 12
    local Q_H     = 22
    local Q_GAP   = 14

    local n = 0
    for i = 1, 4 do
        if options and options[i] then n = n + 1 end
    end
    if n == 0 then return end

    -- Высота всего блока: вопрос + отступ + кнопки
    local block_h = Q_H + Q_GAP + n * BTN_H + (n - 1) * BTN_GAP
    local top     = block_h / 2  -- верхний край блока относительно центра панели

    -- Вопрос
    gui.set_position(choice_question_node,
        vmath.vector3(0, top - Q_H / 2, 0.1))

    -- Кнопки сверху вниз
    local btn_y = top - Q_H - Q_GAP - BTN_H / 2
    for i = 1, 4 do
        if options and options[i] then
            gui.set_position(choice_btns[i],
                vmath.vector3(0, btn_y, 0.10))
            gui.set_position(choice_btn_tops[i],
                vmath.vector3(0, btn_y + BTN_H / 2, 0.15))
            gui.set_position(choice_btn_lefts[i],
                vmath.vector3(-328, btn_y, 0.15))
            btn_y = btn_y - BTN_H - BTN_GAP
        end
    end
end

local function show_choice_mode(node)
    gui.set_enabled(dialogue_panel, false)
    gui.set_enabled(dialogue_text,  false)
    gui.set_enabled(name_panel,     false)
    gui.set_enabled(name_label,     false)
    gui.set_enabled(continue_hint,  false)
    gui.set_enabled(choice_panel,   true)

    gui.set_text(choice_question_node, node.question or "")

    for i = 1, 4 do
        local opt = node.options and node.options[i]
        gui.set_enabled(choice_btns[i],      opt ~= nil)
        gui.set_enabled(choice_texts[i],     opt ~= nil)
        gui.set_enabled(choice_btn_tops[i],  opt ~= nil)
        gui.set_enabled(choice_btn_lefts[i], opt ~= nil)
        if opt then
            gui.set_text(choice_texts[i], opt.text)
        end
    end

    layout_choices(node.options)
end

local function show_end_mode(node)
    gui.set_enabled(choice_panel,   false)
    gui.set_enabled(dialogue_panel, true)
    gui.set_enabled(dialogue_text,  true)
    gui.set_enabled(name_panel,     false)
    gui.set_enabled(name_label,     false)
    gui.set_text(dialogue_text, node.text or "Конец")
    gui.set_text(continue_hint, "начать заново")
    gui.set_enabled(continue_hint, true)
end

local function render()
    set_background(dm.get_background(), dm.get_background_image())
    local node = dm.get_current_node()
    if not node then return end

    if     node.type == "dialogue" then show_dialogue_mode(node)
    elseif node.type == "choice"   then show_choice_mode(node)
    elseif node.type == "end"      then show_end_mode(node)
    end
end

-- -------------------------------------------------------
-- Меню
-- -------------------------------------------------------

local function show_menu()
    in_menu       = true
    glitch_active = false

    gui.set_enabled(bg_nodes["bg_menu"], true)
    gui.set_enabled(menu_panel,     true)
    gui.set_enabled(dialogue_panel, false)
    gui.set_enabled(choice_panel,   false)
    gui.set_enabled(continue_hint,  false)
    gui.set_enabled(name_panel,     false)
    gui.set_enabled(name_label,     false)

    sm.load()
    local has = sm.has_save()
    gui.set_enabled(menu_btn_continue,           has)
    gui.set_enabled(menu_btn_continue_text,      has)
    gui.set_enabled(menu_btn_continue_top_line,  has)
    gui.set_enabled(menu_btn_continue_left_line, has)

    -- Каскадное появление: панель + дочерние элементы
    gui.set_color(menu_panel, vmath.vector4(0.02, 0.02, 0.08, 0))
    gui.animate(menu_panel, gui.PROP_COLOR,
        vmath.vector4(0.02, 0.02, 0.08, 0.5), gui.EASING_OUTQUAD, 0.5)

    -- Кнопка «Играть» — без inherit_alpha, анимируем отдельно
    gui.set_color(menu_btn_play, vmath.vector4(0.08, 0.06, 0.30, 0))
    gui.animate(menu_btn_play, gui.PROP_COLOR,
        vmath.vector4(0.08, 0.06, 0.30, 1), gui.EASING_OUTQUAD, 0.30, 0.40)

    -- Кнопка «Продолжить» — с задержкой
    if has then
        gui.set_color(menu_btn_continue, vmath.vector4(0.06, 0.05, 0.22, 0))
        gui.animate(menu_btn_continue, gui.PROP_COLOR,
            vmath.vector4(0.06, 0.05, 0.22, 1), gui.EASING_OUTQUAD, 0.30, 0.55)
    end

    -- Запускаем глитч после окончания анимации появления
    timer.delay(0.75, false, function()
        if in_menu then start_glitch() end
    end)
end

local function start_game()
    glitch_active = false
    in_menu       = false
    gui.set_enabled(bg_nodes["bg_menu"], false)
    gui.set_enabled(menu_panel, false)
    render()
end

-- -------------------------------------------------------
-- Lifecycle
-- -------------------------------------------------------

function init(self)
    bg_node              = gui.get_node("background")
    bg_nodes["bg_bedroom"]        = gui.get_node("bg_image")
    bg_nodes["bg_metro"]          = gui.get_node("bg_metro")
    bg_nodes["bg_office"]         = gui.get_node("bg_office")
    bg_nodes["bg_office_evening"] = gui.get_node("bg_office_evening")
    bg_nodes["bg_rooftop"]        = gui.get_node("bg_rooftop")
    bg_nodes["bg_menu"]           = gui.get_node("bg_menu")

    dialogue_panel       = gui.get_node("dialogue_panel")
    name_panel           = gui.get_node("name_panel")
    name_label           = gui.get_node("name_label")
    dialogue_text        = gui.get_node("dialogue_text")
    continue_hint        = gui.get_node("continue_hint")
    choice_panel         = gui.get_node("choice_panel")
    choice_question_node = gui.get_node("choice_question")

    for i = 1, 4 do
        choice_btns[i]      = gui.get_node("choice_btn_"  .. i)
        choice_texts[i]     = gui.get_node("choice_text_" .. i)
        choice_btn_tops[i]  = gui.get_node("choice_btn_"  .. i .. "_top")
        choice_btn_lefts[i] = gui.get_node("choice_btn_"  .. i .. "_left")
    end

    menu_panel                   = gui.get_node("menu_panel")
    menu_btn_play                = gui.get_node("menu_btn_play")
    menu_btn_continue            = gui.get_node("menu_btn_continue")
    menu_btn_play_text           = gui.get_node("menu_btn_play_text")
    menu_btn_continue_text       = gui.get_node("menu_btn_continue_text")
    menu_title_glitch_r          = gui.get_node("menu_title_glitch_r")
    menu_title_glitch_b          = gui.get_node("menu_title_glitch_b")
    menu_btn_play_top_line       = gui.get_node("menu_btn_play_top_line")
    menu_btn_play_left_line      = gui.get_node("menu_btn_play_left_line")
    menu_btn_continue_top_line   = gui.get_node("menu_btn_continue_top_line")
    menu_btn_continue_left_line  = gui.get_node("menu_btn_continue_left_line")

    -- Яндекс Игры: инициализация SDK (нужна для показа рекламы в конце новеллы).
    -- Автоопределение языка (2.14) и LoadingAPI.ready уже вызваны в engine_template.html
    -- напрямую через ysdk.environment — срабатывает ДО запуска Defold.
    if yagames then
        yagames.init(function(_, err)
            if err then
                print("YaGames init error: " .. tostring(err))
                return
            end
            ysdk_ready = true

            -- Дублируем чтение языка через Lua SDK — на случай если Яндекс
            -- отслеживает именно обращение через нативный мост.
            local ok, env = pcall(yagames.environment)
            if ok and env and env.i18n then
                game_lang = env.i18n.lang or "ru"
            end
        end)
    end

    show_menu()

    msg.post(".", "acquire_input_focus")
end

function update(self, dt)
    if in_menu then return end
    local node = dm.get_current_node()
    if node and node.type == "dialogue" then
        hint_timer = hint_timer + dt * HINT_BLINK_SPEED
        local c = gui.get_color(continue_hint)
        c.w = 0.5 + 0.5 * math.sin(hint_timer * math.pi)
        gui.set_color(continue_hint, c)
    end
end

-- -------------------------------------------------------
-- Обработка ввода
-- -------------------------------------------------------

function on_input(self, action_id, action)
    if not action.pressed then return false end

    -- Запускаем музыку при первом касании (браузеры блокируют autoplay)
    if not music_started then
        music_started = true
        msg.post("/music_player#sound", "play_sound", { delay = 0, gain = 0.7 })
    end

    if action_id == hash("touch") then

        -- ---- Меню ----
        if in_menu then
            if gui.pick_node(menu_btn_play, action.x, action.y) then
                -- Вспышка на border при клике
                gui.animate(menu_btn_play_top_line, gui.PROP_COLOR,
                    vmath.vector4(1.0, 0.85, 1.0, 1), gui.EASING_OUTQUAD, 0.06)
                sm.new_game()
                dm.init(story)
                start_game()
                return true
            end

            if sm.has_save()
            and gui.pick_node(menu_btn_continue, action.x, action.y) then
                gui.animate(menu_btn_continue_top_line, gui.PROP_COLOR,
                    vmath.vector4(0.85, 0.65, 1.0, 1), gui.EASING_OUTQUAD, 0.06)
                dm.load_saved(story)
                start_game()
                return true
            end

            return false
        end

        -- ---- Игра ----
        local node = dm.get_current_node()
        if not node then return false end

        if node.type == "dialogue" then
            dm.advance()
            render()
            hint_timer = 0
            return true

        elseif node.type == "choice" then
            for i = 1, 4 do
                if gui.is_enabled(choice_btns[i])
                and gui.pick_node(choice_btns[i], action.x, action.y) then
                    dm.choose(i)
                    render()
                    return true
                end
            end

        elseif node.type == "end" then
            -- Защита от двойного вызова show_menu (callback'и Яндекса +
            -- страховочный таймер могут сработать одновременно).
            local menu_returned = false
            local function go_to_menu()
                if menu_returned then return end
                menu_returned = true
                show_menu()
            end

            if yagames and ysdk_ready then
                -- Страховочный таймер: если реклама зависла или callback'и
                -- не придут — через 30 сек всё равно уходим в меню.
                timer.delay(30, false, function() go_to_menu() end)

                local ok, err = pcall(yagames.adv_show_fullscreen_adv, {
                    close   = function(_, was_shown) go_to_menu() end,
                    error   = function(_, e)         go_to_menu() end,
                    offline = function(_)            go_to_menu() end,
                })
                if not ok then
                    print("adv pcall failed: " .. tostring(err))
                    go_to_menu()
                end
            else
                go_to_menu()
            end
            return true
        end
    end

    return false
end
