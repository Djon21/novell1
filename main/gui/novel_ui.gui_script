-- novel_ui.gui_script
-- Контроллер интерфейса визуальной новеллы.

local dm = require "main.scripts.dialogue_manager_ink"
local sm = require "main.scripts.save_manager"

-- Путь к скомпилированному .ink. Меняется при переключении главы.
-- .json лежит в custom_resources=/main/story (см. game.project).
local STORY_RESOURCE = "/main/story/chapter_01.json"

-- Загружает байты скомпилированного .ink/.json и отдаёт их dialogue_manager.
-- Возвращает nil + печатает ошибку, если ресурс не найден — UI в этом
-- случае останется в меню (безопаснее тихого краша).
local function load_story_bytes()
    local ok, bytes = pcall(sys.load_resource, STORY_RESOURCE)
    if not ok or not bytes then
        print("[novel_ui] ❌ не найден " .. STORY_RESOURCE ..
              " — проверь custom_resources и tools/compile_ink.bat")
        return nil
    end
    return bytes
end

-- ВАЖНО: top-level require, БЕЗ pcall/if-обёрток. Defold compiler делает
-- статический анализ require'ов и включает Lua extension'а в HTML5 бандл
-- ТОЛЬКО когда видит require как обычный вызов. pcall(require, "...") — это
-- динамический вызов, модуль НЕ попадает в бандл, на HTML5 будет
-- "module 'yagames.yagames' not found".
local yagames = require "yagames.yagames"
local ysdk_ready = false

local bg_node, bg_sprite, bg_sprite_next, bg_menu_node, pulse_overlay
local current_bg_image = nil  -- имя текущего активного фона (или nil = none)
local BG_FADE_DUR      = 0.35
-- Состояние shake-эффекта (обновляется в update())
local shake_state      = nil  -- { elapsed, duration, intensity, nodes={n={orig_pos}} }
-- Нарраторская плашка (терминал + часы) — показывается вместо портрета
-- в сценах без говорящего (# speaker:none / narration).
local narrator_panel, narrator_clock, narrator_prompt, narrator_cursor
local narrator_visible = false
local cursor_blink_t   = 0
local dialogue_panel, name_panel, name_label
local dialogue_text, continue_hint, choice_panel, choice_question_node
local choice_btns      = {}
local choice_texts     = {}
local choice_btn_tops  = {}
local choice_btn_lefts = {}

-- Портреты персонажей
local portraits           = {}   -- { ["Мила"] = node, ... }
local current_portrait    = nil  -- имя текущего видимого портрета
local PORTRAIT_X          = 120  -- конечная позиция X
local PORTRAIT_Y          = 120  -- прижат к низу экрана через yanchor=BOTTOM
local PORTRAIT_Z          = 0.15 -- поверх dialogue_panel (0.1)
local PORTRAIT_SLIDE_FROM = -150 -- откуда slide-in (за левым краем экрана)
local PORTRAIT_ANIM_DUR   = 0.25 -- длительность анимации

-- Позиции текста: обычные и сдвинутые (когда портрет виден)
local TEXT_X_NORMAL       = 260
local TEXT_X_PORTRAIT     = 280  -- после портрета
local TEXT_W_NORMAL       = 680
local TEXT_W_PORTRAIT     = 660
local TEXT_Y              = 132
local NAME_X_NORMAL       = 330
local NAME_X_PORTRAIT     = 330
local NAME_Y              = 165

local menu_panel, menu_btn_play, menu_btn_continue
local menu_btn_play_text, menu_btn_continue_text
local menu_title_glitch_r, menu_title_glitch_b
local menu_btn_play_top_line, menu_btn_play_left_line
local menu_btn_continue_top_line, menu_btn_continue_left_line

local HINT_BLINK_SPEED = 2.0
local hint_timer       = 0
local in_menu          = true
local glitch_active    = false
local music_started    = false
local game_lang        = "ru"  -- язык по умолчанию (Яндекс требование 2.14)

-- -------------------------------------------------------
-- Глитч-эффект на заголовке (как в Steins;Gate / DDLC)
-- -------------------------------------------------------
local function start_glitch()
    glitch_active = true
    local function do_glitch()
        if not glitch_active then return end

        local pr = gui.get_position(menu_title_glitch_r)
        local pb = gui.get_position(menu_title_glitch_b)
        pr.x = math.random(-6, 6)
        pb.x = math.random(-6, 6)
        gui.set_position(menu_title_glitch_r, pr)
        gui.set_position(menu_title_glitch_b, pb)

        local cr = gui.get_color(menu_title_glitch_r)
        local cb = gui.get_color(menu_title_glitch_b)
        cr.w = math.random(2, 5) * 0.1
        cb.w = math.random(1, 4) * 0.1
        gui.set_color(menu_title_glitch_r, cr)
        gui.set_color(menu_title_glitch_b, cb)

        timer.delay(math.random(3, 8) + math.random(), false, do_glitch)
    end
    timer.delay(math.random(2, 5), false, do_glitch)
end

-- -------------------------------------------------------
-- Вспомогательные функции — игровой экран
-- -------------------------------------------------------

-- Переключает фон с плавным crossfade (BG_FADE_DUR). bg_image == nil или
-- "none" → сцена без картинки (виден только цвет подложки).
-- Схема: два слоя (bg_sprite + bg_sprite_next, next чуть выше по z).
-- При смене: на next ставим новую картинку, fade alpha 0→1, после
-- завершения — копируем результат на sprite, next прячем с alpha=0.
-- Если имя не меняется — ничего не делаем (render() зовётся часто).
local function normalize_bg(name)
    if name == nil or name == "none" then return nil end
    return name
end

local function set_background(bg, bg_image)
    -- Подложка: цвет меняем всегда (дёшево, без анимации).
    gui.set_color(bg_node, vmath.vector4(bg.r, bg.g, bg.b, 1))

    local target = normalize_bg(bg_image)
    if target == current_bg_image then return end  -- та же картинка — не дёргаем

    -- Отменяем незавершённый фейд, чтобы не было наложения анимаций.
    gui.cancel_animation(bg_sprite_next, "color.w")
    gui.cancel_animation(bg_sprite,      "color.w")

    if target == nil then
        -- Фейд текущего фона в прозрачность.
        gui.animate(bg_sprite, "color.w", 0, gui.EASING_INOUTQUAD, BG_FADE_DUR, 0,
            function() gui.set_enabled(bg_sprite, false) end)
        current_bg_image = nil
        return
    end

    local ok, err = pcall(gui.play_flipbook, bg_sprite_next, target)
    if not ok then
        print("[novel_ui] ❌ фон не найден в атласе: " .. tostring(target) ..
              " (" .. tostring(err) .. ")")
        return
    end

    -- Стартуем next с alpha=0 и фейдим до 1. После завершения
    -- переносим картинку на sprite и прячем next.
    gui.set_enabled(bg_sprite_next, true)
    local c = gui.get_color(bg_sprite_next); c.w = 0; gui.set_color(bg_sprite_next, c)

    -- Если sprite был выключен (первый показ после none) — включаем с alpha=1,
    -- чтобы next корректно смешивался поверх пустоты.
    if not gui.is_enabled(bg_sprite) then
        gui.set_enabled(bg_sprite, true)
        local cs = gui.get_color(bg_sprite); cs.w = 1; gui.set_color(bg_sprite, cs)
    end

    gui.animate(bg_sprite_next, "color.w", 1, gui.EASING_INOUTQUAD, BG_FADE_DUR, 0,
        function()
            pcall(gui.play_flipbook, bg_sprite, target)
            local cs2 = gui.get_color(bg_sprite); cs2.w = 1; gui.set_color(bg_sprite, cs2)
            gui.set_enabled(bg_sprite, true)
            local cn = gui.get_color(bg_sprite_next); cn.w = 0; gui.set_color(bg_sprite_next, cn)
            gui.set_enabled(bg_sprite_next, false)
        end)

    current_bg_image = target
end

-- -------------------------------------------------------
-- Эффекты из ink-тегов: sfx / shake / pulse
-- -------------------------------------------------------

-- Реестр звуков: имя из `# sfx:NAME` → url sound-компонента.
-- Пока пусто — когда появятся .sound файлы, регистрируй их здесь, например:
--   SFX_URLS["heartbeat"] = msg.url("main:/sfx_player#heartbeat")
-- Если имя отсутствует — печатаем WARN и идём дальше (игра не ломается).
local SFX_URLS = {}

local function play_sfx(name)
    local url = SFX_URLS[name]
    if url then
        msg.post(url, "play_sound", { delay = 0, gain = 0.6 })
    else
        print("[sfx] " .. tostring(name) .. " — звук не подключён (см. SFX_URLS)")
    end
end

-- Запускаем тряску: собираем исходные позиции bg-нод, update() каждый
-- кадр мажет случайный офсет с затуханием. По истечении duration —
-- возвращаем ноды на место.
local function start_shake(intensity, duration)
    if duration <= 0 then return end
    local nodes = { bg_sprite, bg_sprite_next }
    local origins = {}
    for _, n in ipairs(nodes) do
        origins[n] = gui.get_position(n)
    end
    shake_state = {
        elapsed   = 0,
        duration  = duration,
        intensity = intensity,
        origins   = origins,
    }
end

-- Коротая вспышка-оверлей: alpha 0 → 1 (быстро) → 0 (плавно).
local function pulse_flash(duration, r, g, b)
    local c = vmath.vector4(r, g, b, 0)
    gui.set_color(pulse_overlay, c)
    gui.set_enabled(pulse_overlay, true)

    local up   = duration * 0.3
    local down = duration * 0.7
    gui.animate(pulse_overlay, "color.w", 0.6, gui.EASING_OUTQUAD, up, 0, function()
        gui.animate(pulse_overlay, "color.w", 0, gui.EASING_INQUAD, down, 0, function()
            gui.set_enabled(pulse_overlay, false)
        end)
    end)
end

local function dispatch_effect(e)
    if     e.type == "sfx"   then play_sfx(e.name)
    elseif e.type == "shake" then start_shake(e.intensity or 0.2, e.duration or 0.4)
    elseif e.type == "pulse" then pulse_flash(e.duration or 0.5, e.r or 1, e.g or 1, e.b or 1)
    end
end

-- -------------------------------------------------------
-- Портреты персонажей (стиль Persona 5)
-- -------------------------------------------------------

-- Определяет, какой портрет показать для данного имени персонажа
local function get_portrait_name(character_name)
    if character_name == "Мила" then return "Мила" end
    if character_name == "Артём" then return "Артём" end
    return nil
end

-- Сдвигает текст и имя вправо (под портрет) или возвращает на место
local function shift_text_for_portrait(has_portrait)
    local tx = has_portrait and TEXT_X_PORTRAIT or TEXT_X_NORMAL
    local tw = has_portrait and TEXT_W_PORTRAIT or TEXT_W_NORMAL
    local nx = has_portrait and NAME_X_PORTRAIT or NAME_X_NORMAL

    gui.set_position(dialogue_text, vmath.vector3(tx, TEXT_Y, 0.3))
    gui.set_size(dialogue_text, vmath.vector3(tw, 130, 0))

    gui.set_position(name_panel, vmath.vector3(nx, NAME_Y, 0.2))
    gui.set_position(name_label, vmath.vector3(nx, NAME_Y, 0.3))
end

-- Показать портрет с анимацией slide-in слева + fade-in
local function show_portrait(name)
    if current_portrait == name then return end  -- уже показан

    -- Скрываем предыдущий портрет (мгновенно)
    if current_portrait and portraits[current_portrait] then
        gui.cancel_animation(portraits[current_portrait], gui.PROP_POSITION)
        gui.cancel_animation(portraits[current_portrait], gui.PROP_COLOR)
        gui.set_enabled(portraits[current_portrait], false)
    end

    current_portrait = name
    local node = portraits[name]
    if not node then return end

    gui.set_enabled(node, true)
    shift_text_for_portrait(true)

    -- Стартовая позиция: за левым краем экрана, прозрачный
    gui.set_position(node, vmath.vector3(PORTRAIT_SLIDE_FROM, PORTRAIT_Y, PORTRAIT_Z))
    gui.set_color(node, vmath.vector4(1, 1, 1, 0))

    -- Анимация: slide-in + fade-in
    gui.animate(node, gui.PROP_POSITION,
        vmath.vector3(PORTRAIT_X, PORTRAIT_Y, PORTRAIT_Z),
        gui.EASING_OUTBACK, PORTRAIT_ANIM_DUR)
    gui.animate(node, gui.PROP_COLOR,
        vmath.vector4(1, 1, 1, 1),
        gui.EASING_OUTQUAD, PORTRAIT_ANIM_DUR)
end

-- Скрыть портрет с анимацией slide-out + fade-out
local function hide_portrait()
    if not current_portrait then return end
    local node = portraits[current_portrait]
    current_portrait = nil
    if not node then return end

    shift_text_for_portrait(false)

    gui.animate(node, gui.PROP_POSITION,
        vmath.vector3(PORTRAIT_SLIDE_FROM, PORTRAIT_Y, PORTRAIT_Z),
        gui.EASING_INBACK, PORTRAIT_ANIM_DUR)
    gui.animate(node, gui.PROP_COLOR,
        vmath.vector4(1, 1, 1, 0),
        gui.EASING_INQUAD, PORTRAIT_ANIM_DUR, 0, function()
            gui.set_enabled(node, false)
        end)
end

-- Нарраторская плашка: терминал + часы 03:47.
-- Появляется в сценах без говорящего (# speaker:none) — вместо пустоты
-- в левом нижнем углу. Всё тематично: курсор терминала (как в wake_intro)
-- и застывшее «кодовое» время петли.
local function show_narrator()
    if narrator_visible then return end
    narrator_visible = true
    gui.set_enabled(narrator_panel,  true)
    gui.set_enabled(narrator_clock,  true)
    gui.set_enabled(narrator_prompt, true)
    gui.set_enabled(narrator_cursor, true)
    -- fade-in
    for _, n in ipairs({ narrator_panel, narrator_clock, narrator_prompt, narrator_cursor }) do
        local c = gui.get_color(n); c.w = 0; gui.set_color(n, c)
    end
    gui.animate(narrator_panel,  "color.w", 0.75, gui.EASING_OUTQUAD, 0.25)
    gui.animate(narrator_clock,  "color.w", 1,    gui.EASING_OUTQUAD, 0.25, 0.05)
    gui.animate(narrator_prompt, "color.w", 1,    gui.EASING_OUTQUAD, 0.25, 0.10)
    gui.animate(narrator_cursor, "color.w", 1,    gui.EASING_OUTQUAD, 0.25, 0.15)
end

local function hide_narrator()
    if not narrator_visible then return end
    narrator_visible = false
    local nodes = { narrator_panel, narrator_clock, narrator_prompt, narrator_cursor }
    for _, n in ipairs(nodes) do
        gui.animate(n, "color.w", 0, gui.EASING_INQUAD, 0.2, 0, function()
            gui.set_enabled(n, false)
        end)
    end
end

-- Обновляет портрет по текущему узлу диалога
local function update_portrait(node)
    if not node or not node.character or node.character == "" then
        hide_portrait()
        show_narrator()
        return
    end
    local portrait_name = get_portrait_name(node.character)
    if portrait_name then
        hide_narrator()
        show_portrait(portrait_name)
    else
        hide_portrait()
        show_narrator()
    end
end

local function show_dialogue_mode(node)
    gui.set_enabled(choice_panel,   false)
    gui.set_enabled(dialogue_panel, true)
    gui.set_enabled(dialogue_text,  true)

    local has_name = node.character and node.character ~= ""
    gui.set_enabled(name_panel, has_name)
    gui.set_enabled(name_label, has_name)
    if has_name then
        gui.set_text(name_label, node.character)
    end

    gui.set_text(dialogue_text, node.text or "")
    gui.set_text(continue_hint, ">>>")  -- сброс после end-mode ("начать заново")
    gui.set_enabled(continue_hint, true)

    update_portrait(node)
end

-- Динамически расставляет кнопки по числу вариантов
local function layout_choices(options)
    local BTN_H   = 54
    local BTN_GAP = 12
    local Q_H     = 22
    local Q_GAP   = 14

    local n = 0
    for i = 1, 4 do
        if options and options[i] then n = n + 1 end
    end
    if n == 0 then return end

    -- Высота всего блока: вопрос + отступ + кнопки
    local block_h = Q_H + Q_GAP + n * BTN_H + (n - 1) * BTN_GAP
    local top     = block_h / 2  -- верхний край блока относительно центра панели

    -- Вопрос
    gui.set_position(choice_question_node,
        vmath.vector3(0, top - Q_H / 2, 0.1))

    -- Кнопки сверху вниз
    local btn_y = top - Q_H - Q_GAP - BTN_H / 2
    for i = 1, 4 do
        if options and options[i] then
            gui.set_position(choice_btns[i],
                vmath.vector3(0, btn_y, 0.10))
            gui.set_position(choice_btn_tops[i],
                vmath.vector3(0, btn_y + BTN_H / 2, 0.15))
            gui.set_position(choice_btn_lefts[i],
                vmath.vector3(-328, btn_y, 0.15))
            btn_y = btn_y - BTN_H - BTN_GAP
        end
    end
end

local function show_choice_mode(node)
    gui.set_enabled(dialogue_panel, false)
    gui.set_enabled(dialogue_text,  false)
    gui.set_enabled(name_panel,     false)
    gui.set_enabled(name_label,     false)
    gui.set_enabled(continue_hint,  false)
    gui.set_enabled(choice_panel,   true)

    hide_portrait()
    hide_narrator()

    gui.set_text(choice_question_node, node.question or "")

    for i = 1, 4 do
        local opt = node.options and node.options[i]
        gui.set_enabled(choice_btns[i],      opt ~= nil)
        gui.set_enabled(choice_texts[i],     opt ~= nil)
        gui.set_enabled(choice_btn_tops[i],  opt ~= nil)
        gui.set_enabled(choice_btn_lefts[i], opt ~= nil)
        if opt then
            gui.set_text(choice_texts[i], opt.text)
        end
    end

    layout_choices(node.options)
end

local function show_end_mode(node)
    gui.set_enabled(choice_panel,   false)
    gui.set_enabled(dialogue_panel, true)
    gui.set_enabled(dialogue_text,  true)
    gui.set_enabled(name_panel,     false)
    gui.set_enabled(name_label,     false)

    hide_portrait()
    hide_narrator()
    gui.set_text(dialogue_text, node.text or "Конец")
    gui.set_text(continue_hint, "начать заново")
    gui.set_enabled(continue_hint, true)
end

local function render()
    set_background(dm.get_background(), dm.get_background_image())
    -- Диспатчим одноразовые эффекты текущего параграфа (sfx/shake/pulse)
    local effects = dm.get_effects()
    if effects then
        for _, e in ipairs(effects) do dispatch_effect(e) end
    end
    local node = dm.get_current_node()
    if not node then return end

    if     node.type == "dialogue" then show_dialogue_mode(node)
    elseif node.type == "choice"   then show_choice_mode(node)
    elseif node.type == "end"      then show_end_mode(node)
    end
end

-- -------------------------------------------------------
-- Меню
-- -------------------------------------------------------

local function show_menu()
    in_menu       = true
    glitch_active = false

    gui.set_enabled(bg_menu_node, true)
    gui.set_enabled(bg_sprite,      false)
    gui.set_enabled(bg_sprite_next, false)
    current_bg_image = nil  -- сброс, чтобы при старте игры фон красиво fade-in
    gui.set_enabled(menu_panel,     true)
    gui.set_enabled(dialogue_panel, false)
    gui.set_enabled(choice_panel,   false)
    gui.set_enabled(continue_hint,  false)
    gui.set_enabled(name_panel,     false)
    gui.set_enabled(name_label,     false)

    -- Скрываем портреты
    for _, node in pairs(portraits) do
        gui.set_enabled(node, false)
    end
    current_portrait = nil

    -- Скрываем нарраторскую плашку
    gui.set_enabled(narrator_panel,  false)
    gui.set_enabled(narrator_clock,  false)
    gui.set_enabled(narrator_prompt, false)
    gui.set_enabled(narrator_cursor, false)
    narrator_visible = false

    sm.load()
    local has = sm.has_save()
    gui.set_enabled(menu_btn_continue,           has)
    gui.set_enabled(menu_btn_continue_text,      has)
    gui.set_enabled(menu_btn_continue_top_line,  has)
    gui.set_enabled(menu_btn_continue_left_line, has)

    -- Каскадное появление: панель + дочерние элементы
    gui.set_color(menu_panel, vmath.vector4(0.02, 0.02, 0.08, 0))
    gui.animate(menu_panel, gui.PROP_COLOR,
        vmath.vector4(0.02, 0.02, 0.08, 0.5), gui.EASING_OUTQUAD, 0.5)

    -- Кнопка «Играть» — без inherit_alpha, анимируем отдельно
    gui.set_color(menu_btn_play, vmath.vector4(0.08, 0.06, 0.30, 0))
    gui.animate(menu_btn_play, gui.PROP_COLOR,
        vmath.vector4(0.08, 0.06, 0.30, 1), gui.EASING_OUTQUAD, 0.30, 0.40)

    -- Кнопка «Продолжить» — с задержкой
    if has then
        gui.set_color(menu_btn_continue, vmath.vector4(0.06, 0.05, 0.22, 0))
        gui.animate(menu_btn_continue, gui.PROP_COLOR,
            vmath.vector4(0.06, 0.05, 0.22, 1), gui.EASING_OUTQUAD, 0.30, 0.55)
    end

    -- Запускаем глитч после окончания анимации появления
    timer.delay(0.75, false, function()
        if in_menu then start_glitch() end
    end)
end

local function start_game()
    glitch_active = false
    in_menu       = false
    gui.set_enabled(bg_menu_node, false)
    gui.set_enabled(menu_panel, false)
    render()
end

-- -------------------------------------------------------
-- Lifecycle
-- -------------------------------------------------------

function init(self)
    bg_node         = gui.get_node("background")
    bg_sprite       = gui.get_node("bg_image")
    bg_sprite_next  = gui.get_node("bg_image_next")
    bg_menu_node    = gui.get_node("bg_menu")
    pulse_overlay   = gui.get_node("pulse_overlay")

    narrator_panel  = gui.get_node("narrator_panel")
    narrator_clock  = gui.get_node("narrator_clock")
    narrator_prompt = gui.get_node("narrator_prompt")
    narrator_cursor = gui.get_node("narrator_cursor")

    -- Портреты персонажей
    portraits["Мила"]    = gui.get_node("portrait_mila")
    portraits["Артём"]   = gui.get_node("portrait_artem")

    dialogue_panel       = gui.get_node("dialogue_panel")
    name_panel           = gui.get_node("name_panel")
    name_label           = gui.get_node("name_label")
    dialogue_text        = gui.get_node("dialogue_text")
    continue_hint        = gui.get_node("continue_hint")
    choice_panel         = gui.get_node("choice_panel")
    choice_question_node = gui.get_node("choice_question")

    for i = 1, 4 do
        choice_btns[i]      = gui.get_node("choice_btn_"  .. i)
        choice_texts[i]     = gui.get_node("choice_text_" .. i)
        choice_btn_tops[i]  = gui.get_node("choice_btn_"  .. i .. "_top")
        choice_btn_lefts[i] = gui.get_node("choice_btn_"  .. i .. "_left")
    end

    menu_panel                   = gui.get_node("menu_panel")
    menu_btn_play                = gui.get_node("menu_btn_play")
    menu_btn_continue            = gui.get_node("menu_btn_continue")
    menu_btn_play_text           = gui.get_node("menu_btn_play_text")
    menu_btn_continue_text       = gui.get_node("menu_btn_continue_text")
    menu_title_glitch_r          = gui.get_node("menu_title_glitch_r")
    menu_title_glitch_b          = gui.get_node("menu_title_glitch_b")
    menu_btn_play_top_line       = gui.get_node("menu_btn_play_top_line")
    menu_btn_play_left_line      = gui.get_node("menu_btn_play_left_line")
    menu_btn_continue_top_line   = gui.get_node("menu_btn_continue_top_line")
    menu_btn_continue_left_line  = gui.get_node("menu_btn_continue_left_line")

    -- Яндекс Игры: инициализация SDK (нужна для показа рекламы в конце новеллы).
    -- Автоопределение языка (2.14) и LoadingAPI.ready уже вызваны в engine_template.html
    -- напрямую через ysdk.environment — срабатывает ДО запуска Defold.
    if yagames then
        yagames.init(function(_, err)
            if err then
                print("YaGames init error: " .. tostring(err))
                return
            end
            ysdk_ready = true

            -- Дублируем чтение языка через Lua SDK — на случай если Яндекс
            -- отслеживает именно обращение через нативный мост.
            local ok, env = pcall(yagames.environment)
            if ok and env and env.i18n then
                game_lang = env.i18n.lang or "ru"
            end
        end)
    end

    show_menu()

    msg.post(".", "acquire_input_focus")
end

function update(self, dt)
    -- Тряска bg-нод: случайный офсет с линейным затуханием.
    -- Работает и в меню — на случай, если захочется потрясти меню
    -- (сейчас не используется, но ничего не ломает).
    if shake_state then
        shake_state.elapsed = shake_state.elapsed + dt
        local t = shake_state.elapsed / shake_state.duration
        if t >= 1 then
            for n, op in pairs(shake_state.origins) do
                gui.set_position(n, op)
            end
            shake_state = nil
        else
            local amp = shake_state.intensity * 20 * (1 - t)
            for n, op in pairs(shake_state.origins) do
                local ox = (math.random() - 0.5) * 2 * amp
                local oy = (math.random() - 0.5) * 2 * amp
                gui.set_position(n, vmath.vector3(op.x + ox, op.y + oy, op.z))
            end
        end
    end

    if in_menu then return end

    -- Мигание курсора терминала (квадратная волна 2 Гц, как настоящий cursor)
    if narrator_visible then
        cursor_blink_t = cursor_blink_t + dt
        local phase = (cursor_blink_t % 1.0) < 0.5
        local c = gui.get_color(narrator_cursor)
        c.w = phase and 1.0 or 0.0
        gui.set_color(narrator_cursor, c)
    end

    local node = dm.get_current_node()
    if node and node.type == "dialogue" then
        hint_timer = hint_timer + dt * HINT_BLINK_SPEED
        local c = gui.get_color(continue_hint)
        c.w = 0.5 + 0.5 * math.sin(hint_timer * math.pi)
        gui.set_color(continue_hint, c)
    end
end

-- -------------------------------------------------------
-- Обработка ввода
-- -------------------------------------------------------

function on_input(self, action_id, action)
    if not action.pressed then return false end

    -- Запускаем музыку при первом касании (браузеры блокируют autoplay)
    if not music_started then
        music_started = true
        msg.post("/music_player#sound", "play_sound", { delay = 0, gain = 0.7 })
    end

    if action_id == hash("touch") then

        -- ---- Меню ----
        if in_menu then
            if gui.pick_node(menu_btn_play, action.x, action.y) then
                -- Вспышка на border при клике
                gui.animate(menu_btn_play_top_line, gui.PROP_COLOR,
                    vmath.vector4(1.0, 0.85, 1.0, 1), gui.EASING_OUTQUAD, 0.06)
                local bytes = load_story_bytes()
                if not bytes then return true end
                sm.new_game()
                dm.init(bytes)
                start_game()
                return true
            end

            if sm.has_save()
            and gui.pick_node(menu_btn_continue, action.x, action.y) then
                gui.animate(menu_btn_continue_top_line, gui.PROP_COLOR,
                    vmath.vector4(0.85, 0.65, 1.0, 1), gui.EASING_OUTQUAD, 0.06)
                local bytes = load_story_bytes()
                if not bytes then return true end
                dm.load_saved(bytes)
                start_game()
                return true
            end

            return false
        end

        -- ---- Игра ----
        local node = dm.get_current_node()
        if not node then return false end

        if node.type == "dialogue" then
            dm.advance()
            render()
            hint_timer = 0
            return true

        elseif node.type == "choice" then
            for i = 1, 4 do
                if gui.is_enabled(choice_btns[i])
                and gui.pick_node(choice_btns[i], action.x, action.y) then
                    dm.choose(i)
                    render()
                    return true
                end
            end

        elseif node.type == "end" then
            -- Защита от двойного вызова show_menu (callback'и Яндекса +
            -- страховочный таймер могут сработать одновременно).
            local menu_returned = false
            local function go_to_menu()
                if menu_returned then return end
                menu_returned = true
                show_menu()
            end

            if yagames and ysdk_ready then
                -- Страховочный таймер: если реклама зависла или callback'и
                -- не придут — через 30 сек всё равно уходим в меню.
                timer.delay(30, false, function() go_to_menu() end)

                local ok, err = pcall(yagames.adv_show_fullscreen_adv, {
                    close   = function(_, was_shown) go_to_menu() end,
                    error   = function(_, e)         go_to_menu() end,
                    offline = function(_)            go_to_menu() end,
                })
                if not ok then
                    print("adv pcall failed: " .. tostring(err))
                    go_to_menu()
                end
            else
                go_to_menu()
            end
            return true
        end
    end

    return false
end
