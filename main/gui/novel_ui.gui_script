-- -------------------------------------------------------
-- Глитч-эффект на заголовке (как в Steins;Gate / DDLC)
-- -------------------------------------------------------
local function start_glitch()
    S.glitch_active = true
    local function do_glitch()
        if not S.glitch_active then return end

        local pr = gui.get_position(S.menu_title_glitch_r)
        local pb = gui.get_position(S.menu_title_glitch_b)
        pr.x = math.random(-6, 6)
        pb.x = math.random(-6, 6)
        gui.set_position(S.menu_title_glitch_r, pr)
        gui.set_position(S.menu_title_glitch_b, pb)

        local cr = gui.get_color(S.menu_title_glitch_r)
        local cb = gui.get_color(S.menu_title_glitch_b)
        cr.w = math.random(2, 5) * 0.1
        cb.w = math.random(1, 4) * 0.1
        gui.set_color(S.menu_title_glitch_r, cr)
        gui.set_color(S.menu_title_glitch_b, cb)

        timer.delay(math.random(3, 8) + math.random(), false, do_glitch)
    end
    timer.delay(math.random(2, 5), false, do_glitch)
end

-- -------------------------------------------------------
-- Вспомогательные функции — игровой экран
-- -------------------------------------------------------

-- Переключает фон с плавным crossfade (BG_FADE_DUR). bg_image == nil или
-- "none" → сцена без картинки (виден только цвет подложки).
-- Схема: два слоя (bg_sprite + bg_sprite_next, next чуть выше по z).
-- При смене: на next ставим новую картинку, fade alpha 0→1, после
-- завершения — копируем результат на sprite, next прячем с alpha=0.
-- Если имя не меняется — ничего не делаем (render() зовётся часто).
local function normalize_bg(name)
    if name == nil or name == "none" then return nil end
    return name
end

local function set_background(bg, bg_image)
    -- Подложка: цвет меняем всегда (дёшево, без анимации).
    gui.set_color(S.bg_node, vmath.vector4(bg.r, bg.g, bg.b, 1))

    local target = normalize_bg(bg_image)
    if target == S.current_bg_image then return end  -- та же картинка — не дёргаем

    -- Отменяем незавершённый фейд, чтобы не было наложения анимаций.
    gui.cancel_animation(S.bg_sprite_next, "color.w")
    gui.cancel_animation(S.bg_sprite,      "color.w")

    if target == nil then
        -- Фейд текущего фона в прозрачность.
        gui.animate(S.bg_sprite, "color.w", 0, gui.EASING_INOUTQUAD, S.BG_FADE_DUR, 0,
            function() gui.set_enabled(S.bg_sprite, false) end)
        S.current_bg_image = nil
        return
    end

    local ok, err = pcall(gui.play_flipbook, S.bg_sprite_next, target)
    if not ok then
        print("[novel_ui] ❌ фон не найден в атласе: " .. tostring(target) ..
              " (" .. tostring(err) .. ")")
        return
    end

    -- Стартуем next с alpha=0 и фейдим до 1. После завершения
    -- переносим картинку на sprite и прячем next.
    gui.set_enabled(S.bg_sprite_next, true)
    local c = gui.get_color(S.bg_sprite_next); c.w = 0; gui.set_color(S.bg_sprite_next, c)

    -- Если sprite был выключен (первый показ после none) — включаем с alpha=1,
    -- чтобы next корректно смешивался поверх пустоты.
    if not gui.is_enabled(S.bg_sprite) then
        gui.set_enabled(S.bg_sprite, true)
        local cs = gui.get_color(S.bg_sprite); cs.w = 1; gui.set_color(S.bg_sprite, cs)
    end

    gui.animate(S.bg_sprite_next, "color.w", 1, gui.EASING_INOUTQUAD, S.BG_FADE_DUR, 0,
        function()
            pcall(gui.play_flipbook, S.bg_sprite, target)
            local cs2 = gui.get_color(S.bg_sprite); cs2.w = 1; gui.set_color(S.bg_sprite, cs2)
            gui.set_enabled(S.bg_sprite, true)
            local cn = gui.get_color(S.bg_sprite_next); cn.w = 0; gui.set_color(S.bg_sprite_next, cn)
            gui.set_enabled(S.bg_sprite_next, false)
        end)

    S.current_bg_image = target
end

-- -------------------------------------------------------
-- Эффекты из ink-тегов: sfx / shake / pulse
-- -------------------------------------------------------

-- Реестр звуков: имя из `# sfx:NAME` → url sound-компонента.
-- Пока пусто — когда появятся .sound файлы, регистрируй их здесь, например:
--   SFX_URLS["heartbeat"] = msg.url("main:/sfx_player#heartbeat")
-- Если имя отсутствует — печатаем WARN и идём дальше (игра не ломается).

local function play_sfx(name)
    local url = S.SFX_URLS[name]
    if url then
        msg.post(url, "play_sound", { delay = 0, gain = 0.6 })
    else
        print("[sfx] " .. tostring(name) .. " — звук не подключён (см. SFX_URLS)")
    end
end

-- Запускаем тряску: собираем исходные позиции bg-нод, update() каждый
-- кадр мажет случайный офсет с затуханием. По истечении duration —
-- возвращаем ноды на место.
local function start_shake(intensity, duration)
    if duration <= 0 then return end
    local nodes = { S.bg_sprite, S.bg_sprite_next }
    local origins = {}
    for _, n in ipairs(nodes) do
        origins[n] = gui.get_position(n)
    end
    S.shake_state = {
        elapsed   = 0,
        duration  = duration,
        intensity = intensity,
        origins   = origins,
    }
end

-- Коротая вспышка-оверлей: alpha 0 → 1 (быстро) → 0 (плавно).
local function pulse_flash(duration, r, g, b)
    local c = vmath.vector4(r, g, b, 0)
    gui.set_color(S.pulse_overlay, c)
    gui.set_enabled(S.pulse_overlay, true)

    local up   = duration * 0.3
    local down = duration * 0.7
    gui.animate(S.pulse_overlay, "color.w", 0.6, gui.EASING_OUTQUAD, up, 0, function()
        gui.animate(S.pulse_overlay, "color.w", 0, gui.EASING_INQUAD, down, 0, function()
            gui.set_enabled(S.pulse_overlay, false)
        end)
    end)
end

local function dispatch_effect(e)
    if     e.type == "sfx"   then play_sfx(e.name)
    elseif e.type == "shake" then start_shake(e.intensity or 0.2, e.duration or 0.4)
    elseif e.type == "pulse" then pulse_flash(e.duration or 0.5, e.r or 1, e.g or 1, e.b or 1)
    end
end

-- -------------------------------------------------------
-- Портреты персонажей (стиль Persona 5)
-- -------------------------------------------------------

-- Определяет, какой портрет показать для данного имени персонажа
local function get_portrait_name(character_name)
    if character_name == "Мила" then return "Мила" end
    if character_name == "Артём" then return "Артём" end
    return nil
end

-- Сдвигает текст и имя вправо (под портрет) или возвращает на место
local function shift_text_for_portrait(has_portrait)
    local tx = has_portrait and S.TEXT_X_PORTRAIT or S.TEXT_X_NORMAL
    local tw = has_portrait and S.TEXT_W_PORTRAIT or S.TEXT_W_NORMAL
    local nx = has_portrait and S.NAME_X_PORTRAIT or S.NAME_X_NORMAL

    gui.set_position(S.dialogue_text, vmath.vector3(tx, S.TEXT_Y, 0.3))
    gui.set_size(S.dialogue_text, vmath.vector3(tw, 130, 0))

    gui.set_position(S.name_panel, vmath.vector3(nx, S.NAME_Y, 0.2))
    gui.set_position(S.name_label, vmath.vector3(nx, S.NAME_Y, 0.3))
end

-- Показать портрет с анимацией slide-in слева + fade-in
local function show_portrait(name)
    if S.current_portrait == name then return end  -- уже показан

    -- Скрываем предыдущий портрет (мгновенно)
    if S.current_portrait and S.portraits[S.current_portrait] then
        gui.cancel_animation(S.portraits[S.current_portrait], gui.PROP_POSITION)
        gui.cancel_animation(S.portraits[S.current_portrait], gui.PROP_COLOR)
        gui.set_enabled(S.portraits[S.current_portrait], false)
    end

    S.current_portrait = name
    local node = S.portraits[name]
    if not node then return end

    gui.set_enabled(node, true)
    shift_text_for_portrait(true)

    -- Стартовая позиция: за левым краем экрана, прозрачный
    gui.set_position(node, vmath.vector3(S.PORTRAIT_SLIDE_FROM, S.PORTRAIT_Y, S.PORTRAIT_Z))
    gui.set_color(node, vmath.vector4(1, 1, 1, 0))

    -- Анимация: slide-in + fade-in
    gui.animate(node, gui.PROP_POSITION,
        vmath.vector3(S.PORTRAIT_X, S.PORTRAIT_Y, S.PORTRAIT_Z),
        gui.EASING_OUTBACK, S.PORTRAIT_ANIM_DUR)
    gui.animate(node, gui.PROP_COLOR,
        vmath.vector4(1, 1, 1, 1),
        gui.EASING_OUTQUAD, S.PORTRAIT_ANIM_DUR)
end

-- Скрыть портрет с анимацией slide-out + fade-out
local function hide_portrait()
    if not S.current_portrait then return end
    local node = S.portraits[S.current_portrait]
    S.current_portrait = nil
    if not node then return end

    shift_text_for_portrait(false)

    gui.animate(node, gui.PROP_POSITION,
        vmath.vector3(S.PORTRAIT_SLIDE_FROM, S.PORTRAIT_Y, S.PORTRAIT_Z),
        gui.EASING_INBACK, S.PORTRAIT_ANIM_DUR)
    gui.animate(node, gui.PROP_COLOR,
        vmath.vector4(1, 1, 1, 0),
        gui.EASING_INQUAD, S.PORTRAIT_ANIM_DUR, 0, function()
            gui.set_enabled(node, false)
        end)
end

-- Нарраторская плашка: терминал + часы 03:47.
-- Появляется в сценах без говорящего (# speaker:none) — вместо пустоты
-- в левом нижнем углу. Всё тематично: курсор терминала (как в wake_intro)
-- и застывшее «кодовое» время петли.
local function show_narrator()
    if S.narrator_visible then return end
    S.narrator_visible = true
    gui.set_enabled(S.narrator_panel,  true)
    gui.set_enabled(S.narrator_clock,  true)
    gui.set_enabled(S.narrator_prompt, true)
    gui.set_enabled(S.narrator_cursor, true)
    -- fade-in
    for _, n in ipairs({ S.narrator_panel, S.narrator_clock, S.narrator_prompt, S.narrator_cursor }) do
        local c = gui.get_color(n); c.w = 0; gui.set_color(n, c)
    end
    gui.animate(S.narrator_panel,  "color.w", 0.75, gui.EASING_OUTQUAD, 0.25)
    gui.animate(S.narrator_clock,  "color.w", 1,    gui.EASING_OUTQUAD, 0.25, 0.05)
    gui.animate(S.narrator_prompt, "color.w", 1,    gui.EASING_OUTQUAD, 0.25, 0.10)
    gui.animate(S.narrator_cursor, "color.w", 1,    gui.EASING_OUTQUAD, 0.25, 0.15)
end

local function hide_narrator()
    if not S.narrator_visible then return end
    S.narrator_visible = false
    local nodes = { S.narrator_panel, S.narrator_clock, S.narrator_prompt, S.narrator_cursor }
    for _, n in ipairs(nodes) do
        gui.animate(n, "color.w", 0, gui.EASING_INQUAD, 0.2, 0, function()
            gui.set_enabled(n, false)
        end)
    end
end

-- Обновляет портрет по текущему узлу диалога
local function update_portrait(node)
    if not node or not node.character or node.character == "" then
        hide_portrait()
        show_narrator()
        return
    end
    local portrait_name = get_portrait_name(node.character)
    if portrait_name then
        hide_narrator()
        show_portrait(portrait_name)
    else
        hide_portrait()
        show_narrator()
    end
end

local function show_dialogue_mode(node)
    gui.set_enabled(S.choice_panel,   false)
    gui.set_enabled(S.dialogue_panel, true)
    gui.set_enabled(S.dialogue_text,  true)

    local has_name = node.character and node.character ~= ""
    gui.set_enabled(S.name_panel, has_name)
    gui.set_enabled(S.name_label, has_name)
    if has_name then
        gui.set_text(S.name_label, node.character)
    end

    gui.set_text(S.dialogue_text, node.text or "")
    gui.set_text(S.continue_hint, ">>>")  -- сброс после end-mode ("начать заново")
    gui.set_enabled(S.continue_hint, true)

    update_portrait(node)
end

-- Динамически расставляет кнопки по числу вариантов
local function layout_choices(options)
    local BTN_H   = 54
    local BTN_GAP = 12
    local Q_H     = 22
    local Q_GAP   = 14

    local n = 0
    for i = 1, 4 do
        if options and options[i] then n = n + 1 end
    end
    if n == 0 then return end

    -- Высота всего блока: вопрос + отступ + кнопки
    local block_h = Q_H + Q_GAP + n * BTN_H + (n - 1) * BTN_GAP
    local top     = block_h / 2  -- верхний край блока относительно центра панели

    -- Вопрос
    gui.set_position(S.choice_question_node,
        vmath.vector3(0, top - Q_H / 2, 0.1))

    -- Кнопки сверху вниз
    local btn_y = top - Q_H - Q_GAP - BTN_H / 2
    for i = 1, 4 do
        if options and options[i] then
            gui.set_position(S.choice_btns[i],
                vmath.vector3(0, btn_y, 0.10))
            gui.set_position(S.choice_btn_tops[i],
                vmath.vector3(0, btn_y + BTN_H / 2, 0.15))
            gui.set_position(S.choice_btn_lefts[i],
                vmath.vector3(-328, btn_y, 0.15))
            btn_y = btn_y - BTN_H - BTN_GAP
        end
    end
end

local function show_choice_mode(node)
    gui.set_enabled(S.dialogue_panel, false)
    gui.set_enabled(S.dialogue_text,  false)
    gui.set_enabled(S.name_panel,     false)
    gui.set_enabled(S.name_label,     false)
    gui.set_enabled(S.continue_hint,  false)
    gui.set_enabled(S.choice_panel,   true)

    hide_portrait()
    hide_narrator()

    gui.set_text(S.choice_question_node, node.question or "")

    for i = 1, 4 do
        local opt = node.options and node.options[i]
        gui.set_enabled(S.choice_btns[i],      opt ~= nil)
        gui.set_enabled(S.choice_texts[i],     opt ~= nil)
        gui.set_enabled(S.choice_btn_tops[i],  opt ~= nil)
        gui.set_enabled(S.choice_btn_lefts[i], opt ~= nil)
        if opt then
            gui.set_text(S.choice_texts[i], opt.text)
        end
    end

    layout_choices(node.options)
end

local function show_end_mode(node)
    gui.set_enabled(S.choice_panel,   false)
    gui.set_enabled(S.dialogue_panel, true)
    gui.set_enabled(S.dialogue_text,  true)
    gui.set_enabled(S.name_panel,     false)
    gui.set_enabled(S.name_label,     false)

    hide_portrait()
    hide_narrator()
    gui.set_text(S.dialogue_text, node.text or "Конец")
    gui.set_text(S.continue_hint, "начать заново")
    gui.set_enabled(S.continue_hint, true)
end

-- Прячет всё что относится к dialogue-режиму. Используется когда
-- scene_controller становится активным (exploration overrides dialogue).
local function hide_dialogue_ui()
    gui.set_enabled(S.dialogue_panel, false)
    gui.set_enabled(S.dialogue_text,  false)
    gui.set_enabled(S.name_panel,     false)
    gui.set_enabled(S.name_label,     false)
    gui.set_enabled(S.continue_hint,  false)
    gui.set_enabled(S.choice_panel,   false)
    hide_portrait()
    hide_narrator()
end

local function render()
    -- Сначала применяем команды из ink (flag/item/quest/enter_scene).
    -- Важно делать это ДО get_current_node/рендера, чтобы enter_scene
    -- перехватил управление до того, как мы нарисуем dialogue-узел.
    if dm.get_commands then
        local commands = dm.get_commands()
        if commands then
            for _, c in ipairs(commands) do
                if     c.type == "set_flag"        then gs.set_flag(c.flag, c.value)
                elseif c.type == "add_item"        then gs.add_item(c.item)
                elseif c.type == "remove_item"     then gs.remove_item(c.item)
                elseif c.type == "set_quest"       then gs.set_quest(c.quest, c.status)
                elseif c.type == "add_sms"         then gs.add_sms(c.contact, c.text)
                elseif c.type == "add_note"        then gs.add_note(c.title, c.body)
                elseif c.type == "enter_scene"     then scene_controller.enter(c.scene)
                elseif c.type == "return_to_scene" then scene_controller.return_to_last_scene()
                elseif c.type == "phone_close"     then
                    -- Возврат в сцену-вызыватель телефона (сохранена в flag).
                    local caller = gs.get_flag("_phone_return_scene")
                    if caller then
                        gs.set_flag("_phone_return_scene", nil)
                        scene_controller.enter(caller)
                    else
                        scene_controller.return_to_last_scene()
                    end
                end
            end
        end
    end

    -- Если активен point-and-click слой — прячем диалог и отдаём
    -- управление scene_controller'у (он уже отрисовал фон/hotspot'ы
    -- при enter() через UI-интерфейс).
    if scene_controller.is_active() then
        hide_dialogue_ui()
        return
    end

    -- Dialogue-режим: hotspot'ы предыдущей сцены должны быть спрятаны
    -- (иначе «висят» поверх новых фонов вроде крыши/метро).
    for i = 1, S.HOTSPOT_COUNT do
        gui.set_enabled(S.hotspot_boxes[i],   false)
        gui.set_enabled(S.hotspot_labels[i],  false)
        gui.set_enabled(S.hotspot_icons[i],   false)
        gui.set_enabled(S.hotspot_circles[i], false)
        gui.set_enabled(S.hotspot_rings[i],   false)
        gui.set_enabled(S.hotspot_orbits[i],  false)
        for d = 1, S.ORBIT_DOTS do
            gui.set_enabled(S.hotspot_dots[i][d], false)
        end
    end
    for i = 1, S.SCENE_OBJECT_COUNT do
        gui.set_enabled(S.scene_obj_nodes[i], false)
    end

    set_background(dm.get_background(), dm.get_background_image())
    -- Диспатчим одноразовые эффекты текущего параграфа (sfx/shake/pulse)
    local effects = dm.get_effects()
    if effects then
        for _, e in ipairs(effects) do dispatch_effect(e) end
    end
    local node = dm.get_current_node()
    if not node then return end

    if     node.type == "dialogue" then show_dialogue_mode(node)
    elseif node.type == "choice"   then show_choice_mode(node)
    elseif node.type == "end"      then show_end_mode(node)
    end
end

-- -------------------------------------------------------
-- Меню
-- -------------------------------------------------------

local function show_menu()
    S.in_menu       = true
    S.glitch_active = false

    gui.set_enabled(S.bg_menu_node, true)
    gui.set_enabled(S.bg_sprite,      false)
    gui.set_enabled(S.bg_sprite_next, false)
    S.current_bg_image = nil  -- сброс, чтобы при старте игры фон красиво fade-in
    gui.set_enabled(S.menu_panel,     true)
    gui.set_enabled(S.dialogue_panel, false)
    gui.set_enabled(S.choice_panel,   false)
    gui.set_enabled(S.continue_hint,  false)
    gui.set_enabled(S.name_panel,     false)
    gui.set_enabled(S.name_label,     false)

    -- Скрываем портреты
    for _, node in pairs(S.portraits) do
        gui.set_enabled(node, false)
    end
    S.current_portrait = nil

    -- Скрываем нарраторскую плашку
    gui.set_enabled(S.narrator_panel,  false)
    gui.set_enabled(S.narrator_clock,  false)
    gui.set_enabled(S.narrator_prompt, false)
    gui.set_enabled(S.narrator_cursor, false)
    S.narrator_visible = false

    -- Скрываем hotspot-слоты и гасим scene_controller (если был активен)
    for i = 1, S.HOTSPOT_COUNT do
        gui.set_enabled(S.hotspot_boxes[i],   false)
        gui.set_enabled(S.hotspot_labels[i],  false)
        gui.set_enabled(S.hotspot_icons[i],   false)
        gui.set_enabled(S.hotspot_circles[i], false)
        gui.set_enabled(S.hotspot_rings[i],   false)
        gui.set_enabled(S.hotspot_orbits[i],  false)
        for d = 1, S.ORBIT_DOTS do
            gui.set_enabled(S.hotspot_dots[i][d], false)
        end
    end
    for i = 1, S.SCENE_OBJECT_COUNT do
        gui.set_enabled(S.scene_obj_nodes[i], false)
    end
    scene_controller.exit()

    -- Скрываем HUD (рюкзак/телефон) — в меню они не нужны
    if S.hud and S.hud.backpack and S.hud.backpack.circle then
        S.ui.set_hud_icon_enabled(S.hud.backpack, false)
        S.ui.set_hud_icon_enabled(S.hud.phone,    false)
    end

    sm.load()
    local has = sm.has_save()
    -- Кнопка «Продолжить» видна всегда, но при отсутствии save показывается
    -- притушённой и клик по ней не срабатывает (см. on_input).
    local cont_a = has and 1.0 or 0.35
    local cont_t = gui.get_color(S.menu_btn_continue_text); cont_t.w = cont_a
    gui.set_color(S.menu_btn_continue_text, cont_t)

    -- Галерея/Достижения — заглушки (в этом спринте не реализованы),
    -- поэтому их тексты тоже тусклые.
    for _, node in ipairs({ S.menu_btn_gallery_text, S.menu_btn_awards_text }) do
        local c = gui.get_color(node); c.w = 0.55
        gui.set_color(node, c)
    end

    -- Каскадное появление: сам menu_panel контейнер прозрачен (фон уже
    -- даёт bg_menu), но через inherit_alpha все вложенные ноды плавно
    -- поднимаются от 0 до 1. Для этого анимируем alpha корневой ноды.
    local mc = gui.get_color(S.menu_panel); mc.w = 0
    gui.set_color(S.menu_panel, mc)
    gui.animate(S.menu_panel, "color.w", 1.0, gui.EASING_OUTQUAD, 0.5)

    -- Запускаем глитч после окончания анимации появления
    timer.delay(0.75, false, function()
        if S.in_menu then start_glitch() end
    end)
end

local function start_game()
    S.glitch_active = false
    S.in_menu       = false
    gui.set_enabled(S.bg_menu_node, false)
    gui.set_enabled(S.menu_panel, false)
    S.ui.render_hud()
    render()
end

-- -------------------------------------------------------
-- HUD и модалки (инвентарь + карточка предмета)
-- Все функции кладём в таблицу ui — так они занимают 1 upvalue
-- в init()/on_input() вместо 8 (Lua limit 60).
-- -------------------------------------------------------

-- Включает/выключает все ноды HUD-иконки (backpack или phone).
S.ui.set_hud_icon_enabled = function(icon, on)
    if not icon or not icon.circle then return end
    gui.set_enabled(icon.circle, on)
    gui.set_enabled(icon.ring,   on)
    gui.set_enabled(icon.icon,   on)
    gui.set_enabled(icon.hit,    on)
end

-- Перерисовывает HUD: рюкзак всегда, телефон — по флагу has_phone.
S.ui.render_hud = function()
    if not S.hud.backpack.circle then return end   -- init ещё не прошёл
    S.ui.set_hud_icon_enabled(S.hud.backpack, true)
    S.ui.set_hud_icon_enabled(S.hud.phone, gs.get_flag("has_phone") == true)
end

-- Заполняет сетку slot_1..slot_12 из gs.get_inventory().
S.ui.render_inv_slots = function()
    if not S.inv_modal.slots[1] then return end
    local inv = gs.get_inventory()
    for i = 1, S.inv_modal.COUNT do
        local s = S.inv_modal.slots[i]
        local item_id = inv[i]
        local item = item_id and items_catalog.get(item_id)
        if item then
            gui.set_text(s.icon, item.icon or "?")
            gui.set_enabled(s.circle, true)
            gui.set_enabled(s.ring,   true)
            gui.set_enabled(s.icon,   true)
            gui.set_enabled(s.hit,    true)
            s.item_id = item_id
        else
            gui.set_enabled(s.circle, false)
            gui.set_enabled(s.ring,   false)
            gui.set_enabled(s.icon,   false)
            gui.set_enabled(s.hit,    false)
            s.item_id = nil
        end
    end
end

-- Показать/скрыть инвентарную модалку (клик по рюкзаку).
S.ui.show_inv_modal = function()
    S.ui.render_inv_slots()
    gui.set_enabled(S.inv_modal.dim,         true)
    gui.set_enabled(S.inv_modal.panel,       true)
    gui.set_enabled(S.inv_modal.title,       true)
    gui.set_enabled(S.inv_modal.close_btn,   true)
    gui.set_enabled(S.inv_modal.close_text,  true)
    S.inv_modal.visible = true
end

S.ui.hide_inv_modal = function()
    gui.set_enabled(S.inv_modal.dim,         false)
    gui.set_enabled(S.inv_modal.panel,       false)
    gui.set_enabled(S.inv_modal.title,       false)
    gui.set_enabled(S.inv_modal.close_btn,   false)
    gui.set_enabled(S.inv_modal.close_text,  false)
    for i = 1, S.inv_modal.COUNT do
        local s = S.inv_modal.slots[i]
        if s and s.circle then
            gui.set_enabled(s.circle, false)
            gui.set_enabled(s.ring,   false)
            gui.set_enabled(s.icon,   false)
            gui.set_enabled(s.hit,    false)
        end
    end
    S.inv_modal.visible = false
end

-- Модалка описания предмета (поверх инвентарной).
S.ui.show_item_modal = function(item_id)
    local item = items_catalog.get(item_id)
    if not item then return end
    gui.set_text(S.item_modal.name, item.name or "")
    gui.set_text(S.item_modal.icon, item.icon or "?")
    gui.set_text(S.item_modal.desc, item.description or "")
    gui.set_enabled(S.item_modal.dim,        true)
    gui.set_enabled(S.item_modal.panel,      true)
    gui.set_enabled(S.item_modal.name,       true)
    gui.set_enabled(S.item_modal.icon,       true)
    gui.set_enabled(S.item_modal.desc,       true)
    gui.set_enabled(S.item_modal.close_btn,  true)
    gui.set_enabled(S.item_modal.close_text, true)
    S.item_modal.visible = true
    S.item_modal.item_id = item_id
end

S.ui.hide_item_modal = function()
    gui.set_enabled(S.item_modal.dim,        false)
    gui.set_enabled(S.item_modal.panel,      false)
    gui.set_enabled(S.item_modal.name,       false)
    gui.set_enabled(S.item_modal.icon,       false)
    gui.set_enabled(S.item_modal.desc,       false)
    gui.set_enabled(S.item_modal.close_btn,  false)
    gui.set_enabled(S.item_modal.close_text, false)
    S.item_modal.visible = false
    S.item_modal.item_id = nil
end

-- Открыть телефон. Телефон — обычная point-and-click сцена phone_home
-- (bg_phone.jpg + 4 иконки приложений + закрыть). Чтобы знать, куда
-- возвращаться после закрытия, запоминаем текущую exploration-сцену
-- во флаге _phone_return_scene; команда `phone_close` в render()
-- прочитает её и вернёт игрока на место.
S.ui.open_phone_ui = function()
    if not gs.get_flag("has_phone") then return end
    -- Если уже открыт — ничего не делаем (защита от повторных кликов).
    if scene_controller.get_current_scene_id() == "phone_home" then return end
    local caller = scene_controller.get_current_scene_id()
    if caller then
        gs.set_flag("_phone_return_scene", caller)
    end
    scene_controller.enter("phone_home")
end

-- -------------------------------------------------------
-- Lifecycle
-- -------------------------------------------------------

function init(self)
    S.bg_node         = gui.get_node("background")
    S.bg_sprite       = gui.get_node("bg_image")
    S.bg_sprite_next  = gui.get_node("bg_image_next")
    S.bg_menu_node    = gui.get_node("bg_menu")
    S.pulse_overlay   = gui.get_node("pulse_overlay")

    S.narrator_panel  = gui.get_node("narrator_panel")
    S.narrator_clock  = gui.get_node("narrator_clock")
    S.narrator_prompt = gui.get_node("narrator_prompt")
    S.narrator_cursor = gui.get_node("narrator_cursor")

    -- Портреты персонажей
    S.portraits["Мила"]    = gui.get_node("portrait_mila")
    S.portraits["Артём"]   = gui.get_node("portrait_artem")

    S.dialogue_panel       = gui.get_node("dialogue_panel")
    S.name_panel           = gui.get_node("name_panel")
    S.name_label           = gui.get_node("name_label")
    S.dialogue_text        = gui.get_node("dialogue_text")
    S.continue_hint        = gui.get_node("continue_hint")
    S.choice_panel         = gui.get_node("choice_panel")
    S.choice_question_node = gui.get_node("choice_question")

    for i = 1, 4 do
        S.choice_btns[i]      = gui.get_node("choice_btn_"  .. i)
        S.choice_texts[i]     = gui.get_node("choice_text_" .. i)
        S.choice_btn_tops[i]  = gui.get_node("choice_btn_"  .. i .. "_top")
        S.choice_btn_lefts[i] = gui.get_node("choice_btn_"  .. i .. "_left")
    end

    S.menu_panel                   = gui.get_node("menu_panel")
    S.menu_btn_new                 = gui.get_node("menu_btn_new")
    S.menu_btn_continue            = gui.get_node("menu_btn_continue")
    S.menu_btn_gallery             = gui.get_node("menu_btn_gallery")
    S.menu_btn_awards              = gui.get_node("menu_btn_awards")
    S.menu_btn_new_text            = gui.get_node("menu_btn_new_text")
    S.menu_btn_continue_text       = gui.get_node("menu_btn_continue_text")
    S.menu_btn_gallery_text        = gui.get_node("menu_btn_gallery_text")
    S.menu_btn_awards_text         = gui.get_node("menu_btn_awards_text")
    S.menu_title_glitch_r          = gui.get_node("menu_title_glitch_r")
    S.menu_title_glitch_b          = gui.get_node("menu_title_glitch_b")
    S.menu_hint_node               = gui.get_node("menu_hint")

    -- Пул hotspot-слотов для scene_controller.
    -- Каждый hotspot имеет визуальный стек:
    --   hotspot_circles[i]  — круглая тёмная подложка (PIE)
    --   hotspot_rings[i]    — оранжевое glow-кольцо (PIE inner_radius)
    --   hotspot_icons[i]    — Material Icons символ в центре
    --   hotspot_orbits[i]   — невидимый parent, крутится вокруг своей оси
    --   hotspot_dots[i][d]  — 6 точек-детей orbit_parent'а
    -- + интерактивный bounding box hotspot_boxes[i] и подпись hotspot_labels[i]
    for i = 1, S.HOTSPOT_COUNT do
        S.hotspot_boxes[i]   = gui.get_node("hotspot_" .. i)
        S.hotspot_labels[i]  = gui.get_node("hotspot_label_" .. i)
        S.hotspot_icons[i]   = gui.get_node("hotspot_icon_" .. i)
        S.hotspot_circles[i] = gui.get_node("hotspot_circle_" .. i)
        S.hotspot_rings[i]   = gui.get_node("hotspot_ring_" .. i)
        S.hotspot_orbits[i]  = gui.get_node("hotspot_orbit_" .. i)
        S.hotspot_dots[i]    = {}
        for d = 1, S.ORBIT_DOTS do
            S.hotspot_dots[i][d] = gui.get_node("hotspot_dot_" .. i .. "_" .. d)
        end

        -- Вращение orbit-parent'а делаем вручную в update(), а не через
        -- gui.animate: LOOP_FORWARD на PROP_ROTATION капризничает из-за
        -- нормализации углов — точки «прыгали». Ручной поворот в update
        -- даёт гарантированно плавное бесконечное вращение.
        gui.set_rotation(S.hotspot_orbits[i], vmath.vector3(0, 0, 0))
    end

    -- Пул нод для спрайтов-оверлеев сцены
    for i = 1, S.SCENE_OBJECT_COUNT do
        S.scene_obj_nodes[i] = gui.get_node("scene_obj_" .. i)
    end

    -- HUD: 2 постоянные иконки (backpack всегда, phone по флагу has_phone).
    S.hud.backpack = {
        circle = gui.get_node("hud_backpack_circle"),
        ring   = gui.get_node("hud_backpack_ring"),
        icon   = gui.get_node("hud_backpack_icon"),
        hit    = gui.get_node("hud_backpack_hit"),
    }
    S.hud.phone = {
        circle = gui.get_node("hud_phone_circle"),
        ring   = gui.get_node("hud_phone_ring"),
        icon   = gui.get_node("hud_phone_icon"),
        hit    = gui.get_node("hud_phone_hit"),
    }

    -- Инвентарная модалка: panel + title + close + 12 слотов.
    S.inv_modal.dim         = gui.get_node("inv_modal_dim")
    S.inv_modal.panel       = gui.get_node("inv_modal_panel")
    S.inv_modal.title       = gui.get_node("inv_modal_title")
    S.inv_modal.close_btn   = gui.get_node("inv_modal_close_btn")
    S.inv_modal.close_text  = gui.get_node("inv_modal_close_text")
    for i = 1, S.inv_modal.COUNT do
        S.inv_modal.slots[i] = {
            circle  = gui.get_node("inv_slot_circle_" .. i),
            ring    = gui.get_node("inv_slot_ring_"   .. i),
            icon    = gui.get_node("inv_slot_icon_"   .. i),
            hit     = gui.get_node("inv_slot_hit_"    .. i),
            item_id = nil,
        }
    end

    -- Модалка описания предмета (поверх инвентарной).
    S.item_modal.dim        = gui.get_node("item_modal_dim")
    S.item_modal.panel      = gui.get_node("item_modal_panel")
    S.item_modal.name       = gui.get_node("item_modal_name")
    S.item_modal.icon       = gui.get_node("item_modal_icon")
    S.item_modal.desc       = gui.get_node("item_modal_desc")
    S.item_modal.close_btn  = gui.get_node("item_modal_close_btn")
    S.item_modal.close_text = gui.get_node("item_modal_close_text")

    -- UI-интерфейс для scene_controller: фон, слоты, возврат в ink.
    scene_controller.set_ui({
        max_hotspots = function() return S.HOTSPOT_COUNT end,
        max_scene_objects = function() return S.SCENE_OBJECT_COUNT end,

        set_background = function(bg_name)
            set_background({ r = 0, g = 0, b = 0 }, bg_name)
        end,

        set_scene_object = function(i, obj)
            local node = S.scene_obj_nodes[i]
            if not node then return end
            if not obj then
                gui.set_enabled(node, false)
                return
            end
            -- По умолчанию pivot центр — ставим центр в pos + w/2, h/2.
            local w = obj.size and obj.size.w or 87
            local h = obj.size and obj.size.h or 37
            local cx = (obj.pos.x or 0) + w / 2
            local cy = (obj.pos.y or 0) + h / 2
            gui.set_position(node, vmath.vector3(cx, cy, 0.05))
            gui.set_size(node, vmath.vector3(w, h, 0))
            if obj.image then
                gui.play_flipbook(node, hash(obj.image))
            end
            gui.set_enabled(node, true)
        end,

        set_hotspot = function(i, data)
            if not data then
                gui.set_enabled(S.hotspot_boxes[i],   false)
                gui.set_enabled(S.hotspot_labels[i],  false)
                gui.set_enabled(S.hotspot_icons[i],   false)
                gui.set_enabled(S.hotspot_circles[i], false)
                gui.set_enabled(S.hotspot_rings[i],   false)
                gui.set_enabled(S.hotspot_orbits[i],  false)
                for d = 1, S.ORBIT_DOTS do
                    gui.set_enabled(S.hotspot_dots[i][d], false)
                end
                return
            end
            local r = data.rect
            -- pivot CENTER по умолчанию, так что position — центр бокса
            local cx = r.x + r.w / 2
            local cy = r.y + r.h / 2
            gui.set_position(S.hotspot_boxes[i], vmath.vector3(cx, cy, 0.08))
            gui.set_size(S.hotspot_boxes[i], vmath.vector3(r.w, r.h, 0))

            -- Визуальный стек круглой кнопки: circle (PIE-подложка) + ring
            -- (glow) + icon (Material Icons символ) + orbit-parent с 6
            -- точками, которые вечно крутятся вокруг центра.
            local icon = data.icon
            if icon and icon ~= "" then
                local icon_node   = S.hotspot_icons[i]
                local circle_node = S.hotspot_circles[i]
                local ring_node   = S.hotspot_rings[i]
                local orbit_node  = S.hotspot_orbits[i]

                -- Позиционируем весь стек в центре hotspot'а.
                -- Иконку поднимаем на ICON_Y_OFFSET — text-ноды в Defold
                -- центрируются по baseline шрифта, а не по геометрическому
                -- центру глифа, поэтому Material Icons визуально смещены
                -- вниз. Подъём +8px компенсирует это для size=64 шрифта.
                local ICON_Y_OFFSET = 4
                gui.set_position(circle_node, vmath.vector3(cx, cy, 0.068))
                gui.set_position(ring_node,   vmath.vector3(cx, cy, 0.067))
                gui.set_position(orbit_node,  vmath.vector3(cx, cy, 0.066))
                gui.set_position(icon_node,   vmath.vector3(cx, cy + ICON_Y_OFFSET, 0.07))

                gui.set_text(icon_node, icon)

                -- Альфы: для locked всё тусклее.
                local circle_a = data.locked and 0.50 or 0.78
                local ring_a   = data.locked and 0.35 or 0.90
                local icon_a   = data.locked and 0.45 or 1.0
                local dot_a    = data.locked and 0.35 or 0.95

                local cc = gui.get_color(circle_node); cc.w = circle_a
                gui.set_color(circle_node, cc)
                local rc = gui.get_color(ring_node);   rc.w = ring_a
                gui.set_color(ring_node, rc)
                local ic = gui.get_color(icon_node);   ic.w = icon_a
                gui.set_color(icon_node, ic)

                gui.set_enabled(circle_node, true)
                gui.set_enabled(ring_node,   true)
                gui.set_enabled(icon_node,   true)
                -- Orbit/dots отключены навсегда — минималистичный стиль
                -- без вращающихся точек. Ноды остались в .gui, чтобы при
                -- желании можно было вернуть без правки .gui файла.
                gui.set_enabled(orbit_node,  false)
                for d = 1, S.ORBIT_DOTS do
                    gui.set_enabled(S.hotspot_dots[i][d], false)
                end

                -- Пульсация «дыхание» круга+кольца+иконки синхронно.
                -- Orbit-parent НЕ масштабируем — точки должны ходить
                -- по фиксированному радиусу, иначе их траектория дышит.
                gui.cancel_animation(icon_node,   gui.PROP_SCALE)
                gui.cancel_animation(circle_node, gui.PROP_SCALE)
                gui.cancel_animation(ring_node,   gui.PROP_SCALE)
                gui.set_scale(icon_node,   vmath.vector3(1, 1, 1))
                gui.set_scale(circle_node, vmath.vector3(1, 1, 1))
                gui.set_scale(ring_node,   vmath.vector3(1, 1, 1))
                if not data.locked then
                    local t = vmath.vector3(1.08, 1.08, 1)
                    gui.animate(icon_node,   gui.PROP_SCALE, t,
                        gui.EASING_INOUTSINE, 1.4, 0, nil,
                        gui.PLAYBACK_LOOP_PINGPONG)
                    gui.animate(circle_node, gui.PROP_SCALE, t,
                        gui.EASING_INOUTSINE, 1.4, 0, nil,
                        gui.PLAYBACK_LOOP_PINGPONG)
                    gui.animate(ring_node,   gui.PROP_SCALE,
                        vmath.vector3(1.12, 1.12, 1),
                        gui.EASING_INOUTSINE, 1.4, 0, nil,
                        gui.PLAYBACK_LOOP_PINGPONG)
                end
            else
                gui.cancel_animation(S.hotspot_icons[i],   gui.PROP_SCALE)
                gui.cancel_animation(S.hotspot_circles[i], gui.PROP_SCALE)
                gui.cancel_animation(S.hotspot_rings[i],   gui.PROP_SCALE)
                gui.set_enabled(S.hotspot_icons[i],   false)
                gui.set_enabled(S.hotspot_circles[i], false)
                gui.set_enabled(S.hotspot_rings[i],   false)
                gui.set_enabled(S.hotspot_orbits[i],  false)
                for d = 1, S.ORBIT_DOTS do
                    gui.set_enabled(S.hotspot_dots[i][d], false)
                end
            end

            -- Locked-hotspot рисуем тусклее — игрок должен видеть, что
            -- точка интерактива есть, но пока недоступна.
            -- В режиме редактирования ярко подсвечиваем выбранный hotspot.
            local editing  = hotspot_editor.is_active()
            local selected = editing and (i == hotspot_editor.selected_index())
            local has_icon = icon and icon ~= ""
            local box_alpha
            if editing then
                box_alpha = selected and 0.65 or 0.25
            else
                -- В игровом режиме hotspot-rect полностью прозрачный —
                -- визуальная индикация идёт только через круглую кнопку
                -- (circle+ring+icon). Rect нужен лишь как invisible hitbox.
                box_alpha = 0
            end
            local bc = gui.get_color(S.hotspot_boxes[i])
            bc.w = box_alpha
            gui.set_color(S.hotspot_boxes[i], bc)

            gui.set_enabled(S.hotspot_boxes[i], true)
            gui.set_enabled(S.hotspot_labels[i], true)
            local label_text = data.label or ""
            if editing and selected then
                label_text = "[#" .. i .. "] " .. label_text
            end
            gui.set_text(S.hotspot_labels[i], label_text)

            local lc = gui.get_color(S.hotspot_labels[i])
            if editing then
                lc.w = selected and 1.0 or 0.5
            else
                lc.w = data.locked and 0.35 or 1.0
            end
            gui.set_color(S.hotspot_labels[i], lc)
        end,

        request_ink_knot = function(knot_name, keep_bg)
            -- scene_controller уже вызвал exit() до сюда → is_active()==false,
            -- значит render() пойдёт по обычной ветке и покажет dialogue-узел,
            -- на который нас привёл jump_to_knot.
            dm.jump_to_knot(knot_name)
            -- Если клик был из сцены point-and-click — удерживаем её фон
            -- в качестве «текущего» в dialogue-менеджере, чтобы монолог
            -- не моргал коридором между сценой и return_to_scene.
            if keep_bg then dm.override_bg(keep_bg) end
            render()
        end,
    })

    -- Автосохранение game_state при любом его изменении.
    -- Подписчик дёргается и при reset/deserialize — это безопасно: save
    -- просто перезапишет тем же состоянием.
    gs.subscribe(function()
        sm.set_game_state(gs.serialize())
        S.ui.render_hud()
        if S.inv_modal.visible then S.ui.render_inv_slots() end
    end)

    -- Скрываем модалки на старте, HUD перерисовываем по текущему состоянию.
    S.ui.hide_item_modal()
    S.ui.hide_inv_modal()
    S.ui.render_hud()

    -- Яндекс Игры: инициализация SDK (нужна для показа рекламы в конце новеллы).
    -- Автоопределение языка (2.14) и LoadingAPI.ready уже вызваны в engine_template.html
    -- напрямую через ysdk.environment — срабатывает ДО запуска Defold.
    if yagames then
        yagames.init(function(_, err)
            if err then
                print("YaGames init error: " .. tostring(err))
                return
            end
            S.ysdk_ready = true

            -- Дублируем чтение языка через Lua SDK — на случай если Яндекс
            -- отслеживает именно обращение через нативный мост.
            local ok, env = pcall(yagames.environment)
            if ok and env and env.i18n then
                S.game_lang = env.i18n.lang or "ru"
            end
        end)
    end

    show_menu()

    msg.post(".", "acquire_input_focus")
end

function update(self, dt)
    -- Тряска bg-нод: случайный офсет с линейным затуханием.
    -- Работает и в меню — на случай, если захочется потрясти меню
    -- (сейчас не используется, но ничего не ломает).
    if S.shake_state then
        S.shake_state.elapsed = S.shake_state.elapsed + dt
        local t = S.shake_state.elapsed / S.shake_state.duration
        if t >= 1 then
            for n, op in pairs(S.shake_state.origins) do
                gui.set_position(n, op)
            end
            S.shake_state = nil
        else
            local amp = S.shake_state.intensity * 20 * (1 - t)
            for n, op in pairs(S.shake_state.origins) do
                local ox = (math.random() - 0.5) * 2 * amp
                local oy = (math.random() - 0.5) * 2 * amp
                gui.set_position(n, vmath.vector3(op.x + ox, op.y + oy, op.z))
            end
        end
    end

    if S.in_menu then return end

    -- Мигание курсора терминала (квадратная волна 2 Гц, как настоящий cursor)
    if S.narrator_visible then
        S.cursor_blink_t = S.cursor_blink_t + dt
        local phase = (S.cursor_blink_t % 1.0) < 0.5
        local c = gui.get_color(S.narrator_cursor)
        c.w = phase and 1.0 or 0.0
        gui.set_color(S.narrator_cursor, c)
    end

    local node = dm.get_current_node()
    if node and node.type == "dialogue" then
        S.hint_timer = S.hint_timer + dt * S.HINT_BLINK_SPEED
        local c = gui.get_color(S.continue_hint)
        c.w = 0.5 + 0.5 * math.sin(S.hint_timer * math.pi)
        gui.set_color(S.continue_hint, c)
    end
end

-- -------------------------------------------------------
-- Обработка ввода
-- -------------------------------------------------------

-- Состояние модификатора Shift для редактора хотспотов (нужно отслеживать
-- между press/release, поэтому обрабатываем до общего `action.pressed` фильтра).
local edit_shift_held = false

function on_input(self, action_id, action)
    -- Shift держится — фиксируем press/release (обходит фильтр pressed ниже)
    if action_id == hash("edit_shift") then
        if action.pressed  then edit_shift_held = true  end
        if action.released then edit_shift_held = false end
        return false
    end

    if not action.pressed then return false end

    -- ---- Редактор хотспотов (дев-инструмент) ----
    -- F1 работает всегда (даже когда редактор выключен — это и есть toggle).
    if action_id == hash("edit_toggle") then
        hotspot_editor.toggle()
        return true
    end

    if hotspot_editor.is_active() then
        local s = edit_shift_held and 20 or 5
        if     action_id == hash("edit_exit")     then hotspot_editor.exit_mode()
        elseif action_id == hash("edit_next")     then hotspot_editor.next()
        elseif action_id == hash("edit_left")     then hotspot_editor.nudge(-s, 0, 0, 0)
        elseif action_id == hash("edit_right")    then hotspot_editor.nudge( s, 0, 0, 0)
        elseif action_id == hash("edit_up")       then hotspot_editor.nudge( 0, s, 0, 0)
        elseif action_id == hash("edit_down")     then hotspot_editor.nudge( 0,-s, 0, 0)
        elseif action_id == hash("edit_w_minus")  then hotspot_editor.nudge( 0, 0,-s, 0)
        elseif action_id == hash("edit_w_plus")   then hotspot_editor.nudge( 0, 0, s, 0)
        elseif action_id == hash("edit_h_minus")  then hotspot_editor.nudge( 0, 0, 0,-s)
        elseif action_id == hash("edit_h_plus")   then hotspot_editor.nudge( 0, 0, 0, s)
        elseif action_id == hash("edit_print")    then hotspot_editor.print_current()
        else return false
        end
        return true
    end

    -- Запускаем музыку при первом касании (браузеры блокируют autoplay)
    if not S.music_started then
        S.music_started = true
        msg.post("/music_player#sound", "play_sound", { delay = 0, gain = 0.7 })
    end

    if action_id == hash("touch") then

        -- ---- Меню ----
        if S.in_menu then
            -- Вспомогательная функция: показать тост «скоро» в ноде
            -- menu_hint вместо обычной подсказки ↑↓. Авто-возврат
            -- через 2 сек (проверяется в show_menu на переоткрытии).
            local function toast(msg, accent)
                accent = accent or vmath.vector4(1.0, 0.45, 0.35, 1.0)
                gui.set_text(S.menu_hint_node, msg)
                gui.set_color(S.menu_hint_node, accent)
                gui.cancel_animation(S.menu_hint_node, gui.PROP_COLOR)
                gui.animate(S.menu_hint_node, gui.PROP_COLOR,
                    vmath.vector4(0.788, 0.753, 0.659, 0.45),
                    gui.EASING_INQUAD, 2.0, 0.8,
                    function()
                        if S.in_menu then
                            gui.set_text(S.menu_hint_node,
                                "\226\134\145 \226\134\147  \208\178\209\139\208\177\208\190\209\128   \226\128\162   ENTER  \208\191\208\190\208\180\209\130\208\178\208\181\209\128\208\180\208\184\209\130\209\140   \226\128\162   ESC  \208\189\208\176\208\183\208\176\208\180")
                        end
                    end)
            end

            if gui.pick_node(S.menu_btn_new, action.x, action.y) then
                -- Вспышка на акцент-баре
                local bar = gui.get_node("menu_btn_new_bar")
                if bar then
                    gui.animate(bar, gui.PROP_COLOR,
                        vmath.vector4(1.0, 0.95, 1.0, 1.0), gui.EASING_OUTQUAD, 0.08)
                end
                local bytes = load_story_bytes()
                if not bytes then return true end
                sm.new_game()
                gs.reset()
                sm.set_game_state(gs.serialize())
                dm.init(bytes)
                start_game()
                return true
            end

            if gui.pick_node(S.menu_btn_continue, action.x, action.y) then
                if not sm.has_save() then
                    toast("\208\157\208\225 \209\129\208\190\209\133\209\128\208\176\208\189\208\181\208\189\208\184\208\185: \208\189\208\190\208\178\209\139\208\185 \208\183\208\176\208\191\209\131\209\129\208\186")
                    return true
                end
                local bar = gui.get_node("menu_btn_continue_bar")
                if bar then
                    gui.animate(bar, gui.PROP_COLOR,
                        vmath.vector4(1.0, 0.90, 0.70, 1.0), gui.EASING_OUTQUAD, 0.08)
                end
                local bytes = load_story_bytes()
                if not bytes then return true end
                dm.load_saved(bytes)
                gs.deserialize(sm.get_game_state())
                local saved_scene = gs.get_scene()
                if saved_scene then
                    scene_controller.enter(saved_scene)
                end
                start_game()
                return true
            end

            -- Галерея CG — заглушка
            if gui.pick_node(S.menu_btn_gallery, action.x, action.y) then
                toast("\208\147\208\176\208\187\208\181\209\128\208\181\209\143 CG \226\128\148 \209\129\208\186\208\190\209\128\208\190 (\209\129\208\191\209\128\208\184\208\189\209\130 6)")
                return true
            end

            -- Достижения — заглушка
            if gui.pick_node(S.menu_btn_awards, action.x, action.y) then
                toast("\208\148\208\190\209\129\209\130\208\184\208\182\208\181\208\189\208\184\209\143 \226\128\148 \209\129\208\186\208\190\209\128\208\190 (\209\129\208\191\209\128\208\184\208\189\209\130 7)")
                return true
            end

            return false
        end

        -- ---- Модалка описания предмета (верхний слой) ----
        if S.item_modal.visible then
            if gui.pick_node(S.item_modal.close_btn, action.x, action.y) then
                S.ui.hide_item_modal()
                return true
            end
            if not gui.pick_node(S.item_modal.panel, action.x, action.y) then
                S.ui.hide_item_modal()
                return true
            end
            return true
        end

        -- ---- Инвентарная модалка ----
        if S.inv_modal.visible then
            if gui.pick_node(S.inv_modal.close_btn, action.x, action.y) then
                S.ui.hide_inv_modal()
                return true
            end
            for i = 1, S.inv_modal.COUNT do
                local s = S.inv_modal.slots[i]
                if s.item_id
                and gui.is_enabled(s.hit)
                and gui.pick_node(s.hit, action.x, action.y) then
                    S.ui.show_item_modal(s.item_id)
                    return true
                end
            end
            if not gui.pick_node(S.inv_modal.panel, action.x, action.y) then
                S.ui.hide_inv_modal()
                return true
            end
            return true
        end

        -- ---- HUD (рюкзак + телефон) ----
        if gui.is_enabled(S.hud.backpack.hit)
        and gui.pick_node(S.hud.backpack.hit, action.x, action.y) then
            S.ui.show_inv_modal()
            return true
        end
        if gui.is_enabled(S.hud.phone.hit)
        and gui.pick_node(S.hud.phone.hit, action.x, action.y) then
            S.ui.open_phone_ui()
            return true
        end

        -- ---- Игра ----
        -- Если активен point-and-click слой — ловим клики по hotspot'ам
        -- и игнорируем dialogue-ввод.
        if scene_controller.is_active() then
            for i = 1, S.HOTSPOT_COUNT do
                if gui.is_enabled(S.hotspot_boxes[i])
                and gui.pick_node(S.hotspot_boxes[i], action.x, action.y) then
                    if hotspot_editor.is_active() then
                        -- В режиме редактирования клик только ВЫБИРАЕТ
                        -- hotspot, не запускает его экшн.
                        hotspot_editor.select(i)
                    else
                        scene_controller.on_hotspot_click(i)
                    end
                    render()
                    return true
                end
            end
            return false
        end

        local node = dm.get_current_node()
        if not node then return false end

        if node.type == "dialogue" then
            dm.advance()
            render()
            S.hint_timer = 0
            return true

        elseif node.type == "choice" then
            for i = 1, 4 do
                if gui.is_enabled(S.choice_btns[i])
                and gui.pick_node(S.choice_btns[i], action.x, action.y) then
                    dm.choose(i)
                    render()
                    return true
                end
            end

        elseif node.type == "end" then
            -- Защита от двойного вызова show_menu (callback'и Яндекса +
            -- страховочный таймер могут сработать одновременно).
            local menu_returned = false
            local function go_to_menu()
                if menu_returned then return end
                menu_returned = true
                show_menu()
            end

            if yagames and S.ysdk_ready then
                -- Страховочный таймер: если реклама зависла или callback'и
                -- не придут — через 30 сек всё равно уходим в меню.
                timer.delay(30, false, function() go_to_menu() end)

                local ok, err = pcall(yagames.adv_show_fullscreen_adv, {
                    close   = function(_, was_shown) go_to_menu() end,
                    error   = function(_, e)         go_to_menu() end,
                    offline = function(_)            go_to_menu() end,
                })
                if not ok then
                    print("adv pcall failed: " .. tostring(err))
                    go_to_menu()
                end
            else
                go_to_menu()
            end
            return true
        end
    end

    return false
end
