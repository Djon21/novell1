-- main_menu.gui_script
-- Контроллер главного меню визуальной новеллы

local sm = require "main.scripts.save_manager"
local dm = require "main.scripts.dialogue_manager_ink"

-- Состояние меню
local M = {}
M.glitch_active = false
M.hint_timer = 0
M.HINT_BLINK_SPEED = 2.0

-- Ноды меню
M.menu_panel = nil
M.bg_menu = nil
M.menu_btn_new = nil
M.menu_btn_continue = nil
M.menu_btn_gallery = nil
M.menu_btn_awards = nil
M.menu_btn_new_text = nil
M.menu_btn_continue_text = nil
M.menu_btn_gallery_text = nil
M.menu_btn_awards_text = nil
M.menu_hint_node = nil
M.menu_title_glitch_r = nil
M.menu_title_glitch_b = nil

-- -------------------------------------------------------
-- Глитч-эффект на заголовке (как в Steins;Gate / DDLC)
-- -------------------------------------------------------
local function start_glitch()
    M.glitch_active = true
    local function do_glitch()
        if not M.glitch_active then return end

        local pr = gui.get_position(M.menu_title_glitch_r)
        local pb = gui.get_position(M.menu_title_glitch_b)
        pr.x = math.random(-6, 6)
        pb.x = math.random(-6, 6)
        gui.set_position(M.menu_title_glitch_r, pr)
        gui.set_position(M.menu_title_glitch_b, pb)

        local cr = gui.get_color(M.menu_title_glitch_r)
        local cb = gui.get_color(M.menu_title_glitch_b)
        cr.w = math.random(2, 5) * 0.1
        cb.w = math.random(1, 4) * 0.1
        gui.set_color(M.menu_title_glitch_r, cr)
        gui.set_color(M.menu_title_glitch_b, cb)

        timer.delay(math.random(3, 8) + math.random(), false, do_glitch)
    end
    timer.delay(math.random(2, 5), false, do_glitch)
end

local function stop_glitch()
    M.glitch_active = false
end

-- -------------------------------------------------------
-- Показать меню
-- -------------------------------------------------------
local function show_menu()
    print("[main_menu] show_menu() вызван")
    gui.set_enabled(M.bg_menu, true)
    gui.set_enabled(M.menu_panel, true)
    
    -- Запускаем глитч-эффект на заголовке
    start_glitch()
    
    print("[main_menu] Меню показано")
end

-- -------------------------------------------------------
-- Скрыть меню
-- -------------------------------------------------------
local function hide_menu()
    stop_glitch()
    gui.set_enabled(M.bg_menu, false)
    gui.set_enabled(M.menu_panel, false)
end

-- -------------------------------------------------------
-- Запуск новой игры
-- -------------------------------------------------------
local function start_new_game()
    print("[main_menu] Запуск новой игры")
    hide_menu()
    
    -- Отправляем сообщение UI manager'у для запуска игры
    msg.post("/ui_manager", "start_game")
end

-- -------------------------------------------------------
-- Продолжить игру
-- -------------------------------------------------------
local function continue_game()
    sm.load()
    if not sm.has_save() then
        print("[main_menu] Нет сохранений для продолжения")
        return
    end
    
    print("[main_menu] Продолжение игры")
    hide_menu()
    
    -- Отправляем сообщение UI manager'у для продолжения
    msg.post("/ui_manager", "continue_game")
end

-- -------------------------------------------------------
-- Lifecycle функции
-- -------------------------------------------------------

function init(self)
    print("[main_menu] Инициализация")
    
    -- Получаем ноды
    M.bg_menu = gui.get_node("bg_menu")
    M.menu_panel = gui.get_node("menu_panel")
    M.menu_btn_new = gui.get_node("menu_btn_new")
    M.menu_btn_continue = gui.get_node("menu_btn_continue")
    M.menu_btn_gallery = gui.get_node("menu_btn_gallery")
    M.menu_btn_awards = gui.get_node("menu_btn_awards")
    M.menu_btn_new_text = gui.get_node("menu_btn_new_text")
    M.menu_btn_continue_text = gui.get_node("menu_btn_continue_text")
    M.menu_btn_gallery_text = gui.get_node("menu_btn_gallery_text")
    M.menu_btn_awards_text = gui.get_node("menu_btn_awards_text")
    M.menu_hint_node = gui.get_node("menu_hint")
    M.menu_title_glitch_r = gui.get_node("menu_title_glitch_r")
    M.menu_title_glitch_b = gui.get_node("menu_title_glitch_b")
    
    -- Показываем меню при старте
    show_menu()
    
    -- Запрашиваем input focus
    msg.post(".", "acquire_input_focus")
end

function final(self)
    print("[main_menu] Завершение")
    stop_glitch()
end

function update(self, dt)
    -- Мигание подсказки
    M.hint_timer = M.hint_timer + dt
    local alpha = (math.sin(M.hint_timer * M.HINT_BLINK_SPEED) + 1) * 0.5
    local hint_color = gui.get_color(M.menu_hint_node)
    hint_color.w = alpha * 0.8 + 0.2  -- от 0.2 до 1.0
    gui.set_color(M.menu_hint_node, hint_color)
end

function on_message(self, message_id, message, sender)
    print("[main_menu] Получено сообщение:", message_id)
    if message_id == hash("show_menu") or message_id == hash("show") then
        show_menu()
    elseif message_id == hash("hide_menu") or message_id == hash("hide") then
        hide_menu()
    end
end

function on_input(self, action_id, action)
    if action_id == hash("touch") and action.pressed then
        local x = action.x
        local y = action.y
        
        -- Проверяем клик по кнопке "Новая игра"
        if gui.pick_node(M.menu_btn_new, x, y) then
            start_new_game()
            return true
        end
        
        -- Проверяем клик по кнопке "Продолжить"
        if gui.pick_node(M.menu_btn_continue, x, y) then
            sm.load()
            if sm.has_save() then
                continue_game()
            else
                print("[main_menu] Нет сохранений")
            end
            return true
        end
        
        -- Проверяем клик по кнопке "Галерея" (заглушка)
        if gui.pick_node(M.menu_btn_gallery, x, y) then
            print("[main_menu] Галерея (не реализовано)")
            return true
        end
        
        -- Проверяем клик по кнопке "Достижения" (заглушка)
        if gui.pick_node(M.menu_btn_awards, x, y) then
            print("[main_menu] Достижения (не реализовано)")
            return true
        end
    end
    
    return false
end
