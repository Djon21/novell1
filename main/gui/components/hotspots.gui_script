-- hotspots.gui_script
-- Р С™Р С•Р Р…РЎвЂљРЎР‚Р С•Р В»Р В»Р ВµРЎР‚ Р С‘Р Р…РЎвЂљР ВµРЎР‚Р В°Р С”РЎвЂљР С‘Р Р†Р Р…РЎвЂ№РЎвЂ¦ РЎвЂљР С•РЎвЂЎР ВµР С” (hotspots) Р Т‘Р В»РЎРЏ point-and-click РЎРѓРЎвЂ Р ВµР Р…

local scene_controller = require "main.scripts.scene_controller"
local hotspot_editor = require "main.scripts.hotspot_editor"
local gui_animations = require "main.gui.modules.gui_animations"

-- Р РЋР С•РЎРѓРЎвЂљР С•РЎРЏР Р…Р С‘Р Вµ hotspots
local M = {}
M.HOTSPOT_COUNT = 6
M.ORBIT_DOTS = 6
M.SCENE_OBJECT_COUNT = 4

-- Р СњР С•Р Т‘РЎвЂ№ hotspots (6 РЎРѓР В»Р С•РЎвЂљР С•Р Р†)
M.hotspot_boxes = {}
M.hotspot_labels = {}
M.hotspot_icons = {}
M.hotspot_circles = {}
M.hotspot_rings = {}
M.hotspot_orbits = {}
M.hotspot_dots = {}

-- Р СњР С•Р Т‘РЎвЂ№ scene objects (4 РЎРѓР В»Р С•РЎвЂљР В°)
M.scene_obj_nodes = {}

-- -------------------------------------------------------
-- Р Р€РЎРѓРЎвЂљР В°Р Р…Р С•Р Р†Р С”Р В° hotspot Р Р† РЎРѓР В»Р С•РЎвЂљ
-- -------------------------------------------------------

local function set_hotspot(i, data)
    if not data then
        -- Р РЋР С”РЎР‚РЎвЂ№РЎвЂљРЎРЉ hotspot
        gui.set_enabled(M.hotspot_boxes[i], false)
        gui.set_enabled(M.hotspot_labels[i], false)
        gui.set_enabled(M.hotspot_icons[i], false)
        gui.set_enabled(M.hotspot_circles[i], false)
        gui.set_enabled(M.hotspot_rings[i], false)
        gui.set_enabled(M.hotspot_orbits[i], false)
        for d = 1, M.ORBIT_DOTS do
            gui.set_enabled(M.hotspot_dots[i][d], false)
        end
        return
    end
    
    local r = data.rect
    -- pivot CENTER Р С—Р С• РЎС“Р СР С•Р В»РЎвЂЎР В°Р Р…Р С‘РЎР‹, position РІР‚вЂќ РЎвЂ Р ВµР Р…РЎвЂљРЎР‚ Р В±Р С•Р С”РЎРѓР В°
    local cx = r.x + r.w / 2
    local cy = r.y + r.h / 2
    gui.set_position(M.hotspot_boxes[i], vmath.vector3(cx, cy, 0.08))
    gui.set_size(M.hotspot_boxes[i], vmath.vector3(r.w, r.h, 0))
    
    -- Р вЂ™Р С‘Р В·РЎС“Р В°Р В»РЎРЉР Р…РЎвЂ№Р в„– РЎРѓРЎвЂљР ВµР С”: circle + ring + icon + orbit РЎРѓ РЎвЂљР С•РЎвЂЎР С”Р В°Р СР С‘
    local icon = data.icon
    if icon and icon ~= "" then
        local icon_node = M.hotspot_icons[i]
        local circle_node = M.hotspot_circles[i]
        local ring_node = M.hotspot_rings[i]
        local orbit_node = M.hotspot_orbits[i]
        
        -- Р СџР С•Р В·Р С‘РЎвЂ Р С‘Р С•Р Р…Р С‘РЎР‚РЎС“Р ВµР С Р Р†Р ВµРЎРѓРЎРЉ РЎРѓРЎвЂљР ВµР С” Р Р† РЎвЂ Р ВµР Р…РЎвЂљРЎР‚Р Вµ hotspot'Р В°
        local ICON_Y_OFFSET = 4  -- Р С”Р С•Р СР С—Р ВµР Р…РЎРѓР В°РЎвЂ Р С‘РЎРЏ baseline РЎв‚¬РЎР‚Р С‘РЎвЂћРЎвЂљР В°
        gui.set_position(circle_node, vmath.vector3(cx, cy, 0.068))
        gui.set_position(ring_node, vmath.vector3(cx, cy, 0.067))
        gui.set_position(orbit_node, vmath.vector3(cx, cy, 0.066))
        gui.set_position(icon_node, vmath.vector3(cx, cy + ICON_Y_OFFSET, 0.07))
        
        gui.set_text(icon_node, icon)
        
        -- Р С’Р В»РЎРЉРЎвЂћРЎвЂ№: Р Т‘Р В»РЎРЏ locked Р Р†РЎРѓРЎвЂ РЎвЂљРЎС“РЎРѓР С”Р В»Р ВµР Вµ
        local circle_a = data.locked and 0.50 or 0.78
        local ring_a = data.locked and 0.35 or 0.90
        local icon_a = data.locked and 0.45 or 1.0
        
        local cc = gui.get_color(circle_node)
        cc.w = circle_a
        gui.set_color(circle_node, cc)
        
        local rc = gui.get_color(ring_node)
        rc.w = ring_a
        gui.set_color(ring_node, rc)
        
        local ic = gui.get_color(icon_node)
        ic.w = icon_a
        gui.set_color(icon_node, ic)
        
        gui.set_enabled(circle_node, true)
        gui.set_enabled(ring_node, true)
        gui.set_enabled(icon_node, true)
        
        -- Orbit/dots Р С•РЎвЂљР С”Р В»РЎР‹РЎвЂЎР ВµР Р…РЎвЂ№ (Р СР С‘Р Р…Р С‘Р СР В°Р В»Р С‘РЎРѓРЎвЂљР С‘РЎвЂЎР Р…РЎвЂ№Р в„– РЎРѓРЎвЂљР С‘Р В»РЎРЉ)
        gui.set_enabled(orbit_node, false)
        for d = 1, M.ORBIT_DOTS do
            gui.set_enabled(M.hotspot_dots[i][d], false)
        end
        
        -- Р СџРЎС“Р В»РЎРЉРЎРѓР В°РЎвЂ Р С‘РЎРЏ Р’В«Р Т‘РЎвЂ№РЎвЂ¦Р В°Р Р…Р С‘Р ВµР’В» Р С”РЎР‚РЎС“Р С–Р В°+Р С”Р С•Р В»РЎРЉРЎвЂ Р В°+Р С‘Р С”Р С•Р Р…Р С”Р С‘
        gui.cancel_animation(icon_node, gui.PROP_SCALE)
        gui.cancel_animation(circle_node, gui.PROP_SCALE)
        gui.cancel_animation(ring_node, gui.PROP_SCALE)
        gui.set_scale(icon_node, vmath.vector3(1, 1, 1))
        gui.set_scale(circle_node, vmath.vector3(1, 1, 1))
        gui.set_scale(ring_node, vmath.vector3(1, 1, 1))
        
        if not data.locked then
            local t = vmath.vector3(1.08, 1.08, 1)
            gui.animate(icon_node, gui.PROP_SCALE, t,
                gui.EASING_INOUTSINE, 1.4, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
            gui.animate(circle_node, gui.PROP_SCALE, t,
                gui.EASING_INOUTSINE, 1.4, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
            gui.animate(ring_node, gui.PROP_SCALE, vmath.vector3(1.12, 1.12, 1),
                gui.EASING_INOUTSINE, 1.4, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
        end
    else
        -- Р СњР ВµРЎвЂљ Р С‘Р С”Р С•Р Р…Р С”Р С‘ РІР‚вЂќ РЎРѓР С”РЎР‚РЎвЂ№Р Р†Р В°Р ВµР С Р Р†Р С‘Р В·РЎС“Р В°Р В»РЎРЉР Р…РЎвЂ№Р в„– РЎРѓРЎвЂљР ВµР С”
        gui.cancel_animation(M.hotspot_icons[i], gui.PROP_SCALE)
        gui.cancel_animation(M.hotspot_circles[i], gui.PROP_SCALE)
        gui.cancel_animation(M.hotspot_rings[i], gui.PROP_SCALE)
        gui.set_enabled(M.hotspot_icons[i], false)
        gui.set_enabled(M.hotspot_circles[i], false)
        gui.set_enabled(M.hotspot_rings[i], false)
        gui.set_enabled(M.hotspot_orbits[i], false)
        for d = 1, M.ORBIT_DOTS do
            gui.set_enabled(M.hotspot_dots[i][d], false)
        end
    end
    
    -- Р СџРЎР‚Р С•Р В·РЎР‚Р В°РЎвЂЎР Р…Р С•РЎРѓРЎвЂљРЎРЉ hotspot-rect
    local editing = hotspot_editor.is_active()
    local selected = editing and (i == hotspot_editor.selected_index())
    local box_alpha
    
    if editing then
        box_alpha = selected and 0.65 or 0.25
    else
        -- Р вЂ™ Р С‘Р С–РЎР‚Р С•Р Р†Р С•Р С РЎР‚Р ВµР В¶Р С‘Р СР Вµ rect Р С—Р С•Р В»Р Р…Р С•РЎРѓРЎвЂљРЎРЉРЎР‹ Р С—РЎР‚Р С•Р В·РЎР‚Р В°РЎвЂЎР Р…РЎвЂ№Р в„– (invisible hitbox)
        box_alpha = 0
    end
    
    local bc = gui.get_color(M.hotspot_boxes[i])
    bc.w = box_alpha
    gui.set_color(M.hotspot_boxes[i], bc)
    
    gui.set_enabled(M.hotspot_boxes[i], true)
    gui.set_enabled(M.hotspot_labels[i], true)
    
    local label_text = data.label or ""
    if editing and selected then
        label_text = "[#" .. i .. "] " .. label_text
    end
    gui.set_text(M.hotspot_labels[i], label_text)
    
    local lc = gui.get_color(M.hotspot_labels[i])
    if editing then
        lc.w = selected and 1.0 or 0.5
    else
        lc.w = data.locked and 0.35 or 1.0
    end
    gui.set_color(M.hotspot_labels[i], lc)
end

-- -------------------------------------------------------
-- Р Р€РЎРѓРЎвЂљР В°Р Р…Р С•Р Р†Р С”Р В° scene object Р Р† РЎРѓР В»Р С•РЎвЂљ
-- -------------------------------------------------------

local function set_scene_object(i, obj)
    local node = M.scene_obj_nodes[i]
    if not node then return end
    
    if not obj then
        gui.set_enabled(node, false)
        return
    end
    
    -- Р СџР С• РЎС“Р СР С•Р В»РЎвЂЎР В°Р Р…Р С‘РЎР‹ pivot РЎвЂ Р ВµР Р…РЎвЂљРЎР‚ РІР‚вЂќ РЎРѓРЎвЂљР В°Р Р†Р С‘Р С РЎвЂ Р ВµР Р…РЎвЂљРЎР‚ Р Р† pos + w/2, h/2
    local w = obj.size and obj.size.w or 87
    local h = obj.size and obj.size.h or 37
    local cx = (obj.pos.x or 0) + w / 2
    local cy = (obj.pos.y or 0) + h / 2
    gui.set_position(node, vmath.vector3(cx, cy, 0.05))
    gui.set_size(node, vmath.vector3(w, h, 0))
    
    if obj.image then
        gui.play_flipbook(node, hash(obj.image))
    end
    
    gui.set_enabled(node, true)
end

-- -------------------------------------------------------
-- Р РЋР С”РЎР‚РЎвЂ№РЎвЂљРЎРЉ Р Р†РЎРѓР Вµ hotspots
-- -------------------------------------------------------

local function hide_all_hotspots()
    for i = 1, M.HOTSPOT_COUNT do
        gui.set_enabled(M.hotspot_boxes[i], false)
        gui.set_enabled(M.hotspot_labels[i], false)
        gui.set_enabled(M.hotspot_icons[i], false)
        gui.set_enabled(M.hotspot_circles[i], false)
        gui.set_enabled(M.hotspot_rings[i], false)
        gui.set_enabled(M.hotspot_orbits[i], false)
        for d = 1, M.ORBIT_DOTS do
            gui.set_enabled(M.hotspot_dots[i][d], false)
        end
    end
    
    for i = 1, M.SCENE_OBJECT_COUNT do
        gui.set_enabled(M.scene_obj_nodes[i], false)
    end
end

-- -------------------------------------------------------
-- Lifecycle
-- -------------------------------------------------------

function init(self)
    print("[hotspots] Р ВР Р…Р С‘РЎвЂ Р С‘Р В°Р В»Р С‘Р В·Р В°РЎвЂ Р С‘РЎРЏ hotspots.gui_script")
    
    -- Р СџР С•Р В»РЎС“РЎвЂЎР В°Р ВµР С Р Р…Р С•Р Т‘РЎвЂ№ hotspots (6 РЎРѓР В»Р С•РЎвЂљР С•Р Р†)
    for i = 1, M.HOTSPOT_COUNT do
        M.hotspot_boxes[i] = gui.get_node("hotspot_" .. i)
        M.hotspot_labels[i] = gui.get_node("hotspot_label_" .. i)
        local ok, icon = pcall(gui.get_node, "hotspot_icon_" .. i); M.hotspot_icons[i] = ok and icon or nil
        ok, icon = pcall(gui.get_node, "hotspot_circle_" .. i); M.hotspot_circles[i] = ok and icon or nil
        ok, icon = pcall(gui.get_node, "hotspot_ring_" .. i); M.hotspot_rings[i] = ok and icon or nil
        ok, icon = pcall(gui.get_node, "hotspot_orbit_" .. i); M.hotspot_orbits[i] = ok and icon or nil
        
        M.hotspot_dots[i] = {}
        for d = 1, M.ORBIT_DOTS do
            ok, icon = pcall(gui.get_node, "hotspot_dot_" .. i .. "_" .. d); M.hotspot_dots[i][d] = ok and icon or nil
        end
    end
    
    -- Р СџР С•Р В»РЎС“РЎвЂЎР В°Р ВµР С Р Р…Р С•Р Т‘РЎвЂ№ scene objects (4 РЎРѓР В»Р С•РЎвЂљР В°)
    for i = 1, M.SCENE_OBJECT_COUNT do
        M.scene_obj_nodes[i] = gui.get_node("scene_obj_" .. i)
    end
    
    -- Р ВР В·Р Р…Р В°РЎвЂЎР В°Р В»РЎРЉР Р…Р С• Р Р†РЎРѓРЎвЂ РЎРѓР С”РЎР‚РЎвЂ№РЎвЂљР С•
    hide_all_hotspots()
    
    print("[hotspots] Р ВР Р…Р С‘РЎвЂ Р С‘Р В°Р В»Р С‘Р В·Р В°РЎвЂ Р С‘РЎРЏ Р В·Р В°Р Р†Р ВµРЎР‚РЎв‚¬Р ВµР Р…Р В°")
end

function final(self)
    print("[hotspots] Р В¤Р С‘Р Р…Р В°Р В»Р С‘Р В·Р В°РЎвЂ Р С‘РЎРЏ hotspots.gui_script")
end

function on_message(self, message_id, message, sender)
    if message_id == hash("set_hotspot") then
        -- Р Р€РЎРѓРЎвЂљР В°Р Р…Р С•Р Р†Р С‘РЎвЂљРЎРЉ hotspot Р Р† РЎРѓР В»Р С•РЎвЂљ
        set_hotspot(message.index, message.data)
        
    elseif message_id == hash("set_scene_object") then
        -- Р Р€РЎРѓРЎвЂљР В°Р Р…Р С•Р Р†Р С‘РЎвЂљРЎРЉ scene object Р Р† РЎРѓР В»Р С•РЎвЂљ
        set_scene_object(message.index, message.obj)
        
    elseif message_id == hash("hide_all") then
        -- Р РЋР С”РЎР‚РЎвЂ№РЎвЂљРЎРЉ Р Р†РЎРѓР Вµ hotspots
        hide_all_hotspots()
    end
end

function on_input(self, action_id, action)
    -- Р С›Р В±РЎР‚Р В°Р В±Р С•РЎвЂљР С”Р В° Р С”Р В»Р С‘Р С”Р С•Р Р† Р С—Р С• hotspots Р Т‘Р ВµР В»Р ВµР С–Р С‘РЎР‚РЎС“Р ВµРЎвЂљРЎРѓРЎРЏ scene_controller
    -- Р вЂ”Р Т‘Р ВµРЎРѓРЎРЉ РЎвЂљР С•Р В»РЎРЉР С”Р С• Р С—РЎР‚Р С•Р Р†Р ВµРЎР‚РЎРЏР ВµР С Р С—Р С•Р С—Р В°Р Т‘Р В°Р Р…Р С‘Р Вµ Р Р† hitbox
    if action_id == hash("touch") and action.pressed then
        for i = 1, M.HOTSPOT_COUNT do
            if gui.is_enabled(M.hotspot_boxes[i]) and 
               gui.pick_node(M.hotspot_boxes[i], action.x, action.y) then
                -- Р С›РЎвЂљР С—РЎР‚Р В°Р Р†Р В»РЎРЏР ВµР С РЎРѓР С•Р В±РЎвЂ№РЎвЂљР С‘Р Вµ Р С”Р В»Р С‘Р С”Р В° Р Р† scene_controller
                msg.post("/scene_controller", "hotspot_clicked", {index = i})
                return true
            end
        end
    end
    
    return false
end
