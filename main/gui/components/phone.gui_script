-- phone.gui_script
-- РљРѕРЅС‚СЂРѕР»Р»РµСЂ HUD РёРєРѕРЅРєРё С‚РµР»РµС„РѕРЅР°

local gs = require "main.scripts.game_state"
local scene_controller = require "main.scripts.scene_controller"
local gui_animations = require "main.gui.modules.gui_animations"

-- РЎРѕСЃС‚РѕСЏРЅРёРµ С‚РµР»РµС„РѕРЅР°
local M = {}
M.enabled = false
M.has_notifications = false

-- РќРѕРґС‹ HUD РёРєРѕРЅРєРё С‚РµР»РµС„РѕРЅР°
M.circle = nil
M.ring = nil
M.icon = nil
M.hit = nil
M.decal = nil
M.decal_text = nil
M.badge = nil
M.badge_text = nil
M.tag = nil
M.caption = nil

-- -------------------------------------------------------
-- Р’РєР»СЋС‡Р°РµС‚/РІС‹РєР»СЋС‡Р°РµС‚ РІСЃРµ РЅРѕРґС‹ HUD-РёРєРѕРЅРєРё С‚РµР»РµС„РѕРЅР°
-- -------------------------------------------------------
local function set_phone_enabled(enabled)
    M.enabled = enabled
    
    if M.circle then gui.set_enabled(M.circle, enabled) end
    if M.ring then gui.set_enabled(M.ring, enabled) end
    if M.icon then gui.set_enabled(M.icon, enabled) end
    if M.hit then gui.set_enabled(M.hit, enabled) end
    if M.decal then gui.set_enabled(M.decal, enabled) end
    if M.decal_text then gui.set_enabled(M.decal_text, enabled) end
    if M.badge then gui.set_enabled(M.badge, enabled) end
    if M.badge_text then gui.set_enabled(M.badge_text, enabled) end
    if M.tag then gui.set_enabled(M.tag, enabled) end
    if M.caption then gui.set_enabled(M.caption, enabled) end
end

-- -------------------------------------------------------
-- РћР±РЅРѕРІР»СЏРµС‚ Р±РµР№РґР¶ СЃ РєРѕР»РёС‡РµСЃС‚РІРѕРј СѓРІРµРґРѕРјР»РµРЅРёР№
-- -------------------------------------------------------
local function update_badge()
    if not M.badge or not M.badge_text then return end
    
    -- РџРѕР»СѓС‡Р°РµРј РєРѕР»РёС‡РµСЃС‚РІРѕ РЅРµРїСЂРѕС‡РёС‚Р°РЅРЅС‹С… СЃРѕРѕР±С‰РµРЅРёР№ РёР· game_state
    local unread_count = gs.get_flag("phone_unread_count") or 0
    
    if unread_count > 0 then
        gui.set_enabled(M.badge, true)
        gui.set_enabled(M.badge_text, true)
        gui.set_text(M.badge_text, tostring(unread_count))
        M.has_notifications = true
    else
        gui.set_enabled(M.badge, false)
        gui.set_enabled(M.badge_text, false)
        M.has_notifications = false
    end
end

-- -------------------------------------------------------
-- РћС‚РєСЂС‹РІР°РµС‚ С‚РµР»РµС„РѕРЅ (РїРµСЂРµС…РѕРґ РЅР° СЃС†РµРЅСѓ phone_home)
-- -------------------------------------------------------
local function open_phone()
    if not gs.get_flag("has_phone") then 
        print("[phone] РўРµР»РµС„РѕРЅ РЅРµРґРѕСЃС‚СѓРїРµРЅ (has_phone=false)")
        return 
    end
    
    -- Р•СЃР»Рё СѓР¶Рµ РѕС‚РєСЂС‹С‚ вЂ” РЅРёС‡РµРіРѕ РЅРµ РґРµР»Р°РµРј
    if scene_controller.get_current_scene_id() == "phone_home" then 
        print("[phone] РўРµР»РµС„РѕРЅ СѓР¶Рµ РѕС‚РєСЂС‹С‚")
        return 
    end
    
    -- Р—Р°РїРѕРјРёРЅР°РµРј С‚РµРєСѓС‰СѓСЋ СЃС†РµРЅСѓ РґР»СЏ РІРѕР·РІСЂР°С‚Р°
    local caller = scene_controller.get_current_scene_id()
    if caller then
        gs.set_flag("_phone_return_scene", caller)
        print("[phone] РЎРѕС…СЂР°РЅРµРЅР° СЃС†РµРЅР° РІРѕР·РІСЂР°С‚Р°:", caller)
    end
    
    -- РџРµСЂРµС…РѕРґРёРј РЅР° СЃС†РµРЅСѓ С‚РµР»РµС„РѕРЅР°
    print("[phone] РћС‚РєСЂС‹РІР°РµРј С‚РµР»РµС„РѕРЅ")
    scene_controller.enter("phone_home")
end

-- -------------------------------------------------------
-- РђРЅРёРјР°С†РёСЏ РїСѓР»СЊСЃР°С†РёРё РїСЂРё РЅРѕРІРѕРј СѓРІРµРґРѕРјР»РµРЅРёРё
-- -------------------------------------------------------
local function animate_notification()
    if not M.ring then return end
    
    -- РџСѓР»СЊСЃР°С†РёСЏ РєРѕР»СЊС†Р°
    gui.cancel_animation(M.ring, "scale.x")
    gui.cancel_animation(M.ring, "scale.y")
    
    gui.animate(M.ring, "scale.x", 1.2, gui.EASING_OUTQUAD, 0.3, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
    gui.animate(M.ring, "scale.y", 1.2, gui.EASING_OUTQUAD, 0.3, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
    
    -- Р—РІСѓРє СѓРІРµРґРѕРјР»РµРЅРёСЏ (РѕРїС†РёРѕРЅР°Р»СЊРЅРѕ)
    -- msg.post("main:/sfx_player#phone_notify", "play_sound")
end

-- -------------------------------------------------------
-- Lifecycle
-- -------------------------------------------------------

function init(self)
    print("[phone] РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ phone.gui_script")
    
    -- РџРѕР»СѓС‡Р°РµРј РЅРѕРґС‹ HUD РёРєРѕРЅРєРё С‚РµР»РµС„РѕРЅР°
    M.circle = gui.get_node("hud_phone_circle")
    M.ring = gui.get_node("hud_phone_ring")
    M.icon = gui.get_node("hud_phone_icon")
    M.hit = gui.get_node("hud_phone_hit")
    M.decal = gui.get_node("hud_phone_decal")
    M.decal_text = gui.get_node("hud_phone_decal_text")
    M.badge = gui.get_node("hud_phone_badge")
    M.badge_text = gui.get_node("hud_phone_badge_text")
    M.tag = gui.get_node("hud_phone_tag")
    M.caption = gui.get_node("hud_phone_caption")
    
    -- РР·РЅР°С‡Р°Р»СЊРЅРѕ СЃРєСЂС‹С‚ (РїРѕСЏРІРёС‚СЃСЏ РєРѕРіРґР° has_phone=true)
    set_phone_enabled(false)
    
    -- РћР±РЅРѕРІР»СЏРµРј РІРёРґРёРјРѕСЃС‚СЊ РЅР° РѕСЃРЅРѕРІРµ С„Р»Р°РіР° has_phone
    local has_phone = gs.get_flag("has_phone")
    if has_phone then
        set_phone_enabled(true)
        update_badge()
    end
    
    print("[phone] РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ Р·Р°РІРµСЂС€РµРЅР°, has_phone:", has_phone)
end

function final(self)
    print("[phone] Р¤РёРЅР°Р»РёР·Р°С†РёСЏ phone.gui_script")
end

function on_message(self, message_id, message, sender)
    if message_id == hash("show_phone") then
        -- РџРѕРєР°Р·Р°С‚СЊ РёРєРѕРЅРєСѓ С‚РµР»РµС„РѕРЅР°
        set_phone_enabled(true)
        update_badge()
        print("[phone] РўРµР»РµС„РѕРЅ РїРѕРєР°Р·Р°РЅ")
        
    elseif message_id == hash("hide_phone") then
        -- РЎРєСЂС‹С‚СЊ РёРєРѕРЅРєСѓ С‚РµР»РµС„РѕРЅР°
        set_phone_enabled(false)
        print("[phone] РўРµР»РµС„РѕРЅ СЃРєСЂС‹С‚")
        
    elseif message_id == hash("update_phone") then
        -- РћР±РЅРѕРІРёС‚СЊ СЃРѕСЃС‚РѕСЏРЅРёРµ (РІРёРґРёРјРѕСЃС‚СЊ + Р±РµР№РґР¶)
        local has_phone = gs.get_flag("has_phone")
        set_phone_enabled(has_phone == true)
        if has_phone then
            update_badge()
        end
        print("[phone] РўРµР»РµС„РѕРЅ РѕР±РЅРѕРІР»РµРЅ, has_phone:", has_phone)
        
    elseif message_id == hash("phone_notification") then
        -- РќРѕРІРѕРµ СѓРІРµРґРѕРјР»РµРЅРёРµ
        local count = message.count or 1
        gs.set_flag("phone_unread_count", count)
        update_badge()
        animate_notification()
        print("[phone] РќРѕРІРѕРµ СѓРІРµРґРѕРјР»РµРЅРёРµ, count:", count)
        
    elseif message_id == hash("clear_notifications") then
        -- РћС‡РёСЃС‚РёС‚СЊ СѓРІРµРґРѕРјР»РµРЅРёСЏ
        gs.set_flag("phone_unread_count", 0)
        update_badge()
        print("[phone] РЈРІРµРґРѕРјР»РµРЅРёСЏ РѕС‡РёС‰РµРЅС‹")
        
    elseif message_id == hash("open_phone") then
        -- РћС‚РєСЂС‹С‚СЊ С‚РµР»РµС„РѕРЅ
        open_phone()
    end
end

function on_input(self, action_id, action)
    if not M.enabled then return false end
    
    -- РћР±СЂР°Р±РѕС‚РєР° РєР»РёРєР° РїРѕ РёРєРѕРЅРєРµ С‚РµР»РµС„РѕРЅР°
    if action_id == hash("touch") and action.pressed then
        if gui.is_enabled(M.hit) and gui.pick_node(M.hit, action.x, action.y) then
            print("[phone] РљР»РёРє РїРѕ РёРєРѕРЅРєРµ С‚РµР»РµС„РѕРЅР°")
            open_phone()
            return true
        end
    end
    
    return false
end
