-- inventory.gui_script (С‡Р°СЃС‚СЊ 1)
-- РљРѕРЅС‚СЂРѕР»Р»РµСЂ РёРЅРІРµРЅС‚Р°СЂСЏ РІРёР·СѓР°Р»СЊРЅРѕР№ РЅРѕРІРµР»Р»С‹

local gs = require "main.scripts.game_state"
local items_catalog = require "main.scripts.items"
local gui_animations = require "main.gui.modules.gui_animations"

-- РЎРѕСЃС‚РѕСЏРЅРёРµ РёРЅРІРµРЅС‚Р°СЂСЏ
local M = {}
M.visible = false
M.slots = {}
M.SLOT_COUNT = 12
M.selected_item_id = nil

-- РќРѕРґС‹ РёРЅРІРµРЅС‚Р°СЂСЏ
M.dim = nil
M.panel = nil
M.title = nil
M.close_btn = nil
M.close_text = nil
M.eyebrow = nil
M.stat_slots = nil
M.stat_weight = nil
M.stat_loop = nil

-- Р”РµС‚Р°Р»Рё РїСЂРµРґРјРµС‚Р° (РїСЂР°РІР°СЏ РїР°РЅРµР»СЊ)
M.details = {}

-- -------------------------------------------------------
-- Р—Р°РїРѕР»РЅСЏРµС‚ СЃРµС‚РєСѓ СЃР»РѕС‚РѕРІ РёР· game_state
-- -------------------------------------------------------
local function render_inv_slots()
    if not M.slots[1] then return end
    
    local inv = gs.get_inventory()
    if not inv then inv = {} end
    
    local used = 0
    
    for i = 1, M.SLOT_COUNT do
        local s = M.slots[i]
        local item = inv[i]
        
        if item and item.id then
            used = used + 1
            
            -- РџРѕР»СѓС‡Р°РµРј РґР°РЅРЅС‹Рµ РїСЂРµРґРјРµС‚Р° РёР· РєР°С‚Р°Р»РѕРіР°
            local item_data = items_catalog.get(item.id)
            if item_data then
                -- РџРѕРєР°Р·С‹РІР°РµРј РёРєРѕРЅРєСѓ
                gui.set_enabled(s.circle, true)
                gui.set_enabled(s.ring, true)
                gui.set_enabled(s.icon, true)
                gui.set_enabled(s.hit, true)
                
                -- РЈСЃС‚Р°РЅР°РІР»РёРІР°РµРј РёРєРѕРЅРєСѓ
                gui.set_text(s.icon, item_data.icon or "?")
                
                -- РљРѕРѕСЂРґРёРЅР°С‚С‹ Рё РёРјСЏ
                if s.coord then
                    gui.set_text(s.coord, string.format("[%02d]", i))
                    gui.set_enabled(s.coord, true)
                end
                if s.name then
                    gui.set_text(s.name, item_data.name or "???")
                    gui.set_enabled(s.name, true)
                end
                if s.qty and item.qty and item.qty > 1 then
                    gui.set_text(s.qty, "Г—" .. item.qty)
                    gui.set_enabled(s.qty, true)
                else
                    if s.qty then gui.set_enabled(s.qty, false) end
                end
                
                -- РЎРѕС…СЂР°РЅСЏРµРј item_id РґР»СЏ РѕР±СЂР°Р±РѕС‚РєРё РєР»РёРєРѕРІ
                s.item_id = item.id
            else
                -- РџСЂРµРґРјРµС‚ РЅРµ РЅР°Р№РґРµРЅ РІ РєР°С‚Р°Р»РѕРіРµ
                gui.set_enabled(s.circle, false)
                gui.set_enabled(s.ring, false)
                gui.set_enabled(s.icon, false)
                gui.set_enabled(s.hit, false)
                if s.coord then gui.set_enabled(s.coord, false) end
                if s.name then gui.set_enabled(s.name, false) end
                if s.qty then gui.set_enabled(s.qty, false) end
                s.item_id = nil
            end
        else
            -- РџСѓСЃС‚РѕР№ СЃР»РѕС‚
            gui.set_enabled(s.circle, false)
            gui.set_enabled(s.ring, false)
            gui.set_enabled(s.icon, false)
            gui.set_enabled(s.hit, false)
            if s.coord then gui.set_enabled(s.coord, false) end
            if s.name then gui.set_enabled(s.name, false) end
            if s.qty then gui.set_enabled(s.qty, false) end
            s.item_id = nil
        end
    end
    
    -- РћР±РЅРѕРІР»СЏРµРј СЃС‚Р°С‚РёСЃС‚РёРєСѓ
    if M.stat_slots then
        gui.set_text(M.stat_slots, "СЃР»РѕС‚РѕРІ: " .. used .. "/" .. M.SLOT_COUNT)
    end
    if M.stat_weight then
        local weight = used * 0.3
        gui.set_text(M.stat_weight, string.format("РІРµСЃ: %.1f РєРі", weight))
    end
end

-- -------------------------------------------------------
-- РџРѕРєР°Р·Р°С‚СЊ РґРµС‚Р°Р»Рё РїСЂРµРґРјРµС‚Р°
-- -------------------------------------------------------
local function show_item_details(item_id)
    if not item_id then return end
    
    local item_data = items_catalog.get(item_id)
    if not item_data then return end
    
    local d = M.details
    
    -- РќР°Р·РІР°РЅРёРµ
    if d.name then
        gui.set_text(d.name, item_data.name or "???")
        gui.set_enabled(d.name, true)
    end
    
    -- РРєРѕРЅРєР° РїСЂРµРІСЊСЋ
    if d.preview_icon then
        gui.set_text(d.preview_icon, item_data.icon or "?")
        gui.set_enabled(d.preview_icon, true)
    end
    if d.preview_bg then
        gui.set_enabled(d.preview_bg, true)
    end
    
    -- РћРїРёСЃР°РЅРёРµ
    if d.desc then
        gui.set_text(d.desc, item_data.desc or "РќРµС‚ РѕРїРёСЃР°РЅРёСЏ")
        gui.set_enabled(d.desc, true)
    end
    
    -- РЎС‚Р°С‚РёСЃС‚РёРєР° РїСЂРµРґРјРµС‚Р°
    if d.stat_source_key and d.stat_source_value then
        gui.set_text(d.stat_source_key, "РёСЃС‚РѕС‡РЅРёРє:")
        gui.set_text(d.stat_source_value, item_data.source or "РЅРµРёР·РІРµСЃС‚РЅРѕ")
        gui.set_enabled(d.stat_source_key, true)
        gui.set_enabled(d.stat_source_value, true)
    end
    
    if d.stat_type_key and d.stat_type_value then
        gui.set_text(d.stat_type_key, "С‚РёРї:")
        gui.set_text(d.stat_type_value, item_data.type or "РїСЂРµРґРјРµС‚")
        gui.set_enabled(d.stat_type_key, true)
        gui.set_enabled(d.stat_type_value, true)
    end
    
    -- РћСЃС‚Р°Р»СЊРЅС‹Рµ СЌР»РµРјРµРЅС‚С‹
    if d.cap then gui.set_enabled(d.cap, true) end
    if d.stamp then gui.set_enabled(d.stamp, true) end
    
    M.selected_item_id = item_id
    print("[inventory] РџРѕРєР°Р·Р°РЅС‹ РґРµС‚Р°Р»Рё РїСЂРµРґРјРµС‚Р°: " .. item_id)
end

-- -------------------------------------------------------
-- РЎРєСЂС‹С‚СЊ РґРµС‚Р°Р»Рё РїСЂРµРґРјРµС‚Р°
-- -------------------------------------------------------
local function hide_item_details()
    local d = M.details
    
    if d.name then gui.set_enabled(d.name, false) end
    if d.preview_icon then gui.set_enabled(d.preview_icon, false) end
    if d.preview_bg then gui.set_enabled(d.preview_bg, false) end
    if d.desc then gui.set_enabled(d.desc, false) end
    if d.cap then gui.set_enabled(d.cap, false) end
    if d.stamp then gui.set_enabled(d.stamp, false) end
    if d.stat_source_key then gui.set_enabled(d.stat_source_key, false) end
    if d.stat_source_value then gui.set_enabled(d.stat_source_value, false) end
    if d.stat_type_key then gui.set_enabled(d.stat_type_key, false) end
    if d.stat_type_value then gui.set_enabled(d.stat_type_value, false) end
    
    M.selected_item_id = nil
end

-- -------------------------------------------------------
-- РџРѕРєР°Р·Р°С‚СЊ РёРЅРІРµРЅС‚Р°СЂСЊ
-- -------------------------------------------------------
local function show_inventory()
    print("[inventory] РџРѕРєР°Р· РёРЅРІРµРЅС‚Р°СЂСЏ")
    
    gui.set_enabled(M.dim, true)
    gui.set_enabled(M.panel, true)
    gui.set_enabled(M.title, true)
    gui.set_enabled(M.close_btn, true)
    gui.set_enabled(M.close_text, true)
    
    if M.eyebrow then gui.set_enabled(M.eyebrow, true) end
    if M.stat_slots then gui.set_enabled(M.stat_slots, true) end
    if M.stat_weight then gui.set_enabled(M.stat_weight, true) end
    if M.stat_loop then gui.set_enabled(M.stat_loop, true) end
    
    -- РЎРєСЂС‹РІР°РµРј РґРµС‚Р°Р»Рё РїСЂРё РѕС‚РєСЂС‹С‚РёРё
    hide_item_details()
    
    -- Р—Р°РїРѕР»РЅСЏРµРј СЃР»РѕС‚С‹
    render_inv_slots()
    
    -- РђРЅРёРјР°С†РёСЏ РїРѕСЏРІР»РµРЅРёСЏ
    gui_animations.fade_in(M.dim, 0.2)
    gui_animations.fade_scale_in(M.panel, 0.3)
    
    M.visible = true
end

-- -------------------------------------------------------
-- РЎРєСЂС‹С‚СЊ РёРЅРІРµРЅС‚Р°СЂСЊ
-- -------------------------------------------------------
local function hide_inventory()
    print("[inventory] РЎРєСЂС‹С‚РёРµ РёРЅРІРµРЅС‚Р°СЂСЏ")
    
    gui.set_enabled(M.dim, false)
    gui.set_enabled(M.panel, false)
    gui.set_enabled(M.title, false)
    gui.set_enabled(M.close_btn, false)
    gui.set_enabled(M.close_text, false)
    
    if M.eyebrow then gui.set_enabled(M.eyebrow, false) end
    if M.stat_slots then gui.set_enabled(M.stat_slots, false) end
    if M.stat_weight then gui.set_enabled(M.stat_weight, false) end
    if M.stat_loop then gui.set_enabled(M.stat_loop, false) end
    
    -- РЎРєСЂС‹РІР°РµРј РІСЃРµ СЃР»РѕС‚С‹
    for i = 1, M.SLOT_COUNT do
        local s = M.slots[i]
        gui.set_enabled(s.circle, false)
        gui.set_enabled(s.ring, false)
        gui.set_enabled(s.icon, false)
        gui.set_enabled(s.hit, false)
        if s.coord then gui.set_enabled(s.coord, false) end
        if s.name then gui.set_enabled(s.name, false) end
        if s.qty then gui.set_enabled(s.qty, false) end
    end
    
    -- РЎРєСЂС‹РІР°РµРј РґРµС‚Р°Р»Рё
    hide_item_details()
    
    M.visible = false
end

-- -------------------------------------------------------
-- Lifecycle С„СѓРЅРєС†РёРё
-- -------------------------------------------------------

function init(self)
    print("[inventory] РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ")
    
    -- РџРѕР»СѓС‡Р°РµРј РѕСЃРЅРѕРІРЅС‹Рµ РЅРѕРґС‹
    M.dim = gui.get_node("inv_modal_dim")
    M.panel = gui.get_node("inv_modal_panel")
    M.title = gui.get_node("inv_modal_title")
    M.close_btn = gui.get_node("inv_modal_close_btn")
    M.close_text = gui.get_node("inv_modal_close_text")
    M.eyebrow = gui.get_node("inv_modal_eyebrow")
    M.stat_slots = gui.get_node("inv_modal_stat_slots")
    M.stat_weight = gui.get_node("inv_modal_stat_weight")
    M.stat_loop = gui.get_node("inv_modal_stat_loop")
    
    -- РџРѕР»СѓС‡Р°РµРј СЃР»РѕС‚С‹ (12 С€С‚СѓРє)
    for i = 1, M.SLOT_COUNT do
        M.slots[i] = {
            circle = gui.get_node("inv_slot_circle_" .. i),
            ring = gui.get_node("inv_slot_ring_" .. i),
            icon = gui.get_node("inv_slot_icon_" .. i),
            hit = gui.get_node("inv_slot_hit_" .. i),
            coord = gui.get_node("inv_slot_coord_" .. i),
            name = gui.get_node("inv_slot_name_" .. i),
            qty = gui.get_node("inv_slot_qty_" .. i),
            item_id = nil
        }
    end
    
    -- РџРѕР»СѓС‡Р°РµРј РЅРѕРґС‹ РґРµС‚Р°Р»РµР№ РїСЂРµРґРјРµС‚Р°
    M.details = {
        cap = gui.get_node("inv_details_cap"),
        name = gui.get_node("inv_details_name"),
        preview_bg = gui.get_node("inv_details_preview_bg"),
        preview_icon = gui.get_node("inv_details_preview_icon"),
        stamp = gui.get_node("inv_details_stamp"),
        desc = gui.get_node("inv_details_desc"),
        stat_source_key = gui.get_node("inv_details_stat_source_key"),
        stat_source_value = gui.get_node("inv_details_stat_source_value"),
        stat_type_key = gui.get_node("inv_details_stat_type_key"),
        stat_type_value = gui.get_node("inv_details_stat_type_value"),
    }
    
    -- РЎРєСЂС‹РІР°РµРј РёРЅРІРµРЅС‚Р°СЂСЊ РїСЂРё СЃС‚Р°СЂС‚Рµ
    hide_inventory()
    
    -- Р—Р°РїСЂР°С€РёРІР°РµРј input focus
    msg.post(".", "acquire_input_focus")
end

function final(self)
    print("[inventory] Р—Р°РІРµСЂС€РµРЅРёРµ")
end

function update(self, dt)
    -- РћР±РЅРѕРІР»СЏРµРј СЃР»РѕС‚С‹ РµСЃР»Рё РёРЅРІРµРЅС‚Р°СЂСЊ РІРёРґРёРј
    if M.visible then
        render_inv_slots()
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("show") then
        show_inventory()
    elseif message_id == hash("hide") then
        hide_inventory()
    elseif message_id == hash("toggle") then
        if M.visible then
            hide_inventory()
        else
            show_inventory()
        end
    end
end

-- -------------------------------------------------------
-- РћР±СЂР°Р±РѕС‚РєР° РІРІРѕРґР° (С‡Р°СЃС‚СЊ 2)
-- -------------------------------------------------------

function on_input(self, action_id, action)
    if not M.visible then return false end
    
    if action_id == hash("touch") and action.pressed then
        local x = action.x
        local y = action.y
        
        -- РљР»РёРє РїРѕ РєРЅРѕРїРєРµ Р·Р°РєСЂС‹С‚РёСЏ
        if gui.pick_node(M.close_btn, x, y) then
            hide_inventory()
            return true
        end
        
        -- РљР»РёРє РїРѕ СЃР»РѕС‚Р°Рј РёРЅРІРµРЅС‚Р°СЂСЏ
        for i = 1, M.SLOT_COUNT do
            local s = M.slots[i]
            if s.item_id and gui.pick_node(s.hit, x, y) then
                print("[inventory] РљР»РёРє РїРѕ СЃР»РѕС‚Сѓ " .. i .. ", РїСЂРµРґРјРµС‚: " .. s.item_id)
                show_item_details(s.item_id)
                return true
            end
        end
        
        -- РљР»РёРє РІРЅРµ РїР°РЅРµР»Рё - Р·Р°РєСЂС‹РІР°РµРј РёРЅРІРµРЅС‚Р°СЂСЊ
        if not gui.pick_node(M.panel, x, y) then
            hide_inventory()
            return true
        end
    end
    
    return false
end
