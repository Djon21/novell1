end

local function phone_ctx()
    return {
        components = M.components,
        overlays = M.overlays,
        sync_modal_state = function()
            sync_modal_state()
        end,
        dbg = dbg,
    }
end

local function has_phone_access()
    return phone_flow.has_access()
end

local function run_side_dialogue_knot(self, knot_name, keep_bg)
    if not knot_name or not dm.jump_to_knot then
        return false
    end

    -- keep_bg is the exploration background for side-knot jumps.
    -- Apply it BEFORE jump_to_knot: if the target Ink has an explicit # bg tag,
    -- that tag must win. Applying keep_bg after the jump overwrote explicit
    -- evening/night backgrounds, e.g. sunday_home_after_date_router.
    if keep_bg then
        dm.override_bg(keep_bg)
    end

    dm.jump_to_knot(knot_name)
    handle_dialogue_update(self)
    return true
end

local function jump_inventory_knot(self, knot_name)
    local keep_bg = nil
    if scene_controller.is_active and scene_controller.is_active() then
        keep_bg = scene_controller.get_current_bg and scene_controller.get_current_bg() or nil
        if scene_controller.exit then
            scene_controller.exit()
        end
    end
    return run_side_dialogue_knot(self, knot_name, keep_bg)
end

local function inventory_ctx(self)
    return {
        current_scene_id = function()
            return scene_controller.get_current_scene_id and scene_controller.get_current_scene_id() or nil
        end,
        current_scene_data = function()
            return scene_controller.get_current_scene_data and scene_controller.get_current_scene_data() or nil
        end,
        close_inventory = function()
            close_inventory(self)
        end,
        open_phone = function()
            open_phone(self)
        end,
        jump_inventory_knot = function(knot_name)
            jump_inventory_knot(self, knot_name)
        end,
        show_armed_banner = function(payload)
            msg.post(M.components.hud, "show_armed_banner", payload)
        end,
        hide_armed_banner = function()
            if M.components.hud then
                msg.post(M.components.hud, "hide_armed_banner")
            end
        end,
    }
end

local function clear_armed_state(self)
    inventory_flow.clear_armed(inventory_ctx(self))
end

local function handle_inventory_verb(self, item_id, verb, extra)
    inventory_flow.handle_verb(item_id, verb, extra, inventory_ctx(self))
end

local function handle_armed_hotspot_click(self, hotspot_id)
    return inventory_flow.handle_armed_hotspot(hotspot_id, inventory_ctx(self))
end

local function sync_ui_state(self)
    local inv = gs.get_inventory and gs.get_inventory() or {}
    local unread = gs.get_phone_unread_total and gs.get_phone_unread_total() or 0
    local has_phone = has_phone_access()

    msg.post(M.components.hud, "set_inventory_count", { n = #inv })
    msg.post(M.components.hud, "set_phone_enabled", { enabled = has_phone })
    msg.post(M.components.hud, "set_phone_notif", { n = unread })
    msg.post(M.components.inventory, "refresh_inventory")
    msg.post(M.components.phone, "set_phone_notif", { n = unread })
    -- step23: phone подтягивает SMS/quests/mail/calls/clues из game_state.
    msg.post(M.components.phone, "refresh_phone")
end

local function set_run_save_suppressed(on)
    M.suppress_run_save = on and true or false
end

local function persist_run_state()
    run_state.persist(M.suppress_run_save)
end

local function restore_run_state(opts)
    return run_state.restore(set_run_save_suppressed, opts)
end

local function load_main_story_bytes()
    return run_state.load_main_story_bytes()
end

local function reset_runtime_state()
    run_state.reset_runtime(set_run_save_suppressed)
end

local function start_new_run(self, reset_iteration_progress)
    local bytes = load_main_story_bytes()
    if not bytes then
        return false
    end

    -- Сбросить armed-state на случай если игрок начал новую игру/итерацию
    -- из меню в момент когда был активен use-on-target.
    clear_armed_state(self)

    sm.load()
    meta.init()

    if reset_iteration_progress then
        meta.reset_all()
    end

    M.at_end = false
    M.base_mode = "dialogue"
    M.overlays.choice = false
    M.overlays.inventory = false
    M.overlays.phone = false
    M.overlays.map = false
    M.overlays.backlog = false
    sync_modal_state()

    reset_dialogue_backlog(self)
    msg.post(M.components.choice, "hide_choice")
    msg.post(M.components.inventory, "hide_inventory")
    msg.post(M.components.phone, "close_phone")
    msg.post(M.components.map, "close_map")
    msg.post(M.components.hotspots, "hide_all")

    sm.new_game()
    -- Восстанавливаем выбор персонажа из meta_state (сохраняется между итерациями).
    -- meta.reset_all() ("СБРОСИТЬ ИТЕРАЦИЮ") вернёт nil → choose_character покажется снова.
    local saved_gender = meta.get("mc_gender")
    if saved_gender then
        sm.set_gender(saved_gender)
    end
    reset_runtime_state()

    dm.init(bytes)
    handle_dialogue_update(self)
    sync_ui_state(self)
    persist_run_state()
    return true
end

local function reset_iteration_and_restart(self)
    meta.init()
    meta.reset_all()

    -- Даём UI закончить обработку клика по меню и только потом стартуем новый run.
    timer.delay(0, false, function()
        start_new_run(self, false)
    end)
end

local function refresh_menu_state(self)
    sm.load()
    meta.init()

    msg.post(M.components.main_menu, "set_loop_state", {
        iteration = meta.get("iteration_number", 1),
        iteration_label = meta.get_iteration_label(),
        awareness = meta.get("loop_awareness", 0),
        completed = meta.get("completed_iterations", 0),
        can_continue = sm.has_save(),
    })
end

