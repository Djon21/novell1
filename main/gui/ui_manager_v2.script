-- ui_manager_v2.script
-- Оркестратор всех v2 GUI компонентов: main_menu_v2, hud_v2, inventory_v2,
-- phone_v2, map_v2, dialogue_v2, choice_v2, effects.
--
-- Режимы: menu / exploration / dialogue / choice / inventory / phone / map
-- Поверх модального режима (choice/inventory/phone/map) виден exploration или
-- dialogue — т.е. модалки не сбрасывают текущий базовый режим.
--
-- Совместимость: использует тот же dialogue_manager_ink, game_state,
-- scene_controller, что и старый ui_manager.script. Включение — через
-- переключение bootstrap.main_collection на main_v2 (step16 — опциональный).

go.property("bg_rooftop_atlas", resource.atlas("/main/images/backgrounds/bg_rooftop.atlas"))
go.property("bg_apartment_hall_morning_atlas", resource.atlas("/main/images/backgrounds/bg_apartment_hall_morning.atlas"))
go.property("bg_apartment_hall_night_atlas", resource.atlas("/main/images/backgrounds/bg_apartment_hall_night.atlas"))
go.property("bg_apartment_bedroom_morning_atlas", resource.atlas("/main/images/backgrounds/bg_apartment_bedroom_morning.atlas"))
go.property("bg_apartment_bedroom_night_atlas", resource.atlas("/main/images/backgrounds/bg_apartment_bedroom_night.atlas"))
go.property("bg_apartment_kitchen_morning_atlas", resource.atlas("/main/images/backgrounds/bg_apartment_kitchen_morning.atlas"))
go.property("bg_apartment_kitchen_night_atlas", resource.atlas("/main/images/backgrounds/bg_apartment_kitchen_night.atlas"))
go.property("bg_cafe_morning_atlas", resource.atlas("/main/images/backgrounds/bg_cafe_morning.atlas"))
go.property("bg_park_by_the_river_morning_atlas", resource.atlas("/main/images/backgrounds/bg_park_by_the_river_morning.atlas"))
go.property("bg_shop_day_atlas", resource.atlas("/main/images/backgrounds/bg_shop_day.atlas"))
go.property("bg_observation_day_atlas", resource.atlas("/main/images/backgrounds/bg_observation_day.atlas"))
go.property("bg_office_lobby_day_atlas", resource.atlas("/main/images/backgrounds/bg_office_lobby_day.atlas"))
go.property("bg_office_lobby_night_atlas", resource.atlas("/main/images/backgrounds/bg_office_lobby_night.atlas"))
go.property("bg_office_workspace_day_atlas", resource.atlas("/main/images/backgrounds/bg_office_workspace_day.atlas"))
go.property("bg_office_workspace_night_atlas", resource.atlas("/main/images/backgrounds/bg_office_workspace_night.atlas"))
go.property("bg_office_meeting_room_day_atlas", resource.atlas("/main/images/backgrounds/bg_office_meeting_room_day.atlas"))
go.property("bg_office_meeting_room_night_atlas", resource.atlas("/main/images/backgrounds/bg_office_meeting_room_night.atlas"))
go.property("bg_bar_maybe_night_atlas", resource.atlas("/main/images/backgrounds/bg_bar_maybe_night.atlas"))
go.property("bg_archive_day_atlas", resource.atlas("/main/images/backgrounds/bg_archive_day.atlas"))

local dm = require "main.scripts.dialogue_manager_ink"
local gs = require "main.scripts.game_state"
local sm = require "main.scripts.save_manager"
local meta = require "main.scripts.meta_state"
local scene_controller = require "main.scripts.scene_controller"
local l10n = require "main.scripts.l10n"
local yandex_ads = require "main.scripts.yandex_ads"
local dm_commands = require "main.gui.modules.ui_manager_v2.dm_commands"
local map_flow = require "main.gui.modules.ui_manager_v2.map_flow"
local inventory_flow = require "main.gui.modules.ui_manager_v2.inventory_flow"
local dialogue_flow = require "main.gui.modules.ui_manager_v2.dialogue_flow"
local run_state = require "main.gui.modules.ui_manager_v2.run_state"
local background_flow = require "main.gui.modules.ui_manager_v2.background_flow"
local phone_flow = require "main.gui.modules.ui_manager_v2.phone_flow"
local effects_flow = require "main.gui.modules.ui_manager_v2.effects_flow"
local scene_flow = require "main.gui.modules.ui_manager_v2.scene_flow"
local overlay_flow = require "main.gui.modules.ui_manager_v2.overlay_flow"
