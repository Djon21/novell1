    background_flow.init_atlas_state(self, DEDICATED_BG_ATLAS_PROPS)
end

local function apply_dialogue_bg(self, bg_name)
    background_flow.apply_dialogue_bg(self, M.components, bg_name)
end

local function post_dialogue_background(self, bg_name)
    background_flow.post_dialogue_bg(self, bg_name)
end

local function current_scene_id()
    return scene_controller.get_current_scene_id and scene_controller.get_current_scene_id() or nil
end

local function resolve_current_location_label(bg_name)
    return background_flow.resolve_location_label(bg_name, scenes)
end

local function post_location_to_ui(location_label)
    background_flow.post_location(M.components, location_label)
end

local function resolve_map_selected_pin()
    return map_flow.resolve_selected_pin()
end

local function sync_map_overlay(selected_id, log_text)
    map_flow.sync_overlay(M.components.map, selected_id, log_text)
end

local function handle_map_verb(self, pin_id, verb)
    map_flow.handle_verb(M.components.map, pin_id, verb)
end

local function dialogue_ctx()
    return {
        components = M.components,
        overlays = M.overlays,
        auto_advance_min_delay = AUTO_ADVANCE_MIN_DELAY,
        auto_advance_max_delay = AUTO_ADVANCE_MAX_DELAY,
        skip_advance_delay = SKIP_ADVANCE_DELAY,
        base_mode = function()
            return M.base_mode
        end,
        at_end = function()
            return M.at_end
        end,
        sync_modal_state = function()
            sync_modal_state()
        end,
        render_current_scene = function()
            if scene_controller.is_active and scene_controller.is_active()
                and scene_controller.render_now then
                scene_controller.render_now()
            end
        end,
    }
end

local function cancel_dialogue_autoplay(self)
    dialogue_flow.cancel_autoplay(self)
end

local function reset_dialogue_autoplay_state(self)
    dialogue_flow.reset_autoplay_state(self)
end

local function reset_dialogue_backlog(self)
    dialogue_flow.reset_backlog()
end

local function open_dialogue_backlog(self)
    dialogue_flow.open_backlog(dialogue_ctx())
end

local function close_dialogue_backlog(self)
    dialogue_flow.close_backlog(dialogue_ctx())
end

local function append_dialogue_backlog(self, entry)
    dialogue_flow.append_backlog(entry)
end

local function apply_dialogue_toggle_state(self)
    dialogue_flow.apply_toggle_state(self, dialogue_ctx())
end

local function schedule_dialogue_autoadvance(self)
    dialogue_flow.schedule_autoadvance(self, dialogue_ctx())
end

local function nudge_dialogue_skip(self)
