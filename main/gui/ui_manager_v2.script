        components = M.components,
        overlays = M.overlays,
        dbg = dbg,
        set_base_mode = function(mode)
            M.base_mode = mode
        end,
        set_at_end = function(value)
            M.at_end = value and true or false
        end,
        reset_dialogue_play_modes = function()
            reset_dialogue_play_modes(self)
        end,
        reset_dialogue_autoplay_state = function()
            reset_dialogue_autoplay_state(self)
        end,
        refresh_menu_state = function()
            refresh_menu_state(self)
        end,
        clear_armed_state = function()
            clear_armed_state(self)
        end,
        close_phone = function()
            close_phone(self)
        end,
        close_inventory = function()
            close_inventory(self)
        end,
        close_map = function()
            close_map(self)
        end,
        hide_choice = function()
            hide_choice(self)
        end,
        open_phone_map_app = function()
            return open_phone_map_app(self)
        end,
        resolve_map_selected_pin = function()
            return resolve_map_selected_pin()
        end,
        sync_map_overlay = function(selected_id, log_text)
            sync_map_overlay(selected_id, log_text)
        end,
        resolve_current_location_label = function(bg_name)
            return resolve_current_location_label(bg_name)
        end,
        post_location_to_ui = function(location_label)
            post_location_to_ui(location_label)
        end,
        current_scene_id = function()
            return current_scene_id()
        end,
    }
end

