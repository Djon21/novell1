local function consume_dm_effects()
    effects_flow.consume({
        components = M.components,
        sfx_urls = M.SFX_URLS,
    })
end

-- -------------------------------------------------------
-- dialogue_manager_ink интеграция
-- -------------------------------------------------------

local function apply_dm_commands(self)
    local cmds = dm.get_commands and dm.get_commands() or {}
    return dm_commands.apply(cmds, {
        open_phone = function() open_phone(self) end,
        close_phone = function() close_phone(self) end,
        open_phone_app = function(app) open_phone_app(self, app) end,
        open_map_hub = function(knot) open_map_hub(self, knot) end,
        on_resume = function() handle_dialogue_update(self) end,
    })
end

handle_dialogue_update = function(self)
    cancel_dialogue_autoplay(self)

    -- 1) Применить команды из ink-тегов (могут поменять сцену)
    if apply_dm_commands(self) then
        return
    end

    -- 1a) Если apply_dm_commands открыл map hub, не рендерим диалог поверх:
    -- иначе на `-> DONE` сразу после `# map:hub:KNOT` dialogue уходит в
    -- end-state, клик мимо пина ловится btn_next → advance → chapter_finished.
    if M.overlays.map then
        M.at_end = false
        msg.post(M.components.dialogue, "hide_dialogue")
        hide_choice(self)
        return
    end
    if M.overlays.phone then
        M.at_end = false
        msg.post(M.components.dialogue, "hide_dialogue")
        hide_choice(self)
        return
    end

    -- 2) Проверить режим ПЕРЕД обновлением фона
    local in_exploration = scene_controller.is_active and scene_controller.is_active()
    
    -- 3) Обновить фон только если НЕ в exploration (в exploration фон идёт из scene_controller)
    if not in_exploration then
        local bg = dm.get_background_image and dm.get_background_image()
        dbg("[ui_manager_v2] dm bg=", bg)
        if bg then
            post_dialogue_background(self, bg)
        end
    else
        dbg("[ui_manager_v2] in exploration mode, bg from scene_controller")
    end

    -- 4) Выбрать режим по scene_controller + отрендерить ноду
    consume_dm_effects()

    local node = dm.get_current_node and dm.get_current_node()
    dbg("[ui_manager_v2] dm node=", node and node.type, "char=", node and node.character, "text=", node and node.text and node.text:sub(1,40))

    if in_exploration then
        M.at_end = false
        show_exploration(self)
        hide_choice(self)
        return
    end

    if not node then
        M.at_end = false
        reset_dialogue_autoplay_state(self)
        show_dialogue(self)
        return
    end

    if node.type == "dialogue" then
        M.at_end = false
        self.dialogue_node_type = "dialogue"
        self.dialogue_waiting_for_typewriter = true
        self.dialogue_current_text = node.text or ""
        self.current_choice_question = nil
        self.current_choice_options = nil
        append_dialogue_backlog(self, {
            kind = "dialogue",
            speaker = node.character,
            fallback_speaker = "НАРРАТОР",
            text = node.text or "",
        })
        show_dialogue(self)
        hide_choice(self)
        msg.post(M.components.dialogue, "render_dialogue", {
            speaker = node.character,
            name    = node.character and tostring(node.character):upper() or "—",
            text    = node.text or "",
            loop    = meta.get("iteration_number", 1),
            loop_label = meta.get_iteration_label(),
        })
        nudge_dialogue_skip(self)

    elseif node.type == "choice" then
        -- Автовыбор персонажа: если пол уже сохранён (итерация 2+),
        -- пропускаем choose_character без показа игроку.
        -- Определяем по наличию вариантов "Артём" и "Мила" (ровно 2 варианта).
        local saved_gender = sm.get_gender()
        local should_skip_character_choice = saved_gender and (meta.get("iteration_number", 1) or 1) > 1
        if should_skip_character_choice then
            local opts = node.options or {}
            if #opts == 2 then
                local has_artem = (opts[1].text == "Артём" or opts[2].text == "Артём")
                local has_mila  = (opts[1].text == "Мила"  or opts[2].text == "Мила")
                if has_artem and has_mila then
                    for i, opt in ipairs(opts) do
                        local is_female_opt = (opt.text == "Мила")
                        if (saved_gender == "female") == is_female_opt then
                            dm.choose(i)
                            handle_dialogue_update(self)
                            return
                        end
                    end
                end
            end
        end
        M.at_end = false
        self.dialogue_node_type = "choice"
        self.dialogue_waiting_for_typewriter = false
        self.dialogue_current_text = ""
        self.current_choice_question = node.question or "КАК ПОСТУПИТЬ?"
        self.current_choice_options = node.options or {}
        show_dialogue(self)
        show_choice(self, node.options or {}, 18, node.question or "КАК ПОСТУПИТЬ?")

    elseif node.type == "end" then
        self.dialogue_node_type = "end"
        self.dialogue_waiting_for_typewriter = true
        self.dialogue_current_text = node.text or ""
        self.current_choice_question = nil
        self.current_choice_options = nil
        append_dialogue_backlog(self, {
            kind = "system",
            speaker = "КОНЕЦ",
            text = node.text or "Конец главы.",
        })
        show_dialogue(self)
        hide_choice(self)
        msg.post(M.components.dialogue, "render_dialogue", {
            speaker = "narrator",
            loop    = meta.get("iteration_number", 1),
            loop_label = meta.get_iteration_label(),
            name    = "КОНЕЦ",
            text    = node.text or "Конец главы. Нажми NEXT чтобы вернуться в меню.",
        })
        M.at_end = true
    end
end

-- -------------------------------------------------------
-- scene_controller интеграция
-- -------------------------------------------------------

local function setup_scene_controller_ui(self)
    scene_flow.setup({
        components = M.components,
        dbg = dbg,
        set_background = function(bg_name)
            post_location_to_ui(resolve_current_location_label(bg_name))
            if bg_name then
                post_dialogue_background(self, bg_name)
                dbg("[ui_manager_v2] scene_controller set_background:", bg_name)
            end
        end,
        request_ink_knot = function(knot_name, keep_bg)
            run_side_dialogue_knot(self, knot_name, keep_bg)
        end,
        request_use_on_hotspot = function(hotspot_id)
            return handle_armed_hotspot_click(self, hotspot_id)
        end,
    })
end

-- -------------------------------------------------------
-- Lifecycle
-- -------------------------------------------------------

function init(self)
    dbg("[ui_manager_v2] init")
    -- Локализация: читаем язык из window.__gameLang (выставлен JS-шаблоном
    -- ДО старта Defold) и грузим JSON-словари. Делаем самым первым шагом —
    -- остальные init'ы могут уже звать l10n.t().
    l10n.init()
    init_components()
    init_background_atlas_state(self)
    setup_scene_controller_ui(self)
    sm.load()
    meta.init()
    yandex_ads.init()

    gs.subscribe(function()
        -- Обновляем счётчики в HUD при изменении game_state
        local inv = gs.get_inventory and gs.get_inventory() or {}
        local n = 0
        for _ in pairs(inv) do n = n + 1 end
        msg.post(M.components.hud, "set_inventory_count", { n = n })
    end)

    gs.subscribe(function()
        sync_ui_state(self)
        persist_run_state()
    end)

    self.dialogue_auto = false
    self.dialogue_skip = false
    self.dialogue_autoplay_handle = nil
    self.dialogue_waiting_for_typewriter = false
    self.dialogue_node_type = nil
    self.dialogue_current_text = ""
    self.current_choice_question = nil
    self.current_choice_options = nil

    reset_dialogue_backlog(self)
    apply_dialogue_toggle_state(self)
    sync_ui_state(self)
    show_menu(self)
    msg.post(".", "acquire_input_focus")
    dbg("[ui_manager_v2] init done")
end

function final(self)
    msg.post(".", "release_input_focus")
end

local function message_ctx(self)
    return {
        self = self,
        dbg = dbg,
        show_menu = function() show_menu(self) end,
        start_new_run = function(reset_iteration_progress) start_new_run(self, reset_iteration_progress) end,
        refresh_menu_state = function() refresh_menu_state(self) end,
        restore_run_state = function(opts) return restore_run_state(opts) end,
        enter_restored_scene = function(scene_id) scene_controller.enter(scene_id) end,
        reset_dialogue_backlog = function() reset_dialogue_backlog(self) end,
        handle_dialogue_update = function() handle_dialogue_update(self) end,
        sync_ui_state = function() sync_ui_state(self) end,
        reset_iteration_and_restart = function() reset_iteration_and_restart(self) end,
        reset_runtime_state = function() reset_runtime_state() end,
        apply_dialogue_bg = function(bg_name) apply_dialogue_bg(self, bg_name) end,
        cancel_dialogue_autoplay = function() cancel_dialogue_autoplay(self) end,
        schedule_dialogue_autoadvance = function() schedule_dialogue_autoadvance(self) end,
        set_dialogue_play_mode = function(mode, on) set_dialogue_play_mode(self, mode, on) end,
        open_dialogue_backlog = function() open_dialogue_backlog(self) end,
        close_dialogue_backlog = function() close_dialogue_backlog(self) end,
        append_dialogue_backlog = function(entry) append_dialogue_backlog(self, entry) end,
        hide_choice = function() hide_choice(self) end,
        open_inventory = function() open_inventory(self) end,
        close_inventory = function() close_inventory(self) end,
        handle_inventory_verb = function(item_id, verb, extra) handle_inventory_verb(self, item_id, verb, extra) end,
        clear_armed_state = function() clear_armed_state(self) end,
        open_phone = function() open_phone(self) end,
        close_phone = function() close_phone(self) end,
        run_side_dialogue_knot = function(knot_name, keep_bg) run_side_dialogue_knot(self, knot_name, keep_bg) end,
        open_map = function() open_map(self) end,
        close_map = function() close_map(self) end,
        handle_map_verb = function(pin_id, verb) handle_map_verb(self, pin_id, verb) end,
    }
end

function on_message(self, message_id, message, sender)
    message_flow.handle(message_ctx(self), message_id, message, sender)
end

function on_input(self, action_id, action)
    -- Музыка при первом касании
    if not M.music_started and action_id == hash("touch") and action.pressed then
        M.music_started = true
        msg.post(M.MUSIC_URL, "play_sound", { delay = 0, gain = 0.5 })
    end

    if action_id == hash("key_esc") and action.pressed then
        -- Esc закрывает первую открытую модалку
        if M.overlays.backlog then
            close_dialogue_backlog(self); return true
        elseif M.overlays.choice then
            hide_choice(self)
            msg.post(".", "choice_cancelled")
            return true
        elseif M.overlays.map then
            close_map(self); return true
        elseif M.overlays.phone then
            close_phone(self); return true
        elseif M.overlays.inventory then
            close_inventory(self); return true
        end
    end
    return false
end
