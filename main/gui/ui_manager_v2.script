-- ui_manager_v2.script
-- Оркестратор всех v2 GUI компонентов: main_menu_v2, hud_v2, inventory_v2,
-- phone_v2, map_v2, dialogue_v2, choice_v2, effects.
--
-- Режимы: menu / exploration / dialogue / choice / inventory / phone / map
-- Поверх модального режима (choice/inventory/phone/map) виден exploration или
-- dialogue — т.е. модалки не сбрасывают текущий базовый режим.
--
-- Совместимость: использует тот же dialogue_manager_ink, game_state,
-- scene_controller, что и старый ui_manager.script. Включение — через
-- переключение bootstrap.main_collection на main_v2 (step16 — опциональный).

go.property("bg_apartment_atlas", resource.atlas("/main/images/backgrounds/bg_apartment.atlas"))
go.property("bg_bathroom_atlas", resource.atlas("/main/images/backgrounds/bg_bathroom.atlas"))
go.property("bg_bedroom_atlas", resource.atlas("/main/images/backgrounds/bg_bedroom.atlas"))
go.property("bg_bedroom_01_atlas", resource.atlas("/main/images/backgrounds/bg_bedroom_01.atlas"))
go.property("bg_bedroom_02_atlas", resource.atlas("/main/images/backgrounds/bg_bedroom_02.atlas"))
go.property("bg_bedroom_03_atlas", resource.atlas("/main/images/backgrounds/bg_bedroom_03.atlas"))
go.property("bg_city_map_atlas", resource.atlas("/main/images/backgrounds/bg_city_map.atlas"))
go.property("bg_kitchen_atlas", resource.atlas("/main/images/backgrounds/bg_kitchen.atlas"))
go.property("bg_metro_atlas", resource.atlas("/main/images/backgrounds/bg_metro.atlas"))
go.property("bg_office_atlas", resource.atlas("/main/images/backgrounds/bg_office.atlas"))
go.property("bg_office_evening_atlas", resource.atlas("/main/images/backgrounds/bg_office_evening.atlas"))
go.property("bg_phone_atlas", resource.atlas("/main/images/backgrounds/bg_phone.atlas"))
go.property("bg_rooftop_atlas", resource.atlas("/main/images/backgrounds/bg_rooftop.atlas"))

local dm = require "main.scripts.dialogue_manager_ink"
local gs = require "main.scripts.game_state"
local sm = require "main.scripts.save_manager"
local meta = require "main.scripts.meta_state"
local scene_controller = require "main.scripts.scene_controller"
local catalog = require "main.scripts.items_catalog"

local ok_scenes, scenes = pcall(require, "main.scripts.scenes")
if not ok_scenes then scenes = nil end

-- Debug-логи: переключить в true для диагностики mode/overlay переходов
local DEBUG_LOG = false
local function dbg(...)
    if DEBUG_LOG then print(...) end
end

local M = {}
local handle_dialogue_update
local close_inventory
local open_phone
local close_phone
local close_map
local hide_choice

local INVENTORY_MVP_VERBS = {
    use = true,
    inspect = true,
    read = true,
}

local LEGACY_FLAG_ITEMS = {
    has_mug = "mug",
    has_phone = "phone",
}

local BG_TEXTURE_KEY = "backgrounds"
local DEDICATED_BG_ANIMATION = "scene_bg"
local AUTO_ADVANCE_MIN_DELAY = 1.0
local AUTO_ADVANCE_MAX_DELAY = 3.0
local SKIP_ADVANCE_DELAY = 0.05

local MAP_HOME_SCENES = {
    apartment_hub = true,
    kitchen = true,
    bathroom = true,
    bedroom_day = true,
}

local MAP_PIN_LABELS = {
    home = "Дом",
    work = "Офис",
    cafe = "Кофейня Петля",
    metro = "М. Ул. 1905 года",
    shop = "Магазин 24 часа",
    clue = "След: дежавю",
    gov = "Администрация",
}

local DEDICATED_BG_ATLAS_PROPS = {
    bg_apartment      = "bg_apartment_atlas",
    bg_bathroom       = "bg_bathroom_atlas",
    bg_bedroom        = "bg_bedroom_atlas",
    bg_bedroom_01     = "bg_bedroom_01_atlas",
    bg_bedroom_02     = "bg_bedroom_02_atlas",
    bg_bedroom_03     = "bg_bedroom_03_atlas",
    bg_city_map       = "bg_city_map_atlas",
    bg_kitchen        = "bg_kitchen_atlas",
    bg_metro          = "bg_metro_atlas",
    bg_office         = "bg_office_atlas",
    bg_office_evening = "bg_office_evening_atlas",
    bg_phone          = "bg_phone_atlas",
    bg_rooftop        = "bg_rooftop_atlas",
}

-- Базовый режим (menu / nav / exploration / dialogue). choice/inventory/phone/map —
-- накладываются сверху.
M.base_mode = "menu"

-- Текущий набор модальных экранов (key = name, value = bool).
M.overlays = {
    choice    = false,
    inventory = false,
    phone     = false,
    map       = false,
}

M.music_started = false
M.MUSIC_URL = "/music_player#sound"
M.SFX_URLS = {
    terminal_wake = "/sfx_player#terminal_wake",
    coffee_brew   = "/sfx_player#coffee_brew",
    phone_notify  = "/sfx_player#phone_notify",
    heartbeat     = "/sfx_player#heartbeat",
    paper_rustle  = "/sfx_player#paper_rustle",
}

M.components = {}
M.suppress_run_save = false

-- -------------------------------------------------------
-- init components (URL'ы всех GUI-компонентов в одной GO)
-- -------------------------------------------------------

local function init_components()
    M.components.main_menu   = msg.url("#main_menu_v2")
    M.components.hud         = msg.url("#hud_v2")
    M.components.dialogue    = msg.url("#dialogue_v2")
    M.components.choice      = msg.url("#choice_v2")
    M.components.inventory   = msg.url("#inventory_v2")
    M.components.phone       = msg.url("#phone_v2")
    M.components.map         = msg.url("#map_v2")
    M.components.hotspots    = msg.url("#hotspots_v2")
    M.components.effects     = msg.url("#effects")
    dbg("[ui_manager_v2] компоненты инициализированы")
end

-- -------------------------------------------------------
-- show_* / hide_* — отправка сообщений в конкретный компонент
-- -------------------------------------------------------

local function init_background_atlas_state(self)
    self.dialogue_bg_atlases = {}
    self.current_dialogue_bg_atlas = nil
    -- URL на самого себя — нужен чтобы из callback'ов (которые могут
    -- исполняться в gui_script контексте) перекинуть работу с go.set
    -- обратно в .script контекст через msg.post.
    self.self_url = msg.url()

    for bg_name, prop_name in pairs(DEDICATED_BG_ATLAS_PROPS) do
        self.dialogue_bg_atlases[bg_name] = self[prop_name]
    end
end

local function resolve_dialogue_bg_visual(self, bg_name)
    if bg_name and self.dialogue_bg_atlases[bg_name] then
        return self.dialogue_bg_atlases[bg_name], DEDICATED_BG_ANIMATION
    end
    return nil, nil
end

-- ВНИМАНИЕ: эта функция содержит go.set и ОБЯЗАНА вызываться только
-- из контекста .script (например, on_message ui_manager_v2). Если её
-- дёрнуть из gui_script callback (через scene_controller _ui.set_background),
-- Defold упадёт с "You can only access go.* functions ... from a script instance".
-- Поэтому из callback'ов используем post_dialogue_background, который
-- асинхронно прокидывает запрос обратно сюда через msg.post.
local function apply_dialogue_bg(self, bg_name)
    if not self or not M.components.dialogue then return end
    if not bg_name or bg_name == "" or bg_name == "none" then return end

    local atlas, animation_id = resolve_dialogue_bg_visual(self, bg_name)
    if not atlas then
        -- После завершения миграции в `BACKGROUND_SYSTEM_MIGRATION_PLAN.md`
        -- единственный источник fullscreen-фонов — `DEDICATED_BG_ATLAS_PROPS`.
        -- Незарегистрированный bg_name здесь — это отсутствующий dedicated
        -- atlas. Не падаем, но громко логируем, чтобы такой кейс был виден.
        print("[ui_manager_v2] WARNING: no dedicated atlas for bg:", bg_name,
              "— зарегистрируй его в ui_manager_v2.script + main/images/backgrounds/")
        return
    end

    if self.current_dialogue_bg_atlas ~= atlas then
        go.set(M.components.dialogue, "textures", atlas, { key = BG_TEXTURE_KEY })
        self.current_dialogue_bg_atlas = atlas
    end

    msg.post(M.components.dialogue, "set_background", {
        name = bg_name,
        animation = animation_id,
    })
end

-- Безопасная для любого контекста (script / gui_script) точка входа.
-- Просит ui_manager_v2 переключить atlas и обновить фон через msg.post
-- самому себе — так go.set всегда исполняется в .script контексте.
local function post_dialogue_background(self, bg_name)
    if not bg_name then return end
    local target = (self and self.self_url) or msg.url("#ui_manager_v2")
    msg.post(target, "apply_dialogue_bg", { name = bg_name })
end

local function post_map_log(text)
    msg.post(M.components.map, "set_log", { text = text or "" })
end

local function current_scene_id()
    return scene_controller.get_current_scene_id and scene_controller.get_current_scene_id() or nil
end

local function resolve_map_selected_pin()
    local scene_id = current_scene_id()
    if scene_id and MAP_HOME_SCENES[scene_id] then
        return "home"
    end
    if gs.get_flag and gs.get_flag("reached_office") then
        return "work"
    end
    if gs.get_flag and gs.get_flag("reached_metro") then
        return "metro"
    end
    if gs.get_quest and gs.get_quest("go_to_office") == "active" then
        return "metro"
    end
    return "home"
end

local function build_map_point_overrides()
    local iteration = "#" .. tostring(meta.get_iteration_label and meta.get_iteration_label() or "001")
    local loop_awareness = meta.get and (meta.get("loop_awareness", 0) or 0) or 0
    local scene_id = current_scene_id()
    local at_home = scene_id and MAP_HOME_SCENES[scene_id] == true or false
    local reached_metro = gs.get_flag and gs.get_flag("reached_metro") == true or false
    local reached_office = gs.get_flag and gs.get_flag("reached_office") == true or false
    local go_to_office_status = gs.get_quest and gs.get_quest("go_to_office") or nil
    local current_route = gs.get_flag and gs.get_flag("map_route_target") or nil

    return {
        home = {
            iter = iteration,
            stat = at_home and "текущая" or "исходная",
            clue = gs.get_flag and gs.get_flag("has_phone") and "телефон" or "—",
        },
        metro = {
            iter = iteration,
            stat = reached_metro and "пройдено"
                or (current_route == "metro" and "маршрут отмечен")
                or (go_to_office_status == "active" and "следующая точка")
                or "узел",
            clue = gs.get_flag and gs.get_flag("map_shared_metro") and "да" or "—",
        },
        work = {
            iter = iteration,
            stat = reached_office and "достигнуто"
                or (current_route == "work" and "маршрут отмечен")
                or (go_to_office_status == "active" and "цель дня")
                or "ожидают",
            clue = gs.get_flag and gs.get_flag("map_shared_work") and "да" or "—",
        },
        cafe = {
            iter = iteration,
            stat = current_route == "cafe" and "маршрут отмечен"
                or (gs.get_flag and gs.get_flag("map_saved_cafe") and "в заметках" or "ориентир"),
            clue = gs.get_flag and gs.get_flag("map_shared_cafe") and "да" or "—",
        },
        shop = {
            iter = iteration,
            stat = current_route == "shop" and "маршрут отмечен"
                or (gs.get_flag and gs.get_flag("map_saved_shop") and "в заметках" or "открыто 24/7"),
            clue = gs.get_flag and gs.get_flag("map_shared_shop") and "да" or "—",
        },
        clue = {
            iter = iteration,
            stat = loop_awareness > 0 and "аномалия" or "скрытый след",
            clue = loop_awareness > 0 and "да" or "—",
            visible = loop_awareness > 0,
        },
        gov = {
            iter = iteration,
            stat = current_route == "gov" and "маршрут отмечен"
                or (loop_awareness > 1 and "интерес" or "ч/п 9:00–18:00"),
            clue = gs.get_flag and gs.get_flag("map_shared_gov") and "да" or "—",
        },
    }
end

local function sync_map_overlay(selected_id, log_text)
    msg.post(M.components.map, "set_points", {
        points = build_map_point_overrides(),
        selected_id = selected_id or resolve_map_selected_pin(),
    })
    if log_text then
        post_map_log(log_text)
    end
end

local function add_map_note_once(flag_name, title, body)
    if gs.get_flag and gs.get_flag(flag_name) then
        return false
    end
    if gs.set_flag then
        gs.set_flag(flag_name, true)
    end
    if gs.add_note then
        gs.add_note(title, body)
    end
    return true
end

local function handle_map_verb(self, pin_id, verb)
    if not pin_id or not verb then
        return
    end

    local label = MAP_PIN_LABELS[pin_id] or pin_id
    local iteration = tostring(meta.get_iteration_label and meta.get_iteration_label() or "001")
    local log_text = nil

    if verb == "route" then
        if gs.set_flag then
            gs.set_flag("map_route_target", pin_id)
        end
        local body = "Маршрут до точки «" .. label .. "» отмечен в планировщике. Петля #" .. iteration .. "."
        if pin_id == "metro" then
            body = body .. "\nСледующая сюжетная опора: метро."
        elseif pin_id == "work" then
            body = body .. "\nЦель рабочего дня закреплена в маршруте."
        end
        local added = add_map_note_once("map_note_route_" .. pin_id, "Маршрут: " .. label, body)
        log_text = added and ("> маршрут сохранён: " .. label .. " _") or ("> маршрут уже сохранён: " .. label .. " _")

    elseif verb == "save" then
        if gs.set_flag then
            gs.set_flag("map_saved_" .. pin_id, true)
        end
        local body = "Досье по точке «" .. label .. "» добавлено в заметки. Это быстрый якорь для текущей петли #" .. iteration .. "."
        local added = add_map_note_once("map_note_saved_" .. pin_id, "Досье: " .. label, body)
        log_text = added and ("> досье сохранено: " .. label .. " _") or ("> досье уже было сохранено: " .. label .. " _")

    elseif verb == "share" then
        if gs.set_flag then
            gs.set_flag("map_shared_" .. pin_id, true)
        end
        local body = "Точка «" .. label .. "» помечена как важная для петли #" .. iteration .. "."
        local added = add_map_note_once("map_note_shared_" .. pin_id, "Отметка: " .. label, body)
        log_text = added and ("> маркер отмечен: " .. label .. " _") or ("> маркер уже отмечен: " .. label .. " _")
    end

    sync_map_overlay(pin_id, log_text)
end

local function cancel_dialogue_autoplay(self)
    if self.dialogue_autoplay_handle then
        timer.cancel(self.dialogue_autoplay_handle)
        self.dialogue_autoplay_handle = nil
    end
end

local function reset_dialogue_autoplay_state(self)
    cancel_dialogue_autoplay(self)
    self.dialogue_waiting_for_typewriter = false
    self.dialogue_node_type = nil
    self.dialogue_current_text = ""
end

local function compute_dialogue_autoplay_delay(text, skip_mode)
    if skip_mode then
        return SKIP_ADVANCE_DELAY
    end
    local text_len = #(text or "")
    return math.min(AUTO_ADVANCE_MAX_DELAY, math.max(AUTO_ADVANCE_MIN_DELAY, 0.75 + (text_len / 28)))
end

local function dialogue_can_autoadvance(self)
    return self.dialogue_node_type == "dialogue"
        and M.base_mode == "dialogue"
        and not M.overlays.choice
        and not M.overlays.inventory
        and not M.overlays.phone
        and not M.overlays.map
        and not self.dialogue_waiting_for_typewriter
        and not M.at_end
end

local function apply_dialogue_toggle_state(self)
    msg.post(M.components.dialogue, "set_auto", { on = self.dialogue_auto == true })
    msg.post(M.components.dialogue, "set_skip", { on = self.dialogue_skip == true })
end

local function schedule_dialogue_autoadvance(self)
    cancel_dialogue_autoplay(self)
    if not dialogue_can_autoadvance(self) then
        return
    end
    if not self.dialogue_auto and not self.dialogue_skip then
        return
    end

    local delay = compute_dialogue_autoplay_delay(self.dialogue_current_text, self.dialogue_skip)
    self.dialogue_autoplay_handle = timer.delay(delay, false, function()
        self.dialogue_autoplay_handle = nil
        if not dialogue_can_autoadvance(self) then
            return
        end
        msg.post(".", "dialogue_next")
    end)
end

local function nudge_dialogue_skip(self)
    if not self.dialogue_skip then
        return
    end
    if self.dialogue_node_type ~= "dialogue" then
        return
    end
    if self.dialogue_waiting_for_typewriter then
        timer.delay(0, false, function()
            if self.dialogue_skip and self.dialogue_waiting_for_typewriter and self.dialogue_node_type == "dialogue" then
                msg.post(M.components.dialogue, "finish_typewriter")
            end
        end)
    else
        schedule_dialogue_autoadvance(self)
    end
end

local function set_dialogue_play_mode(self, mode, on)
    if mode == "auto" then
        self.dialogue_auto = on and true or false
        if self.dialogue_auto then
            self.dialogue_skip = false
        end
    elseif mode == "skip" then
        self.dialogue_skip = on and true or false
        if self.dialogue_skip then
            self.dialogue_auto = false
        end
    end

    cancel_dialogue_autoplay(self)
    apply_dialogue_toggle_state(self)
    nudge_dialogue_skip(self)
    if not self.dialogue_waiting_for_typewriter then
        schedule_dialogue_autoadvance(self)
    end
end

local function reset_dialogue_play_modes(self)
    self.dialogue_auto = false
    self.dialogue_skip = false
    reset_dialogue_autoplay_state(self)
    apply_dialogue_toggle_state(self)
end

local function has_phone_access()
    local has_flag = gs.get_flag and gs.get_flag("has_phone") == true or false
    local has_item = gs.has_item and gs.has_item("phone") or false
    return has_flag or has_item
end

local function run_side_dialogue_knot(self, knot_name, keep_bg)
    if not knot_name or not dm.jump_to_knot then
        return false
    end
    dm.jump_to_knot(knot_name)
    if keep_bg then
        dm.override_bg(keep_bg)
    end
    handle_dialogue_update(self)
    return true
end

local function jump_inventory_knot(self, knot_name)
    local keep_bg = nil
    if scene_controller.is_active and scene_controller.is_active() then
        local scene_data = scene_controller.get_current_scene_data and scene_controller.get_current_scene_data()
        keep_bg = scene_data and scene_data.bg or nil
        if scene_controller.exit then
            scene_controller.exit()
        end
    end
    return run_side_dialogue_knot(self, knot_name, keep_bg)
end

local function resolve_inventory_knot(item_id, verb, scene_id)
    local candidates = {}
    if scene_id and scene_id ~= "" then
        table.insert(candidates, "inv_" .. scene_id .. "_" .. verb .. "_" .. item_id)
    end
    table.insert(candidates, "inv_" .. verb .. "_" .. item_id)
    table.insert(candidates, "inv_" .. verb .. "_fallback")
    table.insert(candidates, "inv_fallback")

    for _, knot_name in ipairs(candidates) do
        if dm.has_knot and dm.has_knot(knot_name) then
            return knot_name
        end
    end
    return nil
end

local function handle_inventory_verb(self, item_id, verb)
    if not item_id or not verb then
        return
    end
    if not INVENTORY_MVP_VERBS[verb] then
        print("[ui_manager_v2] inventory verb is not enabled in MVP:", tostring(verb))
        return
    end

    local scene_id = scene_controller.get_current_scene_id and scene_controller.get_current_scene_id() or nil
    if not scene_id or scene_id == "" then
        print("[ui_manager_v2] inventory verbs are only supported from exploration in MVP")
        close_inventory(self)
        return
    end

    if item_id == "phone" and (verb == "use" or verb == "read") then
        close_inventory(self)
        open_phone(self)
        return
    end

    local item = catalog.get_runtime and catalog.get_runtime(item_id) or catalog.get(item_id)
    local knot_name = resolve_inventory_knot(item_id, verb, scene_id)
    if not knot_name then
        print("[ui_manager_v2] WARNING: no inventory knot for", item_id, verb, scene_id)
        close_inventory(self)
        return
    end

    close_inventory(self)
    if dm.set_inventory_action_context then
        dm.set_inventory_action_context({
            item_id = item_id,
            item_name = item and item.name or item_id,
            verb = verb,
            scene_id = scene_id,
        })
    end
    jump_inventory_knot(self, knot_name)
end

local function sync_derived_inventory()
    if M.syncing_inventory then return false end

    M.syncing_inventory = true
    local changed = false

    for flag, item_id in pairs(LEGACY_FLAG_ITEMS) do
        local flag_enabled = gs.get_flag and gs.get_flag(flag) == true
        local has_item = gs.has_item and gs.has_item(item_id)
        if flag_enabled and not has_item and gs.add_item then
            changed = gs.add_item(item_id) or changed
        elseif not flag_enabled and has_item and gs.remove_item then
            changed = gs.remove_item(item_id) or changed
        end
    end

    M.syncing_inventory = false
    return changed
end

local function sync_ui_state(self)
    sync_derived_inventory()

    local inv = gs.get_inventory and gs.get_inventory() or {}
    local unread = gs.get_phone_unread_total and gs.get_phone_unread_total() or 0
    local has_phone = has_phone_access()

    msg.post(M.components.hud, "set_inventory_count", { n = #inv })
    msg.post(M.components.hud, "set_phone_enabled", { enabled = has_phone })
    msg.post(M.components.hud, "set_phone_notif", { n = unread })
    msg.post(M.components.inventory, "refresh_inventory")
    msg.post(M.components.phone, "set_phone_notif", { n = unread })
    -- step23: phone подтягивает SMS/quests/mail/calls/clues из game_state.
    msg.post(M.components.phone, "refresh_phone")
end

-- Сохраняет game_state + scene_controller (стек exploration-сцен) в save_manager.
-- Когда вызывается:
--   • любое изменение `game_state` → срабатывает gs.subscribe-обработчик (init);
--     сюда попадают set_flag, add/remove_item, set_quest, add_sms, add_mail,
--     add_call, add_clue, и КЛЮЧЕВОЕ — gs.set_scene(...) внутри scene_controller.
--   • при start_new_run после reset.
-- Ink-состояние сохраняется отдельно через save_ink_state() в dialogue_manager_ink
-- (вызывается на каждом advance/jump_to_knot/choose).
-- Overlay-состояние (phone/map/inventory открыт?) НЕ персистится — на load всегда
-- закрыто, base_mode восстанавливается из ink/scene_controller.
local function persist_run_state()
    if M.suppress_run_save then return end
    if not gs.serialize or not scene_controller.serialize then return end

    sm.set_game_state({
        gs = gs.serialize(),
        scene_controller = scene_controller.serialize(),
    })
end

local function restore_run_state()
    local saved = sm.get_game_state()

    M.suppress_run_save = true

    if saved and saved.gs then
        gs.deserialize(saved.gs)
        scene_controller.deserialize(saved.scene_controller)
        if saved.scene_controller and saved.scene_controller.active and saved.scene_controller.scene_id then
            scene_controller.enter(saved.scene_controller.scene_id)
        end
    elseif saved then
        gs.deserialize(saved)
        if scene_controller.reset then
            scene_controller.reset()
        else
            scene_controller.deserialize({ scene_stack = {} })
        end
    else
        gs.reset()
        if scene_controller.reset then
            scene_controller.reset()
        else
            scene_controller.deserialize({ scene_stack = {} })
        end
    end

    M.suppress_run_save = false
end

local function load_main_story_bytes()
    local ok, bytes = pcall(sys.load_resource, "/main/story/chapter_01.json")
    if not ok or not bytes then
        print("[ui_manager_v2] ERROR: chapter_01.json not found")
        return nil
    end
    return bytes
end

local function reset_runtime_state()
    M.suppress_run_save = true
    gs.reset()
    if scene_controller.reset then
        scene_controller.reset()
    else
        scene_controller.deserialize({ scene_stack = {} })
    end
    M.suppress_run_save = false
end

local function start_new_run(self, reset_iteration_progress)
    local bytes = load_main_story_bytes()
    if not bytes then
        return false
    end

    sm.load()
    meta.init()

    if reset_iteration_progress then
        meta.reset_all()
    end

    M.at_end = false
    M.base_mode = "dialogue"
    M.overlays.choice = false
    M.overlays.inventory = false
    M.overlays.phone = false
    M.overlays.map = false

    msg.post(M.components.choice, "hide_choice")
    msg.post(M.components.inventory, "hide_inventory")
    msg.post(M.components.phone, "close_phone")
    msg.post(M.components.map, "close_map")
    msg.post(M.components.hotspots, "hide_all")

    sm.new_game()
    reset_runtime_state()

    dm.init(bytes)
    handle_dialogue_update(self)
    sync_ui_state(self)
    persist_run_state()
    return true
end

local function reset_iteration_and_restart(self)
    meta.init()
    meta.reset_all()

    -- Даём UI закончить обработку клика по меню и только потом стартуем новый run.
    timer.delay(0, false, function()
        start_new_run(self, false)
    end)
end

local function refresh_menu_state(self)
    sm.load()
    meta.init()

    msg.post(M.components.main_menu, "set_loop_state", {
        iteration = meta.get("iteration_number", 1),
        iteration_label = meta.get_iteration_label(),
        awareness = meta.get("loop_awareness", 0),
        completed = meta.get("completed_iterations", 0),
        can_continue = sm.has_save(),
    })
end

local function show_menu(self)
    M.base_mode = "menu"
    M.at_end = false
    reset_dialogue_play_modes(self)
    -- скрыть всё игровое
    msg.post(M.components.hud,       "hide_hud")
    msg.post(M.components.dialogue,  "hide_dialogue")
    msg.post(M.components.dialogue,  "hide_bg")
    msg.post(M.components.choice,    "hide_choice")
    msg.post(M.components.inventory, "hide_inventory")
    msg.post(M.components.phone,     "close_phone")
    msg.post(M.components.map,       "close_map")
    msg.post(M.components.hotspots,  "hide_all")
    refresh_menu_state(self)
    msg.post(M.components.main_menu, "show_menu")
    dbg("[ui_manager_v2] mode: menu")
end

local function show_exploration(self)
    M.base_mode = "exploration"
    reset_dialogue_autoplay_state(self)
    dbg("[ui_manager_v2] show_exploration()")
    msg.post(M.components.main_menu, "hide_menu")
    msg.post(M.components.dialogue,  "hide_dialogue")
    msg.post(M.components.dialogue,  "show_bg")
    msg.post(M.components.hud,       "show_hud")
    close_phone(self)
    close_inventory(self)
    close_map(self)
    hide_choice(self)
    dbg("[ui_manager_v2] mode: exploration")
end

local function show_dialogue(self)
    M.base_mode = "dialogue"
    msg.post(M.components.main_menu, "hide_menu")
    msg.post(M.components.dialogue,  "show_bg")
    msg.post(M.components.hud,       "show_hud")
    msg.post(M.components.hotspots,  "hide_all")
    msg.post(M.components.dialogue,  "show_dialogue")
    dbg("[ui_manager_v2] mode: dialogue")
end

-- overlays (поверх exploration/dialogue)

local function open_inventory(self)
    dbg("[ui_manager_v2] open_inventory()")
    M.overlays.inventory = true
    msg.post(M.components.inventory, "show_inventory")
end
close_inventory = function(self)
    dbg("[ui_manager_v2] close_inventory()")
    M.overlays.inventory = false
    msg.post(M.components.inventory, "hide_inventory")
end

open_phone = function(self)
    dbg("[ui_manager_v2] open_phone()")
    if not has_phone_access() then
        dbg("[ui_manager_v2] phone is unavailable, aborting")
        return
    end
    M.overlays.phone = true
    msg.post(M.components.phone, "open_phone")
end
close_phone = function(self)
    dbg("[ui_manager_v2] close_phone()")
    M.overlays.phone = false
    msg.post(M.components.phone, "close_phone")
end

local function open_map(self)
    M.overlays.map = true
    sync_map_overlay(resolve_map_selected_pin(), "> карта синхронизирована _")
    msg.post(M.components.map, "open_map")
end
local function open_map_hub(self, primary_knot)
    M.overlays.map = true
    -- hub-режим заменяет собой ink-выбор маршрута, поэтому под картой не должно
    -- остаться диалога в состоянии "КОНЕЦ": иначе клик мимо пина попадает
    -- в btn_next/dbox → dm.advance() → chapter_finished → выкидывает в меню.
    M.at_end = false
    msg.post(M.components.dialogue, "hide_dialogue")
    sync_map_overlay(resolve_map_selected_pin(), "> выбрать маршрут _")
    msg.post(M.components.map, "open_map_hub", { primary_knot = primary_knot })
end
close_map = function(self)
    M.overlays.map = false
    msg.post(M.components.map, "close_map")
end

local function show_choice(self, opts, timer_sec, title)
    M.overlays.choice = true
    msg.post(M.components.choice, "show_choice", {
        opts = opts or {},
        timer_sec = timer_sec or 18,
        title = title,
    })
end
hide_choice = function(self)
    M.overlays.choice = false
    msg.post(M.components.choice, "hide_choice")
end

local function dispatch_dm_effect(effect)
    if not effect or not effect.type then
        return
    end

    if effect.type == "sfx" then
        local url = effect.name and M.SFX_URLS[effect.name] or nil
        if url then
            msg.post(url, "play_sound", {
                delay = 0,
                gain = tonumber(effect.gain) or 0.6,
            })
        else
            print("[ui_manager_v2] WARNING: unknown sfx effect:", tostring(effect.name))
        end
    elseif effect.type == "shake" then
        msg.post(M.components.effects, "play_shake", {
            intensity = tonumber(effect.intensity) or 0.2,
            duration = tonumber(effect.duration) or 0.4,
        })
    elseif effect.type == "pulse" then
        msg.post(M.components.effects, "play_pulse", {
            duration = tonumber(effect.duration) or 0.5,
            r = tonumber(effect.r) or 1,
            g = tonumber(effect.g) or 1,
            b = tonumber(effect.b) or 1,
        })
    end
end

local function consume_dm_effects()
    local effects = dm.get_effects and dm.get_effects() or {}
    for _, effect in ipairs(effects) do
        dispatch_dm_effect(effect)
    end
end

-- -------------------------------------------------------
-- dialogue_manager_ink интеграция
-- -------------------------------------------------------

local function apply_dm_commands(self)
    local cmds = dm.get_commands and dm.get_commands() or {}
    for _, cmd in ipairs(cmds) do
        if cmd.type == "enter_scene" then
            -- Compatibility alias: old Ink still emits goto_scene:phone_home,
            -- but the real runtime phone is the phone_v2 overlay, not a scene.
            if cmd.scene == "phone_home" then
                open_phone(self)
            elseif scene_controller.enter then
                scene_controller.enter(cmd.scene)
            elseif scene_controller.enter_scene then
                scene_controller.enter_scene(cmd.scene)
            end
        elseif cmd.type == "return_to_scene" then
            if scene_controller.return_to_last_scene then
                scene_controller.return_to_last_scene()
            end
        elseif cmd.type == "set_flag" then
            if gs.set_flag then gs.set_flag(cmd.flag, cmd.value) end
        elseif cmd.type == "add_item" then
            if gs.add_item then gs.add_item(cmd.item) end
        elseif cmd.type == "remove_item" then
            if gs.remove_item then gs.remove_item(cmd.item) end
        elseif cmd.type == "set_quest" then
            if gs.set_quest then gs.set_quest(cmd.quest, cmd.status) end
        elseif cmd.type == "add_sms" then
            if gs.add_sms then gs.add_sms(cmd.contact, cmd.text) end
        elseif cmd.type == "mark_sms_read" then
            if gs.mark_sms_read then gs.mark_sms_read(cmd.contact) end
        elseif cmd.type == "add_note" then
            if gs.add_note then gs.add_note(cmd.title, cmd.body) end
        elseif cmd.type == "add_mail" then
            if gs.add_mail then gs.add_mail(cmd.from, cmd.subject, cmd.body) end
        elseif cmd.type == "mark_mail_read" then
            if gs.mark_mail_read then gs.mark_mail_read(cmd.index) end
        elseif cmd.type == "mark_all_mail_read" then
            if gs.mark_all_mail_read then gs.mark_all_mail_read() end
        elseif cmd.type == "add_call" then
            if gs.add_call then gs.add_call(cmd.who, cmd.kind) end
        elseif cmd.type == "mark_all_calls_seen" then
            if gs.mark_all_calls_seen then gs.mark_all_calls_seen() end
        elseif cmd.type == "add_clue" then
            if gs.add_clue then gs.add_clue(cmd.id, cmd.label) end
        elseif cmd.type == "set_camera" then
            if gs.set_camera_feed then
                gs.set_camera_feed({
                    status  = cmd.status,
                    message = cmd.message,
                    meta    = cmd.meta,
                })
            end
        elseif cmd.type == "reset_camera" then
            if gs.reset_camera_feed then gs.reset_camera_feed() end
        elseif cmd.type == "add_terminal_line" then
            if gs.add_terminal_line then gs.add_terminal_line(cmd.level, cmd.text) end
        elseif cmd.type == "clear_terminal" then
            if gs.clear_terminal then gs.clear_terminal() end
        elseif cmd.type == "reset_terminal" then
            if gs.reset_terminal_to_defaults then gs.reset_terminal_to_defaults() end
        elseif cmd.type == "meta_add" then
            if meta.inc then meta.inc(cmd.key, cmd.delta) end
        elseif cmd.type == "meta_set" then
            if meta.set then meta.set(cmd.key, cmd.value) end
        elseif cmd.type == "phone_close" then
            close_phone(self)
        elseif cmd.type == "open_map_hub" then
            open_map_hub(self, cmd.knot)
        end
    end
end

handle_dialogue_update = function(self)
    cancel_dialogue_autoplay(self)

    -- 1) Применить команды из ink-тегов (могут поменять сцену)
    apply_dm_commands(self)

    -- 1a) Если apply_dm_commands открыл map hub, не рендерим диалог поверх:
    -- иначе на `-> DONE` сразу после `# map:hub:KNOT` dialogue уходит в
    -- end-state, клик мимо пина ловится btn_next → advance → chapter_finished.
    if M.overlays.map then
        M.at_end = false
        msg.post(M.components.dialogue, "hide_dialogue")
        hide_choice(self)
        return
    end

    -- 2) Проверить режим ПЕРЕД обновлением фона
    local in_exploration = scene_controller.is_active and scene_controller.is_active()
    
    -- 3) Обновить фон только если НЕ в exploration (в exploration фон идёт из scene_controller)
    if not in_exploration then
        local bg = dm.get_background_image and dm.get_background_image()
        dbg("[ui_manager_v2] dm bg=", bg)
        if bg then
            post_dialogue_background(self, bg)
        end
    else
        dbg("[ui_manager_v2] in exploration mode, bg from scene_controller")
    end

    -- 4) Выбрать режим по scene_controller + отрендерить ноду
    consume_dm_effects()

    local node = dm.get_current_node and dm.get_current_node()
    dbg("[ui_manager_v2] dm node=", node and node.type, "char=", node and node.character, "text=", node and node.text and node.text:sub(1,40))

    if in_exploration then
        M.at_end = false
        show_exploration(self)
        hide_choice(self)
        return
    end

    if not node then
        M.at_end = false
        reset_dialogue_autoplay_state(self)
        show_dialogue(self)
        return
    end

    if node.type == "dialogue" then
        M.at_end = false
        self.dialogue_node_type = "dialogue"
        self.dialogue_waiting_for_typewriter = true
        self.dialogue_current_text = node.text or ""
        show_dialogue(self)
        hide_choice(self)
        msg.post(M.components.dialogue, "render_dialogue", {
            speaker = node.character,
            name    = node.character and tostring(node.character):upper() or "—",
            text    = node.text or "",
            loop    = meta.get("iteration_number", 1),
            loop_label = meta.get_iteration_label(),
        })
        nudge_dialogue_skip(self)

    elseif node.type == "choice" then
        M.at_end = false
        self.dialogue_node_type = "choice"
        self.dialogue_waiting_for_typewriter = false
        self.dialogue_current_text = ""
        show_dialogue(self)
        show_choice(self, node.options or {}, 18, node.question or "КАК ПОСТУПИТЬ?")

    elseif node.type == "end" then
        self.dialogue_node_type = "end"
        self.dialogue_waiting_for_typewriter = true
        self.dialogue_current_text = node.text or ""
        show_dialogue(self)
        hide_choice(self)
        msg.post(M.components.dialogue, "render_dialogue", {
            speaker = "narrator",
            loop    = meta.get("iteration_number", 1),
            loop_label = meta.get_iteration_label(),
            name    = "КОНЕЦ",
            text    = node.text or "Конец главы. Нажми NEXT чтобы вернуться в меню.",
        })
        M.at_end = true
    end
end

-- -------------------------------------------------------
-- scene_controller интеграция
-- -------------------------------------------------------

local function setup_scene_controller_ui(self)
    scene_controller.set_ui({
        max_hotspots = function() return 6 end,
        max_scene_objects = function() return 4 end,

        set_background = function(bg_name)
            -- HUD показывает имя локации (короткое)
            msg.post(M.components.hud, "set_location", { name = bg_name or "—" })
            -- Обновляем визуальный фон в dialogue компоненте
            if bg_name then
                post_dialogue_background(self, bg_name)
                dbg("[ui_manager_v2] scene_controller set_background:", bg_name)
            end
        end,

        set_scene_object = function(i, obj)
            local clean = nil
            if obj then
                clean = {
                    id    = obj.id,
                    image = obj.image,
                    pos   = obj.pos and { x = obj.pos.x, y = obj.pos.y } or nil,
                    size  = obj.size and { w = obj.size.w, h = obj.size.h } or nil,
                }
            end
            msg.post(M.components.hotspots, "set_scene_object", { index = i, obj = clean })
        end,

        set_hotspot = function(i, data)
            local clean = nil
            if data then
                clean = {
                    rect   = data.rect and { x = data.rect.x, y = data.rect.y, w = data.rect.w, h = data.rect.h } or nil,
                    label  = data.label,
                    icon   = data.icon,
                    locked = data.locked and true or false,
                }
            end
            msg.post(M.components.hotspots, "set_hotspot", { index = i, data = clean })
        end,

        request_ink_knot = function(knot_name, keep_bg)
            run_side_dialogue_knot(self, knot_name, keep_bg)
        end,
    })

    dbg("[ui_manager_v2] scene_controller UI настроен")
end

-- -------------------------------------------------------
-- Lifecycle
-- -------------------------------------------------------

function init(self)
    dbg("[ui_manager_v2] init")
    init_components()
    init_background_atlas_state(self)
    setup_scene_controller_ui(self)
    sm.load()
    meta.init()

    gs.subscribe(function()
        -- Обновляем счётчики в HUD при изменении game_state
        local inv = gs.get_inventory and gs.get_inventory() or {}
        local n = 0
        for _ in pairs(inv) do n = n + 1 end
        msg.post(M.components.hud, "set_inventory_count", { n = n })
    end)

    gs.subscribe(function()
        sync_ui_state(self)
        persist_run_state()
    end)

    self.dialogue_auto = false
    self.dialogue_skip = false
    self.dialogue_autoplay_handle = nil
    self.dialogue_waiting_for_typewriter = false
    self.dialogue_node_type = nil
    self.dialogue_current_text = ""

    apply_dialogue_toggle_state(self)
    sync_ui_state(self)
    show_menu(self)
    msg.post(".", "acquire_input_focus")
    dbg("[ui_manager_v2] init done")
end

function final(self)
    msg.post(".", "release_input_focus")
end

function on_message(self, message_id, message, sender)
    -- --- меню ---
    if message_id == hash("show_menu") then
        show_menu(self)

    elseif message_id == hash("start_game") then
        start_new_run(self, false)

    elseif message_id == hash("continue_game") then
        sm.load()
        meta.init()
        if not sm.has_save() then
            print("[ui_manager_v2] continue_game ignored: no run-state save")
            refresh_menu_state(self)
            return
        end

        local ok, bytes = pcall(sys.load_resource, "/main/story/chapter_01.json")
        if not ok or not bytes then
            print("[ui_manager_v2] ERROR: chapter_01.json not found")
            return
        end
        restore_run_state()
        dm.load_saved(bytes)
        handle_dialogue_update(self)
        sync_ui_state(self)

    elseif message_id == hash("chapter_finished") then
        -- Обычный конец без тега (итерация 001 — линейная, всегда переходит вперёд).
        local next_loop = meta.complete_iteration()

        sm.clear_run()
        M.suppress_run_save = true
        gs.reset()
        if scene_controller.reset then scene_controller.reset()
        else scene_controller.deserialize({ scene_stack = {} }) end
        M.suppress_run_save = false

        dbg("[ui_manager_v2] chapter_finished → iteration", next_loop.iteration_number)
        show_menu(self)

    elseif message_id == hash("false_ending") then
        -- Ложная концовка: запомнить в meta (+1 awareness если впервые),
        -- перезапустить run-state БЕЗ смены номера итерации.
        local id = message and message.id or "unknown"
        local is_new = meta.record_false_ending(id)
        print("[ui_manager_v2] false_ending '" .. id .. "' new=" .. tostring(is_new)
              .. " awareness=" .. tostring(meta.get("loop_awareness"))
              .. " false_count=" .. tostring(meta.get_false_endings_count()))

        sm.clear_run()
        M.suppress_run_save = true
        gs.reset()
        if scene_controller.reset then scene_controller.reset()
        else scene_controller.deserialize({ scene_stack = {} }) end
        M.suppress_run_save = false

        show_menu(self)

    elseif message_id == hash("true_ending") then
        -- Истинная концовка: доступна только когда найдены обе ложных.
        -- Ink сам гейтит ветку через VAR loop_awareness >= 2, но проверяем и здесь.
        if not meta.is_true_ending_unlocked() then
            -- Страховочный fallback: ещё не разблокирована — трактуем как ложную.
            print("[ui_manager_v2] WARNING: true_ending reached but not unlocked — treating as false_ending 'early_true'")
            meta.record_false_ending("early_true")
            sm.clear_run()
            M.suppress_run_save = true
            gs.reset()
            if scene_controller.reset then scene_controller.reset()
            else scene_controller.deserialize({ scene_stack = {} }) end
            M.suppress_run_save = false
            show_menu(self)
            return
        end

        local next_loop = meta.complete_iteration()
        sm.clear_run()
        M.suppress_run_save = true
        gs.reset()
        if scene_controller.reset then scene_controller.reset()
        else scene_controller.deserialize({ scene_stack = {} }) end
        M.suppress_run_save = false

        print("[ui_manager_v2] true_ending → iteration", next_loop.iteration_number)
        show_menu(self)

    elseif message_id == hash("reset_iteration") or message_id == hash("open_gallery") then
        reset_iteration_and_restart(self)

    elseif message_id == hash("open_achievements") then
        dbg("[ui_manager_v2] open_achievements (TODO)")

    -- --- фон ---
    elseif message_id == hash("apply_dialogue_bg") then
        -- Прилетает из callback'ов scene_controller.set_background,
        -- которые могут исполняться из gui_script контекста. go.set
        -- можно дёрнуть только отсюда, поэтому переключение atlas'а
        -- для dialogue_v2 делаем в этом хендлере.
        apply_dialogue_bg(self, message and message.name)

    -- --- диалог ---
    elseif message_id == hash("dialogue_updated") then
        handle_dialogue_update(self)

    elseif message_id == hash("dialogue_next") then
        cancel_dialogue_autoplay(self)
        if dm.advance then dm.advance() end
        handle_dialogue_update(self)

    elseif message_id == hash("typewriter_done") then
        self.dialogue_waiting_for_typewriter = false
        if self.dialogue_skip or self.dialogue_auto then
            schedule_dialogue_autoadvance(self)
        end

    elseif message_id == hash("dialogue_skip") then
        dbg("[ui_manager_v2] dialogue_skip", message.on)
        set_dialogue_play_mode(self, "skip", message and message.on)

    elseif message_id == hash("dialogue_auto") then
        dbg("[ui_manager_v2] dialogue_auto", message.on)
        set_dialogue_play_mode(self, "auto", message and message.on)

    -- --- выбор ---
    elseif message_id == hash("choice_picked") then
        hide_choice(self)
        if dm.choose then dm.choose(message.index) end
        handle_dialogue_update(self)

    elseif message_id == hash("choice_timeout") then
        -- по таймауту выбираем первую опцию (default)
        hide_choice(self)
        if dm.choose then dm.choose(1) end
        handle_dialogue_update(self)

    elseif message_id == hash("choice_cancelled") then
        hide_choice(self)

    -- --- inventory ---
    elseif message_id == hash("open_inventory") then
        dbg("[ui_manager_v2] open_inventory from", sender)
        open_inventory(self)
    elseif message_id == hash("close_inventory") then
        dbg("[ui_manager_v2] close_inventory")
        close_inventory(self)
    elseif message_id == hash("inventory_verb") then
        dbg("[ui_manager_v2] inventory_verb", message.item_id, message.verb)
        handle_inventory_verb(self, message.item_id, message.verb)

    -- --- phone ---
    elseif message_id == hash("open_phone") then
        dbg("[ui_manager_v2] open_phone from", sender)
        open_phone(self)
    elseif message_id == hash("close_phone") then
        close_phone(self)
    elseif message_id == hash("phone_sms_viewed") then
        if gs.mark_all_sms_read then
            gs.mark_all_sms_read()
        end
    elseif message_id == hash("phone_app_clicked") then
        dbg("[ui_manager_v2] phone_app_clicked", message.id)
        -- Карта теперь открывается внутри телефона (phone_map.gui).
        -- Если в будущем нужно открыть внешнюю карту из телефона — добавь здесь.

    -- --- map travel (phone_map POI click) ---
    elseif message_id == hash("map_travel") then
        local scene_id = message and message.scene
        dbg("[ui_manager_v2] map_travel →", scene_id)
        if scene_id then
            close_phone(self)
            scene_controller.enter(scene_id)
        end

    -- --- map ---
    elseif message_id == hash("open_map") then
        open_map(self)
    elseif message_id == hash("close_map") then
        close_map(self)
    elseif message_id == hash("map_verb") then
        dbg("[ui_manager_v2] map_verb", message.pin_id, message.verb)
        handle_map_verb(self, message.pin_id, message.verb)
    elseif message_id == hash("map_hub_route") then
        dbg("[ui_manager_v2] map_hub_route", message and message.knot)
        local knot = message and message.knot
        close_map(self)
        if knot then
            run_side_dialogue_knot(self, knot, nil)
        end

    end
end

function on_input(self, action_id, action)
    -- Музыка при первом касании
    if not M.music_started and action_id == hash("touch") and action.pressed then
        M.music_started = true
        msg.post(M.MUSIC_URL, "play_sound", { delay = 0, gain = 0.5 })
    end

    if action_id == hash("key_esc") and action.pressed then
        -- Esc закрывает первую открытую модалку
        if M.overlays.choice then
            hide_choice(self)
            msg.post(".", "choice_cancelled")
            return true
        elseif M.overlays.map then
            close_map(self); return true
        elseif M.overlays.phone then
            close_phone(self); return true
        elseif M.overlays.inventory then
            close_inventory(self); return true
        end
    end
    return false
end
