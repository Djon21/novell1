-- ui_manager.script
-- РљРѕРѕСЂРґРёРЅР°С‚РѕСЂ РІСЃРµС… GUI РєРѕРјРїРѕРЅРµРЅС‚РѕРІ РІРёР·СѓР°Р»СЊРЅРѕР№ РЅРѕРІРµР»Р»С‹

local dm = require "main.scripts.dialogue_manager_ink"
local gs = require "main.scripts.game_state"
local scene_controller = require "main.scripts.scene_controller"

-- РЎРѕСЃС‚РѕСЏРЅРёРµ UI Manager
local M = {}
M.current_mode = "menu"  -- "menu", "dialogue", "exploration"

-- URL'С‹ РєРѕРјРїРѕРЅРµРЅС‚РѕРІ
M.components = {
    main_menu = nil,
    portraits = nil,
    inventory = nil,
    phone = nil,
    dialogue = nil,
    hotspots = nil,
}

-- -------------------------------------------------------
-- РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ РєРѕРјРїРѕРЅРµРЅС‚РѕРІ
-- -------------------------------------------------------

local function init_components()
    -- РџРѕР»СѓС‡Р°РµРј URL'С‹ РІСЃРµС… GUI РєРѕРјРїРѕРЅРµРЅС‚РѕРІ
    M.components.main_menu = msg.url("main_menu#gui")
    M.components.portraits = msg.url("portraits#gui")
    M.components.inventory = msg.url("inventory#gui")
    M.components.phone = msg.url("phone#gui")
    M.components.dialogue = msg.url("dialogue_system#gui")
    M.components.hotspots = msg.url("hotspots#gui")
    
    print("[ui_manager] РљРѕРјРїРѕРЅРµРЅС‚С‹ РёРЅРёС†РёР°Р»РёР·РёСЂРѕРІР°РЅС‹")
end

-- -------------------------------------------------------
-- РџРµСЂРµРєР»СЋС‡РµРЅРёРµ СЂРµР¶РёРјРѕРІ UI
-- -------------------------------------------------------

local function show_menu()
    M.current_mode = "menu"
    
    msg.post(M.components.main_menu, "show_menu")
    msg.post(M.components.dialogue, "hide_dialogue")
    msg.post(M.components.hotspots, "hide_all")
    msg.post(M.components.portraits, "hide_portrait")
    msg.post(M.components.phone, "hide_phone")
    msg.post(M.components.inventory, "hide_inventory")
    
    print("[ui_manager] Р РµР¶РёРј: РјРµРЅСЋ")
end

local function show_dialogue_mode()
    M.current_mode = "dialogue"
    
    msg.post(M.components.main_menu, "hide_menu")
    msg.post(M.components.dialogue, "render_dialogue")
    msg.post(M.components.hotspots, "hide_all")
    
    -- Phone Рё inventory РѕСЃС‚Р°СЋС‚СЃСЏ РґРѕСЃС‚СѓРїРЅС‹ С‡РµСЂРµР· HUD
    msg.post(M.components.phone, "update_phone")
    
    print("[ui_manager] Р РµР¶РёРј: РґРёР°Р»РѕРі")
end

local function show_exploration_mode()
    M.current_mode = "exploration"
    
    msg.post(M.components.main_menu, "hide_menu")
    msg.post(M.components.dialogue, "hide_dialogue")
    
    -- Hotspots СѓРїСЂР°РІР»СЏСЋС‚СЃСЏ С‡РµСЂРµР· scene_controller
    -- Phone Рё inventory РґРѕСЃС‚СѓРїРЅС‹ С‡РµСЂРµР· HUD
    msg.post(M.components.phone, "update_phone")
    
    print("[ui_manager] Р РµР¶РёРј: РёСЃСЃР»РµРґРѕРІР°РЅРёРµ")
end

-- -------------------------------------------------------
-- РћР±СЂР°Р±РѕС‚РєР° СЃРѕРѕР±С‰РµРЅРёР№ РѕС‚ dialogue_manager
-- -------------------------------------------------------

local function handle_dialogue_update()
    if scene_controller.is_active() then
        -- Р•СЃР»Рё Р°РєС‚РёРІРЅР° exploration СЃС†РµРЅР° - РЅРµ РїРѕРєР°Р·С‹РІР°РµРј РґРёР°Р»РѕРі
        show_exploration_mode()
    else
        -- РџРѕРєР°Р·С‹РІР°РµРј РґРёР°Р»РѕРі
        show_dialogue_mode()
    end
end

-- -------------------------------------------------------
-- РРЅС‚РµРіСЂР°С†РёСЏ СЃ scene_controller
-- -------------------------------------------------------

local function setup_scene_controller_ui()
    scene_controller.set_ui({
        max_hotspots = function() return 6 end,
        max_scene_objects = function() return 4 end,
        
        set_background = function(bg_name)
            -- РћС‚РїСЂР°РІР»СЏРµРј СЃРѕРѕР±С‰РµРЅРёРµ backgrounds РєРѕРјРїРѕРЅРµРЅС‚Сѓ (РµСЃР»Рё Р±СѓРґРµС‚ СЃРѕР·РґР°РЅ)
            -- РџРѕРєР° backgrounds РѕСЃС‚Р°СЋС‚СЃСЏ РІ dialogue_system
            print("[ui_manager] set_background:", bg_name)
        end,
        
        set_scene_object = function(i, obj)
            msg.post(M.components.hotspots, "set_scene_object", {index = i, obj = obj})
        end,
        
        set_hotspot = function(i, data)
            msg.post(M.components.hotspots, "set_hotspot", {index = i, data = data})
        end,
        
        request_ink_knot = function(knot_name, keep_bg)
            dm.jump_to_knot(knot_name)
            if keep_bg then dm.override_bg(keep_bg) end
            handle_dialogue_update()
        end,
    })
    
    print("[ui_manager] scene_controller UI РЅР°СЃС‚СЂРѕРµРЅ")
end

-- -------------------------------------------------------
-- Lifecycle
-- -------------------------------------------------------

function init(self)
    print("[ui_manager] РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ ui_manager.script")
    
    -- РРЅРёС†РёР°Р»РёР·РёСЂСѓРµРј РєРѕРјРїРѕРЅРµРЅС‚С‹
    init_components()
    
    -- РќР°СЃС‚СЂР°РёРІР°РµРј scene_controller
    setup_scene_controller_ui()
    
    -- РџРѕРґРїРёСЃС‹РІР°РµРјСЃСЏ РЅР° РёР·РјРµРЅРµРЅРёСЏ game_state
    gs.subscribe(function()
        -- РћР±РЅРѕРІР»СЏРµРј HUD РїСЂРё РёР·РјРµРЅРµРЅРёРё СЃРѕСЃС‚РѕСЏРЅРёСЏ
        msg.post(M.components.phone, "update_phone")
    end)
    
    -- РџРѕРєР°Р·С‹РІР°РµРј РјРµРЅСЋ РїСЂРё СЃС‚Р°СЂС‚Рµ
    show_menu()
    
    -- РџРѕР»СѓС‡Р°РµРј С„РѕРєСѓСЃ РІРІРѕРґР°
    msg.post(".", "acquire_input_focus")
    
    print("[ui_manager] РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ Р·Р°РІРµСЂС€РµРЅР°")
end

function final(self)
    print("[ui_manager] Р¤РёРЅР°Р»РёР·Р°С†РёСЏ ui_manager.script")
    msg.post(".", "release_input_focus")
end

function update(self, dt)
    -- РћР±РЅРѕРІР»РµРЅРёРµ UI (РµСЃР»Рё РЅСѓР¶РЅРѕ)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("show_menu") then
        show_menu()
        
    elseif message_id == hash("start_game") then
        -- РќР°С‡Р°С‚СЊ РЅРѕРІСѓСЋ РёРіСЂСѓ
        dm.restart()
        handle_dialogue_update()
        
    elseif message_id == hash("continue_game") then
        -- РџСЂРѕРґРѕР»Р¶РёС‚СЊ РёРіСЂСѓ
        handle_dialogue_update()
        
    elseif message_id == hash("dialogue_updated") then
        -- Р”РёР°Р»РѕРі РѕР±РЅРѕРІР»РµРЅ
        handle_dialogue_update()
        
    elseif message_id == hash("open_inventory") then
        -- РћС‚РєСЂС‹С‚СЊ РёРЅРІРµРЅС‚Р°СЂСЊ
        msg.post(M.components.inventory, "show_inventory")
        
    elseif message_id == hash("close_inventory") then
        -- Р—Р°РєСЂС‹С‚СЊ РёРЅРІРµРЅС‚Р°СЂСЊ
        msg.post(M.components.inventory, "hide_inventory")
        
    elseif message_id == hash("open_phone") then
        -- РћС‚РєСЂС‹С‚СЊ С‚РµР»РµС„РѕРЅ
        msg.post(M.components.phone, "open_phone")
        
    elseif message_id == hash("exploration_started") then
        -- РќР°С‡Р°Р»Р°СЃСЊ exploration СЃС†РµРЅР°
        show_exploration_mode()
        
    elseif message_id == hash("exploration_ended") then
        -- Р—Р°РєРѕРЅС‡РёР»Р°СЃСЊ exploration СЃС†РµРЅР°
        handle_dialogue_update()
    end
end

function on_input(self, action_id, action)
    -- Input РѕР±СЂР°Р±Р°С‚С‹РІР°РµС‚СЃСЏ РІ РѕС‚РґРµР»СЊРЅС‹С… РєРѕРјРїРѕРЅРµРЅС‚Р°С…
    -- Р—РґРµСЃСЊ С‚РѕР»СЊРєРѕ РіР»РѕР±Р°Р»СЊРЅС‹Рµ С…РѕС‚РєРµРё (РµСЃР»Рё РЅСѓР¶РЅС‹)
    
    if action_id == hash("key_esc") and action.pressed then
        if M.current_mode == "dialogue" or M.current_mode == "exploration" then
            -- ESC РѕС‚РєСЂС‹РІР°РµС‚ РјРµРЅСЋ РїР°СѓР·С‹ (TODO)
            return true
        end
    end
    
    return false
end
