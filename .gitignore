# .gitignore для AI команды

# Defold
build/
.internal/
*.pyc

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Временные файлы AI
*.tmp
*.bak
*~

# Личные заметки AI (не коммитить!)
AI_NOTES_*.md
PRIVATE_*.md

# Скомпилированные Ink файлы (генерируются автоматически)
# Раскомментируйте, если хотите игнорировать:
# main/story/*.json

# Логи
*.log
