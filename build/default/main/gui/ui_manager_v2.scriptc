end

local function notify_overlay_state(target, open)
    
    
    
    if M.components.hud then
        msg.post(M.components.hud, "set_overlay_state", { target = target, open = open })
    end
    if M.components.dialogue then
        msg.post(M.components.dialogue, "set_overlay_state", { target = target, open = open })
    end
end

local function open_inventory(self)
    
    notify_overlay_state("bag", true)
    overlay_flow.open_inventory(overlay_ctx(self))
end

close_inventory = function(self)
    overlay_flow.close_inventory(overlay_ctx(self))
    notify_overlay_state("bag", false)
end

open_phone = function(self)
    
    
    
    notify_overlay_state("phone", true)
    phone_flow.open(phone_ctx())
end

local function open_phone_app(self, app_id)
    return phone_flow.open_app(phone_ctx(), app_id)
end












local function resume_exploration_if_needed()
    if not scene_controller.is_active or not scene_controller.is_active() then
        return
    end
    if M.overlays.phone or M.overlays.inventory or M.overlays.choice then
        return
    end
    if scene_controller.render_now then
        scene_controller.render_now()
    end
end

close_phone = function(self)
    phone_flow.close(phone_ctx())
    notify_overlay_state("phone", false)
    resume_exploration_if_needed()
end

open_phone_map_app = function(self)
    return phone_flow.open_map_app(phone_ctx())
end

local function show_choice(self, opts, timer_sec, title)
    
    
    
    notify_overlay_state("choice", true)
    overlay_flow.show_choice(overlay_ctx(self), opts, timer_sec, title)
end

hide_choice = function(self)
    overlay_flow.hide_choice(overlay_ctx(self))
    notify_overlay_state("choice", false)
end

local function consume_dm_effects()
    effects_flow.consume({
        components = M.components,
        sfx_urls = M.SFX_URLS,
    })
end





local function apply_dm_commands(self)
    local cmds = dm.get_commands and dm.get_commands() or {}
    return dm_commands.apply(cmds, {
        open_phone = function() open_phone(self) end,
        close_phone = function() close_phone(self) end,
        open_phone_app = function(app) return open_phone_app(self, app) end,
        set_hud_hint = function(target)
            if M.components.hud then
                msg.post(M.components.hud, "set_hud_hint", { target = target })
            end
        end,
        scene_char_show = function(scene, char)
            scene_characters.show(scene, char)
        end,
        scene_char_hide = function(scene, char)
            scene_characters.hide(scene, char)
        end,
        scene_char_hide_all = function()
            scene_characters.hide_all()
        end,
        show_splash = function(cmd, on_done)
            
            
            
            
            if not M.components.splash then
                if on_done then on_done() end
                return
            end
            self.splash_done_cb = on_done
            notify_overlay_state("splash", true)

            local variant = cmd.variant or "generic"
            local payload = { variant = variant }

            if variant == "day" then
                payload.day = cmd.day or cmd.to
                payload.iteration = (meta and meta.get) and meta.get("iteration_number", 1) or 1
            elseif variant == "location" then
                
                local scene_id = cmd.scene_id
                payload.title = scene_id
                if scene_id and scenes_module and scenes_module.get then
                    local data = scenes_module.get(scene_id)
                    if data and data.label then payload.title = data.label end
                end
                payload.subtitle = cmd.subtitle
            else
                
                payload.title = cmd.title
                payload.subtitle = cmd.subtitle
                payload.eyebrow = cmd.eyebrow
            end

            msg.post(M.components.splash, MSG.show_splash, payload)
        end,
        show_transit = function(cmd)
            
            
            if not M.components.transit then return end
            msg.post(M.components.transit, MSG.show_transit, {
                title = cmd.title,
                subtitle = cmd.subtitle,
                eyebrow = cmd.eyebrow,
            })
        end,
        hide_transit = function()
            if not M.components.transit then return end
            msg.post(M.components.transit, MSG.hide_transit)
        end,
        on_resume = function() handle_dialogue_update(self) end,
    })
end




local function dialogue_update_ctx()
    return {
        M                       = M,
        dbg                     = dbg,
        cancel_autoplay         = cancel_dialogue_autoplay,
        reset_autoplay_state    = reset_dialogue_autoplay_state,
        apply_dm_commands       = apply_dm_commands,
        consume_dm_effects      = consume_dm_effects,
        hide_choice             = hide_choice,
        show_dialogue           = show_dialogue,
        show_exploration        = show_exploration,
        show_choice             = show_choice,
        post_dialogue_bg        = post_dialogue_background,
        post_location_to_ui     = post_location_to_ui,
        resolve_location_label  = resolve_current_location_label,
        append_dialogue_backlog = append_dialogue_backlog,
        nudge_dialogue_skip     = nudge_dialogue_skip,
    }
end

handle_dialogue_update = function(self)
    dialogue_orchestrator.update(self, dialogue_update_ctx())
end





local function setup_scene_controller_ui(self)
    scene_flow.setup({
        components = M.components,
        dbg = dbg,
        set_background = function(bg_name)
            post_location_to_ui(resolve_current_location_label(bg_name))
            if bg_name then
                post_dialogue_background(self, bg_name)
                dbg("[ui_manager_v2] scene_controller set_background:", bg_name)
            end
        end,
        request_ink_knot = function(knot_name, keep_bg)
            run_side_dialogue_knot(self, knot_name, keep_bg)
        end,
        request_use_on_hotspot = function(hotspot_id)
            return handle_armed_hotspot_click(self, hotspot_id)
        end,
    })
end





function init(self)
    dbg("[ui_manager_v2] init")
    
    
    
    l10n.init()
    init_components()
    init_background_atlas_state(self)
    setup_scene_controller_ui(self)
    scene_characters.set_ui({
        log = function(...) log.info("scene_char", ...) end,
        set_character_slot = function(slot, cfg)
            msg.post(M.components.dialogue, "set_scene_character",
                     { slot = slot, atlas = cfg.atlas, sprite = cfg.sprite,
                       x = cfg.x, y = cfg.y, w = cfg.w, h = cfg.h })
        end,
        clear_character_slot = function(slot)
            msg.post(M.components.dialogue, "clear_scene_character",
                     { slot = slot })
        end,
    })
    sm.load()
    meta.init()
    yandex_ads.init()
    apply_mute_state()

    gs.subscribe(function()
        
        local inv = gs.get_inventory and gs.get_inventory() or {}
        local n = 0
        for _ in pairs(inv) do n = n + 1 end
        msg.post(M.components.hud, "set_inventory_count", { n = n })
    end)

    gs.subscribe(function()
        sync_ui_state(self)
        persist_run_state()
    end)

    
    
    
    
    self._last_scene_id_for_chars = nil
    gs.subscribe(function()
        local sid = gs.get_scene and gs.get_scene() or nil
        if sid ~= self._last_scene_id_for_chars then
            self._last_scene_id_for_chars = sid
            scene_characters.on_scene_changed(sid)
        end
    end)

    self.dialogue_auto = false
    self.dialogue_skip = false
    self.dialogue_autoplay_handle = nil
    self.dialogue_waiting_for_typewriter = false
    self.dialogue_node_type = nil
    self.dialogue_current_text = ""
    self.current_choice_question = nil
    self.current_choice_options = nil

    reset_dialogue_backlog(self)
    apply_dialogue_toggle_state(self)
    sync_ui_state(self)
    msg.post(".", "acquire_input_focus")

    
    
    
    
    
    
    
    
    
    
    sm.cloud_init(function(err)
        if err then
            dbg("[ui_manager_v2] cloud_init done with err:", err, "- using local save")
        else
            dbg("[ui_manager_v2] cloud_init done - save in sync")
        end
        show_menu(self)
        
        local ok_l10n, l10n = pcall(require, "main.scripts.l10n")
        if ok_l10n and l10n and l10n.sync_sdk then pcall(l10n.sync_sdk) end
        
        local ok_ya, ya = pcall(require, "yagames.yagames")
        if ok_ya and ya and ya.features_loadingapi_ready then
            pcall(ya.features_loadingapi_ready)
        end
        dbg("[ui_manager_v2] init done")
    end)

    
    
    
    
    
    
    
    
    
    pcall(window.set_listener, function(_, event, _data)
        if event == window.WINDOW_EVENT_FOCUS_LOST
           or event == window.WINDOW_EVENT_ICONIFY then
            dbg("[ui_manager_v2] focus_lost - flushing save")
            if sm and sm.save_now then sm.save_now() end
            if sm and sm.cloud_flush_now then sm.cloud_flush_now() end
        end
    end)
end

function final(self)
    
    
    
    
    if sm and sm.save_now then
        sm.save_now()
    end
    
    
    
    
    if sm and sm.cloud_flush_now then
        sm.cloud_flush_now()
    end
    msg.post(".", "release_input_focus")
end

local function message_ctx(self)
    return {
        self = self,
        dbg = dbg,
        show_menu = function() show_menu(self) end,
        prepare_run_restore = function() prepare_run_restore(self) end,
        start_new_run = function(reset_iteration_progress) start_new_run(self, reset_iteration_progress) end,
        refresh_menu_state = function() refresh_menu_state(self) end,
        return_to_menu = function() show_menu(self) end,
        toggle_mute = function() toggle_mute() end,
        restore_run_state = function(opts) return restore_run_state(opts) end,
        enter_restored_scene = function(scene_id) scene_controller.enter(scene_id, { skip_on_enter = true }) end,
        reset_dialogue_backlog = function() reset_dialogue_backlog(self) end,
        handle_dialogue_update = function() handle_dialogue_update(self) end,
        sync_ui_state = function() sync_ui_state(self) end,
        reset_iteration_and_restart = function() reset_iteration_and_restart(self) end,
        reset_runtime_state = function() reset_runtime_state() end,
        apply_dialogue_bg = function(bg_name) apply_dialogue_bg(self, bg_name) end,
        cancel_dialogue_autoplay = function() cancel_dialogue_autoplay(self) end,
        schedule_dialogue_autoadvance = function() schedule_dialogue_autoadvance(self) end,
        set_dialogue_play_mode = function(mode, on) set_dialogue_play_mode(self, mode, on) end,
        open_dialogue_backlog = function() open_dialogue_backlog(self) end,
        close_dialogue_backlog = function() close_dialogue_backlog(self) end,
        append_dialogue_backlog = function(entry) append_dialogue_backlog(self, entry) end,
        hide_choice = function() hide_choice(self) end,
        open_inventory = function() open_inventory(self) end,
        close_inventory = function() close_inventory(self) end,
        handle_inventory_verb = function(item_id, verb, extra) handle_inventory_verb(self, item_id, verb, extra) end,
        clear_armed_state = function() clear_armed_state(self) end,
        open_phone = function() open_phone(self) end,
        close_phone = function() close_phone(self) end,
        run_side_dialogue_knot = function(knot_name, keep_bg, opts) run_side_dialogue_knot(self, knot_name, keep_bg, opts) end,
        enter_side_dialogue = function(knot_name, opts) enter_side_dialogue(self, knot_name, opts) end,
    }
end

local function dev_jump_ctx(self)
    return {
        M = M,
        load_main_story_bytes = function() return load_main_story_bytes() end,
        reset_runtime_state = function() reset_runtime_state() end,
        reset_dialogue_backlog = function() reset_dialogue_backlog(self) end,
        sync_modal_state = function() sync_modal_state() end,
        sync_ui_state = function() sync_ui_state(self) end,
        persist_run_state = function() persist_run_state() end,
        show_exploration = function() show_exploration(self) end,
        handle_dialogue_update = function() handle_dialogue_update(self) end,
    }
end




local function handle_scene_character_click(self, slot)
    local action = scene_characters.get_action(slot)
    if not action then return end
    if action.type == "ink_knot" and action.knot then
        enter_side_dialogue(self, action.knot)
    else
        log.warn("ui_manager", "scene_character action.type –Ω–µ –ø–æ–¥–¥–µ—Ä–∂–∞–Ω:", tostring(action.type))
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("scene_character_clicked") then
        if message and message.slot then
            handle_scene_character_click(self, message.slot)
        end
        return
    end
    if message_id == MSG.splash_done then
        
        
        notify_overlay_state("splash", false)
        local cb = self.splash_done_cb
        self.splash_done_cb = nil
        if cb then cb() end
        return
    end
    message_flow.handle(message_ctx(self), message_id, message, sender)
end

function on_input(self, action_id, action)
    
    if not M.music_started and action_id == MSG.touch and action.pressed then
        M.music_started = true
        msg.post(M.MUSIC_URL, "play_sound", { delay = 0, gain = 0.5 })
    end

    if action_id == MSG.key_esc and action.pressed then
        
        if M.overlays.backlog then
            close_dialogue_backlog(self); return true
        elseif M.overlays.choice then
            hide_choice(self)
            msg.post(".", MSG.choice_cancelled)
            return true
        elseif M.overlays.phone then
            close_phone(self); return true
        elseif M.overlays.inventory then
            close_inventory(self); return true
        end
    end

    if action.pressed and action_id == MSG.dev_jump_next then
        return dev_jump.select_next()
    elseif action.pressed and action_id == MSG.dev_jump_apply then
        return dev_jump.apply_selected(dev_jump_ctx(self))
    elseif action.pressed and action_id == MSG.dev_jump_toggle_gender then
        return dev_jump.toggle_gender()
    elseif action.pressed and action_id == MSG.dev_jump_record then
        return dev_jump.record_snapshot(dev_jump_ctx(self))
    end

    return false
end
