local function lp(id)
    return LIST_PREFIX .. id
end

local function dp(id)
    return DETAIL_PREFIX .. id
end

local function get_node(id)
    if not id then return nil end
    local n = U.get_node(id)
    if n then return n end
    n = U.get_node(LIST_PREFIX .. id)
    if n then return n end
    n = U.get_node(DETAIL_PREFIX .. id)
    if n then return n end
    return nil
end

local function set_text(id, value)
    local n = get_node(id)
    if n then gui.set_text(n, value or "") end
end

local function set_color(id, color, alpha)
    local n = get_node(id)
    if n then
        if alpha ~= nil then
            gui.set_color(n, vmath.vector4(color.x, color.y, color.z, alpha))
        else
            gui.set_color(n, color)
        end
    end
end

local function set_node_enabled(id, enabled)
    local n = get_node(id)
    if n then gui.set_enabled(n, enabled and true or false) end
end

local function set_many_enabled(ids, enabled)
    for _, id in ipairs(ids) do
        set_node_enabled(id, enabled)
    end
end

local function set_host_visible(enabled)
    set_node_enabled("mail_runtime_root", enabled)
    set_node_enabled("mail_list", enabled)
    set_node_enabled("mail_detail", enabled)
end

local function set_all_enabled(enabled)
    set_host_visible(enabled)
    set_many_enabled(LIST_NODE_IDS, enabled)
    set_many_enabled(DETAIL_NODE_IDS, enabled)
end

local function utf8_char_width(byte)
    byte = tonumber(byte) or 0
    if byte < 0x80 then return 1 end
    if byte >= 0xC2 and byte < 0xE0 then return 2 end
    if byte >= 0xE0 and byte < 0xF0 then return 3 end
    if byte >= 0xF0 and byte < 0xF5 then return 4 end
    return 1
end

local function utf8_prefix(s, max_chars)
    s = tostring(s or "")
    max_chars = math.max(0, tonumber(max_chars) or 0)
    if max_chars <= 0 or s == "" then return "", 0, 0 end
    local i, chars, cut, bytes = 1, 0, 0, #s
    while i <= bytes do
        local w = utf8_char_width(s:byte(i))
        if i + w - 1 > bytes then w = 1 end
        chars = chars + 1
        if chars <= max_chars then cut = i + w - 1 end
        i = i + w
    end
    if chars <= max_chars then return s, chars, chars end
    return s:sub(1, cut), max_chars, chars
end

local function clamp_text(s, limit)
    s = tostring(s or ""):gsub("\r", " "):gsub("\n", " ")
    limit = tonumber(limit) or 80
    if limit <= 0 then return "" end
    local ellipsis = "..."
    local keep = math.max(1, limit - #ellipsis)
    local prefix, _, total = utf8_prefix(s, keep)
    if total > keep then return prefix .. ellipsis end
    return s
end

local function utf8_len_safe(s)
    s = tostring(s or "")
    local count = 0
    for i = 1, #s do
        local b = string.byte(s, i)
        if b < 0x80 or b >= 0xC0 then count = count + 1 end
    end
    return count
end

local function utf8_take(s, max_chars)
    s = tostring(s or "")
    max_chars = math.max(0, tonumber(max_chars) or 0)
    if max_chars <= 0 or s == "" then return "", s end
    if utf8_len_safe(s) <= max_chars then return s, "" end
    local cut_pos = 0
    local count = 0
    for i = 1, #s do
        local b = string.byte(s, i)
        if b < 0x80 or b >= 0xC0 then count = count + 1 end
        if count == max_chars + 1 then cut_pos = i; break end
    end
    if cut_pos > 0 then
        return s:sub(1, cut_pos - 1), s:sub(cut_pos)
    end
    return s, ""
end

local function text_cols_for_width(width)
    return math.max(12, math.floor((tonumber(width) or 320) / BODY_AVG_GLYPH_W))
end

local function wrap_text_to_width(text, max_cols)
    text = tostring(text or ""):gsub("\r\n", "\n"):gsub("\r", "\n"):gsub("\t", " ")
    max_cols = math.max(8, tonumber(max_cols) or 32)
    local lines = {}
    local function push(line) lines[#lines + 1] = line or "" end
    for paragraph in (text .. "\n"):gmatch("(.-)\n") do
        paragraph = paragraph:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
        if paragraph == "" then
            if #lines == 0 then push("") end
        else
            local current = ""
            for word in paragraph:gmatch("%S+") do
                while utf8_len_safe(word) > max_cols do
                    if current ~= "" then push(current); current = "" end
                    local part, rest = utf8_take(word, max_cols)
                    push(part)
                    word = rest
                end
                if word ~= "" then
                    if current == "" then
                        current = word
                    elseif utf8_len_safe(current) + 1 + utf8_len_safe(word) <= max_cols then
                        current = current .. " " .. word
                    else
                        push(current)
                        current = word
                    end
                end
            end
            if current ~= "" then push(current) end
        end
    end
    if #lines == 0 then lines[1] = "" end
    return table.concat(lines, "\n"), #lines
end



local function get_row_node(id)
    local n = get_node(id)
    if n then return n end
    if not _row_clones then return nil end
    local N, suffix = id:match("^msg(%d+)(_.+)$")
    if not N then return nil end
    N = tonumber(N)
    if N == 1 then return nil end
    local clone = _row_clones[N]
    if not clone then return nil end
    local prefixed = LIST_PREFIX .. "msg1" .. suffix
    return clone[prefixed] or clone["msg1" .. suffix]
end

local function set_row_enabled(slot, enabled)
    for _, suffix in ipairs(ROW_SUFFIXES) do
        local n = get_row_node("msg" .. slot .. suffix)
        if n then gui.set_enabled(n, enabled) end
    end
end

local function row_set_text(slot, suffix, text)
    local n = get_row_node("msg" .. slot .. suffix)
    if n then gui.set_text(n, text or "") end
end

local function row_set_color(slot, suffix, color, alpha)
    local n = get_row_node("msg" .. slot .. suffix)
    if n then
        gui.set_color(n, color)
        if alpha ~= nil then gui.set_alpha(n, alpha) end
    end
end

local function row_set_color_keep_alpha(slot, suffix, color)
    local n = get_row_node("msg" .. slot .. suffix)
    if n then gui.set_color(n, color) end
end

local function row_set_alpha(slot, suffix, alpha)
    local n = get_row_node("msg" .. slot .. suffix)
    if n then gui.set_alpha(n, alpha) end
end

local function row_set_node_enabled(slot, suffix, enabled)
    local n = get_row_node("msg" .. slot .. suffix)
    if n then gui.set_enabled(n, enabled) end
end

local function truthy(v)
    return v == true or v == 1 or v == "true" or v == "yes" or v == "1" or v == "unread"
end

local function normalize_mails(raw)
    if type(raw) ~= "table" then return {} end
    local out = {}
    if #raw > 0 then
        for i = 1, #raw do
            if type(raw[i]) == "table" then out[#out + 1] = raw[i] end
        end
    else
        for _, item in pairs(raw) do
            if type(item) == "table" then out[#out + 1] = item end
        end
    end
    return out
end

local _fb_mails = nil

local function mail_list()
    local list = normalize_mails(gs.get_mails and gs.get_mails() or {})
    if #list == 0 then
        if not _fb_mails then
            _fb_mails = {}
            for i, m in ipairs(FALLBACK_MAILS) do
                local copy = {}
                for k, v in pairs(m) do copy[k] = v end
                if gs.get_flag and gs.get_flag("mail_fb_" .. i) then
                    copy.unread = false
                end
                _fb_mails[i] = copy
            end
        end
        for i, m in ipairs(_fb_mails) do
            m._index = i
            m._fallback = true
        end
        return _fb_mails
    end
    for i, m in ipairs(list) do
        m._index = i
    end
    return list
end

local function is_unread(m)
    if type(m) ~= "table" then return false end
    if m.unread ~= nil then return truthy(m.unread) end
    if m.read ~= nil then return not truthy(m.read) end
    if m.seen ~= nil then return not truthy(m.seen) end
    return false
end

local function mail_from(m)
    if type(m) ~= "table" then return "—" end
    return m.from_name or m.sender_name or m.sender or m.from or m.author or "—"
end

local function mail_addr(m)
    if type(m) ~= "table" then return "" end
    return m.address or m.email or m.from_email or m.sender_email or m.reply_to or ""
end

local function mail_subject(m)
    if type(m) ~= "table" then return "" end
    return m.subject or m.title or ""
end

local function mail_body(m)
    if type(m) ~= "table" then return "" end
    return m.body or m.snippet or m.preview or m.text or m.message or ""
end

local function mail_time(m)
    if type(m) ~= "table" then return "" end
    return m.time or m.date or m.sent_at or m.received_at or ""
end

local function mail_urgent(m)
    if type(m) ~= "table" then return false end
    return truthy(m.urgent) or truthy(m.important) or tostring(m.priority or "") == "high" or tostring(m.label or ""):lower() == "urgent"
end

local function mail_important(m)
    if type(m) ~= "table" then return false end
    return truthy(m.starred) or truthy(m.important) or truthy(m.favorite)
end

local function mail_label(m, index)
    if type(m) ~= "table" then return "" end
    if type(m.labels) == "table" then
        local v = m.labels[index]
        if type(v) == "table" then return v.text or v.name or v.id or "" end
        return v or ""
    end
    if index == 1 then return m.label or m.tag or m.category or "" end
    return m.label2 or m.tag2 or ""
end

local function attachment_text(m)
    if type(m) ~= "table" then return "" end
    local n = tonumber(m.attachment_count or m.attachments_count or m.attachments or 0) or 0
    if n <= 0 then return "" end
    return "📎 " .. tostring(n)
end

local function row_count()
    return MAX_MAIL_SLOTS
end

local function clamp_offset(self, total)
    local slots = math.max(1, row_count())
    local max_offset = math.max(0, (tonumber(total) or 0) - slots)
    self.mail_offset = math.max(0, math.min(tonumber(self.mail_offset) or 0, max_offset))
    return max_offset
end

local function update_scrollbar(self, total)
    local thumb = get_node(lp("scrollbar_thumb"))
    if not thumb then return end
    local track_h = 505
    local top_y = 65 + track_h
    local max_offset = math.max(0, (tonumber(total) or 0) - MAX_MAIL_SLOTS)
    self.mail_offset = math.max(0, math.min(tonumber(self.mail_offset) or 0, max_offset))
    local ratio = math.min(1, MAX_MAIL_SLOTS / math.max(1, total))
    local h = math.max(46, track_h * ratio)
    local t = max_offset > 0 and (self.mail_offset / max_offset) or 0
    local y = (top_y - h) - ((track_h - h) * t)
    gui.set_size(thumb, vmath.vector3(4, h, 0))
    gui.set_position(thumb, vmath.vector3(1204, y, 0.545))
end

local function label_color(label)
    local s = tostring(label or ""):lower()
    if s == "срочно" or s == "p1" or s == "urgent" then return COLORS.hot end
    if s == "счета" or s == "bills" then return COLORS.amber end
    if s == "семья" or s == "личное" or s == "family" then return COLORS.violet end
    if s == "работа" or s == "work" then return COLORS.accent end
    return COLORS.paper_dim
end

local function render_row(slot, mail)
    local has = type(mail) == "table"
    set_row_enabled(slot, has)
    if not has then return end
    local unread = is_unread(mail)
    local urgent = mail_urgent(mail)
    local important = mail_important(mail)
    local tag1 = tostring(mail_label(mail, 1) or "")
    local tag2 = tostring(mail_label(mail, 2) or "")
    local attach = attachment_text(mail)
    row_set_color(slot, "_bg", urgent and COLORS.card_hot or COLORS.card, unread and 0.84 or 0.58)
    row_set_alpha(slot, "_accent", unread and 0.85 or 0.0)
    row_set_color(slot, "_accent", urgent and COLORS.hot or COLORS.accent, unread and 0.85 or 0.0)
    row_set_text(slot, "_star", important and string.char(0xEE, 0xA0, 0xB8) or string.char(0xEE, 0xA0, 0xB9))
    row_set_color_keep_alpha(slot, "_star", important and COLORS.amber or COLORS.paper_dim)
    row_set_text(slot, "_from", clamp_text(mail_from(mail), 12))
    row_set_text(slot, "_addr", clamp_text(mail_addr(mail), 26))
    row_set_text(slot, "_subj", clamp_text(mail_subject(mail), 48))
    row_set_text(slot, "_body", clamp_text(mail_body(mail), 62))
    row_set_text(slot, "_time", attach ~= "" and attach or clamp_text(mail_time(mail), 8))
    row_set_color_keep_alpha(slot, "_from", unread and COLORS.paper or COLORS.paper_dim)
    row_set_color_keep_alpha(slot, "_subj", urgent and COLORS.hot or (unread and COLORS.accent or COLORS.paper))
    row_set_color_keep_alpha(slot, "_body", COLORS.paper_dim)
    row_set_color_keep_alpha(slot, "_time", attach ~= "" and COLORS.accent or COLORS.paper_dim)
    if tag1 ~= "" then
        row_set_node_enabled(slot, "_tag1_bg", true)
        row_set_node_enabled(slot, "_tag1_text", true)
        row_set_text(slot, "_tag1_text", clamp_text(tag1, 7))
        local c = label_color(tag1)
        row_set_color(slot, "_tag1_bg", c, 0.14)
        row_set_color_keep_alpha(slot, "_tag1_text", c)
    else
        row_set_node_enabled(slot, "_tag1_bg", false)
        row_set_node_enabled(slot, "_tag1_text", false)
    end
    if tag2 ~= "" then
        row_set_node_enabled(slot, "_tag2_bg", true)
        row_set_node_enabled(slot, "_tag2_text", true)
        row_set_text(slot, "_tag2_text", clamp_text(tag2, 5))
        local c = label_color(tag2)
        row_set_color(slot, "_tag2_bg", c, 0.14)
        row_set_color_keep_alpha(slot, "_tag2_text", c)
    else
        row_set_node_enabled(slot, "_tag2_bg", false)
        row_set_node_enabled(slot, "_tag2_text", false)
    end
end

local function is_inside_rect(id, x, y)
    local n = get_node(id)
    if not n or not gui.is_enabled(n) then return false end
    return gui.pick_node(n, x, y)
end

local function build_mail_list(self)
    local all = mail_list()
    if self.filter == "unread" then
        local out = {}
        for _, m in ipairs(all) do
            if is_unread(m) then out[#out + 1] = m end
        end
        return out
    end
    return all
end

local function render_tab(self)
    local all = mail_list()
    local total = #all
    local unread = 0
    for _, m in ipairs(all) do
        if is_unread(m) then unread = unread + 1 end
    end
    set_text(lp("tab_all_count"), tostring(total))
    set_text(lp("tab_unread_count"), tostring(unread))
    local all_active = self.filter ~= "unread"
    set_color(lp("tab_all_bg"), all_active and COLORS.accent or COLORS.card, all_active and 0.15 or 0.60)
    set_color(lp("tab_unread_bg"), (not all_active) and COLORS.accent or COLORS.card, (not all_active) and 0.15 or 0.60)
    set_color(lp("border_all"), COLORS.accent, all_active and 0.55 or 0.25)
    set_color(lp("border_unread"), COLORS.accent, (not all_active) and 0.55 or 0.25)
end



local function render_list(self)
    local list = build_mail_list(self)
    local total = #list
    local slots = math.max(1, row_count())
    clamp_offset(self, total)

    set_text(lp("side_title"), "ПОЧТА")
    render_tab(self)

    for i = 1, slots do
        render_row(i, list[(tonumber(self.mail_offset) or 0) + i])
    end

    update_scrollbar(self, total)
end



local function body_layout(mail)
    local raw = mail_body(mail)
    if raw == "" then return { w = BODY_W, h = 40, text = "", lines = 1, max_line = 0 } end
    local cols = text_cols_for_width(BODY_W - BODY_PAD_X * 2)
    local wrapped, lines = wrap_text_to_width(raw, cols)
    local natural = math.ceil(utf8_len_safe(raw) * BODY_AVG_GLYPH_W / 1.5)
    local h = math.max(40, BODY_PAD_TOP + lines * BODY_LINE_H + BODY_STAMP_AREA_H)
    return { w = BODY_W, h = h, text = wrapped, lines = lines }
end

local function clamp_detail_offset(self, content_h)
    local max_offset = math.max(0, (tonumber(content_h) or 0) - BODY_AREA_H)
    self.detail_offset = math.max(0, math.min(tonumber(self.detail_offset) or 0, max_offset))
    return max_offset
end

local function update_detail_scrollbar(self, content_h)
    local thumb = get_node(dp("det_scrollbar_thumb"))
    local track = get_node(dp("det_scrollbar_track"))
    if not thumb then return end
    content_h = tonumber(content_h) or 0
    local max_offset = clamp_detail_offset(self, content_h)
    if content_h <= BODY_AREA_H or max_offset <= 0 then
        if track then gui.set_enabled(track, false) end
        gui.set_enabled(thumb, false)
        return
    end
    if track then
        gui.set_enabled(track, true)
        gui.set_alpha(track, 0.08)
    end
    gui.set_enabled(thumb, true)
    local ratio = math.min(1, BODY_AREA_H / content_h)
    local h = math.max(46, (BODY_AREA_H) * ratio)
    local travel = BODY_AREA_H - h
    local t = (self.detail_offset or 0) / max_offset
    local y = (BODY_AREA_BOTTOM + BODY_AREA_H - h) - travel * t
    gui.set_size(thumb, vmath.vector3(4, h, 0))
    gui.set_position(thumb, vmath.vector3(1206, y, 0.553))
end

local function render_detail(self)
    local mail = self.active_mail
    if not mail then return end

    set_text(dp("det_from"), mail_from(mail))
    set_text(dp("det_addr"), mail_addr(mail))
    set_text(dp("det_subj"), mail_subject(mail))
    set_text(dp("det_time"), mail_time(mail))

    set_color(dp("det_from"), COLORS.paper, 0.95)
    set_color(dp("det_addr"), COLORS.paper_dim, 0.78)
    set_color(dp("det_subj"), COLORS.paper, 0.92)
    set_color(dp("det_time"), COLORS.paper_dim, 0.78)

    local layout = body_layout(mail)
    local body_text = layout.text
    local content_h = layout.h

    set_text(dp("det_body"), body_text)
    local det_body_node = get_node(dp("det_body"))
    if det_body_node then gui.set_size(det_body_node, vmath.vector3(BODY_W, content_h, 0)) end

    clamp_detail_offset(self, content_h)
    local y = BODY_AREA_TOP + (self.detail_offset or 0)
    local body_node = get_node(dp("det_body"))
    if body_node then
        local p = gui.get_position(body_node)
        gui.set_position(body_node, vmath.vector3(BODY_X, y, p.z))
    end

    update_detail_scrollbar(self, content_h)
end

local function flash_node(id)
    local n = get_node(id)
    if n then
        U.flash_node(n, { low = 0.22, dur_down = 0.06, dur_up = 0.12 })
    end
end



local function set_view(self, view)
    self.view = view
    if not self.visible then
        set_all_enabled(false)
        return
    end

    set_host_visible(true)

    local show_list = view == "list"
    local show_detail = view == "detail"
    set_node_enabled("mail_list", show_list)
    set_node_enabled("mail_detail", show_detail)
    set_node_enabled(lp("list_root"), show_list)
    set_node_enabled(dp("detail_root"), show_detail)
    set_many_enabled(LIST_NODE_IDS, show_list)
    set_many_enabled(DETAIL_NODE_IDS, show_detail)
end

local function open_list(self)
    self.active_mail = nil
    self.detail_offset = 0
    set_view(self, "list")
    self.mail_offset = self.mail_offset or 0
    render_list(self)
end

local PHONE_ROOT = "#phone_v2"

local function open_detail(self, mail)
    self.active_mail = mail
    self.detail_offset = 0
    if mail then
        mail.unread = false
        if mail._index and not mail._fallback and gs.mark_mail_read then
            gs.mark_mail_read(mail._index)
        end
        if mail._index and mail._fallback and gs.set_flag then
            gs.set_flag("mail_fb_" .. mail._index, true)
        end
        if mail._index then
            msg.post(PHONE_ROOT, MSG.refresh_phone)
        end
    end
    set_view(self, "detail")
    render_detail(self)
end

local function refresh(self)
    if self.view == "detail" then
        render_detail(self)
    else
        render_list(self)
    end
end



local function scroll_list(self, delta_rows)
    local list = build_mail_list(self)
    local total = #list
    local max_offset = clamp_offset(self, total)
    if max_offset <= 0 then return false end
    local old = tonumber(self.mail_offset) or 0
    self.mail_offset = math.max(0, math.min(old + delta_rows, max_offset))
    if self.mail_offset ~= old then
        render_list(self)
        return true
    end
    return false
end

local function step_detail(self, delta)
    if not self.active_mail then return false end
    local layout = body_layout(self.active_mail)
    local content_h = layout.h
    local max_offset = clamp_detail_offset(self, content_h)
    if max_offset <= 0 then return false end
    local old = self.detail_offset or 0
    self.detail_offset = math.max(0, math.min(old + delta, max_offset))
    if self.detail_offset ~= old then
        render_detail(self)
        return true
    end
    return false
end



local function is_wheel_down(action_id)
    return action_id == MSG.wheel_down
        or action_id == MSG.mouse_wheel_down
        or action_id == MSG.scroll_down
end

local function is_wheel_up(action_id)
    return action_id == MSG.wheel_up
        or action_id == MSG.mouse_wheel_up
        or action_id == MSG.scroll_up
end

local function is_wheel_axis(action_id)
    return action_id == MSG.wheel
        or action_id == MSG.mouse_wheel
        or action_id == MSG.scroll
end

local function wheel_rows_from_action(action_id, action)
    if is_wheel_down(action_id) then return SCROLL_STEP_ROWS end
    if is_wheel_up(action_id) then return -SCROLL_STEP_ROWS end
    if not is_wheel_axis(action_id) then return 0 end
    local v = 0
    if action then
        v = tonumber(action.value) or 0
        if v == 0 then v = tonumber(action.dy) or 0 end
        if v == 0 and action_id ~= MSG.touch then v = tonumber(action.y) or 0 end
    end
    if v == 0 then return 0 end
    return v > 0 and -SCROLL_STEP_ROWS or SCROLL_STEP_ROWS
end

local function is_inside_list(x, y)
    local n = get_node("mail_runtime_root")
    return n and gui.is_enabled(n) and gui.pick_node(n, x, y) == true
end

local function is_inside_detail(x, y)
    return U.point_in_rect(x, y, 520, BODY_AREA_BOTTOM, 690, BODY_AREA_H)
end

local function pick_row(self, x, y)
    local list = build_mail_list(self)
    for i = 1, MAX_MAIL_SLOTS do
        local idx = (tonumber(self.mail_offset) or 0) + i
        local mail = list[idx]
        if mail then
            local id = "msg" .. i .. "_bg"
            local n = get_row_node(id)
            if n and gui.is_enabled(n) and gui.pick_node(n, x, y) then
                return mail, id
            end
        end
    end
    return nil, nil
end

local function reset_detail_drag(self)
    self.detail_dragging = false
    self.detail_drag_started = false
    self.detail_drag_last_y = nil
    self.detail_drag_total = 0
end

local function handle_detail_input(self, action_id, action)
    action = action or {}
    local x = action.x or 0
    local y = action.y or 0

    local wheel_rows = wheel_rows_from_action(action_id, action)
    if wheel_rows ~= 0 then
        step_detail(self, wheel_rows * DETAIL_WHEEL_STEP_PX)
        return true
    end
    if action_id ~= MSG.touch then return true end

    if action.pressed then
        reset_detail_drag(self)
        if is_inside_detail(x, y) then
            self.detail_dragging = true
            self.detail_drag_last_y = y
            self.detail_drag_total = 0
        end
        return true
    end

    if self.detail_dragging and not action.released then
        local last_y = self.detail_drag_last_y or y
        local dy = y - last_y
        self.detail_drag_last_y = y
        self.detail_drag_total = (self.detail_drag_total or 0) + math.abs(dy)

        if self.detail_drag_started or self.detail_drag_total >= DETAIL_DRAG_THRESHOLD_PX then
            self.detail_drag_started = true
            if dy ~= 0 then
                step_detail(self, -dy)
            end
        end
        return true
    end

    if action.released then
        local was_drag = self.detail_drag_started == true
        reset_detail_drag(self)
        if was_drag then return true end

        local back = get_node(dp("det_back_bg"))
        if back and gui.is_enabled(back) and gui.pick_node(back, x, y) then
            flash_node(dp("det_back_bg"))
            open_list(self)
            return true
        end

        return true
    end

    return true
end

local function handle_list_input(self, action_id, action)
    action = action or {}
    local x, y = action.x or 0, action.y or 0

    local wheel_rows = wheel_rows_from_action(action_id, action)
    if wheel_rows ~= 0 then return scroll_list(self, wheel_rows) end
    if action_id ~= MSG.touch then return false end

    local result = drag_scroll.handle(self.mail_drag, action)

    if result == "tap" and action and action.released then
        if is_inside_rect(lp("tab_all_bg"), x, y) then
            self.filter = "all"
            self.mail_offset = 0
            drag_scroll.reset(self.mail_drag)
            render_list(self)
            return true
        elseif is_inside_rect(lp("tab_unread_bg"), x, y) then
            self.filter = "unread"
            self.mail_offset = 0
            drag_scroll.reset(self.mail_drag)
            render_list(self)
            return true
        end
    end

    if result == "swallow" then
        return true
    end
    if result == "tap" then
        local mail, id = pick_row(self, x, y)
        if mail then
            flash_node(id)
            log.debug("phone_mail", "open detail for", mail_from(mail))
            open_detail(self, mail)
            return true
        end
        return true
    end
    return false
end

local function handle_phone_input(self, action_id, action)
    if not self.visible then return false end
    if self.view == "detail" then
        return handle_detail_input(self, action_id, action or {})
    end
    return handle_list_input(self, action_id, action or {})
end

function init(self)
    self.visible = false
    self.view = "list"
    self.mail_offset = 0
    self.filter = "all"
    self.active_mail = nil
    self.detail_offset = 0

    U.apply_adaptive_layout("mail_runtime_root")

    _row_clones = {}
    local proto = get_node("msg1_bg")
    if proto then
        local proto_pos = gui.get_position(proto)
        for slot = 2, MAX_MAIL_SLOTS do
            local clone = gui.clone_tree(proto)
            _row_clones[slot] = clone
            local clone_root = clone[lp("msg1_bg")] or clone["msg1_bg"]
            if clone_root then
                local y_offset = -(slot - 1) * (ROW_H + ROW_GAP)
                gui.set_position(clone_root, vmath.vector3(
                    proto_pos.x, proto_pos.y + y_offset, proto_pos.z))
            end
        end
    end

    self.mail_drag = drag_scroll.new({
        step_px      = DRAG_STEP_PX,
        threshold_px = DRAG_THRESHOLD_PX,
        owner        = self,
        invert       = true,
        is_inside    = is_inside_list,
        on_step      = function(owner, delta) scroll_list(owner, delta) end,
    })
    reset_detail_drag(self)
    set_all_enabled(false)
end

function final(self)
    set_all_enabled(false)
end

function on_message(self, message_id, message, sender)
    if message_id == MSG.open_app then
        self.visible = true
        self.mail_offset = 0
        open_list(self)

    elseif message_id == MSG.close_app then
        self.visible = false
        self.active_mail = nil
        self.filter = "all"
        self.detail_offset = 0
        if self.mail_drag then drag_scroll.reset(self.mail_drag) end
        reset_detail_drag(self)
        self.view = "list"
        set_all_enabled(false)

    elseif message_id == MSG.refresh_app then
        if self.visible then
            refresh(self)
        end

    elseif message_id == MSG.phone_input then
        if self.visible then
            handle_phone_input(self, message and message.action_id or MSG.touch, {
                x = message and message.x or 0,
                y = message and message.y or 0,
                dx = message and message.dx or 0,
                dy = message and message.dy or 0,
                value = message and message.value or 0,
                pressed = message and message.pressed or false,
                released = message and message.released or false,
                repeated = message and message.repeated or false,
            })
        end
    end
end

function on_input(self, action_id, action)
    return handle_phone_input(self, action_id, action or {})
end
