local UI_MGR = "#ui_manager_v2"

local BASE_W = 1280
local BASE_H = 720
local ROOT_ID = "dlg_root"

local function get_viewport_size()
    return gui.get_width(), gui.get_height()
end

local function set_box_size_if_possible(node, w, h)
    
    pcall(gui.set_size, node, vmath.vector3(w, h, 0))
end

local PORTRAIT_CLIP_W = 220
local PORTRAIT_CLIP_H = 290

local function apply_portrait_clip_layout()
    local clip = gui.get_node("portrait_bg_fon")
    local portrait = gui.get_node("portrait_bg")
    local icon = gui.get_node("portrait_icon")

    
    
    pcall(gui.set_clipping_mode, clip, gui.CLIPPING_MODE_STENCIL)
    pcall(gui.set_clipping_visible, clip, true)
    pcall(gui.set_clipping_inverted, clip, false)

    local square = math.max(PORTRAIT_CLIP_W, PORTRAIT_CLIP_H)
    set_box_size_if_possible(portrait, square, square)
    gui.set_pivot(portrait, gui.PIVOT_SW)
    gui.set_adjust_mode(portrait, gui.ADJUST_FIT)

    local p = gui.get_position(portrait)
    p.x = (PORTRAIT_CLIP_W - square) * 0.5
    p.y = (PORTRAIT_CLIP_H - square) * 0.5
    p.z = 0.01
    gui.set_position(portrait, p)

    local ip = gui.get_position(icon)
    ip.x = PORTRAIT_CLIP_W * 0.5
    ip.y = PORTRAIT_CLIP_H * 0.5 + 15
    ip.z = 0.02
    gui.set_position(icon, ip)
end

local function apply_adaptive_layout(self)
    local screen_w, screen_h = get_viewport_size()
    if not screen_w or not screen_h or screen_w <= 0 or screen_h <= 0 then return end
    if self._adaptive_w == screen_w and self._adaptive_h == screen_h then return end

    self._adaptive_w = screen_w
    self._adaptive_h = screen_h

    
    for _, id in ipairs({ "scene_bg", "scene_bg_next" }) do
        local bg = gui.get_node(id)
        local bg_pos = gui.get_position(bg)
        bg_pos.x = screen_w * 0.5
        bg_pos.y = screen_h * 0.5
        gui.set_position(bg, bg_pos)
        gui.set_scale(bg, vmath.vector3(1, 1, 1))
        set_box_size_if_possible(bg, screen_w, screen_h)
        gui.set_pivot(bg, gui.PIVOT_CENTER)
        gui.set_adjust_mode(bg, gui.ADJUST_ZOOM)
    end

    
    
    local scale = math.min(screen_w / BASE_W, screen_h / BASE_H)
    if scale <= 0 then scale = 1 end

    local root = gui.get_node(ROOT_ID)
    local root_pos = gui.get_position(root)
    root_pos.x = math.floor(((screen_w - BASE_W * scale) * 0.5) + 0.5)
    root_pos.y = math.floor(((screen_h - BASE_H * scale) * 0.5) + 0.5)
    gui.set_position(root, root_pos)
    gui.set_scale(root, vmath.vector3(scale, scale, 1))
    set_box_size_if_possible(root, BASE_W, BASE_H)
    gui.set_pivot(root, gui.PIVOT_SW)
    gui.set_adjust_mode(root, gui.ADJUST_FIT)
end



local log = require "main.scripts.log"
local function dbg(...) log.debug("dialogue", ...) end









