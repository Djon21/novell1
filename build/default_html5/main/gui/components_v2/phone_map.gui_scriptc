�Blocal gs = require "main.scripts.game_state"
local U = require "main.gui.modules.gui_utils"

local UI_MGR = "#ui_manager_v2"

local BLOCKED_LABEL = "Сейчас не время. Мне туда не надо."

local POI_ORDER = {
    "poi_home", "poi_work", "poi_cafe", "poi_park",
    "poi_shop", "poi_bar", "poi_view", "poi_archive",
}

local POI_DATA = {
    poi_home    = { x = 642, y = 412, cx = 0.714, cy = 0.361, cz = 0,    scene = "apartment_hub", label = "Домой",        cy_off = { _circle = 8, _center = 8 } },
    poi_work    = { x = 703, y = 314, cx = 0.282, cy = 0.961, cz = 0,    scene = "work_hub",      label = "На работу",   cy_off = { _hitbox = -21, _circle = -21, _center = -21 } },
    poi_cafe    = { x = 1075, y = 228, cx = 0, cy = 0.71, cz = 0.275,    scene = "cafe_hub",      label = "Кафе" },
    poi_park    = { x = 906, y = 383, cx = 0.412, cy = 0.961, cz = 0.529, scene = "park_hub",      label = "Парк у реки" },
    poi_shop    = { x = 797, y = 499, cx = 0, cy = 0.282, cz = 0.569,    scene = "shop_hub",      label = "Магазин 24/7" },
    poi_bar     = { x = 836, y = 152, cx = 0, cy = 0.282, cz = 0.569,    scene = "bar_hub",       label = "Бар Maybe" },
    poi_view    = { x = 1105, y = 568, cx = 0, cy = 0.71, cz = 0.275,    scene = "view_hub",      label = "Смотровая" },
    poi_archive = { x = 1070, y = 379, cx = 0.714, cy = 0.361, cz = 0,    scene = "archive_hub",   label = "Архив" },
}

local POI_SUFFIXES = { "_hitbox", "_stem", "_circle", "_center" }

local _poi_clones = {}

local function get_poi_node(poi_id, suffix)
    if suffix == "_icon" then
        return gui.get_node(poi_id .. "_icon")
    end
    local clones = _poi_clones[poi_id]
    if not clones then return nil end
    return clones["poi_proto" .. suffix]
end

local function init_poi_clones()
    local proto = gui.get_node("poi_proto")
    if not proto then return end
    for _, poi_id in ipairs(POI_ORDER) do
        local data = POI_DATA[poi_id]
        if data then
            local clone_map = gui.clone_tree(proto)
            _poi_clones[poi_id] = clone_map
            local parent = clone_map["poi_proto"]
            if parent then
                gui.set_position(parent, vmath.vector3(data.x, data.y, 0))
            end
            for _, suf in ipairs(POI_SUFFIXES) do
                local node = clone_map["poi_proto" .. suf]
                if node then
                    local off = data.cy_off and data.cy_off[suf]
                    if off then
                        local p = gui.get_position(node)
                        gui.set_position(node, vmath.vector3(p.x, off, p.z))
                    end
                    gui.set_color(node, vmath.vector4(data.cx, data.cy, data.cz, gui.get_color(node).w))
                end
            end
            local icon = gui.get_node(poi_id .. "_icon")
            if icon then
                gui.set_color(icon, vmath.vector4(data.cx, data.cy, data.cz, 1))
            end
        end
    end
end

local function set_root_enabled(enabled)
    local root = U.get_node("grp_panel")
    if root then gui.set_enabled(root, enabled) end
end

local function hide_confirm(self)
    self.confirm_target = nil
    self.confirm_blocked = false
    local n = U.get_node("grp_confirm")
    if n then gui.set_enabled(n, false) end
end

local function show_confirm(self, info)
    self.confirm_target = info
    self.confirm_blocked = false
    local n = U.get_node("confirm_location_name")
    if n then gui.set_text(n, info.label) end
    local g = U.get_node("grp_confirm")
    if g then gui.set_enabled(g, true) end
end

local function show_blocked(self, info)
    self.confirm_target = info
    self.confirm_blocked = true
    local n = U.get_node("confirm_location_name")
    if n then gui.set_text(n, BLOCKED_LABEL) end
    local g = U.get_node("grp_confirm")
    if g then gui.set_enabled(g, true) end
end

local PULSE_DURATION = 0.9
local PULSE_ALPHA_LO = 0.65
local PULSE_SCALE_HI = 1.18
local PULSE_SUFFIXES = { "_circle", "_center" }
local SCALE_TARGET_SUFFIX = "_circle"

local function start_poi_pulse(poi_id)
    for _, suf in ipairs(PULSE_SUFFIXES) do
        local node = get_poi_node(poi_id, suf)
        if node then
            gui.cancel_animation(node, "color.w")
            gui.set_rotation(node, vmath.vector3(0, 0, 0))
            local c = gui.get_color(node)
            gui.set_color(node, vmath.vector4(c.x, c.y, c.z, 1))
            gui.animate(node, "color.w", PULSE_ALPHA_LO, gui.EASING_INOUTSINE,
                PULSE_DURATION, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
        end
    end
    local scale_node = get_poi_node(poi_id, SCALE_TARGET_SUFFIX)
    if scale_node then
        gui.cancel_animation(scale_node, gui.PROP_SCALE)
        gui.set_scale(scale_node, vmath.vector3(1, 1, 1))
        gui.animate(scale_node, gui.PROP_SCALE,
            vmath.vector3(PULSE_SCALE_HI, PULSE_SCALE_HI, 1),
            gui.EASING_INOUTSINE, PULSE_DURATION, 0, nil,
            gui.PLAYBACK_LOOP_PINGPONG)
    end
end

local function stop_poi_pulse(poi_id)
    for _, suf in ipairs(PULSE_SUFFIXES) do
        local node = get_poi_node(poi_id, suf)
        if node then
            gui.cancel_animation(node, "color.w")
            local c = gui.get_color(node)
            gui.set_color(node, vmath.vector4(c.x, c.y, c.z, 1))
        end
    end
    local scale_node = get_poi_node(poi_id, SCALE_TARGET_SUFFIX)
    if scale_node then
        gui.cancel_animation(scale_node, gui.PROP_SCALE)
        gui.set_scale(scale_node, vmath.vector3(1, 1, 1))
    end
end

local function refresh_pois(self)
    self.pulsing_pois = self.pulsing_pois or {}
    for _, poi_id in ipairs(POI_ORDER) do
        local circle = get_poi_node(poi_id, "_circle")
        if circle then
            local allowed = (not gs.map_is_poi_allowed) or gs.map_is_poi_allowed(poi_id)
            if allowed and not self.pulsing_pois[poi_id] then
                start_poi_pulse(poi_id)
                self.pulsing_pois[poi_id] = true
            elseif not allowed and self.pulsing_pois[poi_id] then
                stop_poi_pulse(poi_id)
                self.pulsing_pois[poi_id] = nil
            end
        end
    end
end

local function stop_all_pois(self)
    for _, poi_id in ipairs(POI_ORDER) do
        stop_poi_pulse(poi_id)
    end
    if self then self.pulsing_pois = {} end
end

function init(self)
    self.visible = false
    self.confirm_target = nil
    self.confirm_blocked = false

    init_poi_clones()

    U.apply_adaptive_layout("map_runtime_root")

    set_root_enabled(false)
    local c = U.get_node("grp_confirm")
    if c then gui.set_enabled(c, false) end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_app") then
        self.visible = true
        set_root_enabled(true)
        hide_confirm(self)
        refresh_pois(self)
    elseif message_id == hash("refresh_app") then
        if self.visible then refresh_pois(self) end
    elseif message_id == hash("close_app") then
        self.visible = false
        hide_confirm(self)
        stop_all_pois(self)
        set_root_enabled(false)
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    if self.confirm_target then
        local yes = U.get_node("confirm_yes_btn")
        if yes and gui.pick_node(yes, action.x, action.y) then
            if self.confirm_blocked then
                hide_confirm(self)
                return true
            end
            local scene_id = self.confirm_target.scene
            hide_confirm(self)
            msg.post(UI_MGR, "map_travel", { scene = scene_id })
            return true
        end
        local no = U.get_node("confirm_no_btn")
        if no and gui.pick_node(no, action.x, action.y) then
            hide_confirm(self)
            return true
        end
        hide_confirm(self)
        return true
    end

    for _, poi_id in ipairs(POI_ORDER) do
        local hitbox = get_poi_node(poi_id, "_hitbox")
        if hitbox and gui.pick_node(hitbox, action.x, action.y) then
            local info = POI_DATA[poi_id]
            local allowed = (not gs.map_is_poi_allowed) or gs.map_is_poi_allowed(poi_id)
            if allowed then
                show_confirm(self, info)
            else
                show_blocked(self, info)
            end
            return true
        end
    end

    return false
end
