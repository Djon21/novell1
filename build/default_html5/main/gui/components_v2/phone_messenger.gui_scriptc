local _row_clones = nil




local _bubble_clones = nil

local function try_get_node(id)
    local ok, n = pcall(gui.get_node, id)
    if ok then return n end
    return nil
end

local function resolve_row_clone(id)
    if not _row_clones then return nil end

    local raw = tostring(id or "")
    raw = raw:gsub("^messenger_list/", "")
    local slot, suffix = raw:match("^chat(%d+)(_.+)$")
    slot = tonumber(slot)
    if not slot or slot <= 1 then return nil end

    local clone = _row_clones[slot]
    if not clone then return nil end

    
    
    if suffix == "_border" then
        return clone["messenger_list/border_chat"]
            or clone["border_chat"]
    end

    return clone["messenger_list/chat1" .. suffix]
        or clone["chat1" .. suffix]
end

local function resolve_bubble_clone(id)
    if not _bubble_clones then return nil end

    local raw = tostring(id or "")
    raw = raw:gsub("^messenger_chat/", "")
    local slot, suffix = raw:match("^bub(%d+)(_.+)$")
    slot = tonumber(slot)
    if not slot or slot <= 1 then return nil end

    local clone = _bubble_clones[slot]
    if not clone then return nil end

    
    
    if suffix == "_border" then
        return clone["messenger_chat/border_bub"]
            or clone["border_bub"]
    end

    return clone["messenger_chat/bub1" .. suffix]
        or clone["bub1" .. suffix]
end

local function resolve_template_alias(id)
    local raw = tostring(id or "")
    raw = raw:gsub("^messenger_list/", ""):gsub("^messenger_chat/", "")

    local row_slot = raw:match("^chat(%d+)_border$")
    if row_slot == "1" then
        return try_get_node("messenger_list/border_chat") or try_get_node("border_chat")
    end

    local bub_slot = raw:match("^bub(%d+)_border$")
    if bub_slot == "1" then
        return try_get_node("messenger_chat/border_bub") or try_get_node("border_bub")
    end

    return nil
end






local function get_node(id)
    local n = resolve_row_clone(id)
    if n then return n end

    n = resolve_bubble_clone(id)
    if n then return n end

    n = resolve_template_alias(id)
    if n then return n end

    n = try_get_node(id)
    if n then return n end

    if id:sub(1, 15) ~= "messenger_list/" then
        n = try_get_node("messenger_list/" .. id)
        if n then return n end
    end
    if id:sub(1, 15) ~= "messenger_chat/" then
        n = try_get_node("messenger_chat/" .. id)
        if n then return n end
    end
    return nil
end

local function set_node_enabled(id, enabled)
    local n = get_node(id)
    if n then gui.set_enabled(n, enabled) end
end

local function set_nodes_enabled(ids, enabled)
    for _, id in ipairs(ids) do set_node_enabled(id, enabled) end
end

local function set_text(id, value)
    local n = get_node(id)
    if n then gui.set_text(n, value or "") end
end

local function set_color(id, color, alpha)
    local n = get_node(id)
    if n then
        local c = vmath.vector4(color.x, color.y, color.z, alpha or color.w or 1)
        gui.set_color(n, c)
    end
end

local function set_alpha(id, alpha)
    local n = get_node(id)
    if n then gui.set_alpha(n, alpha) end
end

local function set_size_x(id, width)
    local n = get_node(id)
    if n then
        local s = gui.get_size(n)
        gui.set_size(n, vmath.vector3(width, s.y, s.z))
    end
end

local function set_size_y(id, height)
    local n = get_node(id)
    if n then
        local s = gui.get_size(n)
        gui.set_size(n, vmath.vector3(s.x, height, s.z))
    end
end

local function set_pos_y(id, y)
    local n = get_node(id)
    if n then
        local p = gui.get_position(n)
        gui.set_position(n, vmath.vector3(p.x, y, p.z))
    end
end

local function set_pos_x(id, x)
    local n = get_node(id)
    if n then
        local target_x = x

        
        
        
        
        
        local raw = tostring(id or ''):gsub('^messenger_chat/', '')
        local slot, suffix = raw:match('^bub(%d+)(_.+)$')
        if slot and suffix and suffix ~= '_bg' then
            local root = get_node('bub' .. tostring(slot) .. '_bg')
            if root then
                local rp = gui.get_position(root)
                target_x = x - rp.x
            end
        end

        local p = gui.get_position(n)
        gui.set_position(n, vmath.vector3(target_x, p.y, p.z))
    end
end

local function utf8_char_width(byte)
    byte = tonumber(byte) or 0
    if byte < 0x80 then return 1 end
    if byte >= 0xC2 and byte < 0xE0 then return 2 end
    if byte >= 0xE0 and byte < 0xF0 then return 3 end
    if byte >= 0xF0 and byte < 0xF5 then return 4 end
    return 1
end

local function utf8_prefix(s, max_chars)
    s = tostring(s or "")
    max_chars = math.max(0, tonumber(max_chars) or 0)
    if max_chars <= 0 or s == "" then return "", 0, 0 end

    local i = 1
    local chars = 0
    local cut = 0
    local bytes = #s
    while i <= bytes do
        local w = utf8_char_width(s:byte(i))
        if i + w - 1 > bytes then
            w = 1
        end
        chars = chars + 1
        if chars <= max_chars then
            cut = i + w - 1
        end
        i = i + w
    end

    if chars <= max_chars then
        return s, chars, chars
    end
    return s:sub(1, cut), max_chars, chars
end

local function utf8_first_char(s)
    local prefix = utf8_prefix(s, 1)
    return prefix ~= "" and prefix or nil
end

local function clamp_text(s, limit)
    s = tostring(s or ""):gsub("\r", " "):gsub("\n", " ")
    limit = tonumber(limit) or 80
    if limit <= 0 then return "" end

    local ellipsis = "..."
    local keep = math.max(1, limit - #ellipsis)
    local prefix, _, total = utf8_prefix(s, keep)
    if total > keep then
        return prefix .. ellipsis
    end
    return s
end

local function utf8_len_safe(s)
    s = tostring(s or "")
    if utf8 and utf8.len then
        local ok, n = pcall(utf8.len, s)
        if ok and n then return n end
    end
    local _, chars = utf8_prefix(s, 1000000)
    return chars or #s
end

local function utf8_take(s, max_chars)
    s = tostring(s or "")
    max_chars = math.max(0, tonumber(max_chars) or 0)
    if max_chars <= 0 then return "", s end
    local prefix, _, total = utf8_prefix(s, max_chars)
    if total <= max_chars then return s, "" end
    return prefix, s:sub(#prefix + 1)
end

local function wrap_text_to_width(text, max_cols)
    text = tostring(text or ""):gsub("\r\n", "\n"):gsub("\r", "\n"):gsub("\t", " ")
    max_cols = math.max(8, tonumber(max_cols) or 32)
    local lines = {}
    local function push(line) lines[#lines + 1] = line or "" end

    for paragraph in (text .. "\n"):gmatch("(.-)\n") do
        paragraph = paragraph:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
        if paragraph == "" then
            if #lines == 0 then push("") end
        else
            local current = ""
            for word in paragraph:gmatch("%S+") do
                while utf8_len_safe(word) > max_cols do
                    if current ~= "" then push(current); current = "" end
                    local part, rest = utf8_take(word, max_cols)
                    push(part)
                    word = rest
                end
                if word ~= "" then
                    if current == "" then
                        current = word
                    elseif utf8_len_safe(current) + 1 + utf8_len_safe(word) <= max_cols then
                        current = current .. " " .. word
                    else
                        push(current)
                        current = word
                    end
                end
            end
            if current ~= "" then push(current) end
        end
    end
    if #lines == 0 then lines[1] = "" end
    return table.concat(lines, "\n"), #lines
end

local function text_cols_for_width(width)
    return math.max(12, math.floor((tonumber(width) or 320) / 8.6))
end

local function tone_color(tone)
    if tone == "hot" then return COLORS.hot end
    if tone == "amber" then return COLORS.amber end
    if tone == "violet" then return COLORS.violet end
    if tone == "green" then return COLORS.green end
    return COLORS.accent
end

local function title_from_id(chat_id)
    local s = tostring(chat_id or "")
    if s == "" then return "—" end
    s = s:gsub("_", " "):gsub("%-", " ")
    return (s:gsub("(%S+)", function(word)
        return word:sub(1, 1):upper() .. word:sub(2)
    end))
end

local function avatar_text(value)
    local s = tostring(value or "?"):gsub("\r", " "):gsub("\n", " ")
    s = s:gsub("%s+", "")
    if s == "" then return "?" end
    local prefix = utf8_prefix(s:upper(), 2)
    return prefix ~= "" and prefix or "?"
end

local function make_avatar(name_or_id)
    local s = tostring(name_or_id or "?")
    local first = utf8_first_char(s:match("%S+") or "?") or "?"
    local second = nil
    local words = {}
    for w in s:gmatch("%S+") do table.insert(words, w) end
    if #words >= 2 then
        second = utf8_first_char(words[2])
    else
        local compact = s:gsub("%s+", "")
        local one = utf8_prefix(compact, 1)
        second = utf8_first_char(compact:sub(#one + 1))
    end
    local av = first .. (second or "")
    return avatar_text(av)
end

local function get_meta(chat_id)
    local id = tostring(chat_id or "")
    local base = (contacts and contacts.get_msg and contacts.get_msg(id)) or CHAT_META[id] or {}
    local out = {}
    for k, v in pairs(base) do out[k] = v end
    out.id = id
    out.name = out.name or title_from_id(id)
    out.av = out.av or make_avatar(out.name ~= "—" and out.name or id)
    out.tone = out.tone or "default"
    out.status = out.status or "в сети"
    return out
end

local function chat_unread(id)
    if not id or id == "" then return 0 end
    return (gs.get_msg_unread and tonumber(gs.get_msg_unread(id)) or 0) or 0
end

local function runtime_chat_ids()
    if gs.get_msg_chats then
        return gs.get_msg_chats() or {}
    end
    return {}
end

local function build_chat_list(self)
    local out = {}
    for _, id in ipairs(runtime_chat_ids()) do
        if self.filter ~= "unread" or chat_unread(id) > 0 then
            table.insert(out, id)
        end
    end
    return out
end

local function unread_total()
    return (gs.get_msg_unread_total and tonumber(gs.get_msg_unread_total()) or 0) or 0
end

local function last_runtime_message(chat_id)
    if not (gs.get_msg and chat_id) then return nil end
    local msgs = gs.get_msg(chat_id) or {}
    return msgs[#msgs]
end

local function preview_from_message(m)
    if not m then return "" end
    local text = tostring(m.text or "")
    if m.direction == "out" then
        text = "Я: " .. text
    end
    return text
end

local BORDER_NODE_BY_PREFIX = {
    search = "border_search",
    tab_unread = "border_unread",
    attach = "border_attach",
    input = "border_input",
    send = "border_send",
}

local function border_node_id(prefix)
    local slot = tostring(prefix or ""):match("^chat(%d+)$")
    if slot then return "chat" .. slot .. "_border" end

    slot = tostring(prefix or ""):match("^bub(%d+)$")
    if slot then return "bub" .. slot .. "_border" end

    return BORDER_NODE_BY_PREFIX[prefix]
end

local function set_border(prefix, color, alpha)
    local id = border_node_id(prefix)
    if id and get_node(id) then
        set_color(id, color, alpha)
        return
    end

    
    
    for _, suffix in ipairs({ "_bt", "_bb", "_bl", "_br" }) do
        set_color(prefix .. suffix, color, alpha)
    end
end

local function set_row_enabled(i, enabled)
    local p = "chat" .. i
    for _, suffix in ipairs({ "_bg", "_border", "_av_bg", "_av", "_name", "_icons", "_preview", "_time", "_badge_bg", "_badge" }) do
        set_node_enabled(p .. suffix, enabled)
    end
end

local function hide_rows()
    for i = 1, MAX_LIST_ROWS do set_row_enabled(i, false) end
end




local function update_badge_pulse(self, slot, pulse_key)
    self.badge_pulse = self.badge_pulse or {}
    local current = self.badge_pulse[slot]
    if current == pulse_key then return end
    local p = "chat" .. slot
    for _, suffix in ipairs({ "_badge_bg", "_badge" }) do
        local node = get_node(p .. suffix)
        if node then
            gui.cancel_animation(node, gui.PROP_COLOR)
            local c = gui.get_color(node)
            gui.set_color(node, vmath.vector4(c.x, c.y, c.z, 1))
            if pulse_key then
                local target = vmath.vector4(c.x, c.y, c.z, 0.35)
                gui.animate(node, gui.PROP_COLOR, target,
                    gui.EASING_INOUTSINE, 0.6, 0, nil,
                    gui.PLAYBACK_LOOP_PINGPONG)
            end
        end
    end
    self.badge_pulse[slot] = pulse_key
end

local function render_tab(self)
    local all_count = #runtime_chat_ids()
    local unread = unread_total()
    set_text("tab_all_count", tostring(all_count))
    set_text("tab_unread_count", tostring(unread))
    local all_active = self.filter ~= "unread"
    set_color("tab_all_bg", all_active and COLORS.accent or COLORS.card, all_active and 0.15 or 0.60)
    set_color("tab_unread_bg", (not all_active) and COLORS.accent or COLORS.card, (not all_active) and 0.15 or 0.60)
    set_border("tab_all", all_active and COLORS.accent or COLORS.accent, all_active and 0.55 or 0.25)
    set_border("tab_unread", (not all_active) and COLORS.accent or COLORS.accent, (not all_active) and 0.55 or 0.25)
end

local function update_list_scrollbar(self, total)
    local track_h = 450
    local visible = MAX_LIST_ROWS
    if total <= visible then
        set_alpha("list_scrollbar_thumb", 0.18)
        set_size_x("list_scrollbar_thumb", 4)
        set_pos_y("list_scrollbar_thumb", 442)
        return
    end
    local ratio = visible / total
    local h = math.max(80, track_h * ratio)
    local max_off = math.max(1, total - visible)
    local travel = track_h - h
    local top_y = 92 + track_h - h
    local y = top_y - travel * ((self.list_offset or 0) / max_off)
    local n = get_node("list_scrollbar_thumb")
    if n then
        local s = gui.get_size(n)
        gui.set_size(n, vmath.vector3(s.x, h, s.z))
        local p = gui.get_position(n)
        gui.set_position(n, vmath.vector3(p.x, y, p.z))
        gui.set_alpha(n, 0.70)
    end
end

local function render_list(self)
    local ids = build_chat_list(self)
    self.visible_chat_ids = ids
    local total = #ids
    local max_offset = math.max(0, total - MAX_LIST_ROWS)
    self.list_offset = math.max(0, math.min(self.list_offset or 0, max_offset))
    hide_rows()
    render_tab(self)

    for slot = 1, MAX_LIST_ROWS do
        local id = ids[(self.list_offset or 0) + slot]
        if not id then
            update_badge_pulse(self, slot, nil)
        end
        if id then
            local p = "chat" .. slot
            local meta = get_meta(id)
            local tone = tone_color(meta.tone)
            local unread_n = chat_unread(id)
            local unread = unread_n > 0
            local last = last_runtime_message(id)

            
            
            local rtone, rlabel = nil, nil
            if gs.get_msg_tag then rtone, rlabel = gs.get_msg_tag(id) end
            local pin_color = nil
            if rtone == "hot" or rtone == "danger" then pin_color = COLORS.hot
            elseif rtone == "amber" or rtone == "warn" then pin_color = COLORS.amber
            elseif rtone == "need_reply" then pin_color = COLORS.hot
            elseif rtone then pin_color = COLORS.accent end

            set_row_enabled(slot, true)
            set_color(p .. "_bg", unread and COLORS.accent or COLORS.card, unread and 0.06 or 0.55)
            set_border(p, unread and COLORS.accent or COLORS.paper, unread and 0.30 or 0.10)
            set_color(p .. "_av_bg", tone, (meta.tone == "dim") and 0.10 or 0.20)
            set_color(p .. "_av", tone, 1)
            set_color(p .. "_name", unread and COLORS.accent or COLORS.paper, 1)
            set_text(p .. "_av", avatar_text(meta.av or "?"))
            set_text(p .. "_name", clamp_text(meta.name or id, 26))
            local icons = ""
            if meta.bot then icons = icons .. " BOT" end
            if meta.group then icons = icons .. " GRP" end
            if meta.channel then icons = icons .. " CH" end
            if meta.muted then icons = icons .. " MUTE" end
            set_text(p .. "_icons", icons)
            set_text(p .. "_preview", clamp_text(preview_from_message(last), 66))
            set_text(p .. "_time", last and last.time or "")
            local pulse_key = nil
            if rtone then
                
                set_node_enabled(p .. "_badge_bg", true)
                set_node_enabled(p .. "_badge", true)
                set_color(p .. "_badge_bg", pin_color or COLORS.accent, 1)
                local label = (rlabel and rlabel ~= "") and rlabel or "!"
                set_text(p .. "_badge", label)
                pulse_key = id .. ":" .. tostring(rtone)
            elseif unread_n > 0 then
                set_node_enabled(p .. "_badge_bg", true)
                set_node_enabled(p .. "_badge", true)
                set_color(p .. "_badge_bg", meta.tone == "hot" and COLORS.hot or COLORS.accent, 1)
                set_text(p .. "_badge", tostring(unread_n))
            else
                set_node_enabled(p .. "_badge_bg", false)
                set_node_enabled(p .. "_badge", false)
            end
            update_badge_pulse(self, slot, pulse_key)
        end
    end
    set_text("list_footer_left", "messenger · runtime channel")
    if total == 0 then
        if self.filter == "unread" then
            set_text("list_footer_right", "нет непрочитанных")
        else
            set_text("list_footer_right", "нет сообщений · # msg:add")
        end
    else
        local first = math.min(total, (self.list_offset or 0) + 1)
        local last = math.min(total, (self.list_offset or 0) + MAX_LIST_ROWS)
        set_text("list_footer_right", "показаны: " .. tostring(first) .. "-" .. tostring(last) .. " / " .. tostring(total))
    end
    update_list_scrollbar(self, total)
end

local function set_bubble_enabled(i, enabled)
    local p = "bub" .. i
    for _, suffix in ipairs({ "_bg", "_border", "_text", "_stamp" }) do
        set_node_enabled(p .. suffix, enabled)
    end
end

local function hide_bubbles()
    for i = 1, MAX_BUBBLES do set_bubble_enabled(i, false) end
end




local function is_today_time(t)
    if not t or t == "" then return true end
    return tostring(t):match("^%d%d:%d%d$") ~= nil
end






local function runtime_msgs_to_ui(chat_id, raw)
    local out = {}
    local meta = get_meta(chat_id)
    local sep_inserted = false
    for _, m in ipairs(raw or {}) do
        if not sep_inserted and is_today_time(m.time) then
            table.insert(out, { type = "daysep", text = "сегодня" })
            sep_inserted = true
        end
        local entry = {
            dir  = m.direction or "in",
            text = m.text or "",
            time = m.time or "",
            tone = meta.tone,
        }
        if entry.dir == "out" then
            entry.status = "✓✓"
        end
        table.insert(out, entry)
    end
    return out
end

local function get_messages(chat_id)
    if not (chat_id and gs.get_msg) then return {} end
    return runtime_msgs_to_ui(chat_id, gs.get_msg(chat_id) or {})
end

local function bubble_layout(m, meta)
    local is_out = m.dir == "out"
    local is_sep = m.type == "daysep" or m.type == "sys"
    if is_sep then
        
        
        
        
        
        local text, lines = wrap_text_to_width(m.text or "", 30)
        local sep_w = 200
        local sep_x = 820 - sep_w / 2
        return {
            x = sep_x,
            w = sep_w,
            h = math.max(24, 10 + lines * 14),
            text_w = sep_w - 20,
            text = text,
            lines = lines,
            is_sep = true,
        }
    end

    local x = is_out and 686 or 540
    local w = is_out and 500 or 560
    local text, lines = wrap_text_to_width(m.text or "", text_cols_for_width(w - BUBBLE_PAD_X * 2))
    local h = math.max(BUBBLE_MIN_H, BUBBLE_PAD_TOP + lines * BUBBLE_LINE_H + BUBBLE_STAMP_AREA_H)
    return {
        x = x,
        w = w,
        h = h,
        text_w = w - BUBBLE_PAD_X * 2,
        text = text,
        lines = lines,
        is_out = is_out,
    }
end

local function update_chat_scrollbar(self, total)
    local track_h = 430
    local visible = MAX_BUBBLES
    if total <= visible then
        set_alpha("chat_scrollbar_thumb", 0.18)
        return
    end
    local ratio = visible / total
    local h = math.max(80, track_h * ratio)
    local max_off = math.max(1, total - visible)
    local travel = track_h - h
    local top_y = 148 + track_h - h
    local y = top_y - travel * ((self.chat_offset or 0) / max_off)
    local n = get_node("chat_scrollbar_thumb")
    if n then
        local s = gui.get_size(n)
        gui.set_size(n, vmath.vector3(s.x, h, s.z))
        local p = gui.get_position(n)
        gui.set_position(n, vmath.vector3(p.x, y, p.z))
        gui.set_alpha(n, 0.70)
    end
end

local function render_chat(self)
    local id = self.active_chat_id
    if not id then return end
    local meta = get_meta(id)
    set_text("head_av", avatar_text(meta.av or "?"))
    set_text("head_name", clamp_text(meta.name or id, 28))
    set_text("head_status", meta.status or "в сети")
    local tone = tone_color(meta.tone)
    set_color("head_av_bg", tone, 0.20)
    set_color("head_av", tone, 1)
    local msgs = get_messages(id)
    local total = #msgs
    local max_offset = math.max(0, total - MAX_BUBBLES)
    self.chat_offset = math.max(0, math.min(self.chat_offset or max_offset, max_offset))
    hide_bubbles()

    local idx = math.min(total, (self.chat_offset or 0) + MAX_BUBBLES)
    local slot = MAX_BUBBLES
    local y = CHAT_AREA_BOTTOM

    
    
    
    while idx >= 1 and slot >= 1 do
        local m = msgs[idx]
        local layout = bubble_layout(m, meta)
        if y + layout.h > CHAT_AREA_TOP then break end

        local p = "bub" .. slot
        set_bubble_enabled(slot, true)
        local is_out = m.dir == "out"
        local is_sep = layout.is_sep
        local color = is_out and COLORS.accent or tone_color(m.tone or meta.tone)
        set_pos_y(p .. "_bg", y)
        set_size_y(p .. "_bg", layout.h)
        set_size_y(p .. "_border", layout.h)

        if is_sep then
            set_color(p .. "_bg", COLORS.paper, m.type == "daysep" and 0.08 or 0.0)
            set_border(p, COLORS.paper, 0.0)
            set_color(p .. "_text", COLORS.dim, 0.78)
            set_text(p .. "_text", layout.text)
            set_text(p .. "_stamp", "")
            set_pos_x(p .. "_bg", layout.x)
            
            
            set_pos_x(p .. "_text", layout.x + layout.w / 2)
            set_pos_x(p .. "_stamp", layout.x + layout.w - 12)
            set_size_x(p .. "_bg", layout.w)
            set_size_x(p .. "_border", layout.w)
            set_size_x(p .. "_text", layout.text_w)
            set_size_y(p .. "_text", math.max(14, layout.h - 8))
            set_pos_y(p .. "_text", layout.h / 2)
            local tnode = get_node(p .. "_text")
            if tnode then
                gui.set_pivot(tnode, gui.PIVOT_CENTER)
                if gui.set_line_break then gui.set_line_break(tnode, true) end
            end
        else
            set_pos_x(p .. "_bg", layout.x)
            set_pos_x(p .. "_text", layout.x + BUBBLE_PAD_X)
            set_pos_x(p .. "_stamp", layout.x + layout.w - 12)
            set_size_x(p .. "_bg", layout.w)
            set_size_x(p .. "_border", layout.w)
            set_size_x(p .. "_text", layout.text_w)
            set_size_y(p .. "_text", math.max(BUBBLE_LINE_H, layout.lines * BUBBLE_LINE_H))
            set_color(p .. "_bg", is_out and COLORS.accent or COLORS.card, is_out and 0.12 or 0.70)
            set_border(p, color, is_out and 0.45 or 0.28)
            set_color(p .. "_text", COLORS.paper, 1)
            set_text(p .. "_text", layout.text)
            set_pos_y(p .. "_text", layout.h - BUBBLE_PAD_TOP)
            local tnode = get_node(p .. "_text")
            if tnode then
                gui.set_pivot(tnode, gui.PIVOT_NW)
                if gui.set_line_break then gui.set_line_break(tnode, true) end
            end
            local stamp = tostring(m.time or "")
            if is_out and m.status then stamp = stamp .. " · " .. tostring(m.status):upper() end
            set_text(p .. "_stamp", stamp)
            set_pos_y(p .. "_stamp", 10)
            set_color(p .. "_stamp", is_out and COLORS.accent or COLORS.dim, 0.80)
        end

        y = y + layout.h + 12
        idx = idx - 1
        slot = slot - 1
    end
    update_chat_scrollbar(self, total)
end




local refresh_send_pulse

local function set_view(self, view)
    self.view = view or "list"
    local show_list = self.view == "list"
    set_node_enabled("list_root", show_list)
    set_node_enabled("chat_root", not show_list)
    set_node_enabled("messenger_runtime_root", true)
    if show_list then render_list(self) else render_chat(self) end
    if refresh_send_pulse then refresh_send_pulse(self) end
end

local function open_list(self)
    self.active_chat_id = nil
    set_view(self, "list")
end

local function open_chat(self, chat_id)
    if not chat_id then return end
    self.active_chat_id = chat_id
    self.chat_offset = nil
    
    
    
    
    
    if gs.mark_msg_read then gs.mark_msg_read(chat_id) end
    set_view(self, "chat")
end

local function is_inside_rect(id, x, y)
    local n = get_node(id)
    if not n or not gui.is_enabled(n) then return false end
    return gui.pick_node(n, x, y)
end







local function resolve_reply_knot(chat_id)
    if not chat_id or chat_id == "" then return nil end
    if gs.get_msg_prompt then
        local pknot = gs.get_msg_prompt(chat_id)
        if pknot and pknot ~= "" then return pknot end
    end
    local knot_name = nil
    if contacts and contacts.get_ink_thread then
        knot_name = contacts.get_ink_thread("msg", chat_id)
    end
    return knot_name or ("msg_thread_" .. tostring(chat_id))
end




local function can_reply(chat_id)
    if not chat_id or chat_id == "" then return false end
    
    if gs.get_msg_prompt then
        local pknot = gs.get_msg_prompt(chat_id)
        if pknot and pknot ~= "" and dm.has_knot and dm.has_knot(pknot) then
            return true
        end
    end
    local knot_name = resolve_reply_knot(chat_id)
    if not (knot_name and dm.has_knot and dm.has_knot(knot_name)) then return false end
    local replied_flag = "msg_" .. tostring(chat_id) .. "_replied"
    if gs.get_flag and gs.get_flag(replied_flag) then return false end
    return true
end


local PULSE_TARGETS = { "input_text", "send_text", "send_bg" }
local PULSE_DURATION = 0.6
local PULSE_ALPHA_LO = 0.45

local function start_send_pulse()
    for _, id in ipairs(PULSE_TARGETS) do
        local n = get_node(id)
        if n then
            gui.cancel_animation(n, "color.w")
            gui.set_color(n, vmath.vector4(gui.get_color(n).x, gui.get_color(n).y, gui.get_color(n).z, 1))
            gui.animate(n, "color.w", PULSE_ALPHA_LO, gui.EASING_INOUTSINE,
                PULSE_DURATION, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
        end
    end
end

local function stop_send_pulse()
    for _, id in ipairs(PULSE_TARGETS) do
        local n = get_node(id)
        if n then
            gui.cancel_animation(n, "color.w")
            local c = gui.get_color(n)
            gui.set_color(n, vmath.vector4(c.x, c.y, c.z, 1))
        end
    end
end

refresh_send_pulse = function(self)
    if self.view == "chat" and can_reply(self.active_chat_id) then
        start_send_pulse()
    else
        stop_send_pulse()
    end
end




local function handle_reply_tap(self)
    if not self.active_chat_id then return end
    if not can_reply(self.active_chat_id) then return end
    msg.post(UI_MGR, MSG.messenger_open_chat, { chat_id = self.active_chat_id })
end

local function disarm_all_taps(self)
    self.reply_tap_armed = false
end

local function step_list(self, delta)
    local ids = build_chat_list(self)
    local max_offset = math.max(0, #ids - MAX_LIST_ROWS)
    self.list_offset = math.max(0, math.min((self.list_offset or 0) + delta, max_offset))
    render_list(self)
end

local function step_chat(self, delta)
    local total = #get_messages(self.active_chat_id)
    local max_offset = math.max(0, total - MAX_BUBBLES)
    self.chat_offset = math.max(0, math.min((self.chat_offset or max_offset) + delta, max_offset))
    render_chat(self)
end

local function handle_scroll(self, action)
    local dy = tonumber(action.dy or action.value or 0) or 0
    if dy == 0 then return false end
    if self.view == "list" then
        local ids = build_chat_list(self)
        local max_offset = math.max(0, #ids - MAX_LIST_ROWS)
        self.list_offset = math.max(0, math.min((self.list_offset or 0) + (dy < 0 and LIST_SCROLL_STEP or -LIST_SCROLL_STEP), max_offset))
        render_list(self)
        return true
    elseif self.view == "chat" then
        local total = #get_messages(self.active_chat_id)
        local max_offset = math.max(0, total - MAX_BUBBLES)
        self.chat_offset = math.max(0, math.min((self.chat_offset or max_offset) + (dy < 0 and CHAT_SCROLL_STEP or -CHAT_SCROLL_STEP), max_offset))
        render_chat(self)
        return true
    end
    return false
end

local function handle_phone_input(self, action_id, action)
    if not self.visible then return false end
    action = action or {}
    if action_id == MSG.wheel_up then
        action.dy = 1
        handle_scroll(self, action)
        return true
    elseif action_id == MSG.wheel_down then
        action.dy = -1
        handle_scroll(self, action)
        return true
    end

    
    
    
    
    if action_id ~= MSG.touch then
        return true
    end
    local pressed = action.pressed and true or false
    local released = action.released and true or false

    
    
    
    
    
    if pressed and self.view == "chat" then
        local x_pre = action.x or 0
        local y_pre = action.y or 0
        if is_inside_rect("send_bg", x_pre, y_pre)
           or is_inside_rect("input_bg", x_pre, y_pre) then
            self.reply_tap_armed = true
        end
    end

    
    
    
    
    local drag_state = (self.view == "list") and self.list_drag
                    or (self.view == "chat") and self.chat_drag
                    or nil
    if drag_state then
        local result = drag_scroll.handle(drag_state, action)
        if result == "swallow" then
            
            
            if self.view == "chat" and drag_state.moved then
                disarm_all_taps(self)
            end
            return true
        end
        
    end

    
    
    if not pressed and not released then
        return true
    end
    local x, y = action.x or 0, action.y or 0

    if self.view == "list" then
        
        
        
        if not released then
            return true
        end
        if is_inside_rect("tab_all_bg", x, y) then
            self.filter = "all"
            self.list_offset = 0
            render_list(self)
            return true
        elseif is_inside_rect("tab_unread_bg", x, y) then
            self.filter = "unread"
            self.list_offset = 0
            render_list(self)
            return true
        end
        for i = 1, MAX_LIST_ROWS do
            if is_inside_rect("chat" .. i .. "_bg", x, y) then
                local id = self.visible_chat_ids and self.visible_chat_ids[(self.list_offset or 0) + i]
                if id then open_chat(self, id) end
                return true
            end
        end
    else
        
        
        
        if is_inside_rect("back_bg", x, y) then
            if not released then return true end
            disarm_all_taps(self)
            open_list(self)
            return true
        elseif is_inside_rect("send_bg", x, y) or is_inside_rect("input_bg", x, y) then
            
            
            
            
            
            if action.pressed then
                self.reply_tap_armed = true
                return true
            end
            if action.released then
                if self.reply_tap_armed then
                    disarm_all_taps(self)
                    handle_reply_tap(self)
                end
                return true
            end
            return true
        elseif is_inside_rect("attach_bg", x, y) then
            log.debug("messenger", "TODO attach runtime hook")
            return true
        end
    end
    
    
    
    return true
end

local function set_all_enabled(enabled)
    set_nodes_enabled(NODE_IDS, enabled)
end

local function clone_rows()
    _row_clones = {}

    local proto = try_get_node("messenger_list/chat1_bg") or try_get_node("chat1_bg")
    if not proto then
        log.warn("messenger", "chat1_bg prototype not found; row clones disabled")
        return
    end

    local proto_pos = gui.get_position(proto)
    for slot = 2, MAX_LIST_ROWS do
        local clone = gui.clone_tree(proto)
        _row_clones[slot] = clone

        local root = clone["messenger_list/chat1_bg"] or clone["chat1_bg"]
        if root then
            gui.set_position(root, vmath.vector3(
                proto_pos.x,
                proto_pos.y - (slot - 1) * LIST_ROW_SLOT_GAP_Y,
                proto_pos.z
            ))
        end
    end
end

local function delete_row_clones()
    if not _row_clones then return end
    for slot = 2, MAX_LIST_ROWS do
        local clone = _row_clones[slot]
        if clone then
            local root = clone["messenger_list/chat1_bg"] or clone["chat1_bg"]
            if root then pcall(gui.delete_node, root) end
        end
    end
    _row_clones = nil
end

local function clone_bubbles()
    _bubble_clones = {}

    local proto = try_get_node("messenger_chat/bub1_bg") or try_get_node("bub1_bg")
    if not proto then
        log.warn("messenger", "bub1_bg prototype not found; bubble clones disabled")
        return
    end

    local proto_pos = gui.get_position(proto)
    for slot = 2, MAX_BUBBLES do
        local clone = gui.clone_tree(proto)
        _bubble_clones[slot] = clone

        local root = clone["messenger_chat/bub1_bg"] or clone["bub1_bg"]
        if root then
            gui.set_position(root, vmath.vector3(
                proto_pos.x,
                proto_pos.y - (slot - 1) * BUBBLE_SLOT_GAP_Y,
                proto_pos.z
            ))
        end
    end
end

local function delete_bubble_clones()
    if not _bubble_clones then return end
    for slot = 2, MAX_BUBBLES do
        local clone = _bubble_clones[slot]
        if clone then
            local root = clone["messenger_chat/bub1_bg"] or clone["bub1_bg"]
            if root then pcall(gui.delete_node, root) end
        end
    end
    _bubble_clones = nil
end

function init(self)
    self.visible = false
    self.view = "list"
    self.filter = "all"
    self.list_offset = 0
    self.chat_offset = 0
    self.reply_tap_armed = false

    U.apply_adaptive_layout("messenger_runtime_root")

    self.list_drag = drag_scroll.new({
        step_px      = LIST_DRAG_STEP_PX,
        threshold_px = DRAG_THRESHOLD_PX,
        owner        = self,
        on_step      = function(owner, delta) step_list(owner, delta) end,
    })
    
    
    self.chat_drag = drag_scroll.new({
        step_px      = CHAT_DRAG_STEP_PX,
        threshold_px = DRAG_THRESHOLD_PX,
        owner        = self,
        invert       = true,
        on_step      = function(owner, delta) step_chat(owner, delta) end,
    })

    
    
    
    clone_rows()
    clone_bubbles()
    set_all_enabled(false)
end

function final(self)
    set_all_enabled(false)
    delete_bubble_clones()
    delete_row_clones()
end

function on_message(self, message_id, message, sender)
    if message_id == MSG.open_app then
        self.visible = true
        self.filter = self.filter or "all"
        self.list_offset = self.list_offset or 0
        set_all_enabled(true)
        open_list(self)
    elseif message_id == MSG.close_app then
        self.visible = false
        self.view = "list"
        self.active_chat_id = nil
        disarm_all_taps(self)
        stop_send_pulse()  
        set_all_enabled(false)
    elseif message_id == MSG.refresh_app then
        if self.visible then set_view(self, self.view or "list") end
    elseif message_id == MSG.phone_input then
        
        
        
        if self.visible then
            handle_phone_input(self, message and message.action_id or MSG.touch, {
                x = message and message.x or 0,
                y = message and message.y or 0,
                dx = message and message.dx or 0,
                dy = message and message.dy or 0,
                value = message and message.value or 0,
                pressed = message and message.pressed or false,
                released = message and message.released or false,
            })
        end
    end
end

function on_input(self, action_id, action)
    return handle_phone_input(self, action_id, action or {})
end
