local gs = require "main.scripts.game_state"
local drag_scroll = require "main.gui.modules.drag_scroll"
local U = require "main.gui.modules.gui_utils"
local COLORS = U.COLORS

local MAX_TERM_SLOTS = 18
local TERM_LINE_Y_BASE = 563   
local TERM_LINE_GAP = 21       
local TERM_LINE_X = 542
local TERM_LINE_Z = 0.564
local SCROLL_STEP_ROWS = 3
local DRAG_STEP_PX = 28
local DRAG_THRESHOLD_PX = 8

local TERM_COLORS = {
    ok     = COLORS.green,
    warn   = COLORS.amber,
    err    = COLORS.hot,
    error  = COLORS.hot,
    info   = COLORS.accent,
    prompt = COLORS.green,
    plain  = COLORS.paper,
    debug  = COLORS.paper_dim,
}

local STATIC_NODE_IDS = {
    "term_runtime_root",
    "v_term_bg", "v_term_crt_scan", "v_term_head_bg",
    "v_term_eyebrow", "v_term_title",
    "v_term_tab1_card", "v_term_tab1", "v_term_tab1_text",
    "v_term_tab2_card", "v_term_tab2", "v_term_tab2_text",
    "v_term_tab3_card", "v_term_tab3", "v_term_tab3_text",
    "v_term_tab_plus_card", "v_term_tab_plus", "v_term_tab_plus_text",
    "v_term_shell", "v_term_shell_clip",
    "v_term_input_bg", "v_term_input_prompt", "v_term_input_text", "v_term_caret",
    "v_term_status_mode_card", "v_term_status_host_card", "v_term_status_path_card", "v_term_status_git_card", "v_term_status_batt_card",
    "v_term_status_mode", "v_term_status_host", "v_term_status_path", "v_term_status_git", "v_term_status_batt",
    "v_term_status_mode_text", "v_term_status_host_text", "v_term_status_path_text", "v_term_status_git_text", "v_term_status_batt_text",
    "v_term_scroll_track", "v_term_scroll_thumb",

    
    "v_term_screen",
}

local _line_clones = {}

local NODE_IDS = {}
for _, id in ipairs(STATIC_NODE_IDS) do NODE_IDS[#NODE_IDS + 1] = id end
NODE_IDS[#NODE_IDS + 1] = "v_term_l1"

local FALLBACK_LINES = {
    { level = "debug", text = "avos-shell 0.17.3 · connected to prod-eu-1.avos.cloud" },
    { level = "debug", text = "Last login: Wed Apr 03 06:01:47 from 95.142.17.4" },
    { level = "prompt", text = "systemctl status loop-daemon" },
    { level = "err", text = "loop-daemon.service failed: oom-killed" },
    { level = "warn", text = "frame #017 leaked 1.2G; aborting" },
    { level = "prompt", text = "git log --oneline -n 3" },
    { level = "plain", text = "a4f1c0b v0.17.3 — fix mem leak in loop-daemon" },
    { level = "plain", text = "3170217 v0.17.2 — frame replay safety" },
    { level = "prompt", text = "avosctl rollback --to v0.17.2 --service loop-daemon" },
    { level = "info", text = "checking acl... [ok]" },
    { level = "info", text = "draining traffic on prod-eu-1... [ok]" },
    { level = "info", text = "pulling image avos/loop-daemon:v0.17.2... [ok]" },
    { level = "warn", text = "3 frames in flight will be replayed on next boot (#015, #016, #017)" },
    { level = "prompt", text = "tail -f /var/log/loop-daemon/frame.log | grep \"#017\"" },
    { level = "plain", text = "06:13:58.014 INFO  frame=#017 anchor=mirror.bathroom subj=NM" },
    { level = "warn", text = "06:13:58.402 WARN  frame=#017 ghost detected (sig=hot, conf=0.87)" },
    { level = "err", text = "06:13:58.799 FATAL frame=#017 loop integrity violated · daemon abort" },
    { level = "info", text = "HINT recovery: locate anchor & meet subj NM with clear memory" },
}

local set_node_enabled     = U.set_node_enabled
local set_text             = U.set_text
local set_color_keep_alpha = U.set_color_keep_alpha

local function get_node(id)
    if type(id) == "string" then
        local slot = id:match("^v_term_l(%d+)$")
        if slot then
            local s = tonumber(slot)
            if s == 1 then return U.get_node(id) end
            local c = _line_clones[s]
            if c then return c end
            return nil
        end
    end
    return U.get_node(id)
end

local function init_line_clones()
    local proto = U.get_node("v_term_l1")
    if not proto then return end
    local pp = gui.get_position(proto)
    for i = 2, MAX_TERM_SLOTS do
        local cmap = gui.clone_tree(proto)
        local c = cmap and cmap["v_term_l1"]
        if c then
            local y = TERM_LINE_Y_BASE - 42 - (i - 2) * TERM_LINE_GAP
            gui.set_position(c, vmath.vector3(pp.x, y, pp.z))
            _line_clones[i] = c
        end
    end
end

local function set_nodes_enabled(enabled)
    U.set_nodes_enabled(NODE_IDS, enabled)
end

local function slot_count()
    local count = 0
    for i = 1, MAX_TERM_SLOTS do
        if get_node("v_term_l" .. i) then count = count + 1 end
    end
    return count
end

local function terminal_lines()
    local list = gs.get_terminal_lines and gs.get_terminal_lines() or nil
    if type(list) ~= "table" or #list == 0 then
        return FALLBACK_LINES
    end
    return list
end

local function clamp_offset(self, total)
    local slots = math.max(1, slot_count())
    local max_offset = math.max(0, (tonumber(total) or 0) - slots)
    self.term_offset = math.max(0, math.min(tonumber(self.term_offset) or 0, max_offset))
    return max_offset
end

local function format_line(entry)
    if type(entry) ~= "table" then return tostring(entry or "") end
    local level = tostring(entry.level or "plain")
    local text = tostring(entry.text or "")
    if level == "prompt" then return "ник@prod-eu-1 /srv/loop $ " .. text end
    if level == "debug" then return "# " .. text end
    if level == "plain" then return text end
    return string.upper(level) .. "  " .. text
end

local function update_scrollbar(self, total)
    local thumb = get_node("v_term_scroll_thumb")
    local track = get_node("v_term_scroll_track")
    if not thumb or not track then return end

    local slots = math.max(1, slot_count())
    local max_offset = clamp_offset(self, total)
    local track_size = gui.get_size(track)
    local track_pos = gui.get_position(track)
    local track_h = math.max(1, track_size.y)

    if total <= slots then
        gui.set_enabled(thumb, false)
        return
    end

    gui.set_enabled(thumb, true)
    local ratio = math.min(1, slots / math.max(1, total))
    local h = math.max(24, track_h * ratio)
    local t = max_offset > 0 and ((tonumber(self.term_offset) or 0) / max_offset) or 0
    local y_top = track_pos.y + (track_h * 0.5)
    local y = (y_top - h * 0.5) - ((track_h - h) * t)

    gui.set_size(thumb, vmath.vector3(track_size.x, h, 0))
    gui.set_position(thumb, vmath.vector3(track_pos.x, y, gui.get_position(thumb).z))
end

local function render(self)
    local list = terminal_lines()
    local total = #list
    local slots = math.max(1, slot_count())

    if self.follow_bottom then
        self.term_offset = math.max(0, total - slots)
    end
    clamp_offset(self, total)

    for i = 1, slots do
        local id = "v_term_l" .. i
        local entry = list[(tonumber(self.term_offset) or 0) + i]
        set_node_enabled(id, entry ~= nil)
        if entry then
            local level = type(entry) == "table" and tostring(entry.level or "plain") or "plain"
            set_text(id, format_line(entry))
            set_color_keep_alpha(id, TERM_COLORS[level] or TERM_COLORS.plain)
        else
            set_text(id, "")
        end
    end

    set_text("v_term_eyebrow", "avos-shell · ssh prod-eu-1 · p1 active")
    set_text("v_term_title", "ТЕРМИНАЛ")
    set_text("v_term_tab1_text", "prod-eu-1 ×")
    set_text("v_term_tab2_text", "local ×")
    set_text("v_term_tab3_text", "db-replica ×")
    set_text("v_term_tab_plus_text", "+")
    set_text("v_term_input_prompt", "ник@prod-eu-1 /srv/loop $")
    set_text("v_term_input_text", "tail -f frame.log")
    set_text("v_term_status_mode_text", "P1 ACTIVE")
    set_text("v_term_status_host_text", "PROD-EU-1")
    set_text("v_term_status_path_text", "/SRV/LOOP")
    set_text("v_term_status_git_text", "MAIN")
    set_text("v_term_status_batt_text", "74%")

    update_scrollbar(self, total)
end

local function refresh(self)
    if self.follow_bottom == nil then self.follow_bottom = true end
    render(self)
end

local function is_at_bottom(self, total)
    local max_offset = clamp_offset(self, total)
    return (tonumber(self.term_offset) or 0) >= max_offset
end

local function scroll_term(self, delta_rows)
    local list = terminal_lines()
    local total = #list
    local max_offset = clamp_offset(self, total)
    if max_offset <= 0 then return false end

    local old = tonumber(self.term_offset) or 0
    self.term_offset = math.max(0, math.min(old + delta_rows, max_offset))
    self.follow_bottom = is_at_bottom(self, total)

    if self.term_offset ~= old then
        render(self)
        return true
    end
    return false
end

local function is_wheel_down(action_id)
    return action_id == hash("wheel_down") or action_id == hash("mouse_wheel_down") or action_id == hash("scroll_down")
end

local function is_wheel_up(action_id)
    return action_id == hash("wheel_up") or action_id == hash("mouse_wheel_up") or action_id == hash("scroll_up")
end

local function is_wheel_axis(action_id)
    return action_id == hash("wheel") or action_id == hash("mouse_wheel") or action_id == hash("scroll")
end

local function wheel_rows_from_action(action_id, action)
    if is_wheel_down(action_id) then return SCROLL_STEP_ROWS end
    if is_wheel_up(action_id) then return -SCROLL_STEP_ROWS end
    if not is_wheel_axis(action_id) then return 0 end

    local v = 0
    if action then
        v = tonumber(action.value) or 0
        if v == 0 then v = tonumber(action.dy) or 0 end
        if v == 0 and action_id ~= hash("touch") then v = tonumber(action.y) or 0 end
    end
    if v == 0 then return 0 end
    return v > 0 and -SCROLL_STEP_ROWS or SCROLL_STEP_ROWS
end

local function inside_shell(x, y)
    local shell = get_node("v_term_shell_clip") or get_node("v_term_shell") or get_node("v_term_screen")
    return shell and gui.is_enabled(shell) and gui.pick_node(shell, x, y) == true
end

local function handle_phone_input(self, action_id, action)
    if not self.visible then return false end
    action = action or {}

    local wheel_rows = wheel_rows_from_action(action_id, action)
    if wheel_rows ~= 0 then return scroll_term(self, wheel_rows) end

    if action_id ~= hash("touch") then return false end

    
    
    local result = drag_scroll.handle(self.term_drag, action)
    return result == "swallow" or result == "tap"
end

function init(self)
    self.visible = false
    self.term_offset = 0
    self.follow_bottom = true

    U.apply_adaptive_layout("term_runtime_root")
    init_line_clones()
    self.term_drag = drag_scroll.new({
        step_px      = DRAG_STEP_PX,
        threshold_px = DRAG_THRESHOLD_PX,
        owner        = self,
        invert       = true,
        is_inside    = inside_shell,
        on_step      = function(owner, delta) scroll_term(owner, delta) end,
    })
    set_nodes_enabled(false)
end

function final(self)
    set_nodes_enabled(false)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open_app") then
        self.visible = true
        self.follow_bottom = true
        set_nodes_enabled(true)
        refresh(self)

    elseif message_id == hash("close_app") then
        self.visible = false
        drag_scroll.reset(self.term_drag)
        set_nodes_enabled(false)

    elseif message_id == hash("refresh_app") then
        if self.visible then refresh(self) end

    elseif message_id == hash("phone_input") then
        if self.visible then
            handle_phone_input(self, message and message.action_id or hash("touch"), {
                x = message and message.x or 0,
                y = message and message.y or 0,
                dx = message and message.dx or 0,
                dy = message and message.dy or 0,
                value = message and message.value or 0,
                pressed = message and message.pressed or false,
                released = message and message.released or false,
                repeated = message and message.repeated or false,
            })
        end
    end
end

function on_input(self, action_id, action)
    return handle_phone_input(self, action_id, action or {})
end
